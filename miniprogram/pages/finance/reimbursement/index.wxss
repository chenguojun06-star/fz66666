@import '/styles/page-utils.wxss';
@import '/styles/modal-form.wxss';

.page {
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ===== 外部（工厂）账号拦截提示 ===== */
.blocked-wrap {
  padding: 48px 16px;
}
.blocked-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 32px 20px;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.blocked-icon {
  width: 40px;
  height: 40px;
  margin: 0 auto 12px;
  border: 2px solid var(--color-warning);
  border-radius: 50%;
  position: relative;
}
.blocked-icon::after {
  content: '!';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--color-warning);
  line-height: 1;
}
.blocked-text {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ===== Filter Bar ===== */
.filter-bar {
  display: flex;
  gap: 8px;
}
.filter-item {
  flex: 1;
  min-width: 0;
}
.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  padding: 0 12px;
  height: 32px;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.picker-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-chevron {
  flex-shrink: 0;
  width: 0;
  height: 0;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 4px solid var(--color-text-tertiary);
}

/* ===== List ===== */
.list-section {
  padding: 4px 16px 16px;
}

.reimburse-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
  border-left: 3px solid var(--color-border);
  overflow: hidden;
}
.reimburse-card.tag-orange { border-left-color: var(--color-warning); }
.reimburse-card.tag-green { border-left-color: var(--color-success); }
.reimburse-card.tag-red { border-left-color: var(--color-danger); }

.card-hover {
  background: var(--color-bg-hover);
}

/* Row 1 */
.card-row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.recon-no {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* Row 2 */
.card-row2 {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.person-icon {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  position: relative;
}
.person-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1.5px solid var(--color-text-tertiary);
}
.person-icon::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 14px;
  height: 7px;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  border: 1.5px solid var(--color-text-tertiary);
  border-bottom: none;
}
.person-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text-secondary);
}
.row-separator {
  flex-shrink: 0;
  color: var(--color-text-tertiary);
}
.factory-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text-secondary);
}

/* Row 3 */
.card-row3 {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  margin-top: 12px;
}
.amount-text {
  font-size: var(--font-size-3xl);
  font-weight: 700;
  line-height: 1;
  color: var(--color-text-primary);
}
.qty-hint {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  white-space: nowrap;
}

.remaining-text {
  display: block;
  margin-top: 6px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Footer */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
}
.time-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.click-hint {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  white-space: nowrap;
}

/* ===== 操作面板 ===== */
.inline-form-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  margin: 12px 0;
  box-shadow: var(--shadow-sm);
}
.inline-form-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  border-bottom: 1px solid var(--color-border);
}
.inline-form-body {
  padding: 0;
}
.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 0;
  text-align: center;
  font-size: var(--font-size-md-lg);
  font-weight: 500;
  border-radius: var(--radius-xl);
}
.action-icon {
  width: 18px;
  height: 18px;
  position: relative;
  flex-shrink: 0;
}
.action-icon-check::before {
  content: '';
  position: absolute;
  top: 2px;
  left: 5px;
  width: 6px;
  height: 10px;
  border-right: 2px solid var(--color-success);
  border-bottom: 2px solid var(--color-success);
  transform: rotate(45deg);
}
.action-icon-warn {
  border: 2px solid var(--color-danger);
  border-radius: 50%;
}
.action-icon-warn::after {
  content: '!';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-danger);
  line-height: 1;
}
.action-approve {
  color: var(--color-success);
}
.action-pay {
  color: var(--color-primary);
}
.action-reject {
  color: var(--color-danger);
}
.action-cancel {
  color: var(--color-text-secondary);
  padding: 14px 16px;
  margin: 0 16px 12px;
}
