/* D-421：工资明细详情页样式（复用对账详情页同套色 token） */
@import '/styles/finance-card.wxss';  /* D-421：来源标签等公共样式 */

.page-root {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 12px var(--page-padding-x) calc(80px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
  gap: 12px;
}
.loading-spinner {
  width: 24px;
  height: 24px;
  border: 2px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* ===== 顶部信息卡 ===== */
.header-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
}
.header-cover {
  width: 96px;
  height: 96px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-cover-pic {
  width: 100%;
  height: 100%;
}
.header-cover-placeholder {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
}
.header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.header-no {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
.info-badges {
  display: flex;
  align-items: center;
  gap: 4px;
}
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  padding: 0 8px;
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-full);
  color: var(--color-text-white);
  line-height: 1;
  flex-shrink: 0;
}
.header-meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-sep {
  color: var(--color-text-tertiary);
  margin: 0 2px;
}

/* ===== 金额卡片 ===== */
.amount-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
}
.amount-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 0;
}
.amount-card-row--minor {
  padding-top: 0;
}
.amount-card-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.amount-card-final {
  display: flex;
  align-items: baseline;
  gap: 2px;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
.amount-card-currency {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
}
.amount-card-num {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  line-height: 1;
}
.amount-card-divider {
  height: 1px;
  background: var(--color-border-light, var(--color-border));
  margin: 4px 0;
}
.amount-card-sub-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.amount-card-sub-val {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

/* ===== Section 通用 ===== */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
}
.section-title {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 12px;
}
.remark-text {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ===== 时间线 ===== */
.timeline {
  display: flex;
  flex-direction: column;
}
.timeline-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 16px;
}
.timeline-item:last-child {
  padding-bottom: 0;
}
.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 5px;
  top: 14px;
  bottom: 0;
  width: 2px;
  background: var(--color-border);
}
.tl-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
  background: var(--color-border);
  z-index: 1;
}
.tl-dot--done {
  background: var(--color-success);
}
.tl-dot--todo {
  background: var(--color-bg-card);
  border: 2px solid var(--color-border);
  box-sizing: border-box;
}
.tl-dot--danger {
  background: var(--color-danger);
}
.tl-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.tl-name {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}
.tl-time {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}
.tl-meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ===== Fact 行 ===== */
.fact-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 8px 0;
  border-top: 1px solid var(--color-border-light, var(--color-border));
}
.fact-row:first-of-type {
  border-top: none;
}
.fact-label {
  flex-shrink: 0;
  width: 80px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.fact-val {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}
.fact-extra {
  color: var(--color-text-tertiary);
  margin-left: 2px;
}

/* ===== 底部操作 ===== */
.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px var(--page-padding-x) calc(12px + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1px solid var(--color-border);
  z-index: 10;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40px;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  transition: transform 0.18s ease, background-color 0.18s ease, color 0.18s ease;
}
.action-btn--pressed {
  transform: scale(0.98);
}
.action-btn--primary {
  background: var(--color-primary);
  color: var(--color-text-white);
}
.action-btn--primary.action-btn--pressed {
  background: var(--color-primary-active, var(--color-primary));
}
.action-btn--ghost {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}
.action-btn--ghost.action-btn--pressed {
  background: var(--color-bg-hover);
}
.footer-spacer {
  height: calc(64px + env(safe-area-inset-bottom));
}
/* D-421：不可审核原因提示 */
.blocked-hint {
  margin-top: 12px;
  padding: 12px 16px;
  background: var(--color-warning-bg, var(--color-bg-card));
  color: var(--color-warning);
  border-radius: var(--radius-xl);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

/* D-421：关键值强调 */
.fact-val--strong {
  font-weight: var(--font-weight-medium);
}

/* D-423：已审核状态提示（绿色，区别于不可审核的橙色警告） */
.blocked-hint--ok {
  background: var(--color-success-bg);
  color: var(--color-success);
}

/* D-428：结算异常提示卡（红） */
.abnormal-card {
  margin-top: 12px;
  padding: 12px 16px;
  background: var(--color-danger-bg);
  border-radius: var(--radius-xl);
}
.abnormal-card__text {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-danger);
  line-height: 1.5;
}
