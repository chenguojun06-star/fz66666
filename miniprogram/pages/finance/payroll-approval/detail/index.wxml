<view class="page-root">

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{loadError}}" class="loading-wrap">
    <text class="loading-text">{{loadError}}</text>
  </view>

  <block wx:elif="{{detail}}">

    <!-- 顶部：封面 + 款号 + 审核状态 -->
    <view class="header-card">
      <view class="header-cover">
        <image wx:if="{{detail._image}}" class="header-cover-pic" src="{{detail._image}}" mode="aspectFill" lazy-load />
        <view wx:else class="header-cover-placeholder"><text>款</text></view>
      </view>
      <view class="header-info">
        <text class="header-no">{{detail.styleNo || detail.orderNo || '—'}}</text>
        <view class="info-badges">
          <view class="source-chip source-chip--{{detail._sourceKind}}" wx:if="{{detail._sourceText}}">{{detail._sourceText}}</view>
          <view class="source-chip source-chip--{{detail._factoryKind}}" wx:if="{{detail._factoryText}}">{{detail._factoryText}}</view>
          <view class="status-badge" style="background:{{detail._statusColor}}">{{detail.auditText}}</view>
        </view>
        <text wx:if="{{detail.styleName}}" class="header-meta">{{detail.styleName}}</text>
        <text class="header-meta">{{detail.operatorName}}<text wx:if="{{detail.processName}}" class="info-sep"> · </text>{{detail.processName}}</text>
      </view>
    </view>

    <!-- 金额卡：本次结算金额 + 数量 × 单价 -->
    <view class="amount-card">
      <view class="amount-card-row">
        <text class="amount-card-label">结算金额</text>
        <view class="amount-card-final">
          <text class="amount-card-currency">¥</text>
          <text class="amount-card-num">{{detail.amountStr}}</text>
        </view>
      </view>
      <view class="amount-card-divider"></view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">计件数量</text>
        <text class="amount-card-sub-val">{{detail.quantityStr}} 件</text>
      </view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">工序单价</text>
        <text class="amount-card-sub-val">¥{{detail.unitPriceStr}}/件</text>
      </view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">计算式</text>
        <text class="amount-card-sub-val">{{detail.quantityStr}} × ¥{{detail.unitPriceStr}} = ¥{{detail.amountStr}}</text>
      </view>
    </view>

    <!-- 完成时间（用户明确要求：什么时候完成的） -->
    <view class="section-card">
      <text class="section-title">时间</text>
      <view class="fact-row">
        <text class="fact-label">开始时间</text>
        <text class="fact-val">{{detail._startText || '—'}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-label">完成时间</text>
        <text class="fact-val fact-val--strong">{{detail._endText || '—'}}</text>
      </view>
      <view wx:if="{{detail.recordCount}}" class="fact-row">
        <text class="fact-label">扫码笔数</text>
        <text class="fact-val">{{detail.recordCount}} 笔</text>
      </view>
    </view>

    <!-- 关联信息 -->
    <view class="section-card">
      <text class="section-title">关联信息</text>
      <view wx:if="{{detail._sourceText}}" class="fact-row">
        <text class="fact-label">来源</text>
        <text class="fact-val fact-val--strong">{{detail._sourceText}}</text>
      </view>
      <view wx:if="{{detail._factoryText}}" class="fact-row">
        <text class="fact-label">工厂类型</text>
        <text class="fact-val fact-val--strong">{{detail._factoryText}}{{detail.isInternal ? '工厂（可直接审核）' : '工厂（订单须关单后可审核）'}}</text>
      </view>
      <view wx:if="{{detail.orderNo}}" class="fact-row">
        <text class="fact-label">订单号</text>
        <text class="fact-val">{{detail.orderNo}}</text>
      </view>
      <view wx:if="{{detail.orderStatusText}}" class="fact-row">
        <text class="fact-label">订单状态</text>
        <text class="fact-val">{{detail.orderStatusText}}</text>
      </view>
      <view wx:if="{{detail.styleNo}}" class="fact-row">
        <text class="fact-label">款号</text>
        <text class="fact-val">{{detail.styleNo}}</text>
      </view>
      <view wx:if="{{detail.processCode}}" class="fact-row">
        <text class="fact-label">工序编码</text>
        <text class="fact-val">{{detail.processCode}}</text>
      </view>
      <view wx:if="{{detail.color || detail.size}}" class="fact-row">
        <text class="fact-label">颜色 / 码数</text>
        <text class="fact-val">{{detail.color || '—'}} / {{detail.size || '—'}}</text>
      </view>
      <view wx:if="{{detail.scanType}}" class="fact-row">
        <text class="fact-label">扫码类型</text>
        <text class="fact-val">{{detail.scanType}}</text>
      </view>
      <view wx:if="{{detail.actualOperatorName && detail.actualOperatorName !== detail.operatorName}}" class="fact-row">
        <text class="fact-label">实际操作人</text>
        <text class="fact-val">{{detail.actualOperatorName}}</text>
      </view>
      <view wx:if="{{detail.settlementId}}" class="fact-row">
        <text class="fact-label">结算单</text>
        <text class="fact-val">{{detail.settlementId}}</text>
      </view>
    </view>

    <!-- 底部操作：三态与 PC 端 actionColumns 对齐（可审核 / 已审核 / 未关单） -->
    <view wx:if="{{canOperate && !detail.audited && detail.eligible}}" class="footer-actions">
      <view class="action-btn action-btn--primary" hover-class="action-btn--pressed" bindtap="onAudit">审核通过</view>
    </view>
    <view wx:elif="{{detail.audited}}" class="blocked-hint blocked-hint--ok">该明细已审核，无需重复操作</view>
    <view wx:elif="{{detail.blockReason}}" class="blocked-hint">{{detail.blockReason}}</view>

    <view wx:if="{{canOperate && !detail.audited && detail.eligible}}" class="footer-spacer"></view>
  </block>

  <ai-assistant />
</view>