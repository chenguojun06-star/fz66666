<view class="page-root">

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <view wx:elif="{{loadError}}" class="loading-wrap">
    <text class="loading-text">{{loadError}}</text>
  </view>

  <block wx:elif="{{detail}}">

    <!-- 顶部：封面 + 款号 + 审核状态 -->
    <view class="header-card">
      <view class="header-cover">
        <image wx:if="{{detail._image}}" class="header-cover-pic" src="{{detail._image}}" mode="aspectFill" lazy-load />
        <view wx:else class="header-cover-placeholder"><text>{{t.wordStyles}}</text></view>
      </view>
      <view class="header-info">
        <text class="header-no">{{detail.styleNo || detail.orderNo || '—'}}</text>
        <view class="info-badges">
          <view class="source-chip source-chip--{{detail._sourceKind}}" wx:if="{{detail._sourceText}}">{{detail._sourceText}}</view>
          <view class="source-chip source-chip--{{detail._factoryKind}}" wx:if="{{detail._factoryText}}">{{detail._factoryText}}</view>
          <view class="status-badge" style="background:{{detail._statusColor}}">{{detail.auditText}}</view>
        </view>
        <text wx:if="{{detail.styleName}}" class="header-meta">{{detail.styleName}}</text>
        <text class="header-meta">{{detail.operatorName}}<text wx:if="{{detail.processName}}" class="info-sep"> · </text>{{detail.processName}}</text>
      </view>
    </view>

    <!-- 金额卡：本次结算金额 + 数量 × 单价 -->
    <view class="amount-card">
      <view class="amount-card-row">
        <text class="amount-card-label">{{t.settleAmount}}</text>
        <view class="amount-card-final">
          <text class="amount-card-currency">¥</text>
          <text class="amount-card-num">{{detail.amountStr}}</text>
        </view>
      </view>
      <view class="amount-card-divider"></view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">{{t.pieceQtyLabel}}</text>
        <text class="amount-card-sub-val">{{detail.quantityStr}}{{t.unitPiece}}</text>
      </view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">{{t.priceProcess}}</text>
        <text class="amount-card-sub-val">¥{{detail.unitPriceStr}}{{t.perPiece}}</text>
      </view>
      <view class="amount-card-row">
        <text class="amount-card-sub-label">{{t.formulaLabel}}</text>
        <text class="amount-card-sub-val">{{detail.quantityStr}} × ¥{{detail.unitPriceStr}} = ¥{{detail.amountStr}}</text>
      </view>
    </view>

    <!-- 完成时间（用户明确要求：什么时候完成的） -->
    <view class="section-card">
      <text class="section-title">{{t.timeLabel}}</text>
      <view class="fact-row">
        <text class="fact-label">{{t.startTimeLabel}}</text>
        <text class="fact-val">{{detail._startText || '—'}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-label">{{t.completeTimeLabel}}</text>
        <text class="fact-val fact-val--strong">{{detail._endText || '—'}}</text>
      </view>
      <view wx:if="{{detail.recordCount}}" class="fact-row">
        <text class="fact-label">{{t.scanCountLabel}}</text>
        <text class="fact-val">{{detail.recordCount}}{{t.timesUnit}}</text>
      </view>
    </view>

    <!-- 关联信息 -->
    <view class="section-card">
      <text class="section-title">{{t.linkedInfo}}</text>
      <!-- D-429：人员（用户反馈"谁做的这些全部都没有"） -->
      <view class="fact-row">
        <text class="fact-label">{{t.personnelLabel}}</text>
        <text class="fact-val fact-val--strong">{{detail._operatorText}}</text>
      </view>
      <view wx:if="{{detail.processName}}" class="fact-row">
        <text class="fact-label">{{t.processWord}}</text>
        <text class="fact-val">{{detail.processName}}</text>
      </view>
      <view wx:if="{{detail._showActual}}" class="fact-row">
        <text class="fact-label">{{t.actualOperator}}</text>
        <text class="fact-val">{{detail.actualOperatorName}}</text>
      </view>
      <view wx:if="{{detail._sourceText}}" class="fact-row">
        <text class="fact-label">{{t.sourceLabel}}</text>
        <text class="fact-val fact-val--strong">{{detail._sourceText}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-label">{{t.settleTypeLabel2}}</text>
        <text class="fact-val fact-val--strong">{{detail._factoryText}}{{detail.isExternalFactory ? t.extAuditHint : t.directAuditHint}}</text>
      </view>
      <view wx:if="{{detail.orderNo}}" class="fact-row">
        <text class="fact-label">{{t.orderNoLabel}}</text>
        <text class="fact-val">{{detail.orderNo}}</text>
      </view>
      <view wx:if="{{detail.orderStatusText}}" class="fact-row">
        <text class="fact-label">{{t.orderStatusLabel}}</text>
        <text class="fact-val">{{detail.orderStatusText}}</text>
      </view>
      <view wx:if="{{detail.styleNo}}" class="fact-row">
        <text class="fact-label">{{t.styleNoLabelW2}}</text>
        <text class="fact-val">{{detail.styleNo}}</text>
      </view>
      <view wx:if="{{detail.processCode}}" class="fact-row">
        <text class="fact-label">{{t.processCodeLabel}}</text>
        <text class="fact-val">{{detail.processCode}}</text>
      </view>
      <view wx:if="{{detail.color || detail.size}}" class="fact-row">
        <text class="fact-label">{{t.colorSizeLabel2}}</text>
        <text class="fact-val">{{detail.color || '—'}} / {{detail.size || '—'}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-label">{{t.scanTypeLabel2}}</text>
        <text class="fact-val">{{detail._scanTypeText}}</text>
      </view>
      <view wx:if="{{detail.actualOperatorName && detail.actualOperatorName !== detail.operatorName}}" class="fact-row">
        <text class="fact-label">{{t.actualOperator}}</text>
        <text class="fact-val">{{detail.actualOperatorName}}</text>
      </view>
      <view wx:if="{{detail.settlementId}}" class="fact-row">
        <text class="fact-label">{{t.settlementSheet}}</text>
        <text class="fact-val">{{detail.settlementId}}</text>
      </view>
    </view>

    <!-- D-428：结算异常提示（红，需人工核实） -->
    <view wx:if="{{detail._abnormalText}}" class="abnormal-card">
      <text class="abnormal-card__text">{{detail._abnormalText}}</text>
    </view>

    <!-- 底部操作：三态与 PC 端 actionColumns 对齐（可审核 / 已审核 / 未关单） -->
    <view wx:if="{{canOperate && !detail.audited && detail.eligible}}" class="footer-actions">
      <view class="action-btn action-btn--primary" hover-class="action-btn--pressed" bindtap="onAudit">{{t.auditPassBtn}}</view>
    </view>
    <view wx:elif="{{detail.audited}}" class="blocked-hint blocked-hint--ok">{{t.auditedNoRepeat}}</view>
    <view wx:elif="{{detail.blockReason}}" class="blocked-hint">{{detail.blockReason}}</view>

    <view wx:if="{{canOperate && !detail.audited && detail.eligible}}" class="footer-spacer"></view>
  </block>

  <ai-assistant />
</view>