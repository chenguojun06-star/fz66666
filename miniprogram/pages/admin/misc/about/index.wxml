<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <view wx:else class="content">

    <!-- 应用 Logo + 名称 -->
    <view class="app-header">
      <view class="app-logo">
        <!-- 品牌 logo 单字：故意不翻译，英文界面同样显示「衣」 -->
        <text class="app-logo-text">衣</text>
      </view>
      <text class="app-name">{{appName || t.appNameFallback}}</text>
      <text class="app-slogan">{{t.slogan}}</text>
    </view>

    <!-- 基本信息 -->
    <view class="info-card">
      <view class="info-title">{{t.sysInfoTitle}}</view>
      <view class="info-row">
        <text class="info-label">{{t.appNameLabel}}</text>
        <text class="info-value">{{appName || '--'}}</text>
      </view>
      <view class="info-row" wx:if="{{tenantName}}">
        <text class="info-label">{{t.factoryLabel}}</text>
        <text class="info-value">{{tenantName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.onlineCountLabel}}</text>
        <text class="info-value">{{onlineCount}} {{t.peopleUnit}}</text>
      </view>
    </view>

    <!-- 技术信息 -->
    <view class="info-card">
      <view class="info-title">{{t.runStatusTitle}}</view>
      <view class="info-row">
        <text class="info-label">{{t.javaVersionLabel}}</text>
        <text class="info-value">{{javaVersion}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.osLabel}}</text>
        <text class="info-value">{{osName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.uptimeLabel}}</text>
        <text class="info-value">{{uptime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.startTimeLabel}}</text>
        <text class="info-value">{{startTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.memUsageLabel}}</text>
        <text class="info-value">{{heapUsedMb}} / {{heapMaxMb}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.memPercentLabel}}</text>
        <view class="info-value-row">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{heapUsedPercent}}%; background: {{heapUsedPercent > 80 ? 'var(--color-error)' : 'var(--color-primary)'}};"></view>
          </view>
          <text class="progress-text">{{heapUsedPercent}}%</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">{{t.dbLabel}}</text>
        <text class="info-value {{dbError ? 'text-error' : 'text-success'}}">{{database}}</text>
      </view>
    </view>

    <!-- 操作 -->
    <view class="action-card">
      <view class="action-btn" hover-class="action-btn-hover" hover-stay-time="100" bindtap="onCopyVersion">
        <text class="action-btn-text">{{t.copyVersionBtn}}</text>
      </view>
    </view>

    <!-- 版权 -->
    <view class="copyright">
      <text class="copyright-text">{{t.appNameFallback}}</text>
      <text class="copyright-sub">{{t.copyrightSub}}</text>
    </view>

  </view>
  <ai-assistant />
</view>
