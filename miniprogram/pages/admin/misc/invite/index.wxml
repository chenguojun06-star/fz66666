<view class="container">
  <view class="qr-section">
    <block wx:if="{{loading}}">
      <view class="qr-loading">
        <view class="qr-loading-spinner"></view>
        <text class="qr-loading-text">{{t.generating}}</text>
      </view>
    </block>
    <block wx:elif="{{qrUrl}}">
      <view class="qr-card">
        <image class="qr-image" src="{{qrUrl}}" mode="aspectFit" />
      </view>
      <text class="qr-label">{{t.scanHint}}</text>
    </block>
    <block wx:else>
      <view class="qr-card qr-card-fail">
        <text class="qr-fail-text">{{t.qrFailed}}</text>
        <view class="retry-btn" hover-class="retry-btn-hover" hover-stay-time="100" bindtap="loadTenantInfo">{{t.tapRetry}}</view>
      </view>
    </block>
  </view>

  <view class="invite-card">
    <view class="card-label-row">
      <text class="card-label">{{t.inviteCodeTitle}}</text>
      <view class="copy-text-btn" hover-class="copy-text-btn-hover" hover-stay-time="100" bindtap="onCopyTenantCode">{{t.copy}}</view>
    </view>
    <view class="code-display">{{tenantCode || '--'}}</view>

    <view class="divider"></view>

    <view class="card-label-row">
      <text class="card-label">{{t.pcLinkTitle}}</text>
    </view>
    <view class="hint-text">{{t.pcLinkDesc}}</view>
    <view class="copy-link-btn" hover-class="copy-link-btn-hover" hover-stay-time="100" bindtap="onCopyInviteUrl">{{t.copyLink}}</view>
  </view>

  <view class="steps-card">
    <view class="steps-title">{{t.stepsTitle}}</view>
    <view class="step-item">
      <view class="step-num">1</view>
      <view class="step-content">
        <text class="step-text">{{t.step1}}</text>
      </view>
    </view>
    <view class="step-item">
      <view class="step-num">2</view>
      <view class="step-content">
        <text class="step-text">{{t.step2}}</text>
      </view>
    </view>
    <view class="step-item">
      <view class="step-num">3</view>
      <view class="step-content">
        <text class="step-text">{{t.step3}}</text>
      </view>
    </view>
  </view>

  <button class="share-btn" open-type="share">
    <view class="share-btn-inner">
      <view class="share-btn-icon line-icon icon-send-arrow"></view>
      <text class="share-btn-text">{{t.shareFriend}}</text>
    </view>
  </button>
  <ai-assistant />
</view>
