/* ============ 首页（与设计稿对齐） ============ */
page {
  background: var(--color-bg-page);
}

.page {
  padding-bottom: calc(60px + env(safe-area-inset-bottom));
}

/* -- 问候卡片 -- */
.header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 var(--page-padding-x) var(--spacing-md);
  padding: 16px;
  background: var(--color-bg-card);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-sm);
}

.header-avatar {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), #66abff);
  color: var(--color-text-white);
  font-size: var(--font-size-2xl);
  font-weight: 600;
  flex-shrink: 0;
  overflow: hidden;
}

.header-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.header-avatar-letter {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.greeting-name {
  font-size: var(--font-size-2xl);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.greeting-sub {
  margin-top: 2px;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.greeting-date {
  margin-top: 2px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* -- 今日小贴士 -- */
.tip-card {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 var(--page-padding-x) var(--spacing-sm);
  background: var(--color-primary-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 6px 12px;
  box-sizing: border-box;
}

.tip-icon-circle {
  width: 22px;
  height: 22px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-bg-dark);
  color: var(--color-primary);
  flex-shrink: 0;
}

.tip-icon-text {
  color: var(--color-primary);
  font-size: var(--font-size-md);
  font-weight: 700;
  font-style: italic;
}

.tip-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.tip-title {
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-primary);
  flex-shrink: 0;
}

.tip-text {
  font-size: var(--font-size-xs);
  line-height: 1.4;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* -- 应用网格（按4大分类分组） -- */
.menu-section {
  margin: 0 var(--page-padding-x) var(--spacing-md);
  padding: 16px;
  background: var(--color-bg-card);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-sm);
}

.menu-group + .menu-group {
  margin-top: 16px;
}

.menu-group-title {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 0 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid var(--color-border);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}

.menu-group-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 16px;
  column-gap: 12px;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.menu-icon-circle {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.menu-icon-circle .line-icon--lg {
  width: 28px;
  height: 28px;
  background-size: 28px 28px;
}

.menu-item-hover .menu-icon-circle {
  transform: scale(0.92);
}

.menu-name {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-align: center;
}

/* -- 图标颜色 -- */
.menu-icon-circle--blue {
  background: var(--color-primary);
}

.menu-icon-circle--green {
  background: var(--color-success);
}

.menu-icon-circle--orange {
  background: var(--color-warning);
}

.menu-icon-circle--purple {
  background: var(--color-purple);
}

.menu-icon-circle--violet {
  background: var(--color-violet);
}

.menu-icon-circle--lightblue {
  background: #66abff;
}

.menu-icon-circle--red {
  background: var(--color-danger);
}

.menu-icon-circle--gray {
  background: var(--color-text-tertiary);
}

.menu-icon-circle--teal {
  background: var(--icon-color-teal, #14b8a6);
}

/* ============ 考勤打卡卡片 ============ */
.attendance-card {
  margin: 0 var(--page-padding-x) var(--spacing-sm);
  padding: 8px 12px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

/* 第1行：标题+状态 + 时间信息 + 查看明细 */
.attendance-top-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.attendance-title-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.attendance-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}

.attendance-status {
  font-size: var(--font-size-xxs);
  padding: 1px 6px;
  border-radius: var(--radius-full);
  font-weight: 500;
  line-height: 1.4;
}

.attendance-status--idle {
  background: var(--color-bg-page);
  color: var(--color-text-tertiary);
}

.attendance-status--working {
  background: var(--color-success-bg, #e9f9ee);
  color: var(--color-success);
}

.attendance-status--done {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

/* 时间信息（行内） */
.attendance-time-inline {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 3px;
  overflow: hidden;
}

.attendance-time-key {
  font-size: var(--font-size-xxs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.attendance-time-val {
  font-size: var(--font-size-xs);
  color: var(--color-text-primary);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.attendance-time-sep {
  font-size: var(--font-size-xxs);
  color: var(--color-text-tertiary);
  margin: 0 2px;
}

/* 查看明细入口（镂空小按钮） */
.attendance-detail-link {
  display: flex;
  align-items: center;
  gap: 1px;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-primary);
  flex-shrink: 0;
}

.attendance-detail-link-text {
  font-size: var(--font-size-xxs);
  color: var(--color-primary);
  font-weight: 500;
}

.attendance-detail-link-arrow {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  line-height: 1;
}

.attendance-detail-link-hover {
  opacity: 0.6;
}

/* 第2行：打卡按钮 */
.attendance-actions {
  display: flex;
  gap: 8px;
}

.attendance-btn {
  flex: 1;
  height: 30px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  background: transparent;
  transition: all 0.2s ease;
}

.attendance-btn-text {
  font-size: var(--font-size-xs);
  font-weight: 600;
}

/* 未激活状态：镂空灰边 */
.attendance-btn--idle .attendance-btn-text {
  color: var(--color-text-tertiary);
}

/* 激活状态：镂空主色边框 + 主色文字（项目铁律：镂空风格） */
.attendance-btn--active {
  border-color: var(--color-primary);
  background: transparent;
}

.attendance-btn--active .attendance-btn-text {
  color: var(--color-primary);
}

.attendance-btn-hover {
  opacity: 0.7;
}
