<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{materialPurchases.length === 0}}">
    <view class="empty-icon line-icon icon-package"></view>
    <text class="empty-text">暂无采购物料</text>
  </view>

  <block wx:else>
    <view class="detail-body">

      <!-- Card 1: 订单头部 -->
      <view class="detail-card order-header">
        <view class="header-top">
          <view class="order-media">
            <view class="media-placeholder line-icon icon-package"></view>
          </view>
          <view class="header-title">
            <text class="order-no">{{isSampleMode ? '样衣采购' : orderNo}}</text>
            <text class="style-no" wx:if="{{styleNo}}">款号 {{styleNo}}</text>
          </view>
          <text class="tag tag-{{overallStatusColor}}">{{overallStatusText}}</text>
        </view>

        <view class="header-summary">
          <view class="summary-item">
            <text class="summary-label">共</text>
            <text class="summary-value">{{materialPurchases.length}}</text>
            <text class="summary-label">项</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-item">
            <text class="summary-label">到货率</text>
            <text class="summary-value summary-primary">{{overallArrivalRate}}%</text>
          </view>
        </view>
      </view>

      <!-- Card 2: 统计概览 -->
      <view class="detail-card stats-card">
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-label">物料项数</text>
            <text class="stat-value">{{materialPurchases.length}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">整体到货率</text>
            <text class="stat-value stat-primary">{{overallArrivalRate}}%</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">回料状态</text>
            <text class="stat-value-text stat-{{hasReturnConfirmed ? 'success' : 'warning'}}">{{hasReturnConfirmed ? '已回料' : '进行中'}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">采购阶段</text>
            <text class="stat-value-text stat-{{overallStatusColor}}">{{overallStatusText}}</text>
          </view>
        </view>
        <view class="overall-progress">
          <view class="overall-progress-track">
            <view class="overall-progress-fill" style="width: {{overallArrivalRate > 100 ? 100 : overallArrivalRate}}%"></view>
          </view>
        </view>
      </view>

      <!-- Card 3: 物料到货进度 -->
      <view class="detail-card material-list">
        <view class="section-head">
          <text class="section-title">物料到货进度</text>
          <text class="section-count">{{materialPurchases.length}} 项</text>
        </view>

        <view
          wx:for="{{materialPurchases}}"
          wx:key="id"
          class="material-item {{item.isComplete ? 'item-done' : ''}}"
        >
          <!-- 物料信息行 -->
          <view class="mat-info">
            <view class="mat-info-left">
              <text class="mat-name">{{item.materialName || '未知物料'}}</text>
              <text class="mat-desc">{{item.materialTypeCN}}{{item.materialCode ? ' · 编号 ' + item.materialCode : ''}}{{item.specifications ? ' · 规格 ' + item.specifications : ''}} · 单位 {{item.unit || '米'}}</text>
            </view>
            <view class="mat-tags">
              <text class="tag tag-{{item.statusColor}}">{{item.statusText}}</text>
              <text wx:if="{{item.returnConfirmed}}" class="tag tag-green">已回料</text>
            </view>
          </view>

          <!-- 数量统计 4 列 -->
          <view class="qty-grid">
            <view class="qty-item">
              <text class="qty-lbl">需求</text>
              <text class="qty-val">{{item.purchaseQuantity || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">已到</text>
              <text class="qty-val">{{item.arrivedQuantity || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">待到</text>
              <text class="qty-val qty-pending">{{item.pendingQuantity || (item.purchaseQuantity - item.arrivedQuantity) || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">到货率</text>
              <text class="qty-val qty-primary">{{item.arrivalRate || 0}}%</text>
            </view>
          </view>

          <!-- 创建/领取/回料信息 -->
          <text class="mat-meta">{{item.creatorName ? '创建：' + item.creatorName + ' · ' : ''}}领取：{{item.receiverName || '-'}}{{item.returnConfirmed ? ' · 回料 ' + (item.returnQuantity || item.arrivedQuantity) + (item.unit || '') + ' ' + (item.returnConfirmerName || '') + ' ' + (item.returnConfirmTimeText || '') : ''}}</text>

          <!-- 进度条 -->
          <view class="progress-bar">
            <view class="progress-fill {{(item.returnConfirmed || item.isComplete) ? 'fill-success' : ''}}" style="width: {{item.arrivalRate > 100 ? 100 : item.arrivalRate}}%"></view>
          </view>

          <!-- 到货数量输入 -->
          <view class="item-input-row" wx:if="{{item.isActionable && !item.returnConfirmed}}">
            <view class="input-wrap">
              <view class="input-icon line-icon icon-search"></view>
              <input
                class="input-field"
                type="digit"
                placeholder="输入到货数量"
                placeholder-class="input-placeholder"
                data-id="{{item.id || item.purchaseId}}"
                bindinput="onMaterialInput"
                value="{{item.inputQuantity}}"
              />
            </view>
            <view
              wx:if="{{item.canConfirmReturn}}"
              class="btn-return-confirm"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              data-arrived="{{item.arrivedQuantity}}"
              data-purchase="{{item.purchaseQuantity}}"
              data-unit="{{item.unit || ''}}"
              bindtap="onReturnConfirm"
              hover-class="btn-hover"
              hover-stay-time="100"
            >确认回料</view>
          </view>

          <!-- 单条操作按钮：确认完成 / 撤回到货 -->
          <view class="item-action-row" wx:if="{{(item.canConfirmComplete || item.canCancelReceive) && !item.returnConfirmed}}">
            <view
              wx:if="{{item.canConfirmComplete}}"
              class="btn-action btn-action-primary"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              bindtap="onConfirmComplete"
              hover-class="btn-hover"
              hover-stay-time="100"
            >确认完成</view>
            <view
              wx:if="{{item.canCancelReceive}}"
              class="btn-action btn-action-danger"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              bindtap="onCancelReceive"
              hover-class="btn-hover"
              hover-stay-time="100"
            >撤回到货</view>
          </view>

          <!-- 需采购提示 -->
          <view class="receive-hint" wx:if="{{item.needsReceive}}">
            <text>需采购后可登记到货</text>
          </view>
        </view>
      </view>

      <!-- Card 4: 备注 -->
      <view class="detail-card remark-section">
        <text class="section-title">备注说明</text>
        <view class="remark-wrap">
          <textarea
            class="remark-input"
            placeholder="到货率不足 70% 时必填备注"
            placeholder-class="remark-placeholder"
            bindinput="onRemarkInput"
            value="{{remark}}"
            maxlength="200"
          />
        </view>
      </view>

    </view>
  </block>
  <ai-assistant />
</view>

<!-- 底部操作栏：领料出库 + 3 主操作 -->
<view class="footer-bar footer-bar-stack" wx:if="{{materialPurchases.length > 0 && !loading}}">
  <view
    class="btn-picking-outline {{hasReturnConfirmed ? 'btn-disabled' : ''}}"
    hover-class="{{hasReturnConfirmed ? '' : 'footer-bar-hover'}}"
    bindtap="onOpenPicking"
  >领料出库</view>
  <view class="footer-bar-row">
    <view
      class="btn-outline {{hasReturnConfirmed ? 'btn-disabled' : ''}}"
      hover-class="{{hasReturnConfirmed ? '' : 'footer-bar-hover'}}"
      bindtap="onReceiveAll"
    >一键采购</view>
    <view
      class="btn-outline {{(!hasInput || submitting || hasReturnConfirmed) ? 'btn-disabled' : ''}}"
      hover-class="{{(hasInput && !submitting && !hasReturnConfirmed) ? 'footer-bar-hover' : ''}}"
      bindtap="onSubmit"
    >提交到货</view>
    <view
      wx:if="{{!isSampleMode}}"
      class="btn-primary {{(!canConfirmProcurement || hasReturnConfirmed) ? 'btn-disabled' : ''}}"
      hover-class="{{(canConfirmProcurement && !hasReturnConfirmed) ? 'footer-bar-hover' : ''}}"
      bindtap="onConfirmProcurement"
    >一键全部完成</view>
  </view>
</view>

<!-- 领料出库弹窗 -->
<view class="picking-modal-mask" wx:if="{{showPickingModal}}" bindtap="onPickingModalClose">
  <view class="picking-modal" catchtap="">
    <view class="picking-modal-header">
      <text class="picking-modal-title">领料出库</text>
      <view class="picking-modal-close" bindtap="onPickingModalClose">×</view>
    </view>
    <view class="picking-modal-tip">填写领料数量，提交后由仓库确认出库</view>
    <scroll-view scroll-y class="picking-modal-body">
      <view
        wx:for="{{pickingItems}}"
        wx:key="id"
        class="picking-item"
      >
        <view class="picking-item-info">
          <text class="picking-item-name">{{item.materialName || '未知物料'}}</text>
          <text class="picking-item-desc">{{item.materialCode ? '编号 ' + item.materialCode + ' · ' : ''}}{{item.specifications ? '规格 ' + item.specifications + ' · ' : ''}}单位 {{item.unit || '米'}}</text>
          <text class="picking-item-stock">到货可用：{{item.arrivedQuantity || 0}}{{item.unit || ''}}</text>
        </view>
        <view class="picking-item-input">
          <input
            class="picking-input"
            type="digit"
            placeholder="领料量"
            placeholder-class="picking-input-placeholder"
            data-index="{{index}}"
            bindinput="onPickQtyInput"
            value="{{item.pickQuantity}}"
          />
        </view>
      </view>
      <view wx:if="{{pickingItems.length === 0}}" class="picking-empty">暂无可领料物料</view>
    </scroll-view>
    <view class="picking-modal-footer">
      <view class="picking-btn-cancel" bindtap="onPickingModalClose" hover-class="btn-hover" hover-stay-time="100">取消</view>
      <view class="picking-btn-confirm" bindtap="onConfirmPicking" hover-class="btn-hover" hover-stay-time="100">提交领料</view>
    </view>
  </view>
</view>

<!-- 回料确认弹窗（含图片上传，对齐PC端） -->
<view class="return-confirm-modal-mask" wx:if="{{showReturnConfirmModal}}" bindtap="onReturnConfirmModalClose">
  <view class="return-confirm-modal" catchtap="">
    <view class="return-confirm-modal-header">
      <text class="return-confirm-modal-title">确认回料</text>
      <view class="return-confirm-modal-close" bindtap="onReturnConfirmModalClose">×</view>
    </view>
    <view class="return-confirm-modal-body">
      <text class="return-confirm-material-name">{{returnConfirmItem.name || '未知物料'}}</text>
      <view class="return-confirm-input-wrap">
        <text class="return-confirm-input-label">回料数量</text>
        <input
          class="return-confirm-input"
          type="digit"
          value="{{returnConfirmQty}}"
          bindinput="onReturnConfirmQtyInput"
          placeholder="请输入回料数量"
          placeholder-class="return-confirm-input-placeholder"
        />
        <text class="return-confirm-input-unit">{{returnConfirmItem.unit || ''}}</text>
      </view>

      <!-- 图片上传 -->
      <view class="return-confirm-image-section">
        <text class="return-confirm-image-label">回料凭证（选填）</text>
        <view class="return-confirm-image-grid">
          <view
            wx:for="{{returnConfirmImages}}"
            wx:key="index"
            class="return-confirm-image-item"
          >
            <image
              class="return-confirm-image-thumb"
              src="{{item.authed}}"
              mode="aspectFill"
              bindtap="onPreviewReturnImage"
              data-url="{{item.authed}}"
            />
            <view
              class="return-confirm-image-delete"
              bindtap="onDeleteReturnImage"
              data-index="{{index}}"
            >×</view>
          </view>
          <view
            wx:if="{{returnConfirmImages.length < 5}}"
            class="return-confirm-image-add"
            bindtap="onUploadReturnImage"
          >
            <text class="return-confirm-image-add-icon">+</text>
            <text class="return-confirm-image-add-text">上传凭证</text>
          </view>
        </view>
      </view>
    </view>
    <view class="return-confirm-modal-footer">
      <view class="return-confirm-btn-cancel" bindtap="onReturnConfirmModalClose" hover-class="btn-hover" hover-stay-time="100">取消</view>
      <view class="return-confirm-btn-confirm {{returnConfirmSubmitting ? 'btn-disabled' : ''}}" bindtap="onSubmitReturnConfirm" hover-class="btn-hover" hover-stay-time="100">确认回料</view>
    </view>
  </view>
</view>
