<view class="container">
  <!-- 信息卡片 -->
  <view class="info-card">
    <view class="card-header">
      <image-preview class="cover-wrap" src="{{detail.coverImage || ''}}" mode="aspectFit" />
      <view class="header-info">
        <text class="style-no-label">{{t.styleNoLabel}}</text>
        <text class="style-no">{{detail.styleNo || detail.orderNo}}</text>
        <text class="style-name">{{detail.styleName || t.scanRecordWord}}</text>
      </view>
    </view>
  </view>

  <!-- 字段列表卡片 -->
  <view class="field-card">
    <view class="field-row">
      <text class="field-label">{{t.orderNoLabel}}</text>
      <text class="field-value">{{detail.orderNo}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">{{t.bundleNoLabel}}</text>
      <text class="field-value">{{detail.bundleNo}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">{{t.qtyLabel}}</text>
      <text class="field-value highlight">{{detail.quantity}} {{t.piece}}</text>
    </view>
    <view class="field-row">
      <text class="field-label">{{t.scanTimeLabel}}</text>
      <text class="field-value">{{detail.scanTime}}</text>
    </view>
    <view wx:if="{{detail.processName}}" class="field-row">
      <text class="field-label">{{t.processLabel}}</text>
      <text class="field-value">{{detail.processName}}</text>
    </view>
  </view>

  <!-- 退回警告 -->
  <view class="warning-card">
    <view class="warning-icon"><view class="icon-warning-orange"></view></view>
    <view class="warning-content">
      <text class="warning-title">{{t.confirmTitle}}</text>
      <text class="warning-desc">{{t.confirmDesc}}</text>
    </view>
  </view>

  <view class="footer-bar">
    <view class="btn-cancel" hover-class="footer-bar-hover" bindtap="goBack">{{t.cancel}}</view>
    <view class="btn-danger {{loading ? 'btn-disabled' : ''}}" hover-class="footer-bar-hover" bindtap="confirmRescan">
      {{loading ? t.rescanning : t.confirmBtn}}
    </view>
  </view>
  <ai-assistant />
</view>
