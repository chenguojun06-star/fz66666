
/* ========= 页面容器（匹配设计稿：扁平背景） ========= */
.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: var(--page-padding-y) var(--page-padding-x) calc(env(safe-area-inset-bottom) + var(--space-160));
}

/* ========= 状态卡片（对齐设计稿：圆形图标 + 标题 + 交期） ========= */
.status-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-bg-card);
  
  
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-40);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 12px;
  box-sizing: border-box;
}
.status-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.status-icon-circle .line-icon {
  width: 24px;
  height: 24px;
  background-size: 24px 24px;
}
.status-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.status-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.2;
}
.status-subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status-date {
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}
.status-date-label {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}
.status-date-value {
  font-size: var(--font-size-md-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

/* --- 状态标签（保留生产功能，右上角浮层） --- */
.status-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: var(--font-size-xxs);
  font-weight: 600;
  padding: var(--space-4) var(--space-16);
  border-radius: var(--radius-xs);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}
.status-badge.status-pending   { background: var(--color-warning-bg); color: var(--color-warning); }
.status-badge.status-progress  { background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.08); color: rgba(var(--color-primary-rgb, 0, 122, 255), 1); }
.status-badge.status-completed { background: var(--color-success-bg); color: var(--color-success); }
.status-badge.status-received  { background: var(--color-success-bg); color: var(--color-success); }

/* ========= 分区组（对齐设计稿：标题在卡片外） ========= */
.section-group {
  margin-bottom: var(--space-40);
}
.section-group-title {
  display: block;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  padding: 0 var(--space-8);
  margin-bottom: var(--space-16);
}
.group-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-2xl);
  padding: 0;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* ========= MES 工序列表（领取 / 报工） ========= */
.process-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: var(--space-24) var(--space-24);
  border-bottom: 1px solid var(--color-border-light);
}
.process-row:last-child {
  border-bottom: none;
}
.process-row--done {
  opacity: 0.6;
}
.process-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.process-row-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.process-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.process-row-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.2;
}
.process-row-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.process-row-price {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}
.process-row-sub {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.process-status-badge {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  padding: var(--space-6) var(--space-16);
  border-radius: var(--radius-999);
  line-height: 1.4;
}
.process-status--pending {
  color: var(--color-text-tertiary);
  background: var(--color-bg-secondary);
}
.process-status--claimed {
  color: var(--color-warning);
  background: var(--color-warning-bg);
}
.process-status--mine {
  color: var(--color-primary);
  background: var(--color-primary-bg);
}
.process-status--completed {
  color: var(--color-success);
  background: var(--color-success-bg);
}
.process-claim-btn {
  flex-shrink: 0;
  min-width: 72rpx;
  padding: var(--space-6) var(--space-18);
  border-radius: var(--radius-999);
  background: var(--color-primary);
  color: var(--color-text-white);
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-medium);
  text-align: center;
  line-height: 1.4;
}
.process-claim-btn--report {
  background: var(--color-success);
}
.process-claim-btn--disabled {
  opacity: 0.5;
}
.process-claim-btn-hover {
  opacity: 0.85;
}

/* ========= 款式头部（对齐设计稿：缩略图 + 品名 + 款号） ========= */
.style-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: var(--space-32);
}
.style-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-page);
}
.style-header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.style-header-name {
  font-size: var(--font-size-md-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.2;
}
.style-header-no {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========= 详情字段列表（对齐设计稿：行间分隔线） ========= */
.field-list {
  padding: 0 var(--space-32);
}
.field-list .field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-24) 0;
}
.field-list .field-row:not(:last-child) {
  border-bottom: 1rpx solid var(--color-border);
}
.field-list .field-label {
  width: auto;
  flex-shrink: 0;
  font-size: var(--font-size-md-lg);
  color: var(--color-text-secondary);
}
.field-list .field-value {
  flex: 1;
  text-align: right;
  font-size: var(--font-size-md-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  word-break: break-all;
}

/* --- 颜色码数聚合矩阵 --- */
.matrix-section {
  padding: var(--space-24) var(--space-32) var(--space-32);
}
/* D-189：码数列超宽不压缩，横向滑动查看（同 D-167 范式：flex 压缩 min-width:0 是重叠炸弹） */
.matrix-scroll {
  width: 100%;
}
.matrix-table {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  width: max-content;
  min-width: 100%;
}
.matrix-row {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
}
.matrix-row:last-child {
  border-bottom: none;
}
.matrix-header {
  background: var(--color-bg-page);
}
.matrix-header .matrix-cell {
  font-weight: 600;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}
.matrix-cell {
  flex: 0 0 auto;
  min-width: 128rpx;
  text-align: center;
  padding: var(--space-14) var(--space-12);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  white-space: nowrap;
}
.matrix-label-cell {
  flex: 0 0 128rpx;
  text-align: left;
  padding-left: var(--space-16);
  font-weight: 500;
  color: var(--color-text-secondary);
}
.matrix-total-cell {
  font-weight: 600;
  color: rgba(var(--color-primary-rgb, 0, 122, 255), 1);
}
.matrix-footer {
  padding: var(--space-24) 0 0;
  text-align: right;
}
.matrix-grand-total {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: rgba(var(--color-primary-rgb, 0, 122, 255), 1);
}

/* ========= 操作区域卡片 ========= */
.section-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 12px;
  box-sizing: border-box;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12px;
}
.section-title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  padding: 0 var(--space-4);
  margin-bottom: var(--spacing-sm);
}

/* --- 工序选择器 --- */
.ops-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-12);
}
.selector-list {
  max-height: 340rpx;
  background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.02);
  border-radius: var(--radius-sm);
  padding: var(--space-8);
  margin-bottom: var(--space-20);
}
.selector-item {
  display: flex;
  align-items: center;
  padding: var(--space-18) var(--space-20);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-6);
  border: 2rpx solid transparent;
  transition: all .15s;
}
.selector-item.active {
  background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.08);
  border-color: rgba(var(--color-primary-rgb, 0, 122, 255), 1);
}
.selector-item.disabled {
  opacity: 0.4;
}
.selector-radio {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  margin-right: var(--space-16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.selector-radio.checked {
  border-color: rgba(var(--color-primary-rgb, 0, 122, 255), 1);
  background: rgba(var(--color-primary-rgb, 0, 122, 255), 1);
}
.selector-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
}
.selector-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

/* --- 审核提示 --- */
.review-warning {
  background: var(--color-warning-bg);
  border: 1rpx solid var(--color-warning-border);
  border-radius: var(--radius-sm);
  padding: var(--space-16) var(--space-20);
  margin-bottom: var(--space-20);
}
.review-warning-text {
  font-size: var(--font-size-xs);
  color: var(--color-warning);
}

.review-selector {
  margin-bottom: var(--space-20);
}
.review-options {
  display: flex;
  gap: 16rpx;
  margin-top: var(--space-12);
}
.review-option {
  flex: 1;
  text-align: center;
  padding: var(--space-16) 0;
  border-radius: var(--radius-sm);
  background: var(--color-bg-page);
  border: 2rpx solid var(--color-border);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.review-option-active {
  background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.08);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 600;
}

/* --- 输入行 --- */
.input-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-20);
}
.input-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  width: 140rpx;
  flex-shrink: 0;
}
.input-field {
  flex: 1;
  height: 72rpx;
  border: 1rpx solid var(--input-border);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-20);
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  background: var(--input-bg);
}
.input-suffix {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-left: var(--space-12);
}

/* D-312：多色样衣颜色选择 */
.color-options {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.color-chip {
  padding: var(--space-10) var(--space-24);
  border-radius: var(--radius-999);
  border: 1rpx solid var(--color-border);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  background: var(--color-bg-card);
}
.color-chip--active {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-bg);
}
.color-chip-hover {
  opacity: 0.7;
}

/* --- 备注 --- */
.remark-row {
  margin-bottom: var(--space-8);
}
.remark-area {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: var(--space-16) var(--space-20);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.02);
  box-sizing: border-box;
  margin-top: var(--space-8);
}

/* 仓库选择（对齐主扫码页样式） */
.warehouse-section {
  margin-bottom: var(--space-20);

  background: rgba(var(--color-primary-rgb, 0, 122, 255), 0.02);



  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 12px;
  box-sizing: border-box;
}

/* D-172：样衣仓为空时的内联提示 */
.warehouse-empty-tip {
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  background: var(--color-warning-bg);
  border-radius: var(--radius-8);
  padding: var(--space-10) var(--space-16);
  margin-bottom: var(--space-8);
  line-height: 1.5;
}

.warehouse-option-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: var(--space-8);
  margin-bottom: var(--space-8);
}

.warehouse-chip {
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 10px;
  border-radius: 10px;
  font-size: var(--font-size-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  text-align: center;
}

.warehouse-chip--active {
  background: var(--color-primary);
  color: var(--color-text-white);
  border-color: var(--color-primary);
}

.warehouse-chip--clear {
  background: rgba(254, 226, 226, 0.6);
  border-color: rgba(252, 165, 165, 0.5);
  color: var(--color-danger);
}

.warehouse-chip--disabled {
  opacity: 0.4;
  pointer-events: none;
}

.warehouse-chip-hover {
  opacity: 0.75;
}

/* D-171：仓库/库位搜索框 */
.warehouse-search-input {
  margin: var(--space-8) 0 var(--space-12);
}

/* D-171：库位chips显示已用/容量，避免超限 */
.warehouse-chip--loc {
  flex-direction: row;
  gap: 6rpx;
}

.warehouse-chip-qty {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-regular);
}

.warehouse-chip--full {
  opacity: 0.6;
  border-color: var(--color-danger);
}

.warehouse-chip-qty--full {
  color: var(--color-danger);
}

.warehouse-chip--active .warehouse-chip-qty {
  color: var(--color-text-white);
}

/* ===== SKU列表 ===== */
.sku-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sku-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-12) var(--space-16);
  border-radius: var(--radius-sm);
  background: var(--color-bg-page);
}
.sku-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
}
.sku-label {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}
.sku-total {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.sku-qty-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}
.sku-qty-input {
  width: 100rpx;
  height: 64rpx;
  text-align: center;
  border: 1rpx solid var(--input-border);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  background: var(--input-bg);
}
.sku-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ===== 汇总卡片 ===== */
.summary-card {
  background: var(--color-primary-bg);
  
  
  margin-bottom: var(--space-16);
  box-shadow: var(--shadow-sm);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 12px;
  box-sizing: border-box;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-6) 0;
}
.summary-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.summary-value {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.process-hint {
  margin: var(--space-12) var(--space-20) 0;
  padding: var(--space-12) var(--space-20);
  border-radius: 10px;
  background: var(--color-warning-bg);
  color: var(--color-warning);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

/* D-181：工序全部完成后的指引（审核/入库在样衣详情，对齐PC） */
.process-next-hint {
  margin-top: var(--space-12);
  padding: var(--space-16) var(--space-20);
  background: var(--color-primary-bg);
  border-radius: var(--radius-sm);
}
.process-next-hint__text {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
}

/* --- D-379：领取按颜色勾选（多色可多选，每色填数量，一起领取） --- */
.claim-color-card {
  margin-top: 0;
  margin-bottom: 12px;
  padding: 12px;
}
.claim-color-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-12);
}
.claim-color-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.claim-color-link {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}
.claim-color-row {
  display: flex;
  align-items: center;
  padding: var(--space-16);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  margin-bottom: var(--space-12);
}
.claim-color-row--active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}
.claim-color-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-8);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
  margin-right: var(--space-16);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.claim-color-check--on {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.claim-color-check-icon {
  font-size: var(--font-size-xs);
  line-height: 1;
  color: var(--color-text-white);
}
.claim-color-name {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}
.claim-color-row--active .claim-color-name {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}
.claim-color-qty-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.claim-color-qty {
  width: 120rpx;
  height: 56rpx;
  min-height: 56rpx;
  text-align: center;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-card);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}
.claim-color-unit {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.claim-color-total {
  margin-top: var(--space-8);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  text-align: right;
}
