<view class="page">
  <!-- 吸顶区：搜索栏 + 状态统计标签 -->
  <sticky-search-bar
    placeholder="搜索款号/款式名"
    value="{{keyword}}"
    show-scan="{{true}}"
    show-filter="{{true}}"
    bind:input="onSearchInput"
    bind:confirm="_doSearch"
    bind:clear="onSearchClear"
    bind:scan="onScan"
  >
    <scroll-view slot="filter" scroll-x class="stat-tags-scroll" enhanced show-scrollbar="{{false}}">
      <view class="stat-tags">
        <block wx:for="{{statusTabs}}" wx:key="key">
          <view
            class="stat-tag {{activeFilter === item.key ? 'active' : ''}} stat-tag--{{item.color}}"
            data-key="{{item.key}}"
            bindtap="onFilterTap"
          >
            <view wx:if="{{item.isSmart}}" class="stat-tag__warn"></view>
            <text class="stat-tag__label">{{item.label}}</text>
            <text class="stat-tag__count">{{item.count}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </sticky-search-bar>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state-wrap">
    <view class="loading-spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="state-wrap state-wrap--empty">
    <view class="line-icon line-icon--lg icon-inbox state-icon"></view>
    <text class="state-text">暂无样衣开发记录</text>
  </view>

  <!-- 卡片列表（布局与生产管理 dashboard 完全一致） -->
  <view wx:else class="card-list">
    <view
      class="order-card {{item.expanded ? 'order-card--open' : ''}}"
      wx:for="{{list}}"
      wx:for-index="cardIdx"
      wx:key="id"
      data-id="{{item.id}}"
      data-card-idx="{{cardIdx}}"
      data-item="{{item}}"
    >
      <!-- 主行：封面 + 基本信息（点击跳详情） -->
      <view class="order-main" data-item="{{item}}" catchtap="onCardTap">
        <view class="order-cover" catchtap="onPreviewImage" data-src="{{item._cover}}">
          <image wx:if="{{item._cover}}" class="cover-pic" src="{{item._cover}}" mode="aspectFill" lazy-load />
          <view wx:else class="cover-placeholder">
            <view class="cover-ph-text"><view class="line-icon line-icon--xl icon-shirt"></view></view>
          </view>
        </view>

        <view class="order-info">
          <!-- 行1：款号 + 状态标签 -->
          <view class="info-line1">
            <text class="order-no">{{item.styleNo || '-'}}</text>
            <view class="info-badges">
              <view class="status-badge" style="background:{{item._statusColor}}">{{item._statusLabel}}</view>
            </view>
          </view>
          <!-- 行2：款名 -->
          <view class="info-style">{{item.styleName || item.styleNo || '暂无款名'}}</view>
          <!-- 行3：客户名 -->
          <view class="info-customer" wx:if="{{item._customer}}">{{item._customer}}</view>
          <!-- 行4：跟单 · 品类 · 季节 -->
          <view class="info-factory" wx:if="{{item._metaShort}}">{{item._metaShort}}</view>
        </view>
      </view>

      <!-- 进度行：数量·交板 + 进度条 + 百分比 + 剩余天数（同一行，与生产管理一致） -->
      <view class="info-progress">
        <view class="ip-left">
          <text class="ip-qty">{{item._quantity || 0}}件</text>
          <text class="ip-dot">·</text>
          <text class="ip-delivery" wx:if="{{item._deliveryTag}}">交板 {{item._deliveryTag}}</text>
        </view>
        <view class="ip-bar">
          <view
            class="ip-fill {{item._overdue ? 'ip-fill--overdue' : ''}} {{item._progressPercent >= 100 ? 'ip-fill--done' : ''}}"
            style="width: {{item._progressPercent > 100 ? 100 : item._progressPercent || 0}}%"
          ></view>
        </view>
        <text class="ip-pct">{{item._progressPercent || 0}}%</text>
        <text
          wx:if="{{item._daysLeftText}}"
          class="ip-remain {{item._overdue ? 'days-overdue' : (item._nearDue ? 'days-urgent' : 'days-safe')}}"
        >{{item._daysLeftText}}</text>
      </view>

      <!-- 展开明细按钮 -->
      <view class="order-expand-btn" data-index="{{cardIdx}}" catchtap="onCardToggle">
        <text class="expand-btn-text">{{item.expanded ? '收起明细' : '展开明细'}}</text>
        <view class="expand-btn-arrow {{item.expanded ? 'expand-btn-arrow--up' : ''}}"><view class="icon-chevron-down-sm"></view></view>
      </view>

      <!-- 展开区：多码多色 + 配置好的子工序 -->
      <view class="card-expand-area" wx:if="{{item.expanded}}">
        <!-- 多码多色矩阵（如有） -->
        <view wx:if="{{item._matrix.sizes.length > 0}}" class="expand-section">
          <text class="section-title">码数颜色</text>
          <scroll-view scroll-x class="matrix-scroll" enhanced show-scrollbar="{{false}}">
            <view class="matrix-table">
              <view class="matrix-row matrix-row--head">
                <text class="matrix-cell matrix-cell--color">颜色</text>
                <text wx:for="{{item._matrix.sizes}}" wx:for-item="sz" wx:key="*this" class="matrix-cell">{{sz}}</text>
                <text class="matrix-cell matrix-cell--total">合计</text>
              </view>
              <view wx:for="{{item._matrix.rows}}" wx:for-item="row" wx:key="color" class="matrix-row">
                <text class="matrix-cell matrix-cell--color">{{row.color}}</text>
                <text wx:for="{{row.quantities}}" wx:for-item="qty" wx:for-index="qi" wx:key="qi" class="matrix-cell">{{qty}}</text>
                <text class="matrix-cell matrix-cell--total">{{row.rowTotal}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 配置好的子工序列表（按父阶段分组） -->
        <view class="expand-section">
          <text class="section-title">子工序明细</text>
          <view wx:if="{{item._configLoading}}" class="state-hint">加载中...</view>
          <view wx:elif="{{item._needsConfig}}" class="state-hint">该款号尚未配置子工序，请先在款式工序配置中添加</view>
          <view wx:elif="{{item._stages.length === 0}}" class="state-hint">暂无子工序</view>
          <view wx:else class="stage-tabs">
            <view
              wx:for="{{item._stages}}"
              wx:for-item="st"
              wx:key="key"
              class="stage-tab {{item._activeStage === st.key ? 'stage-tab--active' : ''}} {{st.percent >= 100 ? 'stage-tab--done' : ''}}"
              data-card-idx="{{cardIdx}}"
              data-stage="{{st.key}}"
              catchtap="onStageTabTap"
            >
              <text class="stage-tab-name">{{st.label}}</text>
              <text class="stage-tab-count" wx:if="{{st.totalCount > 0}}">{{st.completedCount}}/{{st.totalCount}}</text>
            </view>
          </view>

          <!-- 当前 tab 下的子工序列表 -->
          <view wx:if="{{!item._configLoading && !item._needsConfig && item._stages.length > 0}}" class="sub-proc-table">
            <view class="sub-proc-row sub-proc-row--head">
              <text class="sp-cell sp-cell--name">工序</text>
              <text class="sp-cell sp-cell--color">颜色</text>
              <text class="sp-cell sp-cell--size">尺码</text>
              <text class="sp-cell sp-cell--qty">数量</text>
              <text class="sp-cell sp-cell--receiver">领取人</text>
              <text class="sp-cell sp-cell--time">时间</text>
              <text class="sp-cell sp-cell--status">状态</text>
            </view>
            <view wx:for="{{item._currentSubProcesses}}" wx:for-item="sp" wx:key="key" class="sub-proc-row">
              <text class="sp-cell sp-cell--name">{{sp.name}}</text>
              <text class="sp-cell sp-cell--color">{{sp.color || '-'}}</text>
              <text class="sp-cell sp-cell--size">{{sp.size || '-'}}</text>
              <text class="sp-cell sp-cell--qty">{{sp.quantity}}</text>
              <text class="sp-cell sp-cell--receiver">{{sp.receiver || '-'}}</text>
              <text class="sp-cell sp-cell--time">{{sp.time || '-'}}</text>
              <text class="sp-cell sp-cell--status">
                <text wx:if="{{sp.status === 'completed'}}" class="status-tag status-tag--done">已完成</text>
                <text wx:elif="{{sp.status === 'in_progress'}}" class="status-tag status-tag--progress">{{sp.percent}}%</text>
                <text wx:else class="status-tag status-tag--pending">待领取</text>
              </text>
            </view>
            <view wx:if="{{item._currentSubProcesses.length === 0}}" class="sub-proc-empty">该阶段暂无子工序</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more">
      <text>{{loadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
  </view>
  <ai-assistant />
</view>
