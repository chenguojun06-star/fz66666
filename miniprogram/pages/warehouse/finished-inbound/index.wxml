<!-- 成品入库页：手机端此前完全没有入库入口，现补为独立页面（不用弹窗） -->
<view class="page">

  <!-- ① 查询区：款号 / 扫码 -->
  <view class="section">
    <view class="section-hd"><text class="section-title">{{t.styleNoLabel}}</text></view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="{{t.inputStyleNo}}"
        value="{{styleNo}}"
        bindinput="onStyleNoInput"
        confirm-type="search"
        bindconfirm="onQuery"
      />
      <view class="search-btn search-btn--scan" bindtap="onScan">{{t.scan}}</view>
      <view class="search-btn search-btn--go" bindtap="onQuery">{{t.query}}</view>
    </view>
    <text class="style-name" wx:if="{{styleName}}">{{styleName}}</text>
  </view>

  <block wx:if="{{queried}}">
    <!-- ② 入库来源类型 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.inboundType}}</text></view>
      <view class="type-grid">
        <view
          wx:for="{{typeOptions}}"
          wx:key="key"
          class="type-chip {{sourceType === item.key ? 'type-chip--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectType"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- ③ 仓库 -->
    <view class="section">
      <!-- D-517：仓库区域改可搜索选择器 -->
      <view class="row" bindtap="openPicker" data-key="area">
        <text class="row-label">{{t.warehouseArea}}</text>
        <text class="row-value {{warehouseAreaName ? '' : 'row-value--placeholder'}}">
          {{warehouseAreaName || t.pleaseSelect}}
        </text>
        <text class="row-arrow">›</text>
      </view>
      <view class="row">
        <text class="row-label">{{t.location}}</text>
        <input
          class="row-input"
          value="{{warehouseLocation}}"
          bindinput="onLocationInput"
        />
      </view>
      <view class="row">
        <text class="row-label">{{t.supplier}}</text>
        <input
          class="row-input"
          placeholder="{{t.optional}}"
          value="{{supplierName}}"
          bindinput="onSupplierInput"
        />
      </view>
    </view>

    <!-- ④ SKU 明细多选 -->
    <view class="section">
      <view class="section-hd">
        <text class="section-title">{{t.inboundDetail}}</text>
        <view class="select-all" bindtap="onToggleAll">
          <view class="checkbox checkbox--sm">
            <text wx:if="{{allSelected}}" class="check-mark">✓</text>
          </view>
          <text class="select-all-text">{{t.selectAll}}</text>
        </view>
      </view>

      <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>
      <view wx:elif="{{!skuList.length}}" class="empty">{{t.noSkuData}}</view>

      <view wx:else class="sku-list">
        <view
          wx:for="{{skuList}}"
          wx:key="id"
          class="sku-item {{selected[item.id] ? 'sku-item--checked' : ''}}"
        >
          <view class="sku-main" data-id="{{item.id}}" bindtap="onToggleSku">
            <view class="checkbox">
              <text wx:if="{{selected[item.id]}}" class="check-mark">✓</text>
            </view>
            <view class="sku-text">
              <text class="sku-name">{{item.color}} / {{item.size}}</text>
              <text class="sku-meta">{{item.existingStockText}}</text>
            </view>
            <!-- D-513：成本价（PC 端入库有单价列，手机端原先没有） -->
            <text class="sku-price">¥{{item.costPrice || 0}}</text>
          </view>

          <view class="stepper" wx:if="{{selected[item.id]}}">
            <view class="stepper-btn" data-id="{{item.id}}" catchtap="onQtyMinus">−</view>
            <input
              class="stepper-input"
              type="number"
              value="{{selected[item.id]}}"
              data-id="{{item.id}}"
              bindinput="onQtyInput"
            />
            <view class="stepper-btn" data-id="{{item.id}}" catchtap="onQtyPlus">+</view>
          </view>

          <!-- D-513：成本价可改（提交到 items[].unitPrice） -->
          <view class="price-row" wx:if="{{selected[item.id]}}">
            <text class="price-label">{{t.costPrice}}</text>
            <input
              class="price-input"
              type="digit"
              value="{{item.costPrice}}"
              data-id="{{item.id}}"
              bindinput="onPriceInput"
            />
            <text class="price-unit">{{t.yuan}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ⑤ 备注 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.remark}}</text></view>
      <textarea
        class="remark"
        placeholder="{{t.optional}}"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
        auto-height
      />
    </view>
  </block>

  <view class="bottom-pad"></view>
</view>

<!-- ⑥ 底部固定提交栏 -->
<view class="submit-bar" wx:if="{{queried}}">
  <view class="submit-summary">
    <text class="submit-count">{{t.selectedItemsText}}</text>
    <text class="submit-qty">{{t.totalQtyText}}</text>
  </view>
  <view class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? t.submitting : t.confirmInbound}}
  </view>
</view>

<!-- D-517：通用可搜索选择器（仓库区域） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
