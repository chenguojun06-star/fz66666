/* 领料出库页（手机端）— 对标 PC 端 /production/picking */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 0 24rpx 16rpx;
  border-bottom: 1rpx solid #e5e7eb;
}
.tabs {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 0 12rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 24rpx;
}
.tab--active {
  color: #fff;
  background: #2563eb;
  font-weight: 500;
}
.search-row {
  display: flex;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  height: 60rpx;
  padding: 0 20rpx;
  background: #f3f4f6;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.search-btn {
  height: 60rpx;
  padding: 0 26rpx;
  line-height: 60rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 统计 */
.summary-row {
  padding: 14rpx 24rpx 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

/* 状态/空 */
.state {
  padding: 70rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.state.small {
  padding: 22rpx;
  font-size: 22rpx;
}
.state-hint {
  font-size: 22rpx;
  color: #c0c4cc;
}

/* 卡片 */
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.card-no {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}
.status-tag {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

/* 信息网格 */
.info-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}
.info-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 45%;
}
.info-label {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
}
.info-value {
  font-size: 24rpx;
  color: #374151;
}

/* 明细 */
.detail {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e5e7eb;
}
.detail-hd {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}
.detail-row {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f9fafb;
}
.detail-name {
  font-size: 24rpx;
  color: #111827;
}
.detail-meta {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}
.detail-qty {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
  margin-top: 4rpx;
}
.detail-loc {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}
.detail-empty {
  font-size: 22rpx;
  color: #c0c4cc;
  padding: 12rpx 0;
}

/* 操作按钮 */
.actions {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}
.btn {
  padding: 12rpx 30rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  text-align: center;
}
.btn--ghost {
  color: #6b7280;
  background: #f3f4f6;
}
.btn--primary {
  color: #fff;
  background: #2563eb;
}
.btn.is-disabled {
  opacity: 0.6;
}