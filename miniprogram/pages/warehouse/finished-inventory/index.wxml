<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-value">{{total}}</text>
      <text class="stat-label">{{t.styleCount}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-value stat-value--success">{{totalAvailableQty}}</text>
      <text class="stat-label">{{t.availableStockPcs}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-value stat-value--danger">{{totalDefectQty}}</text>
      <text class="stat-label">{{t.defectPcs}}</text>
    </view>
  </view>

  <!-- 搜索 + 筛选器（sticky 吸顶，统一通用组件） -->
  <sticky-search-bar
    placeholder="{{t.searchPlaceholder}}"
    value="{{searchText}}"
    show-scan="{{false}}"
    show-filter="{{true}}"
    bind:input="onSearchInput"
    bind:confirm="onSearchConfirm"
  >
    <view slot="filter" class="filter-pickers">
      
        <view bindtap="openPicker" data-handler="onStatusChange" data-names="statusOptions" data-range-key="label" class="filter-picker">
          <text class="filter-picker-text">{{statusOptions[statusIndex].label}}</text>
          <text class="filter-picker-arrow">▾</text>
        </view>
      
      
        <view bindtap="openPicker" data-handler="onFactoryTypeChange" data-names="factoryTypeOptions" data-range-key="label" class="filter-picker">
          <text class="filter-picker-text">{{factoryTypeOptions[factoryTypeIndex].label}}</text>
          <text class="filter-picker-arrow">▾</text>
        </view>
      
    </view>
  </sticky-search-bar>

  <!-- 列表 -->
  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <view wx:elif="{{list.length === 0}}" class="empty-wrap">
    <view class="empty-icon line-icon line-icon--xl icon-package"></view>
    <text class="empty-text">{{t.noData}}</text>
    <text class="empty-sub">{{t.scanFirst}}</text>
  </view>

  <view wx:else class="list-wrap">
    <view wx:for="{{list}}" wx:key="groupKey" class="inventory-item" data-id="{{item.groupKey}}" bindtap="onItemTap" hover-class="inventory-item--hover" hover-stay-time="100">
      <view class="item-header">
        <image wx:if="{{item._styleImage}}" src="{{item._styleImage}}" mode="aspectFit" class="item-image" />
        <view wx:else class="item-image item-image--placeholder">
          <text class="item-image-text">衣</text>
        </view>
        <view class="item-info">
          <view class="item-title-row">
            <text class="item-style-no">{{item.styleNo}}</text>
            <text class="item-style-name">{{item.styleName}}</text>
          </view>
          <view class="item-order">
            <text class="item-order-label">{{t.orderPrefix}}</text>
            <text class="item-order-value">{{item.orderNo}}</text>
          </view>
          <view class="item-tags">
            <text wx:if="{{item.factoryName}}" class="item-tag item-tag--factory">{{item.factoryName}}</text>
            <text wx:if="{{item.hasAvailable}}" class="item-tag item-tag--success">{{t.tagAvailable}}</text>
            <text wx:if="{{item.hasDefect}}" class="item-tag item-tag--danger">{{t.tagDefect}}</text>
          </view>
        </view>
      </view>

      <view class="item-body">
        <view class="item-qty-row">
          <view class="qty-block">
            <text class="qty-value">{{item.totalAvailableQty || 0}}</text>
            <text class="qty-label">{{t.available}}</text>
          </view>
          <view class="qty-block">
            <text class="qty-value qty-value--muted">{{item.totalLockedQty || 0}}</text>
            <text class="qty-label">{{t.locked}}</text>
          </view>
          <view class="qty-block">
            <text class="qty-value qty-value--danger">{{item.totalDefectQty || 0}}</text>
            <text class="qty-label">{{t.defective}}</text>
          </view>
          <view class="qty-block">
            <text class="qty-value qty-value--info">{{item.totalInboundQty || 0}}</text>
            <text class="qty-label">{{t.totalInbound}}</text>
          </view>
        </view>

        <!-- D-513：列表只显示款级卡片，SKU 明细去掉——避免一个款在列表里占大段空间；
             需要看 SKU 点进详情页（按款号+订单号跳 detail）。 -->

        <view class="item-meta">
          <text class="meta-text">{{item._lastInboundText}}</text>
          <view class="item-actions">
            <!-- D-496：入库按钮（原先只能「点进详情 → 入库」，与出库不对称） -->
            <view class="outbound-btn outbound-btn--plain" catchtap="onInboundTap" data-id="{{item.groupKey}}">{{t.inbound}}</view>
            <view wx:if="{{item.hasAvailable}}" class="outbound-btn" catchtap="onOutboundTap" data-id="{{item.groupKey}}">{{t.outbound}}</view>
            <text class="meta-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more">
      <text class="load-more-text">{{t.pullMore}}</text>
    </view>
    <view wx:elif="{{list.length > 0}}" class="load-more">
      <text class="load-more-text">{{t.noMore}}</text>
    </view>
  </view>
  <ai-assistant />
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
