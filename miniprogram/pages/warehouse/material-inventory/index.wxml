<view class="page">
  <!-- 搜索框 + 扫码 + 类型筛选：统一使用通用组件 sticky-search-bar（与 material-database / material-center 一致） -->
  <sticky-search-bar
    placeholder="搜索物料编码或名称"
    value="{{keyword}}"
    show-scan="{{true}}"
    show-filter="{{true}}"
    bind:input="onSearchInput"
    bind:confirm="onSearchConfirm"
    bind:clear="onSearchClear"
    bind:scan="onScan"
  >
    <view slot="filter" class="filter-pickers">
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="filter-picker">
          <text class="filter-picker-text">{{typeOptions[typeIndex].label}}</text>
          <text class="filter-picker-arrow">▾</text>
        </view>
      </picker>
    </view>
  </sticky-search-bar>

  <!-- 统计 -->
  <view class="summary-row" wx:if="{{list.length > 0}}">
    <text>共 {{total}} 条</text>
    <text wx:if="{{list.length < total}}">· 已显示 {{list.length}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && list.length === 0}}">
    <text>加载中…</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <text>暂无物料库存数据</text>
    <text class="empty-hint">先在 PC 端物料仓储录入物料</text>
  </view>

  <!-- 列表 -->
  <view class="card-list">
    <view class="card" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="onRowTap">
      <view class="card-header">
        <!-- D-514：物料图片（后端 materialImage 已带 token，与成品库存同样式 44x44） -->
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" class="item-image" />
        <view wx:else class="item-image item-image--placeholder">
          <text class="item-image-text">料</text>
        </view>
        <view class="item-info">
          <view class="card-top">
            <view class="type-tag" style="background: {{item.typeColor}};">{{item.typeLabel}}</view>
            <view class="card-name">{{item.materialName}}</view>
            <view wx:if="{{item.lowStock}}" class="low-tag">低库存</view>
          </view>

          <!-- 主行：编码 + 可用库存（最大信息密度，一眼扫完） -->
          <view class="card-main">
            <text class="card-code">{{item.materialCode}}</text>
            <view class="stock-main">
              <text class="stock-label">可用</text>
              <text class="stock-value {{item.isZero ? 'is-zero' : (item.lowStock ? 'is-low' : '')}}">{{item.availableQty}}</text>
              <text class="stock-unit">{{item.unit}}</text>
            </view>
          </view>

          <!-- 次要信息：在途/锁定/安全库存/库位 合并一行 -->
          <view class="card-sub">
            <text wx:if="{{item.inTransitQty > 0}}">在途 {{item.inTransitQty}}</text>
            <text wx:if="{{item.inTransitQty > 0 && item.lockedQty > 0}}"> · </text>
            <text wx:if="{{item.lockedQty > 0}}">锁定 {{item.lockedQty}}</text>
            <text wx:if="{{(item.inTransitQty > 0 || item.lockedQty > 0) && item.safetyStock > 0}}"> · </text>
            <text wx:if="{{item.safetyStock > 0}}">安全 {{item.safetyStock}}</text>
            <text wx:if="{{item.warehouseLocation}}" class="card-loc">库位 {{item.warehouseLocation}}</text>
          </view>
        </view>
      </view>

      <!-- D-513：手机端快捷操作（原先点卡片直接跳出库，易误触） -->
      <view class="card-actions">
        <view class="act-btn act-btn--in" catchtap="onInboundTap" data-code="{{item.materialCode}}">入库</view>
        <view class="act-btn act-btn--out" catchtap="onOutboundTap" data-code="{{item.materialCode}}">出库</view>
      </view>
    </view>
  </view>

  <view class="loadmore" wx:if="{{loading && list.length > 0}}">
    <text>加载中…</text>
  </view>
  <view class="loadmore" wx:if="{{!hasMore && list.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>
</view>