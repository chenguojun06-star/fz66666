/* 物料库存查询页（手机端） */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 16rpx 24rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  background: #f3f4f6;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.search-btn {
  height: 64rpx;
  padding: 0 28rpx;
  line-height: 64rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3f4f6;
}
.picker-label {
  font-size: 26rpx;
  color: #6b7280;
}
.picker-value {
  font-size: 26rpx;
  color: #111827;
}

/* 统计 */
.summary-row {
  padding: 16rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 加载/空状态 */
.loading-state,
.empty-state {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.empty-hint {
  font-size: 22rpx;
  color: #c0c4cc;
}

/* 卡片列表 */
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.type-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.low-tag {
  padding: 2rpx 10rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
.card-code {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.stock-main {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.stock-label {
  font-size: 24rpx;
  color: #6b7280;
}
.stock-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #10b981;
  font-variant-numeric: tabular-nums;
}
.stock-value.is-low {
  color: #dc2626;
}
.stock-value.is-zero {
  color: #9ca3af;
}
.stock-unit {
  font-size: 24rpx;
  color: #6b7280;
}

.stock-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.stock-loc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 加载更多 */
.loadmore {
  padding: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}