/* 物料库存查询页 - 手机端 */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 24rpx;
}

/* 搜索框 + 扫码 由通用组件 sticky-search-bar 提供，这里只定义筛选器 slot 内容 */
.filter-pickers {
  display: flex;
  align-items: center;
  gap: 8px;
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg-card, #fff);
  border-radius: var(--radius-sm, 4px);
  padding: 0 10px;
  height: 32px;
  flex: 1;
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.05));
  box-sizing: border-box;
}
.filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-xs, 12px);
  color: var(--color-text-secondary, #6b7280);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-picker-arrow {
  font-size: var(--font-size-xxs, 11px);
  color: var(--color-text-tertiary, #9ca3af);
  flex-shrink: 0;
}

/* 统计 */
.summary-row {
  padding: 16rpx 24rpx 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 加载/空状态 */
.loading-state,
.empty-state {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.empty-hint {
  font-size: 22rpx;
  color: #c0c4cc;
}

/* 卡片列表 */
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.type-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.low-tag {
  padding: 2rpx 10rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
/* D-513 手机端紧凑卡片: 编码与可用库存同一行, 次要信息合并一行 */
.card-main {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.card-code {
  font-size: 22rpx;
  color: #9ca3af;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-main {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}
.stock-label {
  font-size: 22rpx;
  color: #6b7280;
}
.stock-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #10b981;
  font-variant-numeric: tabular-nums;
}
.stock-value.is-low {
  color: #dc2626;
}
.stock-value.is-zero {
  color: #9ca3af;
}
.stock-unit {
  font-size: 22rpx;
  color: #6b7280;
}

/* 次要信息: 在途/锁定/安全/库位 合并一行 */
.card-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6b7280;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-wrap: wrap;
}
.card-loc {
  color: #9ca3af;
  margin-left: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}

/* D-513 快捷操作按钮: 手机端手指点击友好(最小高度 56rpx) */
.card-actions {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f1f3;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.act-btn {
  min-height: 56rpx;
  line-height: 54rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  text-align: center;
}
.act-btn--in {
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}
.act-btn--out {
  color: #fff;
  background: #2563eb;
}

/* 加载更多 */
.loadmore {
  padding: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}