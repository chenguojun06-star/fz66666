/* 物料库存查询页 - 手机端（D-514）
 * 视觉风格：与 material-center 的「库存」tab / material-database 完全同构
 * - 全部使用 design-tokens，禁止硬编码颜色/尺寸（app.wxss 约定）
 * - 尺寸由 rpx 改为 px + token，与同模块其它页保持同一渲染比例
 * - 原 .act-btn--in 用的是旧主色 #2563eb，现改回 token 主色 #2D7FF9
 */

.page {
  min-height: 100vh;
  padding: var(--page-padding-y) var(--page-padding-x);
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
}

/* 搜索框 + 扫码 由通用组件 sticky-search-bar 提供，这里只定义筛选器 slot 内容 */
.filter-pickers {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  padding: 0 10px;
  height: 32px;
  flex: 1;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-picker-arrow {
  font-size: var(--font-size-xxs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* 统计（对齐 material-center 的 .total-bar） */
.summary-row {
  padding: var(--spacing-sm) 0;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* 加载/空状态（对齐 material-center 的 -wrap / -text / -sub） */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
  font-size: var(--font-size-md-lg);
  color: var(--color-text-secondary);
}
.empty-hint {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* 卡片列表 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-xs);
}
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}
/* D-514：卡片头 = 图片(44x44) + 右侧信息，与成品库存 / 物料中心同构 */
.card-header {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
}
.item-image {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.item-image--placeholder {
  background: var(--color-primary-bg);
}
.item-image-text {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}
.item-info {
  flex: 1;
  min-width: 0;
}
.card-top {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.type-tag {
  padding: 2px 10px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  color: var(--color-text-white);
  flex-shrink: 0;
}
.card-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.low-tag {
  padding: 2px 8px;
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  flex-shrink: 0;
}
/* D-513 手机端紧凑卡片: 编码与可用库存同一行, 次要信息合并一行 */
.card-main {
  margin-top: var(--spacing-sm);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--spacing-sm);
}
.card-code {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-main {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  flex-shrink: 0;
}
.stock-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}
.stock-value {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
  font-variant-numeric: tabular-nums;
}
.stock-value.is-low {
  color: var(--color-danger);
}
.stock-value.is-zero {
  color: var(--color-text-tertiary);
}
.stock-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

/* 次要信息: 在途/锁定/安全/库位 合并一行 */
.card-sub {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}
.card-loc {
  color: var(--color-text-tertiary);
  margin-left: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160px;
}

/* D-513 快捷操作按钮: 手机端手指点击友好(最小高度 32px) */
.card-actions {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1px solid var(--color-border);
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-sm);
}
.act-btn {
  min-height: 32px;
  line-height: 30px;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  text-align: center;
}
.act-btn--in {
  color: var(--color-primary);
  background: var(--color-primary-bg);
  border: 1px solid var(--color-primary-border);
}
.act-btn--out {
  color: var(--color-text-white);
  background: var(--color-primary);
}

/* 加载更多 */
.loadmore {
  padding: var(--spacing-md);
  text-align: center;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}
