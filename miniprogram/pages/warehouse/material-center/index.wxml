<view class="container">
  <!-- D-515：顶部搜索栏只服务「库存」列表，其余 tab 各用各的控件
       （入库/出库表单自带「物料编码+扫码+查询」，领料列表自带「搜索+状态筛选」，料卷 tab 本身就是扫码入口）。
       之前顶部栏常驻 → 出现「上面一个搜索框、下面又一个搜索框、两个扫码入口」的重复观感。 -->
  <sticky-search-bar
    wx:if="{{activeTab === 'inventory'}}"
    placeholder="搜索物料编码或名称"
    value="{{keyword}}"
    show-scan="{{true}}"
    show-filter="{{true}}"
    bind:input="onSearchInput"
    bind:confirm="onSearchConfirm"
    bind:clear="onSearchClear"
    bind:scan="onScan"
  >
    <view slot="filter" class="filter-pickers">
      
        <view bindtap="openPicker" data-handler="onTypeChange" data-names="typeOptions" data-range-key="label" class="filter-picker">
          <text class="filter-picker-text">{{typeOptions[typeIndex].label}}</text>
          <text class="filter-picker-arrow">▾</text>
        </view>
      
    </view>
  </sticky-search-bar>

  <!-- 5 个 tab 切换（沿用项目 tab-bar / tab-item / active 约定，与 order/create 等页面一致） -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 库存 tab：inline 列表（用户最常用） -->
  <view class="tab-body" wx:if="{{activeTab === 'inventory'}}">
    <view class="total-bar" wx:if="{{inventoryList.length > 0}}">
      <text class="total-text">共 {{inventoryTotal}} 条</text>
    </view>
    <view class="loading-wrap" wx:if="{{loading && inventoryList.length === 0}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中…</text>
    </view>
    <view class="empty-wrap" wx:if="{{!loading && inventoryList.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无物料库存数据</text>
      <text class="empty-sub">先在 PC 端物料仓储录入物料</text>
    </view>
    <view class="card-list">
      <view class="card" wx:for="{{inventoryList}}" wx:key="id">
        <view class="card-header" data-item="{{item}}" bindtap="onInventoryDetail">
          <!-- D-514：物料图片（后端 materialImage 已带 token，与成品库存同样式 44x44） -->
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" class="item-image" />
          <view wx:else class="item-image item-image--placeholder">
            <text class="item-image-text">料</text>
          </view>
          <view class="item-info">
            <view class="card-top">
              <view class="type-tag" style="background: {{item.typeColor}};">{{item.typeLabel}}</view>
              <view class="card-name">{{item.materialName}}</view>
              <view wx:if="{{item.lowStock}}" class="low-tag">低库存</view>
            </view>
            <view class="card-main">
              <text class="card-code">{{item.materialCode}}</text>
              <view class="stock-main">
                <text class="stock-label">可用</text>
                <text class="stock-value {{item.isZero ? 'is-zero' : (item.lowStock ? 'is-low' : '')}}">{{item.availableQty}}</text>
                <text class="stock-unit">{{item.unit}}</text>
              </view>
            </view>
            <view class="card-sub">
              <text wx:if="{{item.lockedQty > 0}}">锁定 {{item.lockedQty}}</text>
              <text wx:if="{{item.lockedQty > 0 && item.safetyStock > 0}}"> · </text>
              <text wx:if="{{item.safetyStock > 0}}">安全 {{item.safetyStock}}</text>
              <text wx:if="{{item.warehouseLocation}}" class="card-loc">库位 {{item.warehouseLocation}}</text>
            </view>
          </view>
        </view>
        <view class="card-actions">
          <view class="act-btn act-btn--in" catchtap="onInventoryInbound" data-code="{{item.materialCode}}">入库</view>
          <view class="act-btn act-btn--out" catchtap="onInventoryOutbound" data-code="{{item.materialCode}}">出库</view>
        </view>
      </view>
    </view>

    <!-- D-515：分页（补齐原 material-inventory 独立页的「加载更多」，删孤儿页前先补平能力） -->
    <view class="loadmore" wx:if="{{inventoryList.length > 0}}">
      <text wx:if="{{loading}}">加载中…</text>
      <text wx:elif="{{hasMore}}" class="loadmore-btn" bindtap="loadMoreInventory">加载更多</text>
      <text wx:else>— 没有更多了 —</text>
    </view>
  </view>

  <!-- 入库 tab：内联表单（D-514，不再跳页；从库存卡片点「入库」会带编码预填） -->
  <view class="tab-panel" wx:elif="{{activeTab === 'inbound'}}">
    <material-inbound-form
      material-code="{{formCode}}"
      bind:success="onFormSuccess"
    />
  </view>

  <!-- 出库 tab：内联表单（D-514，不再跳页；从库存卡片点「出库」会带编码预填） -->
  <view class="tab-panel" wx:elif="{{activeTab === 'outbound'}}">
    <material-outbound-form
      material-code="{{formCode}}"
      bind:success="onFormSuccess"
    />
  </view>

  <!-- 领料 tab：内联列表（D-514，不再跳页）
       D-515：默认「全部」而不是「待出库」——D-099 后内部领料是「领取即出库」直接落 completed，
       默认看 pending 会一直空白，用户以为数据没同步。搜索栏交给组件自己（顶部栏已不在本 tab 显示）。 -->
  <view class="tab-panel" wx:elif="{{activeTab === 'picking'}}">
    <material-picking-list
      status=""
      show-search="{{true}}"
      bind:success="onPickingSuccess"
    />
  </view>

  <!-- 料卷 tab：扫码入口 -->
  <view class="tab-panel" wx:elif="{{activeTab === 'scan'}}">
    <view class="action-card" bindtap="gotoScan">
      <view class="action-icon action-icon--scan">📷</view>
      <view class="action-info">
        <view class="action-title">料卷出库 / 退回</view>
        <view class="action-desc">扫料卷二维码 → 选择出库或退回</view>
      </view>
      <view class="action-arrow">›</view>
    </view>
    <view class="action-tips">
      <view>• 退回流程：扫料卷 → 选择「退回」</view>
      <view>• 扫码后会自动带出料卷关联的款号/订单</view>
    </view>
  </view>
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
