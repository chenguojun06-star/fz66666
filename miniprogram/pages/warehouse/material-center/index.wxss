/* 物料中心（D-514）：搜索+扫码+类型+5tab 统一布局 */
.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 32rpx;
}

/* 搜索框 + 扫码 由通用组件 sticky-search-bar 提供，这里只定义筛选器 slot 内容 */
.filter-pickers {
  display: flex;
  align-items: center;
  gap: 8px;
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg-card, #fff);
  border-radius: var(--radius-sm, 4px);
  padding: 0 10px;
  height: 32px;
  flex: 1;
  box-shadow: var(--shadow-sm, 0 1px 2px rgba(0, 0, 0, 0.05));
  box-sizing: border-box;
}
.filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-xs, 12px);
  color: var(--color-text-secondary, #6b7280);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-picker-arrow {
  font-size: var(--font-size-xxs, 11px);
  color: var(--color-text-tertiary, #9ca3af);
  flex-shrink: 0;
}

/* 5 个 tab（沿用项目 tab-bar / tab-item / active 约定） */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e7eb;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2563eb;
  border-radius: 2rpx;
}

/* tab body */
.tab-body {
  padding-top: 16rpx;
}

/* 库存 tab 列表 */
.summary-row {
  padding: 0 24rpx 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.loading-state,
.empty-state {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.empty-hint {
  font-size: 22rpx;
  color: #c0c4cc;
}
.card-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}
.card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.type-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.low-tag {
  padding: 2rpx 10rpx;
  background: #fef2f2;
  color: #dc2626;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
.card-main {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.card-code {
  font-size: 22rpx;
  color: #9ca3af;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stock-main {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}
.stock-label {
  font-size: 22rpx;
  color: #6b7280;
}
.stock-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #10b981;
  font-variant-numeric: tabular-nums;
}
.stock-value.is-low {
  color: #dc2626;
}
.stock-value.is-zero {
  color: #9ca3af;
}
.stock-unit {
  font-size: 22rpx;
  color: #6b7280;
}
.card-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6b7280;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-wrap: wrap;
}
.card-loc {
  color: #9ca3af;
  margin-left: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}
.card-actions {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f1f3;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.act-btn {
  min-height: 56rpx;
  line-height: 54rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  text-align: center;
}
.act-btn--in {
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}
.act-btn--out {
  color: #fff;
  background: #2563eb;
}

/* 非库存 tab：跳转卡片 */
.launcher {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.launcher-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #eff6ff;
  border-radius: 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #2563eb;
  flex-shrink: 0;
}
.launcher-icon--in {
  background: #ecfdf5;
  color: #10b981;
}
.launcher-icon--out {
  background: #fef2f2;
  color: #dc2626;
}
.launcher-icon--picking {
  background: #fef3c7;
  color: #d97706;
}
.launcher-icon--scan {
  background: #f3e8ff;
  font-size: 36rpx;
}
.launcher-info {
  flex: 1;
  min-width: 0;
}
.launcher-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}
.launcher-desc {
  font-size: 24rpx;
  color: #6b7280;
}
.launcher-arrow {
  font-size: 40rpx;
  color: #c0c4cc;
  flex-shrink: 0;
}
.launcher-tips {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 40rpx;
}