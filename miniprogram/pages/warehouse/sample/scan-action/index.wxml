<wxs src="/utils/wxmlUtils.wxs" module="wxu" />
<!-- 样衣仓库管理页 -->
<view class="container">
  
  <!-- ==================== 列表视图 ==================== -->
  <view wx:if="{{viewMode === 'list'}}">
    <!-- 搜索框 + 扫码按钮 + 筛选器：复用通用组件 sticky-search-bar -->
    <view class="ssb-wrap">
      <sticky-search-bar
        sticky="{{false}}"
        placeholder="{{t.listSearchPlaceholder}}"
        value="{{searchKeyword}}"
        show-scan="{{true}}"
        show-filter="{{true}}"
        bind:input="onSearchInput"
        bind:confirm="onSearchConfirm"
        bind:clear="onSearchClear"
        bind:scan="onScanCode"
      >
        <view slot="filter">
          <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view
              wx:for="{{statusTabs}}"
              wx:key="key"
              class="filter-pill {{activeStatus === item.key ? 'filter-pill--on' : ''}} {{item.pillClass}}"
              data-key="{{item.key}}"
              bindtap="onStatusTabTap"
            >
              <text class="filter-text">{{item.label}}</text>
              <text class="filter-num">{{item.count}}</text>
            </view>
          </scroll-view>
        </view>
      </sticky-search-bar>
    </view>

    <!-- 列表 -->
    <view class="stock-list">
      <view wx:if="{{stockListLoading && stockList.length === 0}}" class="loading-wrap">
        <text class="loading-text">{{t.loading}}</text>
      </view>
      
      <view wx:elif="{{stockListError}}" class="error-card">
        <view class="line-icon icon-alert error-icon"></view>
        <text class="error-msg">{{stockListError}}</text>
        <view class="btn-retry" bindtap="loadStockList" data-refresh="true">{{t.retry}}</view>
      </view>
      
      <view wx:elif="{{stockList.length === 0}}" class="empty-wrap">
        <view class="line-icon icon-shirt empty-icon"></view>
        <text class="empty-text">{{t.noStock}}</text>
      </view>

      <view wx:elif="{{filteredStockList.length === 0}}" class="empty-wrap">
        <view class="line-icon icon-shirt empty-icon"></view>
        <text class="empty-text">{{t.noFilterResult}}</text>
      </view>

      <block wx:else>
      <view
        class="stock-item"
        wx:for="{{filteredStockList}}"
        wx:key="id"
        bindtap="onStockItemTap"
        data-stock="{{item}}"
      >
        <image wx:if="{{item._imageUrl}}" class="stock-thumb" src="{{item._imageUrl}}" mode="aspectFit" catchtap="onPreviewImage" data-src="{{item._imageUrl}}" />
        <view wx:else class="stock-thumb-placeholder">
        </view>
        <view class="stock-info">
          <view class="stock-row">
            <text class="stock-label">{{t.styleNoLabel}}</text>
            <text class="stock-value">{{item.styleNo || '-'}}</text>
          </view>
          <view class="stock-row">
            <text class="stock-label">{{t.colorLabel}}</text>
            <text class="stock-value">{{item.color || '-'}}</text>
          </view>
          <view class="stock-row">
            <text class="stock-label">{{t.sizeLabel}}</text>
            <text class="stock-value">{{item.size || '-'}}</text>
          </view>
          <view class="stock-row" wx:if="{{item._sampleTypeLabel}}">
            <text class="stock-label">{{t.typeLabel}}</text>
            <text class="stock-value">{{item._sampleTypeLabel}}</text>
          </view>
        </view>
        <view class="stock-status">
          <view class="stock-quantity">
            <text class="qty-num">{{item.quantity || 0}}</text>
            <text class="qty-unit">{{t.piece}}</text>
          </view>
          <text class="stock-loan" wx:if="{{item._loanedText}}">{{item._loanedText}}</text>
          <text class="stock-arrow">›</text>
        </view>
      </view>
      </block>

      <!-- 加载更多：仅在"全部"tab下显示，本地过滤时不显示（避免误以为还有数据） -->
      <view class="load-more" wx:if="{{activeStatus === 'all' && stockList.length > 0}}">
        <text wx:if="{{stockListLoading}}" class="load-text">{{t.loading}}</text>
        <text wx:elif="{{hasMore}}" class="load-text" bindtap="loadStockList">{{t.loadMore}}</text>
        <text wx:else class="load-text">{{t.noMore}}</text>
      </view>
    </view>
  </view>
  
  <!-- ==================== 详情视图 ==================== -->
  <view wx:if="{{viewMode === 'detail'}}">
    <!-- 头部 -->
    <view class="header">
      <text class="header-title">{{t.detailTitle}}</text>
      <view class="header-scan" bindtap="onScanCode">{{t.scan}}</view>
    </view>
    
    <view class="header-info">
      <text class="header-sub">{{styleNo}} · {{color}} · {{size}}</text>
    </view>
    
    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <text class="loading-text">{{t.querying}}</text>
    </view>
    
    <!-- 错误提示 -->
    <view class="error-card" wx:elif="{{errorMsg}}">
      <view class="line-icon icon-alert error-icon"></view>
      <text class="error-msg">{{errorMsg}}</text>
      <view class="btn-retry" bindtap="onRetry">{{t.retry}}</view>
    </view>
    
    <!-- 成功提示 -->
    <view class="success-banner" wx:if="{{successMsg}}">
      <view class="line-icon icon-checkmark success-icon"></view>
      <text class="success-text">{{successMsg}}</text>
    </view>
    
    <!-- 库存信息卡片 -->
    <block wx:if="{{stockInfo && !loading}}">
      <!-- 未找到库存记录 -->
      <view class="info-card" wx:if="{{!stockInfo.found}}">
        <view class="info-row">
          <text class="info-label">{{t.statusLabel}}</text>
          <text class="info-value">
            <text class="status-tag tag-orange">{{t.notInStock}}</text>
          </text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.styleNoLabel}}</text>
          <text class="info-value bold">{{styleNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.colorLabel}}</text>
          <text class="info-value">{{color}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.sizeLabel}}</text>
          <text class="info-value">{{size}}</text>
        </view>
      </view>
      
      <!-- 已有库存记录 -->
      <view class="info-card" wx:if="{{stockInfo.found && stockInfo.stock}}">
        <image
          wx:if="{{stockInfo.stock._imageUrl}}"
          class="detail-image"
          src="{{stockInfo.stock._imageUrl}}"
          mode="aspectFit"
          bindtap="onPreviewImage"
          data-src="{{stockInfo.stock._imageUrl}}"
        />
        <view class="info-row">
          <text class="info-label">{{t.statusLabel}}</text>
          <text class="info-value">
            <text class="status-tag tag-green" wx:if="{{stockInfo.availableQuantity > 0}}">{{t.inStockTag}}</text>
            <text class="status-tag tag-orange" wx:else>{{t.allLoanedOut}}</text>
          </text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.styleNoLabel}}</text>
          <text class="info-value bold">{{stockInfo.stock.styleNo}}</text>
        </view>
        <view class="info-row" wx:if="{{stockInfo.stock.styleName}}">
          <text class="info-label">{{t.styleName}}</text>
          <text class="info-value">{{stockInfo.stock.styleName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.colorLabel}}</text>
          <text class="info-value">{{stockInfo.stock.color}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.sizeLabel}}</text>
          <text class="info-value">{{stockInfo.stock.size}}</text>
        </view>
        <view class="info-row" wx:if="{{stockInfo.stock.sampleType}}">
          <text class="info-label">{{t.typeLabel}}</text>
          <text class="info-value">{{stockInfo.stock._sampleTypeLabel || stockInfo.stock.sampleType}}</text>
        </view>
        <view class="info-row" wx:if="{{stockInfo.stock.location}}">
          <text class="info-label">{{t.binLocation}}</text>
          <text class="info-value">{{stockInfo.stock.location}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.stockQty}}</text>
          <text class="info-value bold">{{stockInfo.stock._qtyText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">{{t.availableLabel}}</text>
          <text class="info-value bold">{{stockInfo._availableText}}</text>
        </view>
        <view class="info-row" wx:if="{{stockInfo.stock.loanedQuantity > 0}}">
          <text class="info-label">{{t.loanedLabel}}</text>
          <text class="info-value">{{stockInfo.stock._loanedQtyText}}</text>
        </view>

        <!-- 库存统计：总数量/已借调/待归还/报废（复用项目统一 stats-row/stat-card 样式） -->
        <view class="stats-row">
          <view class="stat-card">
            <text class="stat-value">{{stockInfo.stock.quantity || 0}}</text>
            <text class="stat-label">{{t.totalQty}}</text>
          </view>
          <view class="stat-card">
            <text class="stat-value stat-value--warning">{{stockInfo.stock.loanedQuantity || 0}}</text>
            <text class="stat-label">{{t.loanedQty}}</text>
          </view>
          <view class="stat-card">
            <text class="stat-value stat-value--danger">{{stockInfo.pendingReturnCount || 0}}</text>
            <text class="stat-label">{{t.pendingReturnQty}}</text>
          </view>
          <view class="stat-card">
            <text class="stat-value stat-value--secondary">{{stockInfo.scrappedCount || 0}}</text>
            <text class="stat-label">{{t.scrappedQty}}</text>
          </view>
        </view>
      </view>
      
      <!-- 借调记录 -->
      <view class="info-card" wx:if="{{stockInfo.activeLoans && stockInfo.activeLoans.length > 0}}">
        <view class="info-row">
          <text class="info-label bold" style="width:auto">{{t.activeLoans}}</text>
        </view>
        <view class="loan-item" wx:for="{{stockInfo.activeLoans}}" wx:key="id">
          <view class="info-row">
            <text class="info-label">{{t.borrower}}</text>
            <text class="info-value">{{item.borrower}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{t.quantityLabel}}</text>
            <text class="info-value">{{item._qtyText}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{t.timeLabel}}</text>
            <text class="info-value">{{item.createTime}}</text>
          </view>
        </view>
      </view>
      
      <!-- 操作按钮区域 -->
      <view class="action-area" wx:if="{{!successMsg}}">
        <!-- 出库库位提示（已入库时显示，让用户清楚样衣在哪里） -->
        <view wx:if="{{stockInfo.found && stockInfo.stock && (stockInfo.stock.warehouseAreaName || stockInfo.stock.location)}}" class="stock-location-banner">
          <text class="stock-location-label">{{t.outboundLocationLabel}}</text>
          <text class="stock-location-value">{{stockInfo.stock.warehouseAreaName || '-'}}{{stockInfo.stock.location ? ' / ' + stockInfo.stock.location : ''}}</text>
        </view>

        <!-- 仓库区域选择（入库时显示） -->
        <view wx:if="{{wxu.has(actions, 'inbound')}}" class="warehouse-section">
          <view class="warehouse-label">{{t.inboundWarehouseLabel}}</view>
          <!-- D-171：仓库搜索（仓库较多时快速定位） -->
          <input
            wx:if="{{warehouseOptions.length > 2}}"
            class="input-box warehouse-search-input"
            placeholder="{{t.warehouseSearchPlaceholder}}"
            value="{{warehouseSearchKey}}"
            bindinput="onWarehouseSearchInput"
          />
          <view class="warehouse-option-row">
            <view
              wx:for="{{filteredWarehouseOptions}}"
              wx:key="index"
              class="warehouse-chip {{warehouse === item ? 'warehouse-chip--active' : ''}}"
              bindtap="onWarehouseChipTap"
              data-value="{{item}}"
              hover-class="warehouse-chip-hover"
            >{{item}}</view>
            <view
              class="warehouse-chip warehouse-chip--clear {{warehouse ? '' : 'warehouse-chip--disabled'}}"
              bindtap="onWarehouseClear"
              hover-class="warehouse-chip-hover"
            >{{t.clear}}</view>
          </view>
          <input
            class="input-box"
            placeholder="{{t.warehouseCodePlaceholder}}"
            value="{{warehouse}}"
            bindinput="onWarehouseCodeInput"
          />

          <!-- 库位选择（显示已用/容量避免超限） -->
          <view wx:if="{{warehouse && locationItems.length > 0}}" class="warehouse-label" style="margin-top: 12rpx;">{{t.inboundLocationLabel}}</view>
          <input
            wx:if="{{warehouse && locationItems.length > 4}}"
            class="input-box warehouse-search-input"
            placeholder="{{t.locationSearchPlaceholder}}"
            value="{{locationSearchKey}}"
            bindinput="onLocationSearchInput"
          />
          <view wx:if="{{warehouse && locationItems.length > 0}}" class="warehouse-option-row">
            <view
              wx:for="{{filteredLocationItems}}"
              wx:key="label"
              class="warehouse-chip warehouse-chip--loc {{warehouseLocationCode === item.label ? 'warehouse-chip--active' : ''}} {{item.isFull ? 'warehouse-chip--full' : ''}}"
              bindtap="onLocationChipTap"
              data-value="{{item.label}}"
              hover-class="warehouse-chip-hover"
            >{{item.label}}<text class="warehouse-chip-qty {{item.isFull ? 'warehouse-chip-qty--full' : ''}}">{{item.used}}/{{item.capacity}}</text></view>
            <view
              class="warehouse-chip warehouse-chip--clear {{warehouseLocationCode ? '' : 'warehouse-chip--disabled'}}"
              bindtap="onLocationClear"
              hover-class="warehouse-chip-hover"
            >{{t.clear}}</view>
          </view>
          <input
            wx:if="{{warehouse}}"
            class="input-box"
            placeholder="{{t.locationCodePlaceholder}}"
            value="{{warehouseLocationCode}}"
            bindinput="onLocationCodeInput"
          />
        </view>
        
        <!-- 操作按钮：一行3个 + 镂空风格（遵循项目铁律：所有按钮必须镂空） -->
        <view class="action-btn-row">
          <view
            class="action-btn action-btn--inbound {{submitting ? 'action-btn--disabled' : ''}}"
            wx:if="{{wxu.has(actions, 'inbound')}}"
            bindtap="onInbound"
            hover-class="action-btn--hover"
          >{{t.actionInbound}}</view>
          <view
            class="action-btn action-btn--loan {{submitting ? 'action-btn--disabled' : ''}}"
            wx:if="{{wxu.has(actions, 'loan')}}"
            bindtap="onLoan"
            hover-class="action-btn--hover"
          >{{t.actionLoan}}</view>
          <view
            class="action-btn action-btn--return {{submitting ? 'action-btn--disabled' : ''}}"
            wx:if="{{wxu.has(actions, 'return')}}"
            bindtap="onReturn"
            hover-class="action-btn--hover"
          >{{t.actionReturn}}</view>
        </view>
      </view>
    </block>
  </view>
  
  <!-- 借调目标选择弹窗 -->
  <view wx:if="{{showLoanPicker}}" class="loan-picker-mask" catchtap="onLoanCancel">
    <view class="loan-picker" catchtap="noop">
      <view class="loan-picker-header">
        <text class="loan-picker-title">{{t.loanPickerTitle}}</text>
        <view class="loan-picker-close" bindtap="onLoanCancel">×</view>
      </view>

      <!-- 借调对象类型切换 -->
      <view class="loan-type-tabs">
        <view
          class="loan-type-tab {{loanTargetType === 'person' ? 'loan-type-tab--active' : ''}}"
          bindtap="onLoanTargetTypeChange"
          data-type="person"
        >{{t.loanToPerson}}</view>
        <view
          class="loan-type-tab {{loanTargetType === 'factory' ? 'loan-type-tab--active' : ''}}"
          bindtap="onLoanTargetTypeChange"
          data-type="factory"
        >{{t.loanToFactory}}</view>
      </view>

      <!-- 借调数量 -->
      <view class="loan-qty-row">
        <text class="loan-qty-label">{{t.loanQtyLabel}}</text>
        <input
          class="loan-qty-input"
          type="number"
          value="{{loanQuantity}}"
          bindinput="onLoanQuantityInput"
        />
        <text class="loan-qty-max">{{t.loanAvailableText}}</text>
      </view>

      <!-- D-517：借调对象改为可搜索选择器 —— 原先只拉前 200 条做本地过滤，
           第 201 个员工/工厂永远搜不到；现在按关键字远程搜索 + 分页。 -->
      <view class="loan-picker-row" bindtap="openPicker" data-key="loanTarget">
        <text class="loan-picker-value {{loanTargetName ? '' : 'is-placeholder'}}">
          {{loanTargetName || (loanTargetType === 'person' ? t.loanSelectPerson : t.loanSelectFactory)}}
        </text>
        <text class="loan-picker-arrow">›</text>
      </view>

      <!-- 确认按钮 -->
      <view class="loan-picker-footer">
        <view class="loan-btn loan-btn--cancel" bindtap="onLoanCancel">{{t.cancel}}</view>
        <view
          class="loan-btn loan-btn--confirm {{(!loanTargetId || submitting) ? 'loan-btn--disabled' : ''}}"
          bindtap="onLoanConfirm"
        >{{t.confirmLoan}}</view>
      </view>
    </view>
  </view>

  <!-- 隐私协议 -->
  <privacy-dialog
    wx:if="{{showPrivacy}}"
    bind:agree="onPrivacyAgree"
    bind:disagree="onPrivacyDisagree"
  />
  <ai-assistant />

  <!-- D-517：通用可搜索选择器（借调对象：员工 / 外发工厂） -->
  <search-picker
    visible="{{pickerVisible}}"
    title="{{pickerTitle}}"
    options="{{pickerOptions}}"
    value="{{pickerValue}}"
    remote="{{pickerRemote}}"
    loading="{{pickerLoading}}"
    has-more="{{pickerHasMore}}"
    bind:search="onPickerSearch"
    bind:loadmore="onPickerLoadMore"
    bind:select="onPickerSelect"
    bind:close="onPickerClose"
  />
</view>
