<!-- 成品出库页：独立页面（原弹窗面积太小，手机上不好操作，改为全屏页） -->
<view class="page">

  <!-- ① 顶部款号信息 -->
  <view class="header-card">
    <image wx:if="{{styleImage}}" class="header-img" src="{{styleImage}}" mode="aspectFill" />
    <view wx:else class="header-img header-img--empty">{{t.noImage}}</view>
    <view class="header-info">
      <text class="header-name">{{styleName || '—'}}</text>
      <text class="header-sub">{{t.styleNoText}}</text>
      <text class="header-sub" wx:if="{{orderNo}}">{{t.orderNoText}}</text>
      <text class="header-sub" wx:if="{{factoryName}}">{{t.factoryText}}</text>
    </view>
  </view>

  <!-- ② 出库类型（决定后续必填项） -->
  <view class="section">
    <view class="section-hd">
      <text class="section-title">{{t.outboundType}}</text>
    </view>
    <view class="type-grid">
      <view
        wx:for="{{typeOptions}}"
        wx:key="key"
        class="type-chip {{outstockType === item.key ? 'type-chip--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSelectType"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- ③ 仓库区域 -->
  <view class="section">
      <!-- D-517：仓库区域改为可搜索选择器（原生 picker 无搜索，区域一多只能一路滚） -->
      <view class="row" bindtap="openPicker" data-key="area">
        <text class="row-label">{{t.warehouseArea}}</text>
        <text class="row-value {{warehouseAreaName ? '' : 'row-value--placeholder'}}">
          {{warehouseAreaName || t.pleaseSelect}}
        </text>
        <text class="row-arrow">›</text>
      </view>

      <!-- ④ 客户：仅销售类出库需要（后端 REQUIRES_CUSTOMER_TYPES） -->
      <view class="row" wx:if="{{needsCustomer}}" bindtap="openPicker" data-key="customer">
        <text class="row-label">{{t.customer}} <text class="req">*</text></text>
        <text class="row-value {{customerName ? '' : 'row-value--placeholder'}}">
          {{customerName || t.requiredCustomer}}
        </text>
        <text class="row-arrow">›</text>
      </view>

      <!-- ④-2 收货地址：PC 端有（CustomerInfoSection），手机端原先缺失 -->
      <view class="row" wx:if="{{needsCustomer}}">
        <text class="row-label">{{t.shippingAddress}}</text>
        <input
          class="row-input"
          placeholder="{{t.autoFillEditable}}"
          value="{{shippingAddress}}"
          bindinput="onAddressInput"
        />
      </view>

      <!-- ④-3 联系电话：PC 端 CustomerInfoSection 也有，手机端原先缺失 -->
      <view class="row" wx:if="{{needsCustomer}}">
        <text class="row-label">{{t.contactPhone}}</text>
        <input
          class="row-input"
          type="number"
          placeholder="{{t.autoFillEditable}}"
          value="{{customerPhone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <!-- ④-4 物流信息：后端 FinishedOutstockHelper 支持，手机端/PC端原先都没做 -->
      <view class="row">
        <text class="row-label">{{t.expressCompany}}</text>
        <input
          class="row-input"
          placeholder="{{t.expressPlaceholder}}"
          value="{{expressCompany}}"
          bindinput="onExpressInput"
        />
      </view>
      <view class="row">
        <text class="row-label">{{t.trackingNo}}</text>
        <input
          class="row-input"
          placeholder="{{t.optional}}"
          value="{{trackingNo}}"
          bindinput="onTrackingInput"
        />
      </view>
      <!-- 直发开关已撤回：后端 directShip 语义是「质检直发」（D-360k，不落成品库存、
           跳过库存扣减，且仅允许销售出库，其他类型直接抛异常），不是可随手勾选的普通开关。
           误触会导致「记了出库单但库存没扣」或出库直接失败。PC 端也只通过 URL 入口
           (?directShip=1) 进入该模式，不做开关。 -->
  </view>

  <!-- ⑤ SKU 明细多选 -->
  <view class="section">
    <view class="section-hd">
      <text class="section-title">{{t.selectDetail}}</text>
      <view class="hd-actions">
        <!-- D-513：一键把所有规格的数量填为可用库存 -->
        <view class="hd-btn" bindtap="onFillAllQty">{{t.fillAllQty}}</view>
        <view class="select-all" bindtap="onToggleAll">
          <view class="checkbox checkbox--sm">
            <text wx:if="{{allSelected}}" class="check-mark">✓</text>
          </view>
          <text class="select-all-text">{{t.selectAll}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

    <view wx:elif="{{!skuList.length}}" class="empty">{{t.noStockData}}</view>

    <view wx:else class="sku-list">
      <view
        wx:for="{{skuList}}"
        wx:key="id"
        class="sku-item {{selected[item.id] ? 'sku-item--checked' : ''}} {{item.availableQty <= 0 ? 'sku-item--disabled' : ''}}"
      >
        <view class="sku-main" data-id="{{item.id}}" bindtap="onToggleSku">
          <view class="checkbox">
            <text wx:if="{{selected[item.id]}}" class="check-mark">✓</text>
          </view>
          <view class="sku-text">
            <text class="sku-name">{{item.color}} / {{item.size}}</text>
            <text class="sku-meta">{{item.availableText}}</text>
          </view>
          <!-- D-513：单价（数据里一直有 salesPrice，原界面没显示） -->
          <text class="sku-price">¥{{item.salesPrice || 0}}</text>
        </view>

        <!-- 数量步进器：仅选中后可用 -->
        <view class="stepper" wx:if="{{selected[item.id]}}">
          <view class="stepper-btn" data-id="{{item.id}}" catchtap="onQtyMinus">−</view>
          <input
            class="stepper-input"
            type="number"
            value="{{selected[item.id]}}"
            data-id="{{item.id}}"
            bindinput="onQtyInput"
          />
          <view class="stepper-btn" data-id="{{item.id}}" catchtap="onQtyPlus">+</view>
        </view>

        <!-- D-513：单价可改，提交到 items[].salesPrice -->
        <view class="price-row" wx:if="{{selected[item.id]}}">
          <text class="price-label">{{t.price}}</text>
          <input
            class="price-input"
            type="digit"
            value="{{item.salesPrice}}"
            data-id="{{item.id}}"
            bindinput="onPriceInput"
          />
          <text class="price-unit">{{t.yuan}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ⑥ 备注 -->
  <view class="section">
    <view class="section-hd"><text class="section-title">{{t.remark}}</text></view>
    <textarea
      class="remark"
      placeholder="{{t.remarkPlaceholder}}"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
      auto-height
    />
  </view>

  <view class="bottom-pad"></view>
</view>

<!-- ⑦ 底部固定提交栏 -->
<view class="submit-bar">
  <view class="submit-summary">
    <text class="submit-count">{{t.selectedItemsText}}</text>
    <text class="submit-qty">{{t.totalQtyText}}</text>
  </view>
  <view class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? t.submitting : t.confirmOutbound}}
  </view>
</view>

<!-- D-517：通用可搜索选择器（仓库区域 / 客户） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
