<scroll-view class="page" scroll-y="{{true}}" enhanced="{{true}}">
  <view class="doc-header">
    <text class="doc-title">{{t.docTitle}}</text>
    <text class="doc-date">{{t.docDate}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h1}}</text>
    <text class="doc-body">{{t.p1}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h2}}</text>
    <text class="doc-body">{{t.p2}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h3}}</text>
    <text class="doc-body">{{t.p3}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h4}}</text>
    <text class="doc-body">{{t.p4}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h5}}</text>
    <text class="doc-body">{{t.p5}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h6}}</text>
    <text class="doc-body">{{t.p6}}</text>
  </view>

  <view class="doc-section">
    <text class="doc-heading">{{t.h7}}</text>
    <view class="doc-contact">
      <text class="doc-body">{{t.p7}}</text>
      <text class="doc-email">support@yizhilian.com</text>
    </view>
  </view>

  <view class="doc-footer">
    <text>{{t.copyright}}</text>
  </view>
  <ai-assistant />
</scroll-view>
