@import '/styles/page-utils.wxss';
@import '/styles/modal-form.wxss';

.page {
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ===== Filter Bar ===== */
.filter-bar {
  display: flex;
  gap: 8px;
}
.filter-item {
  flex: 1;
  min-width: 0;
}
.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  padding: 0 12px;
  height: 32px;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.picker-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-chevron {
  flex-shrink: 0;
  width: 0;
  height: 0;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 4px solid var(--color-text-tertiary);
}

/* ===== List ===== */
.list-section {
  padding: 4px 16px 16px;
}

.task-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
  border-left: 3px solid var(--color-border);
  overflow: hidden;
}
.task-card.tag-orange { border-left-color: var(--color-warning); }
.task-card.tag-blue { border-left-color: var(--color-primary); }
.task-card.tag-green { border-left-color: var(--color-success); }
.task-card.tag-red { border-left-color: var(--color-danger); }

.card-hover {
  background: var(--color-bg-hover);
}

/* ===== 图片位行（D-418，与仓库/成品卡片视觉统一）===== */
.card-media-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.card-media {
  width: 64px;
  height: 64px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--color-bg-page);
}
.card-media--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-media-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.card-media-body {
  flex: 1;
  min-width: 0;
}

/* Row 1 */
.card-row1 {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}
.task-title {
  flex: 1;
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.status-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* Row 2 */
.card-row2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.meta-text {
  color: var(--color-text-secondary);
}
.row-separator {
  color: var(--color-text-tertiary);
}

.task-sub {
  display: block;
  margin-top: 8px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* Footer */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border);
}
.time-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.overdue-text {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-danger);
}
.click-hint {
  flex-shrink: 0;
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  white-space: nowrap;
}
