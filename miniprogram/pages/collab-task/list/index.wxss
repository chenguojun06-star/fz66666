/* D-463：筛选器胶囊样式已收编共享（含 D-427 选中态） */
@import "/styles/picker-filter.wxss";

@import '/styles/page-utils.wxss';
/* D-421：卡片样式统一走公共文件（与对账/报销/工资审批同款） */
@import '/styles/finance-card.wxss';

.page {
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ===== Filter Bar ===== */
.picker-text {
  font-size: var(--font-size-sm); color: var(--color-text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.picker-chevron {
  flex-shrink: 0; width: 0; height: 0;
  border-left: 4px solid transparent; border-right: 4px solid transparent;
  border-top: 4px solid var(--color-text-tertiary);
}