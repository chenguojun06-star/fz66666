<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{loading && !order && !detail}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <!-- 错误兜底 -->
  <block wx:elif="{{!order && !detail}}">
    <view class="empty-state">
      <view class="empty-icon"><view class="line-icon line-icon--xl icon-alert"></view></view>
      <text class="empty-text">{{t.cannotLoadBrief}}</text>
      <text class="empty-hint">{{t.backToListHint}}</text>
    </view>
  </block>

  <block wx:else>
    <!-- ============ 1. 基本信息卡（设计稿：封面图 + 订单号 + 状态标签 + 行式信息 border-b 分隔） ============ -->
    <view class="detail-card">
      <view class="basic-header">
        <image wx:if="{{styleCover}}" class="basic-cover" src="{{styleCover}}" mode="aspectFill" />
        <view class="basic-header-info {{styleCover ? '' : 'basic-header-info--full'}}">
          <view class="basic-title-row">
            <text class="basic-order-no">{{order.orderNo || (detail.orderNo || '-')}}</text>
            <view wx:if="{{latestRecord.qualityStatusText}}" class="status-pill {{latestRecord.qualityStatusCls}}">{{latestRecord.qualityStatusText}}</view>
            <view wx:elif="{{qcStats.count > 0}}" class="status-pill status-info">{{t.checkedWord}} {{qcStats.count}} {{t.checkedTimesW}}</view>
          </view>
          <text wx:if="{{order.styleNo || detail.styleNo}}" class="basic-style-no">{{order.styleNo || detail.styleNo}}</text>
          <view class="basic-info-rows">
            <view class="basic-info-row" wx:if="{{warehousingNo || detail.warehousingNo}}">
              <text class="basic-info-label">{{t.inboundNoLabel}}</text>
              <text class="basic-info-value">{{warehousingNo || detail.warehousingNo}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.styleName || detail.styleName}}">
              <text class="basic-info-label">{{t.styleNameLabel}}</text>
              <text class="basic-info-value">{{order.styleName || detail.styleName}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.color}}">
              <text class="basic-info-label">{{t.colorLabel}}</text>
              <text class="basic-info-value">{{order.color}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.size}}">
              <text class="basic-info-label">{{t.sizeLabel}}</text>
              <text class="basic-info-value">{{order.size}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.orderQuantity}}">
              <text class="basic-info-label">{{t.qtyLabel}}</text>
              <text class="basic-info-value">{{order.orderQuantity}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.factoryName}}">
              <text class="basic-info-label">{{t.producerLabel}}</text>
              <text class="basic-info-value">{{order.factoryName}}</text>
            </view>
            <view class="basic-info-row" wx:if="{{order.deliveryDateStr}}">
              <text class="basic-info-label">{{t.deliveryLabel}}</text>
              <text class="basic-info-value">{{order.deliveryDateStr}}</text>
              <text class="remain-badge {{order.remainDaysClass}}" wx:if="{{order.remainDaysText}}">{{order.remainDaysText}}</text>
            </view>
            <view class="basic-info-row last" wx:if="{{order.merchandiser}}">
              <text class="basic-info-label">{{t.merchLabel}}</text>
              <text class="basic-info-value">{{order.merchandiser}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ============ 1.5 页内 tab 栏（质检明细 / 尺寸表，布局对齐样衣开发详情页） ============ -->
    <view class="detail-tabs">
      <view class="detail-tab {{activeTab === 'qc' ? 'detail-tab--active' : ''}}" data-key="qc" bindtap="onTabChange">{{t.navTitle}}</view>
      <view class="detail-tab {{activeTab === 'size' ? 'detail-tab--active' : ''}}" data-key="size" bindtap="onTabChange">{{t.sizeTableTitle}}</view>
    </view>

    <!-- ============ 质检明细 tab 内容 ============ -->
    <block wx:if="{{activeTab === 'qc'}}">

    <!-- ============ 2. 数量进度卡（设计稿：4列大数字 22px） ============ -->
    <view class="detail-card">
      <view class="qty-progress-grid">
        <view class="qty-progress-col">
          <text class="qty-progress-label">{{t.cuttingLabelW}}</text>
          <text class="qty-progress-value">{{detail.cuttingQuantity || order.orderQuantity || 0}}</text>
        </view>
        <view class="qty-progress-col">
          <text class="qty-progress-label">{{t.qcLabelW}} </text>
          <text class="qty-progress-value">{{detail.warehousingQuantity || qcStats.count || 0}}</text>
        </view>
        <view class="qty-progress-col">
          <text class="qty-progress-label">{{t.pass}}</text>
          <text class="qty-progress-value qty-success">{{detail.qualifiedQuantity || qcStats.qualified || 0}}</text>
        </view>
        <view class="qty-progress-col">
          <text class="qty-progress-label">{{t.fail}}</text>
          <text class="qty-progress-value qty-error">{{detail.unqualifiedQuantity || qcStats.unqualified || 0}}</text>
        </view>
      </view>
    </view>

    <!-- ============ 3. 质检信息卡（设计稿：标题 + 4行键值对 border-b 分隔） ============ -->
    <view class="detail-card" wx:if="{{latestRecord}}">
      <text class="card-title-text">{{t.qcInfoTitle}}</text>
      <view class="info-rows">
        <view class="info-row">
          <text class="info-row-label">{{t.scanModeLabel}}</text>
          <text class="info-row-value">{{latestRecord.scanMode || t.scanModePiece}}</text>
        </view>
        <view class="info-row">
          <text class="info-row-label">{{t.qcPersonLabel}}</text>
          <text class="info-row-value">{{latestRecord.qualityOperatorName || latestRecord.operatorName || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-row-label">{{t.qcTimeLabel}}</text>
          <text class="info-row-value">{{latestRecord.displayTime || '-'}}</text>
        </view>
        <view class="info-row last">
          <text class="info-row-label">{{t.processWord}}</text>
          <text class="info-row-value">{{latestRecord.processName || order.processName || t.qcBeforePack}}</text>
        </view>
      </view>
    </view>

    <!-- ============ 4. 质检明细卡（设计稿：标题 + 缺陷详情 + 不良品照片3列网格） ============ -->
    <view class="detail-card" wx:if="{{latestRecord && (latestRecord.defectCategoryText || latestRecord.defectRemark || latestRecord.remark)}}">
      <text class="card-title-text">{{t.navTitle}}</text>
      <view class="info-rows">
        <view class="info-row" wx:if="{{latestRecord.defectCategoryText}}">
          <text class="info-row-label">{{t.defectCategory}}</text>
          <text class="info-row-value defect-value">{{latestRecord.defectCategoryText}}</text>
        </view>
        <view class="info-row" wx:if="{{latestRecord.defectRemark}}">
          <text class="info-row-label">{{t.handleMethod}}</text>
          <text class="info-row-value">{{latestRecord.defectRemark}}</text>
        </view>
        <view class="info-row last" wx:if="{{latestRecord.remark}}">
          <text class="info-row-label">{{t.remarkLabel}}</text>
          <text class="info-row-value info-row-value--right">{{latestRecord.remark}}</text>
        </view>
      </view>
      <!-- 不良品照片区域 -->
      <view class="defect-photo-section" wx:if="{{latestRecord.imageList.length > 0}}">
        <view class="defect-photo-header">
          <text class="defect-photo-title">{{t.defectPhotos}}</text>
          <text class="defect-photo-count">{{latestRecord.imageList.length}}{{t.photosUnit}}</text>
        </view>
        <view class="photo-grid-3">
          <image wx:for="{{latestRecord.imageList}}" wx:key="*this"
                 class="defect-photo-img" src="{{item}}" mode="aspectFit"
                 data-url="{{item}}" data-idx="{{index}}" data-src="latest" bindtap="onPreviewImage" />
        </view>
      </view>
    </view>

    <!-- ============ 5. 质检概览（保留：3列卡片） ============ -->
    <view class="overview-grid">
      <view class="overview-card overview-card--primary {{pendingBundles.length > 0 ? 'overview-card--active' : ''}}"
            bindtap="onScrollToPending">
        <view class="overview-value">{{pendingBundles.length}}</view>
        <view class="overview-label">{{t.pendingQcTab}}</view>
        <view class="overview-hint" wx:if="{{pendingBundles.length > 0}}">{{t.startQcHint}}</view>
        <view class="overview-hint overview-hint--muted" wx:else>{{t.noPendingTab}}</view>
      </view>
      <view class="overview-card overview-card--warning {{qcStats.pendingWarehouse > 0 ? 'overview-card--active' : ''}}"
            bindtap="onScrollToRecords">
        <view class="overview-value">{{qcStats.pendingWarehouse}}</view>
        <view class="overview-label">{{t.pendingInboundTab}}</view>
        <view class="overview-hint" wx:if="{{qcStats.pendingWarehouse > 0}}">{{t.goInboundHint}}</view>
        <view class="overview-hint overview-hint--muted" wx:else>{{t.noInboundTab}}</view>
      </view>
      <view class="overview-card overview-card--success">
        <view class="overview-value">{{qcStats.passRate}}</view>
        <view class="overview-label">{{t.passRateLabel}}</view>
        <view class="overview-hint overview-hint--muted">{{t.pass}} {{qcStats.qualified}} / {{t.fail}} {{qcStats.unqualified}}</view>
      </view>
    </view>

    <!-- ============ 6. 待质检菲号（页面内多选，与 PC 端 InspectionDetail 对齐） ============ -->
    <view class="detail-card section-pending" wx:if="{{pendingBundles.length > 0}}">
      <view class="card-title-row">
        <view class="card-title-with-tag">
          <text class="card-title">{{t.pendingQcTab}}</text>
          <text class="card-badge card-badge--primary">{{pendingBundles.length}}</text>
        </view>
      </view>

      <!-- 多选操作栏：全选/反选/清空 + 已选汇总 -->
      <view class="bundle-select-toolbar">
        <view class="bundle-select-actions">
          <text class="bundle-select-action" bindtap="onSelectAllBundles">{{t.selectAll}}</text>
          <text class="bundle-select-action" bindtap="onInvertBundles">{{t.invertSel}}</text>
          <text class="bundle-select-action" bindtap="onClearBundles">{{t.clearText}}</text>
        </view>
        <text class="bundle-select-summary" wx:if="{{selectedBundleQrs.length > 0}}">
          {{t.selectedWord}} {{selectedBundleQrs.length}} / {{t.currentWord}} {{selectedBundleTotalQty}}{{t.pieceUnit}}
        </text>
      </view>

      <!-- D-517：菲号多时加关键字搜索（菲号/二维码/颜色/码数） -->
      <view class="bundle-search-row">
        <input
          class="bundle-search-input"
          placeholder="{{t.searchBundlePhW}}"
          value="{{bundleSearchKey}}"
          bindinput="onBundleSearchInput"
          confirm-type="search"
        />
        <text wx:if="{{bundleSearchKey}}" class="bundle-search-clear" bindtap="onBundleSearchClear">×</text>
      </view>

      <!-- 菲号多选列表 -->
      <view class="bundle-select-list">
        <view wx:if="{{filteredPendingBundles.length === 0}}" class="bundle-select-empty">
          {{bundleSearchKey ? t.noBundleMatch : t.noPendingQcW}}
        </view>
        <view wx:for="{{filteredPendingBundles}}" wx:key="bundleId"
              class="bundle-select-item {{item.selected ? 'bundle-select-item--active' : ''}}"
              data-key="{{item.selectKey}}" bindtap="onToggleBundle">
          <view class="bundle-checkbox {{item.selected ? 'bundle-checkbox--checked' : ''}}">
            <text wx:if="{{item.selected}}" class="bundle-checkbox-icon">✓</text>
          </view>
          <view class="bundle-select-info">
            <view class="bundle-select-row">
              <text class="bundle-select-no">{{item.bundleNoShort}}</text>
              <text class="tag tag-info" wx:if="{{item.qrCode}}">{{item.qrCode}}</text>
            </view>
            <view class="bundle-select-meta">
              <text class="bundle-select-meta-item" wx:if="{{item.color}}">{{t.colorLabel}} {{item.color}}</text>
              <text class="bundle-select-meta-item">{{t.sizeLabel}} {{item.size || '-'}} · {{item.quantity || 0}}{{t.pieceUnit}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 单选质检表单（原弹窗内容移至此） -->
      <block wx:if="{{selectedBundleQrs.length === 1}}">
        <view class="qc-form">
          <view class="qc-form-title">{{t.qualityEntry}}</view>
          <view class="qc-form-info-card">
            <view class="qc-form-info-row"><text class="qc-form-info-label">{{t.bundleWord}}</text><text class="qc-form-info-value">{{qcSheetData.bundleNoShort || qcSheetData.bundleNo || '-'}}</text></view>
            <view class="qc-form-info-row" wx:if="{{qcSheetData.qrCode}}"><text class="qc-form-info-label">{{t.qrWord}}</text><text class="qc-form-info-value">{{qcSheetData.qrCode}}</text></view>
            <view class="qc-form-info-row"><text class="qc-form-info-label">{{t.qcTotalLabel}}</text><text class="qc-form-info-value qc-form-info-strong">{{qcSheetData.quantity}}</text></view>
          </view>
          <view class="qc-form-row">
            <view class="qc-form-col"><text class="qc-form-label">{{t.passQtyLabel}}</text><input class="qc-form-input" type="number" value="{{qcSheetData.qualifiedQty}}" bindinput="onQcQualifiedQtyChange" placeholder="0" /></view>
            <view class="qc-form-col"><text class="qc-form-label">{{t.defectQtyLabel}}</text><input class="qc-form-input" type="number" value="{{qcSheetData.unqualifiedQty}}" bindinput="onQcUnqualifiedQtyChange" placeholder="0" /></view>
          </view>
          <block wx:if="{{qcSheetData.unqualifiedQty > 0}}">
            <view class="qc-form-divider"></view>
            <view class="qc-form-row">
              <view class="qc-form-col"><text class="qc-form-label">{{t.defectCategory}}</text>
                
                  <view bindtap="openPicker" data-handler="onDefectCategoryChange" data-names="defectCategoryOptions" data-range-key="label" class="picker-value {{qcSheetData.defectCategoryLabel ? '' : 'picker-placeholder'}}">{{qcSheetData.defectCategoryLabel ? qcSheetData.defectCategoryLabel : t.selectDefectCatW}}</view>
                
              </view>
              <view class="qc-form-col"><text class="qc-form-label">{{t.handleMethod}}</text>
                
                  <view bindtap="openPicker" data-handler="onDefectRemarkChange" data-names="defectRemarkOptions" data-range-key="label" class="picker-value {{qcSheetData.defectRemark ? '' : 'picker-placeholder'}}">{{qcSheetData.defectRemark ? qcSheetData.defectRemark : t.selectHandleMW}}</view>
                
              </view>
            </view>
            <view class="qc-form-row">
              <view class="qc-form-col-full"><text class="qc-form-label">{{t.remarkOptional}}</text>
                <textarea class="qc-form-textarea" value="{{qcSheetData.remark}}" bindinput="onQcRemarkInput" placeholder="{{t.remarkPhW}}" maxlength="200" />
              </view>
            </view>
            <view class="qc-form-row">
              <view class="qc-form-col-full"><text class="qc-form-label">{{t.photoOptionalHint}}</text>
                <view class="upload-grid">
                  <view wx:for="{{qcSheetData.imageUrls}}" wx:key="*this" class="upload-item">
                    <image class="upload-img" src="{{item}}" mode="aspectFit" data-index="{{index}}" data-url="{{item}}" data-urls="{{qcSheetData.imageUrls}}" bindtap="onQcImagePreview" />
                    <view class="upload-remove" data-index="{{index}}" bindtap="onQcImageRemove">x</view>
                  </view>
                  <view wx:if="{{qcSheetData.imageUrls.length < 5}}" class="upload-add" bindtap="onQcImageAdd">
                    <text class="upload-add-icon">+</text><text class="upload-add-text">{{t.addPhoto}}</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
          <view class="qc-form-actions">
            <button class="btn btn-default-outline btn-block" bindtap="onClearBundles">{{t.cancel}}</button>
            <button class="btn btn-primary-outline btn-block" loading="{{submitting}}" bindtap="onSubmitQc">{{t.submitQc}}</button>
          </view>
        </view>
      </block>

      <!-- 多选批量操作 -->
      <block wx:if="{{selectedBundleQrs.length > 1}}">
        <!-- 批量不合格内联表单 -->
        <block wx:if="{{batchUnqualFormVisible}}">
          <view class="qc-form batch-unqual-form">
            <view class="qc-form-title">{{t.batchFailTitleW}}</view>
            <view class="qc-form-row">
              <view class="qc-form-col"><text class="qc-form-label">{{t.defectCategory}}</text>
                
                  <view bindtap="openPicker" data-handler="onBatchUnqualDefectCategoryChange" data-names="defectCategoryOptions" data-range-key="label" class="picker-value {{batchUnqualData.defectCategoryLabel ? '' : 'picker-placeholder'}}">{{batchUnqualData.defectCategoryLabel ? batchUnqualData.defectCategoryLabel : t.selectDefectCatW}}</view>
                
              </view>
              <view class="qc-form-col"><text class="qc-form-label">{{t.handleMethod}}</text>
                
                  <view bindtap="openPicker" data-handler="onBatchUnqualDefectRemarkChange" data-names="defectRemarkOptions" data-range-key="label" class="picker-value {{batchUnqualData.defectRemark ? '' : 'picker-placeholder'}}">{{batchUnqualData.defectRemark ? batchUnqualData.defectRemark : t.selectHandleMW}}</view>
                
              </view>
            </view>
            <view class="qc-form-actions">
              <button class="btn btn-default-outline btn-block" bindtap="onCancelBatchUnqualified">{{t.cancel}}</button>
              <button class="btn btn-danger-outline btn-block" loading="{{submitting}}" bindtap="onConfirmBatchUnqualified">{{t.batchFailBtn}}</button>
            </view>
          </view>
        </block>
        <!-- 批量操作按钮 -->
        <view class="batch-actions" wx:if="{{!batchUnqualFormVisible}}">
          <button class="btn btn-success-outline btn-block" loading="{{submitting}}" bindtap="onBatchQualified">{{t.batchPassTitle}}</button>
          <button class="btn btn-danger-outline btn-block" loading="{{submitting}}" bindtap="onBatchUnqualified">{{t.batchFailTitleW}}</button>
        </view>
      </block>
    </view>

    <!-- ============ 7. 质检记录列表（保留，入库改为页面内展开） ============ -->
    <view class="detail-card section-records">
      <view class="card-title-row">
        <view class="card-title-with-tag">
          <text class="card-title">{{t.qcRecordsTitle}}</text>
          <text class="card-badge" wx:if="{{qcRecords.length > 0}}">{{qcRecords.length}}</text>
        </view>
        <text class="card-title-hint" wx:if="{{qcRecords.length === 0}}">{{t.noRecordsW}}</text>
      </view>

      <view wx:if="{{recordsLoading && qcRecords.length === 0}}" class="loading-inline">
        <text class="loading-text">{{t.loading}}</text>
      </view>
      <view wx:elif="{{qcRecords.length === 0}}" class="empty-inline">
        <text class="empty-text-inline">{{t.noQcRecordsW}}</text>
      </view>
      <view wx:else class="qc-list">
        <view wx:for="{{qcRecords}}" wx:key="id"
              class="qc-card {{item.isHighlighted ? 'qc-card-highlighted' : ''}} {{item.canWarehouse ? 'qc-card--actionable' : ''}} {{item.canMarkRepaired ? 'qc-card--warning' : ''}}">
          <view class="qc-card-header">
            <view class="qc-card-left">
              <text class="qc-wh-no">{{item.warehousingNo || '-'}}</text>
              <text wx:if="{{item.isHighlighted}}" class="tag tag-current">{{t.currentWord}}</text>
            </view>
            <view class="qc-card-header-right">
              <text class="quality-status {{item.qualityStatusCls}}">{{item.qualityStatusText}}</text>
              <!-- 订单终态（已关单/已完成/已取消/已报废/已归档）时不显示操作按钮 -->
              <block wx:if="{{!order.orderTerminal}}">
                <button wx:if="{{item.canWarehouse}}" class="btn btn-primary-outline btn-sm {{whExpandIndex === index ? 'btn-primary-solid' : ''}}" data-index="{{index}}" bindtap="onOpenWhSheet">{{whExpandIndex === index ? t.collapseTextW : t.inboundBtnW}}</button>
                <button wx:if="{{item.canMarkRepaired}}" class="btn btn-warning-outline btn-sm" data-index="{{index}}" bindtap="onStartRepair">{{t.startRepairBtn}}</button>
                <button wx:if="{{item.repairStatus === 'repairing'}}" class="btn btn-success-outline btn-sm" data-index="{{index}}" bindtap="onCompleteRepair">{{t.finishRepairBtn}}</button>
                <button wx:if="{{item.qualityCategory === 'unqualified' && !item.canMarkRepaired && item.repairStatus !== 'scrapped' && item.repairStatus !== 'repair_done'}}" class="btn btn-danger-outline btn-sm" data-index="{{index}}" bindtap="onScrap">{{t.scrapBtn}}</button>
              </block>
              <text wx:else class="tag tag-default">{{t.orderClosed}}</text>
            </view>
          </view>
          <view class="qc-card-body">
            <view class="qc-row"><text class="qc-label">{{t.bundleWord}}</text><text class="qc-value">{{item.bundleNoShort}}</text></view>
            <view class="qc-row"><text class="qc-label">{{t.colorSizeLabel}}</text><text class="qc-value">{{item.color || '-'}} / {{item.size || '-'}}</text></view>
            <view class="qc-qty-row">
              <view class="qc-qty-item"><text class="qc-qty-label">{{t.qcLabelW}}</text><text class="qc-qty-value">{{item.warehousingQuantity || 0}}</text></view>
              <view class="qc-qty-item"><text class="qc-qty-label">{{t.pass}}</text><text class="qc-qty-value qc-success">{{item.qualifiedQuantity || 0}}</text></view>
              <view class="qc-qty-item"><text class="qc-qty-label">{{t.fail}}</text><text class="qc-qty-value qc-error">{{item.unqualifiedQuantity || 0}}</text></view>
              <view class="qc-qty-item" wx:if="{{item.warehouse}}"><text class="qc-qty-label">{{t.warehouseLabel}}</text><text class="qc-qty-value qc-info">{{item.warehouse}}</text></view>
            </view>
            <view class="qc-row" wx:if="{{item.defectCategoryText}}"><text class="qc-label">{{t.defectCategory}}</text><text class="qc-value qc-error-text">{{item.defectCategoryText}}</text></view>
            <view class="qc-row" wx:if="{{item.defectRemark}}"><text class="qc-label">{{t.handleMethod}}</text><text class="qc-value">{{item.defectRemark}}</text></view>
            <view class="qc-row" wx:if="{{item.remark}}"><text class="qc-label">{{t.remarkLabel}}</text><text class="qc-value">{{item.remark}}</text></view>
            <view class="qc-row"><text class="qc-label">{{t.qcPersonLabel}}</text><text class="qc-value">{{item.qualityOperatorName || item.operatorName || '-'}}</text></view>
            <view class="qc-row" wx:if="{{item.displayTime}}"><text class="qc-label">{{t.qcTimeLabel}}</text><text class="qc-value">{{item.displayTime}}</text></view>
          </view>
          <view wx:if="{{item.imageList.length > 0}}" class="qc-photos">
            <view class="qc-photos-title">{{t.defectPhotos}} ({{item.imageList.length}})</view>
            <view class="photo-grid-3">
              <image wx:for="{{item.imageList}}" wx:for-item="imgUrl" wx:for-index="imgIndex" wx:key="*this"
                     class="defect-photo-img" src="{{imgUrl}}" mode="aspectFit"
                     data-url="{{imgUrl}}" data-idx="{{imgIndex}}" data-rec-idx="{{index}}" data-src="record" bindtap="onPreviewImage" />
            </view>
          </view>

          <!-- 页面内入库表单（记录下方展开，原入库弹窗内容移至此） -->
          <block wx:if="{{whExpandIndex === index}}">
            <view class="wh-form">
              <view class="wh-form-title">{{t.inboundOpTitle}}</view>
              <view class="wh-form-info-card">
                <view class="wh-form-info-row"><text class="wh-form-info-label">{{t.inboundNoLabel}}</text><text class="wh-form-info-value">{{whSheetData.warehousingNo || '-'}}</text></view>
                <view class="wh-form-info-row" wx:if="{{whSheetData.bundleNo}}"><text class="wh-form-info-label">{{t.bundleWord}}</text><text class="wh-form-info-value">{{whSheetData.bundleNo}}</text></view>
                <view class="wh-form-info-row"><text class="wh-form-info-label">{{t.passQtyLabel}}</text><text class="wh-form-info-value wh-form-info-strong">{{whSheetData.qualifiedQty}}</text></view>
              </view>
              <view class="wh-form-divider"></view>
              <!-- D-185：仓库/库位页面内直选（对齐样衣仓库页 chips 风格），废弃底部 picker 弹窗 -->
              <view class="wh-form-col-full">
                <text class="wh-form-label">{{t.selectWhPrefix}}</text>
                <view class="wh-chip-row">
                  <view
                    wx:for="{{warehouseOptions}}"
                    wx:key="id"
                    class="wh-chip {{whSheetData.warehouseAreaId === item.id ? 'wh-chip--active' : ''}}"
                    data-id="{{item.id}}"
                    bindtap="onWarehouseChipTap"
                    hover-class="wh-chip--hover"
                  >{{item.name}}</view>
                  <text wx:if="{{warehouseOptions.length === 0}}" class="wh-chip-empty">{{t.noWhAvailable}}</text>
                </view>
              </view>
              <!-- D-517：库位改可搜索选择（库位常几十上百个，chip 平铺只能一路滚；满库位仍会拦截） -->
              <view class="wh-form-col-full" wx:if="{{whSheetData.warehouseAreaId}}">
                <text class="wh-form-label">{{t.pickLocationW}} ({{locationOptions.length}})：</text>
                <view class="wh-chip-row">
                  <view class="wh-loc-picker" bindtap="openPicker" data-key="location">
                    <text class="wh-loc-picker-value {{whSheetData.warehouseLocationCode ? '' : 'is-placeholder'}}">
                      {{whSheetData.warehouseLocationCode || t.pickLocationW}}
                    </text>
                    <text class="wh-loc-picker-arrow">›</text>
                  </view>
                  <text wx:if="{{locationOptions.length === 0}}" class="wh-chip-empty">{{t.noLocationInWh}}</text>
                </view>
              </view>
              <view class="wh-form-actions">
                <button class="btn btn-default-outline btn-block" data-index="{{index}}" bindtap="onOpenWhSheet">{{t.cancel}}</button>
                <button class="btn btn-primary-outline btn-block" loading="{{submitting}}" bindtap="onSubmitWarehouse">{{t.confirmInbound}}</button>
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- ============ 8. AI 质检助手（保留，可折叠） ============ -->
    <view class="detail-card ai-card {{aiCollapsed ? 'ai-card--collapsed' : ''}}" wx:if="{{aiSuggestion || aiLoading}}">
      <view class="card-title-row" bindtap="onToggleAi">
        <view class="card-title-with-tag">
          <text class="card-title">{{t.aiAssistantTitle}}</text>
          <text class="card-badge card-badge--ai">AI</text>
        </view>
        <text class="card-collapse-icon">{{aiCollapsed ? t.expandTextC : t.collapseTextW}}</text>
      </view>
      <block wx:if="{{!aiCollapsed}}">
        <view wx:if="{{aiLoading}}" class="loading-inline"><text class="loading-text">{{t.aiAnalyzing}}</text></view>
        <block wx:else>
          <view wx:if="{{aiSuggestion.urgentTip}}" class="ai-urgent-tip">
            <text class="urgent-icon">!</text><text class="urgent-text">{{aiSuggestion.urgentTip}}</text>
          </view>
          <view wx:if="{{aiSuggestion.hasHistoricalData}}" class="ai-history-row">
            <view class="history-block">
              <text class="history-label">{{t.histDefectRate}}</text>
              <text class="history-value {{aiSuggestion.historicalVerdictCls}}">{{aiSuggestion.historicalDefectRateText}}</text>
            </view>
            <view wx:if="{{aiSuggestion.historicalVerdictText}}" class="history-block">
              <text class="history-label">{{t.riskLevelLabel}}</text>
              <text class="history-value {{aiSuggestion.historicalVerdictCls}}">{{aiSuggestion.historicalVerdictText}}</text>
            </view>
          </view>
          <view wx:if="{{aiSuggestion.checkpoints.length > 0}}" class="ai-section">
            <view class="ai-section-title">{{t.qcPointsLabel}}</view>
            <view class="tips-list">
              <view wx:for="{{aiSuggestion.checkpoints}}" wx:key="index" class="tip-item">
                <text class="tip-bullet">.</text><text class="tip-text">{{item}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{aiSuggestion.defectList.length > 0}}" class="ai-section">
            <view class="ai-section-title">{{t.defectSuggestion}}</view>
            <view class="defect-advice-list">
              <view wx:for="{{aiSuggestion.defectList}}" wx:key="category" class="defect-advice-item">
                <view class="defect-advice-label">{{item.label}}</view>
                <view class="defect-advice-text">{{item.advice}}</view>
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>

    <!-- ============ 9. BOM 物料（保留，可折叠） ============ -->
    <view class="detail-card {{bomCollapsed ? 'bom-card--collapsed' : ''}}" wx:if="{{bom.length > 0}}">
      <view class="card-title-row" bindtap="onToggleBom">
        <view class="card-title-with-tag">
          <text class="card-title">{{t.tabBom}}</text>
          <text class="card-badge">{{bom.length}}</text>
        </view>
        <text class="card-collapse-icon">{{bomCollapsed ? t.expandTextC : t.collapseTextW}}</text>
      </view>
      <block wx:if="{{!bomCollapsed}}">
        <view class="bom-list">
          <view wx:for="{{bom}}" wx:key="id" class="bom-item">
            <view class="bom-row"><text class="bom-code">{{item.materialCode || '-'}}</text><text class="bom-type-tag">{{item.materialTypeText}}</text></view>
            <text class="bom-name">{{item.materialName || '-'}}</text>
            <view class="bom-meta">
              <text class="bom-meta-item" wx:if="{{item.color}}">{{item.color}}</text>
              <text class="bom-meta-item" wx:if="{{item.size}}">{{item.size}}</text>
              <text class="bom-meta-item">{{t.usageLabelW}} {{item.usageAmount || 0}}{{item.unit || ''}}</text>
              <text class="bom-meta-item" wx:if="{{item.lossRate}}">{{t.lossLabelW}} {{item.lossRate}}%</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    </block>
    <!-- ============ / 质检明细 tab 内容 ============ -->

    <!-- ============ 尺寸表 tab 内容（布局对齐样衣开发详情页：部位为行、尺码为列，横向滚动） ============ -->
    <block wx:if="{{activeTab === 'size'}}">
      <view class="detail-card">
        <view class="card-title-row">
          <view class="card-title-with-tag">
            <text class="card-title">{{t.sizeTableTitle}}</text>
            <text class="card-badge" wx:if="{{sizeRows.length > 0}}">{{sizeRows.length}}</text>
          </view>
          <text class="card-title-hint" wx:if="{{sizeRows.length > 0}}">{{sizeRows.length}}{{t.partsCountW}}</text>
        </view>
        <view wx:if="{{sizeLoading}}" class="loading-inline"><text class="loading-text">{{t.loading}}</text></view>
        <scroll-view scroll-x wx:elif="{{sizeRows.length > 0}}" class="size-scroll" enhanced show-scrollbar="{{false}}">
          <view class="size-table">
            <!-- 表头：部位 | S | M | L | ... -->
            <view class="size-row size-row--head">
              <text class="size-cell size-cell--part">{{t.partHeader}}</text>
              <text wx:for="{{sizeColumns}}" wx:key="*this" class="size-cell size-cell--size">{{item}}</text>
            </view>
            <!-- 数据行：胸围 | 90 | 94 | 98 | ... -->
            <view wx:for="{{sizeRows}}" wx:key="partName" class="size-row">
              <text class="size-cell size-cell--part">{{item.partName}}</text>
              <block wx:for="{{sizeColumns}}" wx:for-item="col" wx:key="*this">
                <text class="size-cell size-cell--val">{{item.values[col]}}</text>
              </block>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="empty-inline">
          <text class="empty-text-inline">{{t.noSizeHint}}</text>
        </view>
      </view>
    </block>
    <!-- ============ / 尺寸表 tab 内容 ============ -->

    <view style="height: 120rpx;"></view>
  </block>
  <privacy-dialog id="privacyDialog" />
  <ai-assistant />

  <!-- D-517：通用可搜索选择器（库位） -->
  <search-picker
    visible="{{pickerVisible}}"
    title="{{pickerTitle}}"
    options="{{pickerOptions}}"
    value="{{pickerValue}}"
    bind:select="onPickerSelect"
    bind:close="onPickerClose"
  />
</view>
