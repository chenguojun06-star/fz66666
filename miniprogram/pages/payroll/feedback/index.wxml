<view class="page">

  <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

  <view wx:if="{{!loading && settlements.length === 0}}" class="empty">
    <view class="empty-icon line-icon line-icon--xl icon-clipboard"></view>
    <text class="empty-text">{{t.emptySettlements}}</text>
  </view>

  <view wx:for="{{settlements}}" wx:key="id" class="settlement-card" bindtap="onSettlementTap" data-id="{{item.id}}" data-no="{{item.settlementNo}}">
    <view class="card-header">
      <text class="settlement-no">{{item.settlementNo || item.id}}</text>
      <view class="feedback-status {{item.feedbackStatus ? 'status-' + item.feedbackStatus : 'status-none'}}">
        <text wx:if="{{!item.feedbackStatus}}">{{t.statusNone}}</text>
        <text wx:elif="{{item.feedbackStatus === 'PENDING'}}">{{t.statusPending}}</text>
        <text wx:elif="{{item.feedbackStatus === 'RESOLVED'}}">{{t.statusResolved}}</text>
        <text wx:elif="{{item.feedbackStatus === 'REJECTED'}}">{{t.statusRejected}}</text>
      </view>
    </view>
    <view class="card-body">
      <view class="order-info">
        <text wx:if="{{item.styleNo}}" class="style-no">{{item.styleNo}}</text>
        <text class="order-no">{{item.orderNo || '-'}}</text>
      </view>
      <view class="amount-row">
        <text class="amount">¥{{item.totalAmount || 0}}</text>
        <text class="quantity">/ {{item.totalQuantity || 0}}{{t.pieceUnit}}</text>
      </view>
    </view>
    <view class="card-footer">
      <text class="time">{{item.createTimeText}}</text>
      <view wx:if="{{!item.feedbackStatus}}" class="feedback-action">
        <text>{{t.tapFeedback}}</text><view class="icon-arrow-right-sm"></view>
      </view>
    </view>
  </view>

  <!-- 页面内反馈表单 -->
  <view wx:if="{{showForm}}" class="inline-form-card">
    <view class="inline-form-title">{{t.submitTitle}}</view>

    <view class="form-group">
      <text class="form-label">{{t.settlementNo}}</text>
      <input class="form-input form-input-readonly" value="{{currentSettlementNo}}" disabled="{{true}}" />
    </view>

    <view class="form-group">
      <text class="form-label">{{t.feedbackType}}</text>
      <radio-group class="radio-group" bindchange="onFeedbackTypeChange">
        <label class="radio-item {{feedbackType === 'CONFIRM' ? 'radio-item-active' : ''}}">
          <radio value="CONFIRM" checked="{{feedbackType === 'CONFIRM'}}" color="var(--color-primary)" />
          <text>{{t.typeConfirm}}</text>
        </label>
        <label class="radio-item {{feedbackType === 'OBJECTION' ? 'radio-item-active' : ''}}">
          <radio value="OBJECTION" checked="{{feedbackType === 'OBJECTION'}}" color="var(--color-warning)" />
          <text>{{t.typeDispute}}</text>
        </label>
      </radio-group>
    </view>

    <view wx:if="{{feedbackType === 'OBJECTION'}}" class="form-group">
      <text class="form-label">{{t.disputeContent}}</text>
      <textarea class="form-textarea" placeholder="{{t.disputePlaceholder}}" value="{{feedbackContent}}" bindinput="onFeedbackContentInput" maxlength="500" />
    </view>

    <view class="form-actions">
      <view class="btn-cancel" hover-class="btn-hover" bindtap="closeForm">{{t.cancel}}</view>
      <view class="btn-submit" hover-class="btn-hover" bindtap="submitFeedback">{{submitting ? t.submitting : t.submitBtn}}</view>
    </view>
  </view>
  <ai-assistant />
</view>
