<view class="page">
  <view class="section">
    <view class="section-title"><view class="line-icon icon-clipboard"></view>{{t.basicInfo}}</view>
    
    <!-- 款号输入 - 带搜索 -->
    <view class="form-item search-input-wrapper">
      <text class="label required">{{t.styleNoLabel}}</text>
      <view class="search-input-container">
        <input 
          class="input search-input" 
          placeholder="{{t.styleNoPlaceholder}}" 
          value="{{styleSearchKeyword}}" 
          bindinput="onStyleNoInput"
          bindfocus="onStyleNoFocus"
          bindblur="onStyleNoBlur"
        />
        <view class="search-loading" wx:if="{{styleSearching}}">
          <text>{{t.searching}}</text>
        </view>
        <view class="clear-icon icon-close" wx:if="{{styleSearchKeyword && !styleSearching}}" bindtap="onStyleNoInput" data-clear="true"></view>
      </view>
      <!-- 款号搜索下拉框 -->
      <view class="search-dropdown" wx:if="{{showStyleDropdown && styleSearchResults.length > 0}}">
        <view 
          class="search-dropdown-item" 
          wx:for="{{styleSearchResults}}" 
          wx:key="styleNo"
          data-item="{{item}}"
          bindtap="selectStyle"
        >
          <view class="dropdown-item-main">{{item.styleNo}}</view>
          <view class="dropdown-item-sub" wx:if="{{item.styleName}}">{{item.styleName}}</view>
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">{{t.styleNameLabel}}</text>
      <input class="input" placeholder="{{t.styleNamePlaceholder}}" value="{{styleName}}" bindinput="onStyleNameInput" />
    </view>
    
    <view class="form-row">
      <view class="form-item half">
        <text class="label required">{{t.orderDateLabel}}</text>
        <picker mode="date" value="{{orderDate}}" bindchange="onOrderDateChange">
          <view class="picker">{{orderDate || t.pleaseSelect}}</view>
        </picker>
      </view>
      <view class="form-item half">
        <text class="label">{{t.deliveryDateLabel}}</text>
        <picker mode="date" value="{{deliveryDate}}" bindchange="onDeliveryDateChange">
          <view class="picker">{{deliveryDate || t.pleaseSelect}}</view>
        </picker>
      </view>
    </view>
    
    <!-- 客户输入 - 带搜索 -->
    <view class="form-item search-input-wrapper">
      <text class="label">{{t.customerLabel}}</text>
      <view class="search-input-container">
        <input 
          class="input search-input" 
          placeholder="{{t.customerPlaceholder}}" 
          value="{{customerSearchKeyword}}" 
          bindinput="onCustomerInput"
          bindfocus="onCustomerFocus"
          bindblur="onCustomerBlur"
        />
        <view class="search-loading" wx:if="{{customerSearching}}">
          <text>{{t.searching}}</text>
        </view>
        <view class="clear-icon icon-close" wx:if="{{customerSearchKeyword && !customerSearching}}" bindtap="onCustomerInput" data-clear="true"></view>
      </view>
      <!-- 客户搜索下拉框 -->
      <view class="search-dropdown" wx:if="{{showCustomerDropdown && customerSearchResults.length > 0}}">
        <view 
          class="search-dropdown-item" 
          wx:for="{{customerSearchResults}}" 
          wx:key="id"
          data-item="{{item}}"
          bindtap="selectCustomer"
        >
          <view class="dropdown-item-main">{{item.name}}</view>
        </view>
      </view>
    </view>
    
    <view class="form-item">
      <text class="label">{{t.categoryLabel}}</text>
      <picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{categoryLabel || t.pleaseSelect}}</view>
      </picker>
    </view>
    
    <view class="form-item">
      <text class="label">{{t.urgencyLabel}}</text>
      <radio-group class="radio-group" bindchange="onUrgencyChange">
        <radio value="normal" checked="{{urgencyLevel === 'normal'}}" />{{t.normalOption}}
        <radio value="urgent" checked="{{urgencyLevel === 'urgent'}}" />{{t.urgencyLabel}}</radio-group>
    </view>
  </view>

  <view class="section">
    <view class="section-title">{{t.producerTitle}}</view>
    <radio-group class="mode-radio-group" bindchange="onFactoryModeChange">
      <label class="mode-radio">
        <radio value="INTERNAL" checked="{{factoryMode === 'INTERNAL'}}" />{{t.internalFactory}}
      </label>
      <label class="mode-radio">
        <radio value="EXTERNAL" checked="{{factoryMode === 'EXTERNAL'}}" />{{t.externalFactory}}
      </label>
    </radio-group>
    
    <view class="form-item" wx:if="{{factoryMode === 'INTERNAL'}}">
      <text class="label required">{{t.orgUnitLabel}}</text>
      <picker range="{{internalUnitOptions}}" range-key="label" value="{{orgUnitIndex}}" bindchange="onOrgUnitChange">
        <view class="picker">{{orgUnitLabel || t.pleaseSelect}}</view>
      </picker>
    </view>
    
    <!-- 外发工厂 - 带搜索 -->
    <view class="form-item" wx:if="{{factoryMode === 'EXTERNAL'}}">
      <text class="label required">{{t.externalFactoryLabel}}</text>
      <view class="search-input-container">
        <input 
          class="input search-input" 
          placeholder="{{t.factorySearchPlaceholder}}" 
          value="{{factorySearchKeyword}}" 
          bindinput="onFactorySearchInput"
        />
      </view>
      <picker range="{{factoryOptions}}" range-key="label" value="{{factoryIndex}}" bindchange="onFactoryChange">
        <view class="picker">{{factoryLabel || t.selectFactoryHint}}</view>
      </picker>
    </view>
  </view>

  <view class="section">
    <view class="section-title"><view class="line-icon icon-camera"></view>{{t.styleImageTitle}}</view>
    <view class="image-upload" bindtap="chooseImage">
      <image wx:if="{{styleImageUrl}}" src="{{styleImageUrl}}" mode="aspectFit" bindtap="previewImage" catchtap="previewImage" />
      <view wx:else class="upload-placeholder">
        <view class="upload-icon line-icon icon-camera"></view>
        <text>{{t.tapUploadImage}}</text>
      </view>
      <view class="delete-image" wx:if="{{styleImageUrl}}" bindtap="deleteImage" catchtap="deleteImage">
        <view class="icon-close"></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">{{t.orderLinesTitle}}</text>
      <text class="add-btn" bindtap="addOrderLine">{{t.addLineBtn}}</text>
    </view>
    <view class="order-lines">
      <view class="order-line" wx:for="{{orderLines}}" wx:key="index">
        <view class="line-item">
          <text class="line-label">{{t.colorLabel}}</text>
          <input class="line-input" placeholder="{{t.requiredPlaceholder}}" value="{{item.color}}" data-index="{{index}}" data-field="color" bindinput="onOrderLineInput" />
        </view>
        <view class="line-item">
          <text class="line-label">{{t.sizeLabel}}</text>
          <input class="line-input" placeholder="{{t.requiredPlaceholder}}" value="{{item.size}}" data-index="{{index}}" data-field="size" bindinput="onOrderLineInput" />
        </view>
        <view class="line-item">
          <text class="line-label">{{t.quantityLabel}}</text>
          <input class="line-input" type="number" placeholder="{{t.requiredPlaceholder}}" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="onOrderLineInput" />
        </view>
        <view class="line-del icon-close" wx:if="{{orderLines.length > 1}}" data-index="{{index}}" bindtap="removeOrderLine"></view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">{{t.remarksLabel}}</view>
    <textarea class="textarea" placeholder="{{t.remarksPlaceholder}}" value="{{remarks}}" bindinput="onRemarksInput" />
  </view>

  <view class="submit-wrap">
    <button class="submit-btn" loading="{{submitting}}" bindtap="submitOrder">{{t.createOrderBtn}}</button>
  </view>
  <ai-assistant />
</view>
