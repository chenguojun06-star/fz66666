<!-- 物料出库表单（通用组件 D-514）
     两个消费方：① 独立页 material-outbound ② 物料中心「出库」tab（内联） -->
<view class="material-outbound-form">

  <!-- ① 物料查询 -->
  <view class="section">
    <view class="section-hd"><text class="section-title">{{t.materialCode}}</text></view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="{{t.inputCodePlaceholder}}"
        value="{{materialCode}}"
        bindinput="onCodeInput"
        confirm-type="search"
        bindconfirm="onQuery"
      />
      <view class="search-btn search-btn--scan" wx:if="{{showScan}}" bindtap="openPicker" data-key="material">{{t.select}}</view>
      <view wx:if="{{showScan}}" class="search-btn search-btn--scan" bindtap="onScan">{{t.scan}}</view>
      <view class="search-btn search-btn--go" bindtap="onQuery">{{t.query}}</view>
    </view>

    <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>
    <block wx:if="{{queried && materialInfo}}">
      <view class="mat-card">
        <text class="mat-name">{{materialInfo.materialName || '—'}}</text>
        <text class="mat-meta">{{t.codeText}}</text>
        <text class="mat-meta">{{t.availableText}}</text>
      </view>
    </block>
    <view wx:elif="{{queried}}" class="empty">{{t.noMaterial}}</view>
  </view>

  <block wx:if="{{queried && materialInfo}}">
    <!-- ② 数量与用途 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.outboundInfo}}</text></view>

      <view class="row">
        <text class="row-label">{{t.quantity}} <text class="req">*</text></text>
        <!-- D-513：手机端步进器（小屏输入数字不便，加减按钮更快） -->
        <view class="qty-stepper">
          <view class="stepper-btn" catchtap="onQtyMinus">-</view>
          <input class="row-input row-input--center" type="digit" placeholder="{{t.qtyPlaceholder}}" value="{{quantity}}" bindinput="onQtyInput" />
          <view class="stepper-btn" catchtap="onQtyPlus">+</view>
        </view>
        <text class="row-unit" wx:if="{{unit}}">{{unit}}</text>
      </view>

      <view class="type-grid">
        <view
          wx:for="{{typeOptions}}"
          wx:key="key"
          class="type-chip {{usageType === item.key ? 'type-chip--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectUsage"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- ③ 必填关联项（后端 7 个必填里的其余 4 个） -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.relatedInfo}}</text></view>

      <!-- ⚠️ 用 picker 而非 wx.showActionSheet：后者 itemList 最多 6 项，
           而订单/工厂/领料人可能有上百条，必然失败 -->
      <view class="row" bindtap="openPicker" data-key="order">
          <text class="row-label">{{t.relatedOrder}} <text class="req">*</text></text>
          <text class="row-value {{orderNo ? '' : 'row-value--placeholder'}}">{{orderNo || t.pleaseSelect}}</text>
          <text class="row-arrow">›</text>
        </view>
      
      <view class="row" wx:if="{{styleNo}}">
        <text class="row-label">{{t.relatedStyleNo}}</text>
        <text class="row-value">{{styleNo}}</text>
      </view>
      <view class="row" bindtap="openPicker" data-key="factory">
          <text class="row-label">{{t.relatedFactory}} <text class="req">*</text></text>
          <text class="row-value {{factoryName ? '' : 'row-value--placeholder'}}">{{factoryName || t.pleaseSelect}}</text>
          <text class="row-arrow">›</text>
        </view>
      
      <view class="row" bindtap="openPicker" data-key="receiver">
          <text class="row-label">{{t.receiver}} <text class="req">*</text></text>
          <text class="row-value {{receiverName ? '' : 'row-value--placeholder'}}">{{receiverName || t.pleaseSelect}}</text>
          <text class="row-arrow">›</text>
        </view>
      
      <view class="row" bindtap="openPicker" data-key="area">
          <text class="row-label">{{t.warehouseArea}}</text>
          <text class="row-value {{warehouseAreaName ? '' : 'row-value--placeholder'}}">
            {{warehouseAreaName || t.pleaseSelect}}
          </text>
          <text class="row-arrow">›</text>
        </view>
      
    </view>

    <!-- ④ 原因 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.outboundReason}}</text></view>
      <textarea
        class="remark"
        placeholder="{{t.optional}}"
        value="{{reason}}"
        bindinput="onReasonInput"
        maxlength="200"
        auto-height
      />
    </view>
  </block>

  <view class="bottom-pad"></view>
</view>

<!-- ⑤ 底部固定提交栏 -->
<view class="submit-bar" wx:if="{{queried && materialInfo}}">
  <view class="submit-summary">
    <text class="submit-count">{{materialCode}}</text>
    <text class="submit-qty">{{t.outboundQtyText}}</text>
  </view>
  <view class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? t.submitting : t.confirmOutbound}}
  </view>
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  remote="{{pickerRemote}}"
  loading="{{pickerLoading}}"
  has-more="{{pickerHasMore}}"
  bind:search="onPickerSearch"
  bind:loadmore="onPickerLoadMore"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
