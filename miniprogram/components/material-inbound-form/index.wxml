<!-- 物料入库表单（通用组件 D-514）
     两个消费方：① 独立页 material-inbound ② 物料中心「入库」tab（内联） -->
<view class="material-inbound-form">

  <!-- ① 物料编码查询 -->
  <view class="section">
    <view class="section-hd"><text class="section-title">{{t.materialCode}}</text></view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="{{t.inputCodePlaceholder}}"
        value="{{materialCode}}"
        bindinput="onCodeInput"
        confirm-type="search"
        bindconfirm="onQuery"
      />
      <view class="search-btn search-btn--scan" wx:if="{{showScan}}" bindtap="openPicker" data-key="material">{{t.select}}</view>
      <view wx:if="{{showScan}}" class="search-btn search-btn--scan" bindtap="onScan">{{t.scan}}</view>
      <view class="search-btn search-btn--go" bindtap="onQuery">{{t.query}}</view>
    </view>

    <view wx:if="{{loading}}" class="loading">{{t.loading}}</view>

    <block wx:if="{{queried}}">
      <view wx:if="{{materialInfo}}" class="mat-card">
        <text class="mat-name">{{materialInfo.materialName || materialInfo.name || '—'}}</text>
        <text class="mat-meta">{{t.codeText}}</text>
        <text class="mat-meta" wx:if="{{typeLabel}}">{{t.typeText}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.color}}">{{t.colorText}}</text>
        <!-- D-514：面料属性**只读展示**，从「物料资料」读取（手机端不需要填写） -->
        <text class="mat-meta" wx:if="{{isFabric && fabricWidth}}">{{t.fabricWidthText}}</text>
        <text class="mat-meta" wx:if="{{isFabric && fabricWeight}}">{{t.fabricWeightText}}</text>
        <text class="mat-meta" wx:if="{{isFabric && fabricComposition}}">{{t.compositionText}}</text>
        <!-- D-514：面料不显示「规格」—— 库里存的是服装码数(XS/S/M/L)，对 面料 没意义。
             PC 端对 面料 走的是「幅宽/克重/成分」，不问码数。 -->
        <text class="mat-meta" wx:if="{{materialInfo.size && !isFabric}}">{{t.specText}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.quantity != null}}">{{t.existingStockText}}</text>
      </view>
      <!-- D-499：没查到库存记录时不能入库 —— 后端 freeInbound 在 stock==null 且未传
           autoCreateStock=true 时会直接抛「物料库存记录不存在」。提示用户先建档，而非让他白填。 -->
      <view wx:else class="empty">{{t.noStockRecord}}</view>
    </block>
  </view>

  <block wx:if="{{queried}}">
    <!-- ② 入库来源（对齐 PC 端 InboundDrawer 的「入库来源」+ 大货入库的 chips） -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.sourceType}}</text></view>
      <view class="type-grid">
        <view
          wx:for="{{sourceTypes}}"
          wx:key="key"
          class="type-chip {{sourceType === item.key ? 'type-chip--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectSourceType"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- ③ 入库信息 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.inboundInfo}}</text></view>

      <view class="row">
        <text class="row-label">{{t.quantity}} <text class="req">*</text></text>
        <!-- D-513：手机端步进器（小屏输入数字不便，加减按钮更快） -->
        <view class="qty-stepper">
          <view class="stepper-btn" catchtap="onQtyMinus">-</view>
          <input
            class="row-input row-input--center"
            type="digit"
            placeholder="{{t.qtyPlaceholder}}"
            value="{{quantity}}"
            bindinput="onQtyInput"
          />
          <view class="stepper-btn" catchtap="onQtyPlus">+</view>
        </view>
        <text class="row-unit" wx:if="{{unit}}">{{unit}}</text>
      </view>

      <!-- ⚠️ picker 而非 wx.showActionSheet（后者 itemList 最多 6 项） -->
      <view class="row" bindtap="openPicker" data-key="area">
        <text class="row-label">{{t.warehouseArea}}</text>
        <text class="row-value {{warehouseAreaName ? '' : 'row-value--placeholder'}}">
          {{warehouseAreaName || t.pleaseSelect}}
        </text>
        <text class="row-arrow">›</text>
      </view>

      <!-- D-514：库位 = **依赖仓库区域的下拉选择**（对齐 PC 端 InboundDrawer：
           先选仓库，库位下拉才可用；PC 上库位是必填项） -->
      <view wx:if="{{warehouseAreaId}}" class="row" bindtap="openPicker" data-key="location">
        <text class="row-label">{{t.location}}</text>
        <text class="row-value {{warehouseLocation ? '' : 'row-value--placeholder'}}">
          {{locationLoading ? t.loading : (warehouseLocation || (locationNames.length ? t.pleaseSelect : t.noLocationInArea))}}
        </text>
        <text class="row-arrow">›</text>
      </view>
      <view wx:else class="row">
        <text class="row-label">{{t.location}}</text>
        <text class="row-value row-value--placeholder">{{t.selectAreaFirst}}</text>
      </view>

      <view class="row">
        <text class="row-label">{{t.supplier}}</text>
        <input class="row-input" placeholder="{{t.optional}}" value="{{supplierName}}" bindinput="onSupplierInput" />
      </view>

      <view class="row">
        <text class="row-label">{{t.price}}</text>
        <input class="row-input" type="digit" placeholder="{{t.optional}}" value="{{unitPrice}}" bindinput="onPriceInput" />
      </view>
    </view>

    <!-- ③ 备注 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">{{t.remark}}</text></view>
      <textarea
        class="remark"
        placeholder="{{t.optional}}"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
        auto-height
      />
    </view>
  </block>

  <view class="bottom-pad"></view>
</view>

<!-- ④ 底部固定提交栏 -->
<view class="submit-bar" wx:if="{{queried}}">
  <view class="submit-summary">
    <text class="submit-count">{{materialCode}}</text>
    <text class="submit-qty">{{t.inboundQtyText}}</text>
  </view>
  <view class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? t.submitting : t.confirmInbound}}
  </view>
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  remote="{{pickerRemote}}"
  loading="{{pickerLoading}}"
  has-more="{{pickerHasMore}}"
  bind:search="onPickerSearch"
  bind:loadmore="onPickerLoadMore"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
