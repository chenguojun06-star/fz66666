/* =====================================================
 * finance-card.wxss — 财务处理页统一卡片样式（全局共享）
 *
 * D-421 起因：物料对账 / 报销 / 工资审批 / 协作任务 4 个页面
 *   各写了一份几乎相同的卡片样式 → 改一处要改四遍，且容易走样。
 *
 * 用法：
 *   @import '/styles/finance-card.wxss';
 *
 * 设计原则（用户明确要求）：
 *   1. 卡片内所有文字**同一字号**（--font-size-sm 13px），
 *      层级只用颜色区分，不靠字号堆"大字"
 *   2. **金额统一用主色蓝**
 *   3. 卡片底部**不再单独占一行**（无分界线、无独立 footer 行），
 *      金额与操作按钮并排放在最后一行
 *   4. 全部使用 design-tokens 变量，禁止硬编码颜色
 * ===================================================== */

/* ===== 列表容器 ===== */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 8px var(--page-padding-x) 16px;
}

/* ===== 卡片主体 ===== */
.order-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  padding: 12px;
  box-sizing: border-box;
  overflow: hidden;
  border-left-width: 3px;
  border-left-color: var(--color-border);
}
.order-card.order-card--warn    { border-left-color: var(--color-warning); }
.order-card.order-card--danger  { border-left-color: var(--color-danger);  }
.order-card.order-card--primary { border-left-color: var(--color-primary); }

/* ===== 主行：封面 + 信息（点击进详情）===== */
.order-main {
  display: flex;
  gap: 12px;
}

.order-cover {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-pic {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
}
.cover-ph-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.order-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* 首行：单号/款号 + 状态标签 */
.info-line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.info-no {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信息行：与 .info-no 同字号，仅颜色区分层级 */
.info-line {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 主信息（操作人 / 供应商 / 申请人）：同字号，加深颜色 */
.info-line--strong {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 弱信息（时间 / 来源 / 备注）：同字号，更浅 */
.info-line--weak {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 异常提示：同字号，警示色 */
.info-line--warn {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  overflow: hidden;
  white-space: nowrap;
}
/* D-421：异常时引导用户问 AI（带上下文提问） */
.info-line--warn-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ask-ai {
  flex-shrink: 0;
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
  background: var(--color-primary-bg);
  border-radius: var(--radius-full);
  padding: 2px 8px;
  line-height: 1.4;
}
.ask-ai:active { opacity: 0.7; }
.info-sep {
  color: var(--color-text-quaternary, var(--color-text-tertiary));
  margin: 0 2px;
}

/* 状态标签 */
.info-badges {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  padding: 0 8px;
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-full);
  color: var(--color-text-white);
  line-height: 1;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ===== 来源标签：样衣 / 大货（用户要求"哪些是样衣 哪些是大货"要明确）===== */
.source-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  padding: 0 7px;
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-full);
  line-height: 1;
  flex-shrink: 0;
  white-space: nowrap;
}
/* 样衣：紫色系 */
.source-chip--sample {
  background: var(--color-purple-bg, #f0effe);
  color: var(--color-purple, #5856d6);
}
/* 大货：蓝色系 */
.source-chip--bulk {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}
/* 裁床（大货流程内的独立环节） */
.source-chip--cutting {
  background: var(--color-info-bg, rgba(90, 200, 250, 0.08));
  color: var(--color-info-700, #0a6ca8);
}

/* ===== 末行：金额（蓝） + 计价说明 + 操作按钮，同一行 ===== */
.card-bottom {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
}
.amount-left {
  display: flex;
  align-items: baseline;
  gap: 1px;
  flex-shrink: 0;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}
.amount-currency {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
}
.amount-num {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: 1;
}
/* 计价说明（数量 × 单价）：占满中间空间，过长省略 */
.amount-right {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮组（贴右） */
.bottom-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 12px;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  line-height: 1;
  white-space: nowrap;
  transition: transform 0.18s ease, opacity 0.18s ease;
}
.action-btn:active { transform: scale(0.96); }
.action-btn--primary {
  background: var(--color-primary);
  color: var(--color-text-white);
}
.action-btn--primary:active { opacity: 0.85; }
.action-btn--ghost {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}
.action-btn--ghost:active { background: var(--color-bg-hover); }
.action-btn--disabled {
  background: var(--color-bg-page);
  color: var(--color-text-quaternary, var(--color-text-tertiary));
}

/* ===== 批量操作条（页面顶部，与卡片内单条按钮职责区分，不重复）===== */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 8px var(--page-padding-x) 0;
  height: 36px;
  background: var(--color-primary-bg);
  border-radius: var(--radius-lg);
}
.batch-bar:active { opacity: 0.8; }
.batch-bar__text {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
}

/* ===== 加载更多 ===== */
.load-more {
  padding: 20px 0;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.load-more.disabled { opacity: 0.7; }
