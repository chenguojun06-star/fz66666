+ * @param {Object} params - 查询参数
+ * @returns {string} 形如 a=1&b=2（空对象返回 ''）
+ */
+function toQuery(params) {
+  if (!params) return '';
+  const parts = [];
+  Object.keys(params).forEach(function (k) {
+    const v = params[k];
+    if (v === undefined || v === null || v === '') return;
+    parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
+  });
+  return parts.join('&');
+}
