<view class="cockpit">

  <view class="status-bar">
    <view class="status-left">
      <view class="live-dot"></view>
      <text class="live-label">LIVE</text>
      <text class="status-time">{{currentTime}}</text>
    </view>
    <text class="alert-tag {{totalWarn > 0 ? 'alert-warn' : 'alert-ok'}}">{{alertText}}</text>
  </view>

  <view class="hero-card">
    <view class="hero-main">
      <text class="hero-label">{{t.todayScanQty}}</text>
      <view class="hero-num-row">
        <text class="hero-num">{{heroScanQty}}</text>
        <text class="hero-unit">{{t.pieceUnit}}</text>
      </view>
      <text class="hero-sub">{{t.scanSubText}}</text>
    </view>
    <view class="hero-divider"></view>
    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-stat-num-lg">{{menuData.inProduction}}</text>
        <text class="hero-stat-label">{{t.doingOrders}}</text>
      </view>
      <view class="hero-stat-div"></view>
      <view class="hero-stat">
        <text class="hero-stat-num-lg">{{factoryList.length}}</text>
        <text class="hero-stat-label">{{t.partnerFactories}}</text>
      </view>
      <view class="hero-stat-div"></view>
      <view class="hero-stat">
        <text class="hero-stat-num-lg hero-stat-num-warn">{{menuData.riskOrders}}</text>
        <text class="hero-stat-label">{{t.riskOrdersW}}</text>
      </view>
    </view>
  </view>

  <view class="quick-stats">
    <view class="quick-stat">
      <text class="quick-stat-label">{{t.todayOrderW}}</text>
      <view class="quick-stat-num-row">
        <text class="quick-stat-num">{{menuData.todayOrders}}</text>
        <text class="quick-stat-unit">{{t.orderUnitW}}</text>
      </view>
      <text class="quick-stat-qty">{{menuExtra.todayOrdersQty}}{{t.pieceUnit}}</text>
    </view>
    <view class="quick-stat-div"></view>
    <view class="quick-stat">
      <text class="quick-stat-label">{{t.todayInboundW}}</text>
      <view class="quick-stat-num-row">
        <text class="quick-stat-num">{{menuData.todayInbound}}</text>
        <text class="quick-stat-unit">{{t.orderUnitW}}</text>
      </view>
      <text class="quick-stat-qty">{{menuExtra.todayInboundQty}}{{t.pieceUnit}}</text>
    </view>
    <view class="quick-stat-div"></view>
    <view class="quick-stat">
      <text class="quick-stat-label">{{t.todayOutboundW}}</text>
      <view class="quick-stat-num-row">
        <text class="quick-stat-num">{{menuData.todayOutbound}}</text>
        <text class="quick-stat-unit">{{t.orderUnitW}}</text>
      </view>
      <text class="quick-stat-qty">{{menuExtra.todayOutboundQty}}{{t.pieceUnit}}</text>
    </view>
  </view>

  <view class="section">
    <view class="card">
      <view class="card-header">
        <view class="live-dot-sm"></view>
        <text class="card-title">{{t.orderOverview}}</text>
      </view>
      <view class="card-body">
        <view class="menu-grid">
          <view class="menu-card {{activeMenu === 'inProduction' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="inProduction">
            <text class="menu-label">{{t.producingW}}</text>
            <view class="menu-num-row">
              <text class="menu-val">{{menuData.inProduction}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.inProductionQty}}{{t.pieceUnit}}</text>
          </view>
          <view class="menu-card {{activeMenu === 'todayOrders' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="todayOrders">
            <text class="menu-label">{{t.todayOrderW}}</text>
            <view class="menu-num-row">
              <text class="menu-val">{{menuData.todayOrders}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.todayOrdersQty}}{{t.pieceUnit}}</text>
          </view>
          <view class="menu-card {{activeMenu === 'todayInbound' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="todayInbound">
            <text class="menu-label">{{t.todayInboundW}}</text>
            <view class="menu-num-row">
              <text class="menu-val">{{menuData.todayInbound}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.todayInboundQty}}{{t.pieceUnit}}</text>
          </view>
          <view class="menu-card {{activeMenu === 'todayOutbound' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="todayOutbound">
            <text class="menu-label">{{t.todayOutboundW}}</text>
            <view class="menu-num-row">
              <text class="menu-val">{{menuData.todayOutbound}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.todayOutboundQty}}{{t.pieceUnit}}</text>
          </view>
          <view class="menu-card menu-card-warn {{activeMenu === 'delayedOrders' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="delayedOrders">
            <text class="menu-label">{{t.delayedOrders2}}</text>
            <view class="menu-num-row">
              <text class="menu-val warn">{{menuData.delayedOrders}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.delayedOrdersQty}}{{t.pieceUnit}}</text>
          </view>
          <view class="menu-card menu-card-warn {{activeMenu === 'riskOrders' ? 'menu-active' : ''}}" bindtap="onMenuTap" data-key="riskOrders">
            <text class="menu-label">{{t.riskOrdersW2}}</text>
            <view class="menu-num-row">
              <text class="menu-val warn">{{menuData.riskOrders}}</text>
              <text class="menu-unit">{{t.orderUnitW}}</text>
            </view>
            <text class="menu-qty">{{menuExtra.riskOrdersQty}}{{t.pieceUnit}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{activeMenu}}">
    <view class="card">
      <view class="card-header">
        <view class="live-dot-sm"></view>
        <text class="card-title">{{activeMenuTitle}}</text>
        <text class="card-badge">{{activeOrders.length}}{{t.orderUnitW}}</text>
        <view class="card-close" bindtap="closeMenu"><view class="icon-close"></view></view>
      </view>
      <view class="card-body">
        <view class="order-row" wx:for="{{activeOrders}}" wx:key="orderNo" data-index="{{index}}" bindtap="onOrderTap">
          <view class="order-cover" wx:if="{{item.styleCoverUrl}}" catchtap="onPreviewCover" data-url="{{item.styleCoverUrl}}">
            <image class="order-cover-img" src="{{item.styleCoverUrl}}" mode="aspectFit" lazy-load />
          </view>
          <view class="order-content">
            <view class="order-top">
              <text class="order-no">{{item.orderNo}}</text>
              <text class="order-progress">{{item.progress}}%</text>
            </view>
            <view class="order-info">
              <text class="order-style">{{item.styleNo}}</text>
              <text class="order-factory">{{item.factoryName || '--'}}</text>
              <text class="order-qty">{{item.orderQuantity}}{{t.pieceUnit}}</text>
              <text class="order-date">{{t.deliveryPrefix}}{{item.plannedEndDate}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{activeOrders.length === 0}}" class="empty-hint">{{t.noOrders}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="card">
      <view class="card-header">
        <view class="live-dot-sm"></view>
        <text class="card-title">{{t.progressNodes}}</text>
        <text class="card-badge">{{t.tapExpand}}</text>
      </view>
      <view class="card-body">
        <view class="stage-grid">
          <view class="stage-card {{activeStage === item.key ? 'stage-active' : ''}}" wx:for="{{stageBuckets}}" wx:key="key" bindtap="onStageTap" data-key="{{item.key}}">
            <view class="stage-head">
              <text class="stage-name">{{item.label}}</text>
              <text class="stage-count">{{item.count}}{{t.orderUnitW}}</text>
            </view>
            <text class="stage-qty">{{item.quantity}}{{t.pieceUnit}}</text>
            <view class="stage-foot" wx:if="{{item.leadOrderNo}}">
              <text class="stage-lead">{{item.leadOrderNo}}</text>
              <text class="stage-lead-prog">{{item.leadProgress}}%</text>
            </view>
            <text class="stage-empty" wx:else>{{t.noneWord}}</text>
          </view>
        </view>

        <view class="stage-detail" wx:if="{{activeStage}}">
          <view class="stage-detail-head">
            <text class="stage-detail-title">{{activeStageLabel}}</text>
            <view class="card-close" bindtap="closeStage"><view class="icon-close"></view></view>
          </view>
          <view class="order-row" wx:for="{{activeStageOrders}}" wx:key="orderNo" data-index="{{index}}" bindtap="onStageOrderTap">
            <view class="order-cover" wx:if="{{item.styleCoverUrl}}" catchtap="onPreviewCover" data-url="{{item.styleCoverUrl}}">
              <image class="order-cover-img" src="{{item.styleCoverUrl}}" mode="aspectFit" lazy-load />
            </view>
            <view class="order-content">
              <view class="order-top">
                <text class="order-no">{{item.orderNo}}</text>
                <text class="order-progress">{{item.progress}}%</text>
              </view>
              <view class="order-info">
                <text class="order-style">{{item.styleNo}}</text>
                <text class="order-factory">{{item.factoryName || '--'}}</text>
                <text class="order-qty">{{item.orderQuantity}}{{t.pieceUnit}}</text>
                <text class="order-date">{{t.deliveryPrefix}}{{item.plannedEndDate}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{activeStageOrders.length === 0}}" class="empty-hint">{{t.noWipInStage}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="card">
      <view class="card-header">
        <view class="live-dot-sm green"></view>
        <text class="card-title">{{t.navTitle}}</text>
        <text class="card-badge">{{factoryList.length}} / {{factoryTotalOrders}}</text>
      </view>
      <view class="card-body">
        <view class="factory-summary">
          <text class="factory-summary-item">{{factoryOnline}}{{t.onlineW}}</text>
          <text class="factory-summary-item warn" wx:if="{{factoryStagnant > 0}}">{{factoryStagnant}}{{t.stagnantW}}</text>
          <text class="factory-summary-item">{{factoryTotalOrders}}{{t.orderUnitW}} {{factoryTotalQty}}{{t.pieceUnit}}</text>
        </view>
        <!-- D-513：工厂筛选栏（名称搜索 + 在线/异常切换）-->
        <view class="factory-filter-row">
          <input class="factory-filter-input" placeholder="{{t.searchFactoryPh}}" value="{{factoryKeyword}}" bindinput="onFactoryKeywordInput" />
          <view class="factory-filter-tabs">
            <view class="filter-tab {{factoryStatusFilter === 'ALL' ? 'filter-tab--active' : ''}}" data-value="ALL" bindtap="onFactoryStatusChange">{{t.allWord}}</view>
            <view class="filter-tab {{factoryStatusFilter === 'ONLINE' ? 'filter-tab--active' : ''}}" data-value="ONLINE" bindtap="onFactoryStatusChange">{{t.onlyOnline}}</view>
            <view class="filter-tab {{factoryStatusFilter === 'RISK' ? 'filter-tab--active' : ''}}" data-value="RISK" bindtap="onFactoryStatusChange">{{t.onlyAbnormal}}</view>
          </view>
        </view>
        <view class="factory-row" wx:for="{{factoryList}}" wx:key="factoryName">
          <view class="factory-dot {{item.active ? 'dot-active' : 'dot-idle'}}"></view>
          <text class="factory-name">{{item.factoryName}}</text>
          <text class="factory-orders">{{item.activeOrders}}{{t.orderUnitW}}</text>
          <text class="factory-qty">{{item.totalQty}}{{t.pieceUnit}}</text>
          <text class="factory-risk" wx:if="{{item.atRiskCount > 0}}">{{item.atRiskCount}}{{t.riskSuffix}}</text>
          <text class="factory-risk" wx:if="{{item.overdueCount > 0}}">{{item.overdueCount}}{{t.overdueSuffix}}</text>
          <text class="factory-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>
        <view wx:if="{{factoryList.length === 0 && factoryTotalOrders > 0}}" class="empty-hint">{{t.noFactoryFilter}}</view>
        <view wx:if="{{factoryList.length === 0 && factoryTotalOrders === 0}}" class="empty-hint">{{t.noFactoryData}}</view>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">{{t.autoRefreshFmt}}{{lastRefreshTime}}</text>
  </view>

  <ai-assistant />

</view>
