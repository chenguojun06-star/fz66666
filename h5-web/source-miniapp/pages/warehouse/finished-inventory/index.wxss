@import '/styles/modal-form.wxss';

/**
 * 成品库存页 — 统一卡片风格
 * 原生导航栏（不使用 custom-nav）
 * 卡片用 box-shadow + var(--radius-card)，无 border 外框
 */

page {
  background: var(--color-bg-page);
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
}

.container {
  min-height: 100vh;
}

/* ============ 统计卡片 ============ */
.stats-row {
  display: flex;
  gap: 8px;
  padding: 12px 0;
}

.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  /* D-513：原 14px 8px 偏松 → 降为 10px 6px */
  padding: 10px 6px;
  box-sizing: border-box;
}

.stat-value {
  /* D-513：原 3xl(22px) 偏大，用户反馈"卡片字太大"→ 降为 xl(18px) */
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat-value--success {
  color: var(--color-success);
}

.stat-value--danger {
  color: var(--color-danger);
}

.stat-label {
  margin-top: 4px;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

/* ============ 筛选器（picker 行）：已迁移到 sticky-search-bar 的 filter slot ============ */
.filter-pickers {
  display: flex;
  align-items: center;
  gap: 8px;
}

.filter-picker {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  padding: 0 10px;
  height: 32px;
  flex: 1;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.filter-picker-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-picker-arrow {
  font-size: var(--font-size-xxs);
  color: var(--color-text-tertiary);
}

/* ============ 加载/空状态 ============ */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 12px;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}

.empty-icon {
  /* D-513：原 48px 过大 → 降为 36px */
  font-size: 36px;
  opacity: 0.3;
}

.empty-text {
  margin-top: 12px;
  font-size: var(--font-size-md-lg);
  color: var(--color-text-secondary);
}

.empty-sub {
  margin-top: 4px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ============ 列表 ============ */
.list-wrap {
  padding: 0;
}

/* 卡片：与 dashboard/order-card 完全一致 */
.inventory-item {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  /* D-513：再缩，用户要求列表卡片砍掉约 1/3 高度 */
  margin-bottom: 8px;
  overflow: hidden;
  padding: 8px;
  box-sizing: border-box;
  transition: transform 0.18s ease, background-color 0.18s ease;
}

.inventory-item--hover {
  box-shadow: var(--shadow-md);
}

/* 头部 */
.item-header {
  display: flex;
  /* D-513：12px → 8px */
  gap: 8px;
}

.item-image {
  /* D-513：80→56→44，用户要求列表卡片再砍掉约 1/3 高度 */
  width: 44px;
  height: 44px;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.item-image--placeholder {
  background: var(--color-primary-bg);
}

.item-image-text {
  /* D-513：原 3xl(22px) 偏大（图缩到56后字更要跟上）→ 降为 xl(18px) */
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.item-style-no {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.item-style-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.item-order {
  margin-top: 6px;
  display: flex;
  align-items: center;
}

.item-order-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.item-order-value {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.item-tags {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.item-tag {
  font-size: var(--font-size-2xs);
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  line-height: 1.4;
}

.item-tag--factory {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.item-tag--success {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.item-tag--danger {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

/* 主体：数量4列，border-top 分隔 */
.item-body {
  /* D-513：12px → 8px */
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--color-border);
}

.item-qty-row {
  display: flex;
  justify-content: space-between;
}

.qty-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qty-value {
  /* D-513：xl(18) → lg(16) → md(14) */
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.qty-value--muted {
  color: var(--color-text-tertiary);
}

.qty-value--danger {
  color: var(--color-danger);
}

.qty-value--info {
  color: var(--color-primary);
}

.qty-label {
  /* D-513：4px → 2px */
  margin-top: 2px;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

.item-meta {
  /* D-513：10px → 6px */
  margin-top: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.meta-arrow {
  font-size: var(--font-size-md);
  color: var(--color-text-quaternary);
}

/* 右侧操作区（出库按钮 + 箭头） */
.item-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* 列表直接出库按钮（D-418） */
.outbound-btn {
  font-size: var(--font-size-xs);
  font-weight: 600;
  padding: 4px 12px;
  border-radius: var(--radius-lg);
  color: var(--color-primary);
  background: transparent;
  border: 1.5px solid var(--color-primary);
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}
.outbound-btn:active {
  background: var(--color-primary-bg);
}

/* ============ 加载更多 ============ */
.load-more {
  text-align: center;
  padding: 16px 0;
}

.load-more-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-quaternary);
}

.modal-content--bottom {
  width: 100%;
  max-height: 70vh;
  background: var(--color-bg-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid var(--color-border);
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.modal-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
}

.detail-header {
  padding: 12px 16px;
  border-bottom: 1px solid var(--color-border);
}

.detail-style {
  font-size: var(--font-size-md-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.detail-order {
  display: block;
  margin-top: 4px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.detail-scroll {
  flex: 1;
  padding: 0 16px 16px;
  max-height: 50vh;
}

.sku-table {
  margin-top: 8px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.sku-row {
  display: flex;
  align-items: center;
  padding: 10px 8px;
}

.sku-row + .sku-row {
  border-top: 1px solid var(--color-border);
}

.sku-row--header {
  background: var(--color-bg-page);
}

.sku-row--header .sku-cell {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
}

.sku-cell {
  font-size: var(--font-size-xs);
  color: var(--color-text-primary);
  text-align: center;
}

.sku-cell--color {
  flex: 1.2;
  text-align: left;
  padding-left: 4px;
}

.sku-cell--size {
  flex: 1;
}

.sku-cell--qty {
  flex: 0.9;
}

.sku-cell--price {
  flex: 1;
  text-align: right;
  padding-right: 4px;
}

.sku-cell--danger {
  color: var(--color-danger);
}

.sku-empty {
  padding: 40px 0;
  text-align: center;
}

.sku-empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* D-496：列表「入库」按钮（次要样式，与「出库」主色描边区分） */
.outbound-btn--plain {
  margin-right: 8px;
  color: var(--color-text-secondary, #666);
  border-color: var(--color-border-strong, #ccc);
}
.outbound-btn--plain:active {
  background: var(--color-bg-page, #f5f5f5);
}

/* D-513：SKU 明细列表（同一款的多 SKU 展开显示） */
.sku-detail {
  margin: 8rpx 0 12rpx;
  padding: 12rpx 14rpx;
  background: #fafbfc;
  border-radius: 8rpx;
  border: 1rpx solid #eef0f3;
}
.sku-detail-title {
  font-size: 22rpx;
  color: var(--color-text-secondary, #666);
  margin-bottom: 8rpx;
}
.sku-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 24rpx;
}
.sku-label {
  flex: 1;
  min-width: 0;
}
.sku-text {
  color: var(--color-text-primary, #333);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sku-text--empty {
  color: var(--color-text-tertiary, #999);
  font-style: italic;
}
.sku-numbers {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}
.sku-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary, #333);
}
.sku-num--danger {
  color: var(--color-danger, #e54545);
}
.sku-num-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary, #999);
  margin-right: 10rpx;
}
