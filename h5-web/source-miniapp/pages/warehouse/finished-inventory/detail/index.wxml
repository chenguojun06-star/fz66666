<view class="container">
  <!-- 加载 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{skuList.length > 0 || activeTab === 'inbound'}}">
    <!-- 款式信息 -->
    <view class="section-card style-card">
      <image wx:if="{{styleImage}}" src="{{styleImage}}" mode="aspectFit" class="style-image" />
      <view wx:else class="style-image style-image--placeholder">
        <text class="style-image-text">衣</text>
      </view>
      <view class="style-info">
        <text class="style-no">{{styleNo}}</text>
        <text class="style-name">{{styleName || '-'}}</text>
        <view class="style-meta">
          <text wx:if="{{factoryName}}" class="meta-tag">{{factoryName}}</text>
          <text wx:if="{{orderNo}}" class="meta-sub">订单：{{orderNo}}</text>
        </view>
      </view>
    </view>

    <!-- 操作：入库（D-482：手机端此前完全没有入库入口，只能回 PC 端操作） -->
    <view class="action-row">
      <view class="action-btn action-btn--primary" bindtap="onGoInbound">入库</view>
    </view>

    <!-- 统计卡片 -->
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-value">{{summary.totalAvailable}}</text>
        <text class="stat-label">可用库存</text>
      </view>
      <view class="stat-card">
        <text class="stat-value stat-value--muted">{{summary.totalLocked}}</text>
        <text class="stat-label">锁定</text>
      </view>
      <view class="stat-card">
        <text class="stat-value stat-value--danger">{{summary.totalDefect}}</text>
        <text class="stat-label">次品</text>
      </view>
      <view class="stat-card">
        <text class="stat-value stat-value--info">{{summary.totalInbound}}</text>
        <text class="stat-label">累计入库</text>
      </view>
    </view>

    <!-- Tab 切换 -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'sku' ? 'tab-item--active' : ''}}" bindtap="onSwitchTab" data-tab="sku">
        <text class="tab-text">商品编码明细</text>
      </view>
      <view class="tab-item {{activeTab === 'inbound' ? 'tab-item--active' : ''}}" bindtap="onSwitchTab" data-tab="inbound">
        <text class="tab-text">入库记录</text>
        <text wx:if="{{inboundHistory.length > 0}}" class="tab-badge">{{inboundHistory.length}}</text>
      </view>
    </view>

    <!-- SKU 明细 Tab -->
    <view wx:if="{{activeTab === 'sku'}}" class="section-card">
      <view class="card-header">
        <text class="card-title">商品编码明细</text>
        <text class="card-count">{{skuList.length}}个</text>
      </view>

      <scroll-view scroll-x class="sku-scroll" enhanced show-scrollbar="{{false}}">
        <view class="sku-table">
          <view class="sku-row sku-row--header">
            <!-- D-513：加「商品编码」列（用户要求必须列上） -->
            <text class="sku-cell sku-cell--code">商品编码</text>
            <text class="sku-cell sku-cell--color">颜色</text>
            <text class="sku-cell sku-cell--size">尺码</text>
            <text class="sku-cell sku-cell--qty">可用</text>
            <text class="sku-cell sku-cell--qty">次品</text>
            <!-- D-513：去掉「累计入库」列（顶部统计已有） -->
            <text class="sku-cell sku-cell--price">售价</text>
            <text class="sku-cell sku-cell--loc">库位</text>
            <text class="sku-cell sku-cell--action">操作</text>
          </view>
          <view wx:for="{{skuList}}" wx:key="id" class="sku-row">
            <text class="sku-cell sku-cell--code">{{item.sku || '-'}}</text>
            <text class="sku-cell sku-cell--color">{{item.color}}</text>
            <text class="sku-cell sku-cell--size">{{item.size}}</text>
            <text class="sku-cell sku-cell--qty sku-cell--bold">{{item.availableQty}}</text>
            <text class="sku-cell sku-cell--qty sku-cell--danger">{{item.defectQty}}</text>
            <!-- D-513：售价为空显示"-"（实测一半 SKU 未定价，原来显示空白） -->
            <text class="sku-cell sku-cell--price">
              <block wx:if="{{item.salesPrice}}">¥{{item.salesPrice}}</block>
              <block wx:else>-</block>
            </text>
            <text class="sku-cell sku-cell--loc">{{item.warehouseLocation}}</text>
            <view class="sku-cell sku-cell--action">
              <view wx:if="{{item.availableQty > 0}}" class="outbound-btn" catchtap="onOutbound" data-sku="{{item}}">出库</view>
              <text wx:else class="outbound-btn--disabled">无库存</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 入库记录 Tab -->
    <view wx:if="{{activeTab === 'inbound'}}" class="section-card">
      <view class="card-header">
        <text class="card-title">入库记录</text>
        <text class="card-count">{{inboundHistory.length}}条</text>
      </view>

      <view wx:if="{{inboundLoading}}" class="loading-wrap loading-wrap--small">
        <view class="loading-spinner loading-spinner--small"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:elif="{{inboundHistory.length === 0}}" class="empty-wrap empty-wrap--small">
        <text class="empty-text">暂无入库记录</text>
      </view>

      <view wx:else class="inbound-list">
        <view wx:for="{{inboundHistory}}" wx:key="id" class="inbound-item">
          <!-- D-513：用户反馈"信息没用砍掉一半高度" → 6 行字段合并成 1 行紧凑布局
               只保留 4 个核心信息：菲号、规格、数量、时间（操作人/库位/质检单号去掉） -->
          <view class="inbound-line">
            <text class="inbound-no">{{item.cuttingBundleNo}}</text>
            <text class="inbound-spec" wx:if="{{item.color || item.size}}">{{item.color}}/{{item.size}}</text>
            <text class="inbound-qty">{{item.quantity}}件</text>
            <text class="inbound-time">{{item.inboundDate}}</text>
          </view>
        </view>
      </view>

      <!-- 对账信息：一行紧凑展示 -->
      <view wx:if="{{inboundHistory.length > 0}}" class="reconcile-summary">
        <text>入库 <text class="reconcile-strong">{{inboundTotalQty}}</text>件 · 可用 <text class="reconcile-strong reconcile-strong--success">{{summary.totalAvailable}}</text> · 次品 <text class="reconcile-strong reconcile-strong--danger">{{summary.totalDefect}}</text></text>
      </view>
    </view>
  </block>

  <view wx:else class="empty-wrap">
    <text class="empty-text">暂无库存数据</text>
  </view>

  <!-- D-489：出库弹窗已移除 —— 出库改为跳独立页面 pages/warehouse/finished-outbound
       （弹窗面积小、手机上难操作，且无法批量选择、缺类型/仓库/客户等必填字段） -->
  <ai-assistant />
</view>
