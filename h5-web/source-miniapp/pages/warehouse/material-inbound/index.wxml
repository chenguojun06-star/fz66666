<!-- 物料入库页：手机端此前只有扫码发料/退回，没有手工入库入口 -->
<view class="page">

  <!-- ① 物料编码查询 -->
  <view class="section">
    <view class="section-hd"><text class="section-title">物料编码</text></view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="输入物料编码"
        value="{{materialCode}}"
        bindinput="onCodeInput"
        confirm-type="search"
        bindconfirm="onQuery"
      />
      <view class="search-btn search-btn--scan" bindtap="onScan">扫码</view>
      <view class="search-btn search-btn--go" bindtap="onQuery">查询</view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:if="{{queried}}">
      <view wx:if="{{materialInfo}}" class="mat-card">
        <text class="mat-name">{{materialInfo.materialName || materialInfo.name || '—'}}</text>
        <text class="mat-meta">编码 {{materialInfo.materialCode || materialCode}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.materialType}}">类型 {{materialInfo.materialType}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.color}}">颜色 {{materialInfo.color}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.size}}">规格 {{materialInfo.size}}</text>
        <text class="mat-meta" wx:if="{{materialInfo.quantity != null}}">现有库存 {{materialInfo.quantity}}{{unit}}</text>
      </view>
      <view wx:else class="empty">未查到该物料，可直接填写编码入库</view>
    </block>
  </view>

  <block wx:if="{{queried}}">
    <!-- ② 入库信息 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">入库信息</text></view>

      <view class="row">
        <text class="row-label">数量 <text class="req">*</text></text>
        <input
          class="row-input"
          type="digit"
          placeholder="支持小数，如 1.32"
          value="{{quantity}}"
          bindinput="onQtyInput"
        />
        <text class="row-unit" wx:if="{{unit}}">{{unit}}</text>
      </view>

      <!-- ⚠️ picker 而非 wx.showActionSheet（后者 itemList 最多 6 项） -->
      <picker mode="selector" range="{{areaNames}}" bindchange="onAreaChange">
        <view class="row">
          <text class="row-label">仓库区域</text>
          <text class="row-value {{warehouseAreaName ? '' : 'row-value--placeholder'}}">
            {{warehouseAreaName || '请选择'}}
          </text>
          <text class="row-arrow">›</text>
        </view>
      </picker>

      <view class="row">
        <text class="row-label">库位</text>
        <input class="row-input" placeholder="选填" value="{{warehouseLocation}}" bindinput="onLocationInput" />
      </view>

      <view class="row">
        <text class="row-label">供应商</text>
        <input class="row-input" placeholder="选填" value="{{supplierName}}" bindinput="onSupplierInput" />
      </view>

      <view class="row">
        <text class="row-label">单价</text>
        <input class="row-input" type="digit" placeholder="选填" value="{{unitPrice}}" bindinput="onPriceInput" />
      </view>
    </view>

    <!-- ③ 备注 -->
    <view class="section">
      <view class="section-hd"><text class="section-title">备注</text></view>
      <textarea
        class="remark"
        placeholder="选填"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
        auto-height
      />
    </view>
  </block>

  <view class="bottom-pad"></view>
</view>

<!-- ④ 底部固定提交栏 -->
<view class="submit-bar" wx:if="{{queried}}">
  <view class="submit-summary">
    <text class="submit-count">{{materialCode}}</text>
    <text class="submit-qty">入库 {{quantity || 0}}{{unit}}</text>
  </view>
  <view class="submit-btn {{submitting ? 'submit-btn--disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? '提交中…' : '确认入库'}}
  </view>
</view>
