/* 成品出库页 —— 独立页面版（原弹窗方案废弃：面积小、手机难操作）
   规范：字号 12/13/14/16/20；圆角 4/6/8；间距 8pt 网格 */

.page {
  padding: var(--space-12, 12rpx) var(--space-12, 12rpx) 0;
  box-sizing: border-box;
}

/* ── ① 顶部款号卡片 ── */
.header-card {
  display: flex;
  padding: var(--space-16, 16rpx);
  background: var(--color-bg-card, #fff);
  border-radius: var(--radius-lg, 8px);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--space-12, 12rpx);
}
.header-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm, 4px);
  flex-shrink: 0;
  background: var(--color-bg-page, #f5f5f5);
}
.header-img--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--color-text-disabled, #bbb);
}
.header-info {
  flex: 1;
  margin-left: var(--space-12, 12rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.header-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text-primary, #1d1d1f);
  margin-bottom: var(--space-4, 4rpx);
}
.header-sub {
  font-size: 12px;
  color: var(--color-text-secondary, #666);
  line-height: 1.6;
}

/* ── 区块通用 ── */
.section {
  background: var(--color-bg-card, #fff);
  border-radius: var(--radius-lg, 8px);
  box-shadow: var(--shadow-sm);
  padding: var(--space-16, 16rpx);
  margin-bottom: var(--space-12, 12rpx);
}
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-12, 12rpx);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-primary, #1d1d1f);
}

/* ── ② 出库类型 chips ── */
.type-grid {
  display: flex;
  flex-wrap: wrap;
}
.type-chip {
  padding: var(--space-8, 8rpx) var(--space-16, 16rpx);
  margin: 0 var(--space-8, 8rpx) var(--space-8, 8rpx) 0;
  font-size: 13px;
  color: var(--color-text-secondary, #666);
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
  border: 1rpx solid transparent;
}
.type-chip--active {
  color: var(--color-primary, #2d7ff9);
  background: var(--color-primary-bg, #e8f2ff);
  border-color: var(--color-primary, #2d7ff9);
  font-weight: 600;
}

/* ── ③④ 行（仓库区域 / 客户）── */
.row {
  display: flex;
  align-items: center;
  padding: var(--space-12, 12rpx) 0;
  border-bottom: 1rpx solid var(--color-border, #eee);
}
.row:last-child { border-bottom: none; }
.row-label {
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  width: 180rpx;
  flex-shrink: 0;
}
.req { color: var(--color-danger, #e5433d); }
.row-value {
  flex: 1;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  text-align: right;
}
.row-value--placeholder { color: var(--color-text-disabled, #bbb); }
.row-arrow {
  margin-left: var(--space-8, 8rpx);
  font-size: 16px;
  color: var(--color-text-disabled, #bbb);
}

/* ── ⑤ SKU 多选列表 ── */
.select-all { display: flex; align-items: center; }
.select-all-text {
  font-size: 13px;
  color: var(--color-primary, #2d7ff9);
  margin-left: var(--space-4, 4rpx);
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border-strong, #ccc);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.checkbox--sm { width: 32rpx; height: 32rpx; }
.check-mark {
  font-size: 12px;
  color: var(--color-primary, #2d7ff9);
  font-weight: 700;
}
.sku-item {
  padding: var(--space-12, 12rpx) 0;
  border-bottom: 1rpx solid var(--color-border, #eee);
}
.sku-item:last-child { border-bottom: none; }
.sku-item--disabled { opacity: 0.45; }
.sku-main { display: flex; align-items: center; }
.sku-text {
  flex: 1;
  margin-left: var(--space-12, 12rpx);
  min-width: 0;
}
.sku-name {
  display: block;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
}
.sku-meta {
  display: block;
  font-size: 12px;
  color: var(--color-text-secondary, #666);
  margin-top: var(--space-4, 4rpx);
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
  margin-top: var(--space-12, 12rpx);
  padding-left: 52rpx;
}
.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 20px;
  color: var(--color-text-primary, #1d1d1f);
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
}
.stepper-input {
  width: 120rpx;
  height: 64rpx;
  margin: 0 var(--space-8, 8rpx);
  text-align: center;
  font-size: 14px;
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
}

/* ── ⑥ 备注 ── */
.remark {
  width: 100%;
  min-height: 120rpx;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  box-sizing: border-box;
}

.loading, .empty {
  padding: var(--space-24, 24rpx) 0;
  text-align: center;
  font-size: 13px;
  color: var(--color-text-disabled, #bbb);
}

/* 底部提交栏占位（避免内容被固定栏遮住） */
.bottom-pad { height: 180rpx; }

/* ── ⑦ 底部固定提交栏 ── */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: var(--space-12, 12rpx) var(--space-16, 16rpx);
  padding-bottom: calc(var(--space-12, 12rpx) + env(safe-area-inset-bottom));
  background: var(--color-bg-card, #fff);
  box-shadow: var(--shadow-md);
  z-index: 100;
}
.submit-summary { flex: 1; }
.submit-count {
  display: block;
  font-size: 13px;
  color: var(--color-text-secondary, #666);
}
.submit-qty {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-primary, #2d7ff9);
}
.submit-btn {
  padding: var(--space-12, 12rpx) var(--space-32, 32rpx);
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary, #2d7ff9);
  border-radius: var(--radius-lg, 8px);
}
.submit-btn--disabled { opacity: 0.6; }
