/* 成品入库页 —— 独立页面（手机端此前无入库入口）
   规范：字号 12/13/14/16/20；圆角 4/6/8；间距 8pt 网格
   版式与 finished-outbound 保持一致，额外增加查询区样式 */

.page {
  padding: var(--space-12, 12rpx) var(--space-12, 12rpx) 0;
  box-sizing: border-box;
}

.section {
  background: var(--color-bg-card, #fff);
  border-radius: var(--radius-lg, 8px);
  box-shadow: var(--shadow-sm);
  padding: var(--space-16, 16rpx);
  margin-bottom: var(--space-12, 12rpx);
}
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-12, 12rpx);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-primary, #1d1d1f);
}

/* ── ① 查询区 ── */
.search-row { display: flex; align-items: center; }
.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--space-12, 12rpx);
  font-size: 14px;
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
  min-width: 0;
}
.search-btn {
  margin-left: var(--space-8, 8rpx);
  padding: 0 var(--space-16, 16rpx);
  height: 72rpx;
  line-height: 72rpx;
  font-size: 14px;
  border-radius: var(--radius-sm, 4px);
  flex-shrink: 0;
}
.search-btn--scan {
  color: var(--color-text-secondary, #666);
  background: var(--color-bg-page, #f5f5f5);
}
.search-btn--go {
  color: #fff;
  background: var(--color-primary, #2d7ff9);
  font-weight: 600;
}
.style-name {
  display: block;
  margin-top: var(--space-12, 12rpx);
  font-size: 13px;
  color: var(--color-text-secondary, #666);
}

/* ── ② 类型 chips ── */
.type-grid { display: flex; flex-wrap: wrap; }
.type-chip {
  padding: var(--space-8, 8rpx) var(--space-16, 16rpx);
  margin: 0 var(--space-8, 8rpx) var(--space-8, 8rpx) 0;
  font-size: 13px;
  color: var(--color-text-secondary, #666);
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
  border: 1rpx solid transparent;
}
.type-chip--active {
  color: var(--color-primary, #2d7ff9);
  background: var(--color-primary-bg, #e8f2ff);
  border-color: var(--color-primary, #2d7ff9);
  font-weight: 600;
}

/* ── ③ 仓库行 ── */
.row {
  display: flex;
  align-items: center;
  padding: var(--space-12, 12rpx) 0;
  border-bottom: 1rpx solid var(--color-border, #eee);
}
.row:last-child { border-bottom: none; }
.row-label {
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  width: 160rpx;
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  text-align: right;
}
.row-value--placeholder { color: var(--color-text-disabled, #bbb); }
.row-input {
  flex: 1;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  text-align: right;
}
.row-arrow {
  margin-left: var(--space-8, 8rpx);
  font-size: 16px;
  color: var(--color-text-disabled, #bbb);
}

/* ── ④ SKU 多选 ── */
.select-all { display: flex; align-items: center; }
.select-all-text {
  font-size: 13px;
  color: var(--color-primary, #2d7ff9);
  margin-left: var(--space-4, 4rpx);
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border-strong, #ccc);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.checkbox--sm { width: 32rpx; height: 32rpx; }
.check-mark {
  font-size: 12px;
  color: var(--color-primary, #2d7ff9);
  font-weight: 700;
}
.sku-item {
  padding: var(--space-12, 12rpx) 0;
  border-bottom: 1rpx solid var(--color-border, #eee);
}
.sku-item:last-child { border-bottom: none; }
.sku-main { display: flex; align-items: center; }
.sku-text { flex: 1; margin-left: var(--space-12, 12rpx); min-width: 0; }
.sku-name {
  display: block;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
}
.sku-meta {
  display: block;
  font-size: 12px;
  color: var(--color-text-secondary, #666);
  margin-top: var(--space-4, 4rpx);
}

.stepper {
  display: flex;
  align-items: center;
  margin-top: var(--space-12, 12rpx);
  padding-left: 52rpx;
}
.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 20px;
  color: var(--color-text-primary, #1d1d1f);
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
}
.stepper-input {
  width: 120rpx;
  height: 64rpx;
  margin: 0 var(--space-8, 8rpx);
  text-align: center;
  font-size: 14px;
  background: var(--color-bg-page, #f5f5f5);
  border-radius: var(--radius-sm, 4px);
}

/* ── ⑤ 备注 ── */
.remark {
  width: 100%;
  min-height: 120rpx;
  font-size: 14px;
  color: var(--color-text-primary, #1d1d1f);
  box-sizing: border-box;
}

.loading, .empty {
  padding: var(--space-24, 24rpx) 0;
  text-align: center;
  font-size: 13px;
  color: var(--color-text-disabled, #bbb);
}

.bottom-pad { height: 180rpx; }

/* ── ⑥ 底部固定提交栏 ── */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: var(--space-12, 12rpx) var(--space-16, 16rpx);
  padding-bottom: calc(var(--space-12, 12rpx) + env(safe-area-inset-bottom));
  background: var(--color-bg-card, #fff);
  box-shadow: var(--shadow-md);
  z-index: 100;
}
.submit-summary { flex: 1; }
.submit-count {
  display: block;
  font-size: 13px;
  color: var(--color-text-secondary, #666);
}
.submit-qty {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-primary, #2d7ff9);
}
.submit-btn {
  padding: var(--space-12, 12rpx) var(--space-32, 32rpx);
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary, #2d7ff9);
  border-radius: var(--radius-lg, 8px);
}
.submit-btn--disabled { opacity: 0.6; }
