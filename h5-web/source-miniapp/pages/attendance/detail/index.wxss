/* ============ 考勤明细页 ============ */
.page {
  padding: var(--page-padding-y) var(--page-padding-x);
  padding-bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* -- 月份切换 -- */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.month-arrow {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
}

.month-arrow-text {
  font-size: 22px;
  color: var(--color-text-secondary);
  line-height: 1;
}

.month-arrow-hover {
  opacity: 0.6;
}

.month-arrow--disabled {
  opacity: 0.3;
}

.month-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  min-width: 120px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

/* -- 月度汇总卡 -- */
.summary-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.summary-num {
  font-size: 22px;
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.summary-num--warn {
  color: var(--color-warning);
}

.summary-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  position: absolute;
  margin-top: -10px;
  margin-left: 36px;
}

.summary-item {
  position: relative;
}

.summary-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 4px;
}

.summary-divider {
  width: 1px;
  height: 32px;
  background: var(--color-border);
}

.summary-meta {
  margin-top: var(--spacing-md);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.summary-meta-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.summary-meta-dot {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}

/* 月度产量+金额汇总行 */
.summary-production {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1px dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.summary-production-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.summary-production-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.summary-production-value {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.summary-production-value--amount {
  color: var(--color-success);
}

.summary-production-divider {
  width: 1px;
  height: 28px;
  background: var(--color-border);
}

/* -- 日历视图 -- */
.calendar-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-md) var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.calendar-week {
  display: flex;
  padding: 0 4px;
  margin-bottom: 6px;
}

.calendar-week-cell {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.calendar-body {
  padding: 0 4px;
}

.calendar-row {
  display: flex;
  margin-bottom: 2px;
}

.calendar-cell {
  flex: 1;
  height: 44px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.calendar-cell--empty {
  visibility: hidden;
}

.cell-day {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.cell-day--weekend {
  color: var(--color-text-tertiary);
}

.cell-day--future {
  color: var(--color-text-tertiary);
}

.cell-day--today {
  width: 26px;
  height: 26px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.cell-dot {
  width: 6px;
  height: 6px;
  border-radius: var(--radius-full);
  margin-top: 3px;
}

/* 日历点颜色：与图例一致（全部使用 CSS 变量） */
.cell-dot--NORMAL         { background: var(--color-success); }
.cell-dot--LATE           { background: var(--color-warning); }
.cell-dot--EARLY_LEAVE    { background: var(--color-warning); }
.cell-dot--LATE_EARLY_LEAVE { background: var(--color-danger); }
.cell-dot--MISSING_CLOCK_OUT { background: var(--color-warning); }
.cell-dot--ABNORMAL       { background: var(--color-danger); }
.cell-dot--LEAVE          { background: var(--color-info); }
.cell-dot--ADJUSTED       { background: var(--color-primary); }
.cell-dot--CANCELLED      { background: var(--color-text-quaternary); }
.cell-dot--NO_RECORD      { background: var(--color-border); }
.cell-dot--FUTURE         { background: transparent; }

/* -- 图例 -- */
.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--spacing-sm) var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-xs);
  margin-top: var(--spacing-sm);
  border-top: 1px solid var(--color-border);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: var(--radius-full);
}

.legend-dot--NORMAL         { background: var(--color-success); }
.legend-dot--LATE           { background: var(--color-warning); }
.legend-dot--EARLY_LEAVE    { background: var(--color-warning); }
.legend-dot--MISSING_CLOCK_OUT { background: var(--color-warning); }
.legend-dot--ABNORMAL       { background: var(--color-danger); }
.legend-dot--LEAVE          { background: var(--color-info); }
.legend-dot--ADJUSTED       { background: var(--color-primary); }
.legend-dot--CANCELLED      { background: var(--color-text-quaternary); }
.legend-dot--NO_RECORD      { background: var(--color-border); }

.legend-text {
  font-size: 10px;
  color: var(--color-text-tertiary);
}

/* -- 每日明细列表 -- */
.records-section {
  margin-top: var(--spacing-md);
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4px;
  margin-bottom: var(--spacing-sm);
}

.section-title-text {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-title-meta {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.record-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-md) var(--spacing-md);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-sm);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.record-date {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.record-date-main {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.record-date-sub {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.record-status {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-weight: 500;
}

.record-status--NORMAL         { background: var(--color-success-bg); color: var(--color-success); }
.record-status--LATE           { background: var(--color-warning-bg); color: var(--color-warning); }
.record-status--EARLY_LEAVE    { background: var(--color-warning-bg); color: var(--color-warning); }
.record-status--LATE_EARLY_LEAVE { background: var(--color-danger-bg); color: var(--color-danger); }
.record-status--MISSING_CLOCK_OUT { background: var(--color-warning-bg); color: var(--color-warning); }
.record-status--ABNORMAL       { background: var(--color-danger-bg); color: var(--color-danger); }
.record-status--LEAVE          { background: var(--color-info-bg); color: var(--color-info); }
.record-status--ADJUSTED       { background: var(--color-primary-bg); color: var(--color-primary); }
.record-status--CANCELLED      { background: var(--color-bg-page); color: var(--color-text-quaternary); }

.record-body {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
}

.record-time-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.record-time-label {
  font-size: 10px;
  color: var(--color-text-tertiary);
}

.record-time-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.record-time-arrow {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

.record-duration {
  display: flex;
  align-items: baseline;
  gap: 1px;
  padding: 4px 10px;
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
}

.record-duration-num {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

.record-duration-unit {
  font-size: 10px;
  color: var(--color-primary);
}

.record-remark {
  margin-top: var(--spacing-xs);
  padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

/* 当日产量+金额展示行 */
.record-production {
  margin-top: var(--spacing-xs);
  padding-top: var(--spacing-xs);
  border-top: 1px dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
}

.record-production-item {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.record-production-label {
  font-size: 10px;
  color: var(--color-text-tertiary);
}

.record-production-value {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.record-production-value--amount {
  color: var(--color-success);
}

.record-production-separator {
  color: var(--color-text-quaternary);
  font-size: var(--font-size-xs);
}

/* -- 空状态 -- */
.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-xl) 0;
}

.empty-action {
  padding: 8px 24px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-primary);
  background: transparent;
}

.empty-action-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 500;
}

.empty-action-hover {
  opacity: 0.85;
}

/* ============ 休假/作废/管理员调整 专属样式 ============ */

/* 已作废卡片淡化 */
.record-card--CANCELLED {
  opacity: 0.55;
  background: var(--color-bg-page);
}

/* 休假记录体 */
.record-body--leave {
  flex-direction: column;
  align-items: stretch;
  gap: var(--spacing-xs);
  padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
}

.record-leave-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 12px;
  background: var(--color-info-bg);
  border-radius: var(--radius-md);
  border: 1px dashed var(--color-info);
}

.record-leave-text {
  font-size: var(--font-size-sm);
  color: var(--color-info);
  font-weight: 500;
}

.record-leave-remark {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  padding: 4px 8px;
  text-align: center;
}

/* 已作废记录体 */
.record-body--cancelled {
  padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
}

.record-cancelled-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
}

.record-cancelled-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-quaternary);
}

/* 管理员操作来源 */
.record-source {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px dashed var(--color-border);
  display: flex;
  align-items: center;
  gap: 4px;
}

.record-source-text {
  font-size: 10px;
  color: var(--color-text-tertiary);
  font-style: italic;
}

/* ============ 第2行：操作工具栏 ============ */
.toolbar-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: var(--spacing-md);
  padding: 8px 12px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.toolbar-actions--normal {
  flex: 1;
  justify-content: flex-end;
}

.toolbar-employee {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  padding: 6px 12px;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
}

.toolbar-employee-hover {
  opacity: 0.7;
}

.toolbar-employee-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolbar-employee-arrow {
  font-size: 14px;
  color: var(--color-text-tertiary);
  line-height: 1;
  flex-shrink: 0;
}

.supplement-btn {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-primary);
  background: transparent;
  white-space: nowrap;
}

.supplement-btn-text {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  font-weight: 500;
}

.supplement-btn-hover {
  opacity: 0.6;
}

.month-bar {
  position: relative;
}

.calendar-cell--clickable {
  cursor: pointer;
  border-radius: var(--radius-md);
  transition: background 0.15s ease;
}

.calendar-cell--hover {
  background: var(--color-primary-bg);
}

/* ============ 补卡弹窗 ============ */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-dialog {
  width: 86%;
  max-width: 360px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--color-border);
}

.modal-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.modal-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
}

.modal-close-text {
  font-size: 22px;
  color: var(--color-text-tertiary);
  line-height: 1;
}

.modal-body {
  padding: 14px 16px;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 14px;
}

.form-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: 6px;
  font-weight: 500;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.form-picker--placeholder {
  color: var(--color-text-quaternary);
}

.form-picker-arrow {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-md);
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  min-height: 60px;
}

.form-tip {
  margin-top: 4px;
  padding: 8px 10px;
  background: var(--color-warning-bg, #fff7e6);
  border-radius: var(--radius-md);
}

.form-tip-text {
  font-size: 11px;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  gap: 10px;
  padding: 12px 16px;
  border-top: 1px solid var(--color-border);
}

.modal-btn {
  flex: 1;
  height: 40px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  background: transparent;
}

.modal-btn--cancel {
  border-color: var(--color-border);
}

.modal-btn--ok {
  border-color: var(--color-primary);
}

.modal-btn--disabled {
  opacity: 0.5;
}

.modal-btn-text {
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.modal-btn-text--cancel {
  color: var(--color-text-secondary);
}

.modal-btn-text--ok {
  color: var(--color-primary);
}

/* ============ 管理员模式 ============ */

/* 管理员切换按钮 */
.admin-toggle {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-warning);
  background: transparent;
  white-space: nowrap;
}

.admin-toggle--active {
  background: var(--color-warning);
}

.admin-toggle--active .admin-toggle-text {
  color: var(--color-text-white);
}

.admin-toggle-text {
  font-size: var(--font-size-xs);
  color: var(--color-warning);
  font-weight: 500;
}

/* 管理员补卡按钮（区别于普通补卡） */
.supplement-btn--admin {
  border-color: var(--color-warning);
}

.supplement-btn--admin .supplement-btn-text {
  color: var(--color-warning);
}

/* 员工选择栏（旧样式已废弃，保留兼容） */
.admin-employee-bar {
  display: none;
}

/* 管理端统计 */
.admin-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: var(--spacing-md);
  padding: 12px 14px;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.admin-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.admin-stat-num {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.admin-stat-num--warn {
  color: var(--color-danger);
}

.admin-stat-label {
  font-size: 10px;
  color: var(--color-text-tertiary);
}

/* 管理端记录卡片操作区 */
.record-card--admin {
  padding-bottom: 8px;
}

.record-admin-actions {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px dashed var(--color-border);
  justify-content: flex-end;
}

.admin-action-btn {
  padding: 4px 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  background: transparent;
}

.admin-action-btn--adjust {
  border-color: var(--color-primary);
}

.admin-action-btn--adjust .admin-action-btn-text {
  color: var(--color-primary);
}

.admin-action-btn--cancel {
  border-color: var(--color-danger);
}

.admin-action-btn--cancel .admin-action-btn-text {
  color: var(--color-danger);
}

.admin-action-btn-text {
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.admin-action-btn-hover {
  opacity: 0.6;
}

/* 只读表单项 */
.form-picker--readonly {
  background: var(--color-bg-page);
  border: none;
}

.form-picker--readonly .form-picker-arrow {
  display: none;
}

.modal-btn-hover {
  opacity: 0.7;
}

/* ============ 员工搜索弹窗 ============ */
.employee-picker-dialog {
  width: 88%;
  max-width: 380px;
  max-height: 70vh;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.employee-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--color-border);
}

.employee-picker-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.employee-picker-search {
  padding: 10px 14px;
  border-bottom: 1px solid var(--color-border-light);
}

.employee-picker-input {
  width: 100%;
  height: 36px;
  padding: 0 12px;
  box-sizing: border-box;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}

.employee-picker-list {
  flex: 1;
  max-height: 50vh;
}

.employee-picker-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--color-border-light);
}

.employee-picker-item-hover {
  background: var(--color-primary-bg);
}

.employee-picker-item--active {
  background: var(--color-primary-bg);
}

.employee-picker-item-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-picker-item-id {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.employee-picker-item-check {
  font-size: 16px;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
}

.employee-picker-empty {
  padding: 40px 0;
  text-align: center;
}

.employee-picker-empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
