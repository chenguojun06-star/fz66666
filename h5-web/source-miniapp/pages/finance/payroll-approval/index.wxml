<view class="page">

  <!-- 工厂（外部）账号拦截 -->
  <view class="blocked-wrap" wx:if="{{blocked}}">
    <view class="blocked-card">
      <view class="blocked-icon"></view>
      <text class="blocked-text">{{blockedMsg}}</text>
    </view>
  </view>

  <block wx:else>
    <!-- 统计卡 -->
    <view class="stat-card">
      <view class="stat-item">
        <text class="stat-num stat-num--warn">{{pendingCount}}</text>
        <text class="stat-label">{{t.statusAuditing}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num stat-num--ok">{{auditedCount}}</text>
        <text class="stat-label">{{t.statusAudited}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">¥{{totalAmountStr}}</text>
        <text class="stat-label">{{t.totalLabel}}</text>
      </view>
    </view>

    <!-- 搜索 + 月份筛选 -->
    <sticky-search-bar
      placeholder="{{t.searchPhW}}"
      value="{{keyword}}"
      show-scan="{{false}}"
      show-filter="{{true}}"
      bind:input="onKeywordInput"
      bind:confirm="onKeywordSearch"
    >
      <view slot="filter" class="filter-bar">
        <view class="filter-item">
          <picker mode="date" fields="month" value="{{monthValue}}" bindchange="onMonthChange">
            <view class="picker-box">
              <text class="picker-text">{{monthLabel}}</text>
              <view class="picker-chevron"></view>
            </view>
          </picker>
        </view>
        <!-- D-427：结算类型筛选（自己完成 / 内部指派 / 外发工厂） -->
        <view class="filter-item">
          
            <view bindtap="openPicker" data-handler="onFactoryFilterChange" data-names="FACTORY_FILTER_OPTIONS" data-range-key="label" class="picker-box {{factoryFilter ? 'picker-box--active' : ''}}">
              <text class="picker-text">{{factoryFilterLabel}}</text>
              <view class="picker-chevron"></view>
            </view>
          
        </view>
      </view>
    </sticky-search-bar>

    <!-- 批量审核入口（页面顶部，与卡片内单条审核职责区分，不重复） -->
    <view class="batch-bar" wx:if="{{canOperate && auditableIds.length > 0}}" hover-class="batch-bar--pressed" hover-stay-time="60" bindtap="onBatchAudit">
      <text class="batch-bar__text">{{t.batchAuditBtn}} {{auditableIds.length}}{{t.wordRecords}}</text>
    </view>

    <!-- D-428：异常汇总提示（有数据异常时醒目告知，引导核实） -->
    <view class="abnormal-bar" wx:if="{{abnormalCount > 0}}">
      <text class="abnormal-bar__text">{{abnormalText}}</text>
    </view>

    <!-- 卡片列表 -->
    <view class="card-list">
      <empty-state wx:if="{{!loading && list.length === 0}}" text="{{t.noMonthData}}" />

      <view
        class="order-card {{item._cardCls}}"
        wx:for="{{list}}"
        wx:key="approvalId"
      >
        <!-- 主行：封面 + 信息（点击进详情页） -->
        <view class="order-main" data-item="{{item}}" data-index="{{index}}" catchtap="onTapItem">
          <view class="order-cover">
            <image wx:if="{{item._image}}" class="cover-pic" src="{{item._image}}" mode="aspectFill" lazy-load />
            <view wx:else class="cover-placeholder"><view class="cover-ph-text">{{t.wordStyles}}</view></view>
          </view>

          <view class="order-info">
            <view class="info-line1">
              <text class="info-no">{{item.styleNo || item.orderNo || '—'}}</text>
              <view class="info-badges">
                <view class="source-chip source-chip--{{item._sourceKind}}" wx:if="{{item._sourceText}}">{{item._sourceText}}</view>
                <view class="source-chip source-chip--{{item._factoryKind}}" wx:if="{{item._factoryText}}">{{item._factoryText}}</view>
                <view class="status-badge" style="background:{{item._statusColor}}">{{item.auditText}}</view>
              </view>
            </view>
            <view class="info-line--strong">{{item.operatorName}}<text wx:if="{{item.processName}}" class="info-sep">·</text><text wx:if="{{item.processName}}">{{item.processName}}</text></view>
            <view class="info-line" wx:if="{{item.orderNo || item.orderStatusText}}">
              <text wx:if="{{item.orderNo}}">{{item.orderNo}}</text>
              <text wx:if="{{item.orderNo && item.orderStatusText}}" class="info-sep">·</text>
              <text wx:if="{{item.orderStatusText}}">{{item.orderStatusText}}</text>
            </view>
            <view class="info-line--weak" wx:if="{{item._timeText}}">{{item._timeText}}</view>
            <!-- D-428：结算异常提示 —— 红色=数据异常需核实；橙色=业务流转中 -->
            <view class="info-line--danger" wx:if="{{item._abnormalText && item._cardCls === 'order-card--danger'}}">{{item._abnormalText}}</view>
            <view class="info-line--warn" wx:elif="{{item._abnormalText}}">{{item._abnormalText}}</view>
          </view>
        </view>

        <!-- 末行：金额（蓝）+ 计价 + 操作（不占额外行，无分界线） -->
        <view class="card-bottom">
          <view class="amount-left">
            <text class="amount-currency">¥</text>
            <text class="amount-num">{{item.amountStr}}</text>
          </view>
          <view class="amount-right" wx:if="{{item.quantityStr && item.unitPriceStr && item.unitPriceStr !== '—'}}">{{item.quantityStr}} × ¥{{item.unitPriceStr}}</view>
          <view class="amount-right" wx:else></view>
          <view class="bottom-actions">
            <!-- D-423：审核列三态与 PC 端 actionColumns 对齐：已审核 / 未关单 / 审核 -->
            <view
              wx:if="{{item.audited}}"
              class="action-btn action-btn--ghost action-btn--disabled"
            >{{t.statusAudited}}</view>
            <view
              wx:elif="{{!item.canAudit}}"
              class="action-btn action-btn--ghost action-btn--disabled"
            >{{t.notClosedTag}}</view>
            <view
              wx:elif="{{canOperate && item.eligible}}"
              class="action-btn action-btn--primary"
              data-index="{{index}}"
              catchtap="onActionAuditInline"
            >{{t.auditBtn}}</view>
            <view
              class="action-btn action-btn--ghost"
              data-item="{{item}}"
              data-index="{{index}}"
              catchtap="onTapItem"
            >{{t.detailBtn}}</view>
          </view>
        </view>
      </view>

      <view class="load-more {{!hasMore ? 'disabled' : ''}}" wx:if="{{loading || !hasMore}}">
        <text>{{loading ? t.loading : t.noMoreW2}}</text>
      </view>
    </view>
  </block>

  <ai-assistant id="ai-assistant" />
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
