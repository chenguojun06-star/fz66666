<view class="page">

  <!-- 工厂（外部）账号拦截 -->
  <view class="blocked-wrap" wx:if="{{blocked}}">
    <view class="blocked-card">
      <view class="blocked-icon"></view>
      <text class="blocked-text">{{blockedMsg}}</text>
    </view>
  </view>

  <block wx:else>
    <sticky-search-bar
      placeholder="搜索申请人 / 事由 / 单号"
      value="{{keyword}}"
      show-scan="{{false}}"
      show-filter="{{true}}"
      bind:input="onKeywordInput"
      bind:confirm="onKeywordSearch"
    >
      <view slot="filter" class="filter-bar">
        <view class="filter-item">
          
            <view bindtap="openPicker" data-handler="onStatusFilterChange" data-names="STATUS_OPTIONS" data-range-key="label" class="picker-box">
              <text class="picker-text">{{statusFilter ? STATUS_MAP[statusFilter].text : '全部状态'}}</text>
              <view class="picker-chevron"></view>
            </view>
          
        </view>
      </view>
    </sticky-search-bar>

    <!-- 卡片列表 -->
    <view class="card-list">
      <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无报销单" />

      <view
        class="order-card {{item.statusCls === 'tag-orange' ? 'order-card--warn' : (item.statusCls === 'tag-red' ? 'order-card--danger' : '')}}"
        wx:for="{{list}}"
        wx:key="id"
      >
        <!-- 主行：封面 + 信息（点击进详情/操作） -->
        <view class="order-main" data-item="{{item}}" data-index="{{index}}" catchtap="onTapItem">
          <view class="order-cover">
            <view class="cover-placeholder"><view class="cover-ph-text">报</view></view>
          </view>

          <view class="order-info">
            <view class="info-line1">
              <text class="info-no">{{item.reimbursementNo || '—'}}</text>
              <view class="info-badges">
                <view class="status-badge" style="background:{{item._statusColor}}">{{item.statusText}}</view>
              </view>
            </view>
            <view class="info-line--strong">{{item.applicantName || '—'}}<text wx:if="{{item.expenseType}}" class="info-sep">·</text><text wx:if="{{item.expenseType}}">{{item.expenseType}}</text></view>
            <view class="info-line" wx:if="{{item.title || item.description}}">{{item.title || item.description}}</view>
            <view class="info-line--weak" wx:if="{{item.approverName}}">审批 {{item.approverName}}</view>
            <view class="info-line--weak" wx:if="{{item.orderNo}}">关联 {{item.orderNo}}</view>
          </view>
        </view>

        <!-- 末行：金额（蓝）+ 日期 + 操作 -->
        <view class="card-bottom">
          <view class="amount-left">
            <text class="amount-currency">¥</text>
            <text class="amount-num">{{item.amountStr}}</text>
          </view>
          <view class="amount-right" wx:if="{{item.expenseDate}}">{{item.expenseDate}}</view>
          <view class="amount-right" wx:else></view>
          <view class="bottom-actions">
            <view
              wx:if="{{canOperate && item.status === 'pending'}}"
              class="action-btn action-btn--primary"
              data-id="{{item.id}}"
              data-index="{{index}}"
              catchtap="onActionApproveInline"
            >批准</view>
            <view
              wx:if="{{canOperate && item.status === 'pending'}}"
              class="action-btn action-btn--ghost"
              data-id="{{item.id}}"
              data-index="{{index}}"
              catchtap="onActionRejectInline"
            >驳回</view>
            <view
              wx:if="{{canOperate && item.status === 'approved'}}"
              class="action-btn action-btn--primary"
              data-id="{{item.id}}"
              data-index="{{index}}"
              catchtap="onActionPayInline"
            >付款</view>
            <view
              class="action-btn action-btn--ghost"
              data-id="{{item.id}}"
              data-index="{{index}}"
              catchtap="onTapItem"
            >详情</view>
          </view>
        </view>
      </view>

      <view class="load-more {{!hasMore ? 'disabled' : ''}}" wx:if="{{loading || !hasMore}}">
        <text>{{loading ? '加载中...' : '没有更多了'}}</text>
      </view>
    </view>

    <!-- 操作面板（保留兼容） -->
    <view class="inline-form-card" wx:if="{{showActionSheet}}">
      <view class="inline-form-title">
        <text>{{current.reimbursementNo || '报销操作'}}</text>
        <text class="status-tag {{current.statusCls}}">{{current.statusText}}</text>
      </view>
      <view class="inline-form-body">
        <view class="action-item action-approve" wx:if="{{currentCanApprove}}" bindtap="onActionApprove">
          <view class="action-icon action-icon-check"></view>
          <text>批准</text>
        </view>
        <view class="action-item action-reject" wx:if="{{currentCanApprove}}" bindtap="onActionReject">
          <view class="action-icon action-icon-warn"></view>
          <text>驳回</text>
        </view>
        <view class="action-item action-pay" wx:if="{{currentCanPay}}" bindtap="onActionPay">
          <view class="action-icon action-icon-check"></view>
          <text>确认付款</text>
        </view>
        <view class="action-item action-cancel" bindtap="onCloseActionSheet">
          <text>取消</text>
        </view>
      </view>
    </view>
  </block>

  <ai-assistant id="ai-assistant" />
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
