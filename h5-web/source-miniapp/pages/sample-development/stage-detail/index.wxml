<!--
  样衣阶段详情页 — 只显示当前阶段内容，不重复 detail 页面的样衣信息/时间轴/附件/备注
  ① 开发阶段快捷入口（横向滚动切换）
  ② 当前阶段详情卡（详情网格+时间信息+现场照片+操作按钮）
  ③ 分阶段内容（BOM/纸样/尺码/工序/二次工艺/生产制单/码数单价）
  ④ 审核表单（页面内展开）
  ⑤ 底部固定操作栏（提交审核；修改信息为 PC 端能力，手机端不提供）
-->
<view class="stage-detail-page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <block wx:else>

    <!-- ══ ① 开发阶段快捷入口 ══ -->
    <view class="dev-stage-section">
      <view class="ds-header">
        <text class="ds-title">{{t.sampleDevWord}}</text>
        <text class="ds-sub">{{t.stageSubtitle}}</text>
      </view>
      <scroll-view class="ds-scroll" scroll-x="true" enable-flex="true">
        <view class="ds-list">
          <view wx:for="{{devStages}}" wx:key="key"
            class="ds-item {{item.key === stageKey ? 'ds-item-active' : ''}} {{item.status === 'completed' ? 'ds-item-done' : ''}}"
            data-key="{{item.key}}" bindtap="onSwitchDevStage">
            <view class="ds-icon-wrap">
              <text class="ds-icon-text">{{item.name}}</text>
              <view wx:if="{{item.status === 'completed'}}" class="ds-check">
                <view class="line-icon line-icon--sm icon-check-sm"></view>
              </view>
            </view>
            <text wx:if="{{item.statusText}}" class="ds-status">{{item.statusText}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ══ ② 当前阶段详情卡 ══ -->
    <view wx:if="{{stageDetail}}" class="sdc-card sdc-{{stageDetail.status}}">
      <!-- 头部 -->
      <view class="sdc-header">
        <view class="sdc-title-wrap">
          <view class="sdc-icon sdc-icon-{{stageDetail.status}}">
            <view class="line-icon line-icon--sm icon-scissors-white"></view>
          </view>
          <text class="sdc-title">{{stageDetail.name}}{{t.stageDetailSuffix}}</text>
        </view>
        <text class="sdc-status tag-{{stageDetail.status}}">{{stageDetail.statusText}}</text>
      </view>

      <!-- 详情网格 -->
      <view class="sdc-detail-grid">
        <view class="sdc-grid-item">
          <text class="sdc-grid-label">{{t.assigneeLabel}}</text>
          <text class="sdc-grid-value">{{stageDetail.assignee || t.noAssigneeW}}</text>
        </view>
        <view class="sdc-grid-item">
          <text class="sdc-grid-label">{{t.plannedQtyLabel}}</text>
          <text class="sdc-grid-value">{{stageDetail.plannedQty || '-'}}{{stageDetail.plannedQty ? t.pieceUnit : ''}}</text>
        </view>
        <view class="sdc-grid-item">
          <text class="sdc-grid-label">{{t.completedLabel}}</text>
          <text class="sdc-grid-value sdc-grid-value-success">{{stageDetail.completedQty || 0}}{{t.pieceUnit}}</text>
        </view>
        <view class="sdc-grid-item">
          <text class="sdc-grid-label">{{t.remainingQtyLabel}}</text>
          <text class="sdc-grid-value sdc-grid-value-warning">{{stageDetail.remainingQty !== undefined ? stageDetail.remainingQty : (stageDetail.plannedQty ? stageDetail.plannedQty : 0)}}{{t.pieceUnit}}</text>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="sdc-divider"></view>

      <!-- 时间信息 -->
      <view class="sdc-time-info">
        <view class="sdc-time-row" wx:if="{{stageDetail.startTime}}">
          <view class="line-icon line-icon--sm icon-clock-gray"></view>
          <text class="sdc-time-label">{{t.startTimeLabel}}</text>
          <text class="sdc-time-value">{{stageDetail.startTime}}</text>
        </view>
        <view class="sdc-time-row" wx:if="{{stageDetail.completedAt}}">
          <view class="line-icon line-icon--sm icon-calendar-gray"></view>
          <text class="sdc-time-label">{{t.completeTimeLabel}}</text>
          <text class="sdc-time-value">{{stageDetail.completedAt}}</text>
        </view>
      </view>

      <!-- 现场照片 -->
      <view wx:if="{{stagePhotos.length > 0}}" class="sdc-photos">
        <view class="sdc-photos-header">
          <text class="sdc-photos-label">{{t.stagePhotosLabel}}</text>
          <text class="sdc-photos-count">{{stagePhotos.length}}{{t.photosUnit}}</text>
        </view>
        <view class="sdc-photos-grid">
          <image wx:for="{{stagePhotos}}" wx:key="url" src="{{item.url}}" mode="aspectFit"
            class="sdc-photo" data-url="{{item.url}}" bindtap="onPreviewStagePhoto" />
        </view>
      </view>

      <!-- 操作按钮（已完成阶段不显示操作按钮） -->
      <view wx:if="{{stageDetail.status !== 'completed'}}" class="sdc-actions">
        <view class="sdc-btn sdc-btn-primary" bindtap="onScanUpdate">
          <view class="line-icon line-icon--sm icon-scan-white"></view>
          <text class="sdc-btn-text">{{t.processScanUpdate}}</text>
        </view>
        <view class="sdc-btn sdc-btn-outline" bindtap="onUploadPhotoDetail">
          <view class="line-icon line-icon--sm icon-camera-gray"></view>
          <text class="sdc-btn-text">{{t.uploadPhoto}}</text>
        </view>
        <view class="sdc-btn sdc-btn-outline" bindtap="onMarkComplete">
          <view class="line-icon line-icon--sm icon-check-gray"></view>
          <text class="sdc-btn-text">{{t.markComplete}}</text>
        </view>
      </view>
      <!-- 已完成提示 -->
      <view wx:if="{{stageDetail.status === 'completed'}}" class="sdc-completed-banner">
        <view class="line-icon line-icon--sm icon-check-sm"></view>
        <text class="sdc-completed-text">{{t.stageDoneHint}}</text>
      </view>
    </view>

    <!-- ══ ③ BOM 清单（bom / procurement 阶段） ══ -->
    <block wx:if="{{stageKey === 'bom' || stageKey === 'procurement'}}">
      <view class="section-label">
        <text class="sl-text">{{t.tabBom}}</text>
        <text class="sl-count" wx:if="{{bomSummary.totalCount}}">{{bomSummary.totalCount}}{{t.kindFmt}}</text>
      </view>
      <view wx:if="{{bomList.length === 0}}" class="empty-state">
        <text class="empty-text">{{t.noMaterialData}}</text>
      </view>
      <block wx:else>
        <!-- BOM 汇总 -->
        <view class="bom-summary-bar">
          <view class="bsb-item">
            <text class="bsb-label">{{t.materialCountW}}</text>
            <text class="bsb-value">{{bomSummary.totalCount}}{{t.kindFmt}}</text>
          </view>
          <view class="bsb-divider"></view>
          <view class="bsb-item">
            <text class="bsb-label">{{t.matMainLabel}}</text>
            <text class="bsb-value">{{bomSummary.mainCount}}{{t.kindFmt}}</text>
          </view>
          <view class="bsb-divider"></view>
          <view class="bsb-item">
            <text class="bsb-label">{{t.matAuxLabel}}</text>
            <text class="bsb-value">{{bomSummary.accessoryCount}}{{t.kindFmt}}</text>
          </view>
          <view class="bsb-divider"></view>
          <view class="bsb-item">
            <text class="bsb-label">{{t.costLabel}}</text>
            <text class="bsb-value bsb-amount">¥{{bomSummary.totalAmount}}</text>
          </view>
        </view>
        <!-- 按分类分组 -->
        <block wx:for="{{bomGroups}}" wx:for-item="group" wx:key="key">
          <view class="group-title">
            <text class="gt-name">{{group.name}}</text>
            <text class="gt-count">{{group.count}}{{t.kindFmt}}</text>
          </view>
          <view class="data-card" wx:for="{{group.items}}" wx:for-item="item" wx:key="id">
            <view class="dc-header">
              <view class="dc-title-wrap">
                <text class="dc-title">{{item._materialLabel}}</text>
                <text class="dc-part-tag {{item._isWholePart ? 'dc-part-whole' : 'dc-part-other'}}">{{item._partLabel}}</text>
                <text wx:if="{{item._subPartLabel}}" class="dc-part-tag dc-part-sub">{{item._subPartLabel}}</text>
              </view>
              <text class="dc-amount">¥{{item._amount}}</text>
            </view>
            <view class="dc-body">
              <view class="dc-row">
                <text class="dc-label">{{t.specLabel}}</text>
                <text class="dc-value">{{item._specLabel || '-'}}</text>
              </view>
              <view class="dc-row">
                <text class="dc-label">{{t.usageLabel}}</text>
                <text class="dc-value">{{item._displayQty}}{{item._unit}}</text>
              </view>
              <view wx:if="{{item.unitPrice}}" class="dc-row">
                <text class="dc-label">{{t.unitPriceLabel}}</text>
                <text class="dc-value">¥{{item.unitPrice}}</text>
              </view>
              <view wx:if="{{item.supplier}}" class="dc-row">
                <text class="dc-label">{{t.supplierLabel}}</text>
                <text class="dc-value">{{item.supplier}}</text>
              </view>
            </view>
          </view>
        </block>
      </block>
    </block>

    <!-- ══ ④ 纸样开发 ══ -->
    <block wx:if="{{stageKey === 'pattern'}}">
      <view class="section-label">
        <text class="sl-text">{{t.patternInfoTitle}}</text>
      </view>
      <view wx:if="{{!patternData}}" class="empty-state">
        <text class="empty-text">{{t.noPatternData}}</text>
      </view>
      <view wx:else class="data-card">
        <view class="dc-header">
          <text class="dc-title">{{t.patternInfoTitle}}</text>
          <text wx:if="{{patternData.statusText}}" class="dc-tag">{{patternData.statusText}}</text>
        </view>
        <view class="dc-body">
          <view wx:if="{{patternData.patternMaker}}" class="dc-row">
            <text class="dc-label">{{t.roleMakerLabel}}</text>
            <text class="dc-value">{{patternData.patternMaker}}</text>
          </view>
          <view wx:if="{{patternData.version}}" class="dc-row">
            <text class="dc-label">{{t.versionLabel}}</text>
            <text class="dc-value">{{patternData.version}}</text>
          </view>
          <view wx:if="{{patternData.startTime}}" class="dc-row">
            <text class="dc-label">{{t.startTimeLabel}}</text>
            <text class="dc-value">{{patternData.startTime}}</text>
          </view>
          <view wx:if="{{patternData.completeTime}}" class="dc-row">
            <text class="dc-label">{{t.completeTimeLabel}}</text>
            <text class="dc-value">{{patternData.completeTime}}</text>
          </view>
          <view wx:if="{{patternData.remark}}" class="dc-row">
            <text class="dc-label">{{t.remarkLabel}}</text>
            <text class="dc-value">{{patternData.remark}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ══ ⑤ 尺码表 ══ -->
    <block wx:if="{{stageKey === 'size'}}">
      <view class="section-label">
        <text class="sl-text">{{t.sizeInfoTitle}}</text>
      </view>
      <view wx:if="{{!sizeTableData || !sizeTableData.sizes || sizeTableData.sizes.length === 0}}" class="empty-state">
        <text class="empty-text">{{t.noSizeData}}</text>
      </view>
      <view wx:else class="data-card">
        <view class="dc-header">
          <text class="dc-title">{{t.sizeInfoTitle}}</text>
        </view>
        <view class="dc-body">
          <view class="size-tag-list">
            <text wx:for="{{sizeTableData.sizes}}" wx:key="*this" class="size-tag">{{item}}</text>
          </view>
        </view>
        <view class="size-table-wrap">
          <view class="size-table-header">
            <text class="sth-cell sth-part">{{t.partHeader}}</text>
            <text class="sth-cell sth-method">{{t.measureMethodLabel}}</text>
            <text class="sth-cell sth-tol">{{t.toleranceLabel}}</text>
            <text class="sth-cell sth-base">{{t.baseSizeLabel}}</text>
            <text wx:for="{{sizeTableData.sizes}}" wx:key="*this" class="sth-cell sth-size">{{item}}</text>
          </view>
          <view wx:for="{{sizeTableData.rows}}" wx:key="partName" class="size-table-row">
            <text class="str-cell str-part">{{item.partName}}</text>
            <text class="str-cell str-method">{{item.measureMethod || '-'}}</text>
            <text class="str-cell str-tol">{{item.tolerance || '-'}}</text>
            <text class="str-cell str-base">{{item.baseSize || '-'}}</text>
            <text wx:for="{{sizeTableData.sizes}}" wx:for-item="sn" wx:key="*this" class="str-cell str-size">{{item['size_' + sn] || '-'}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ══ ⑥ 工序配置（process / cutting / sewing / tail 阶段） ══ -->
    <block wx:if="{{stageKey === 'process' || stageKey === 'cutting' || stageKey === 'sewing' || stageKey === 'tail'}}">
      <view class="section-label">
        <text class="sl-text">{{t.processListTitle}}</text>
        <text class="sl-count">{{processTotalCount}}{{t.countFmt}}</text>
      </view>
      <view wx:if="{{processTotalCount === 0}}" class="empty-state">
        <text class="empty-text">{{t.noProcessConfigT}}</text>
        <text class="empty-hint">{{t.configOnPcHint}}</text>
      </view>
      <block wx:else>
        <!-- 按阶段分组（同步PC端父子结构） -->
        <block wx:for="{{processGroups}}" wx:for-item="group" wx:key="stageName">
          <view class="process-group-header">
            <text class="pgg-name">{{group.stageName}}</text>
            <text class="pgg-count">{{group.totalCount}}{{t.countFmt}} · {{t.completedLabel}}{{group.completedCount}}{{t.countFmt}}</text>
          </view>
          <view wx:for="{{group.processes}}" wx:for-item="item" wx:key="key" class="data-card process-stage-card {{item.expanded ? 'psc-expanded' : ''}}" data-key="{{item.key}}" bindtap="onToggleProcess">
            <view class="dc-header">
              <view class="dc-title-row">
                <text class="dc-title">{{item.name}}</text>
                <text class="dc-status-tag dst-{{item.status}}">{{item.statusText}}</text>
              </view>
              <text wx:if="{{item.unitPrice}}" class="dc-amount">¥{{item.unitPrice}}</text>
            </view>
            <view class="dc-body">
              <view class="dc-row">
                <text class="dc-label">{{t.claimantLabel}}</text>
                <text class="dc-value">{{item.assignee || t.noClaimW}}</text>
              </view>
              <view wx:if="{{item.scanTime}}" class="dc-row">
                <text class="dc-label">{{t.scanTimeLabel}}</text>
                <text class="dc-value">{{item.scanTime}}</text>
              </view>
              <view wx:if="{{item.scanCount > 0}}" class="dc-row">
                <text class="dc-label">{{t.scanCountLabel}}</text>
                <text class="dc-value">{{item.scanCount}}{{t.countFmt}}</text>
              </view>
              <view wx:if="{{item.warehouse}}" class="dc-row">
                <text class="dc-label">{{t.warehouseLabel}}</text>
                <text class="dc-value">{{item.warehouse}}</text>
              </view>
              <view wx:if="{{item.machineType}}" class="dc-row">
                <text class="dc-label">{{t.machineTypeLabel}}</text>
                <text class="dc-value">{{item.machineType}}</text>
              </view>
              <view wx:if="{{item.difficulty}}" class="dc-row">
                <text class="dc-label">{{t.difficultyLabel}}</text>
                <text class="dc-value">{{item.difficulty}}</text>
              </view>
            </view>
            <!-- 展开区域：扫码记录列表 -->
            <view wx:if="{{item.expanded}}" class="psc-expand-area" catchtap="">
              <view wx:if="{{item.scanList.length > 0}}" class="psc-scan-list">
                <view class="psc-scan-header">
                  <text class="psc-scan-title">{{item.scanTitle}}</text>
                </view>
                <view wx:for="{{item.scanList}}" wx:for-item="rec" wx:key="id" class="psc-scan-item">
                  <view class="psc-scan-row">
                    <view class="psc-scan-operator">
                      <view class="psc-scan-dot"></view>
                      <text class="psc-scan-name">{{rec.operatorName}}</text>
                    </view>
                    <text class="psc-scan-time">{{rec.scanTimeText}}</text>
                  </view>
                  <view class="psc-scan-meta">
                    <text class="psc-scan-op">{{rec.operationLabel}}</text>
                    <text wx:if="{{rec.color || rec.size}}" class="psc-scan-cs">{{rec.color}}/{{rec.size}}</text>
                    <text class="psc-scan-qty">{{rec.quantity}}{{t.pieceUnit}}</text>
                    <text wx:if="{{rec.unitPrice}}" class="psc-scan-price">¥{{rec.unitPrice}}/{{t.pieceUnit}}</text>
                    <text wx:if="{{rec.scanCost}}" class="psc-scan-wage">{{rec.wageText}}</text>
                    <text wx:if="{{rec.warehouse && rec.warehouse !== '-'}}" class="psc-scan-wh">{{rec.warehouse}}</text>
                  </view>
                  <view wx:if="{{rec.remark}}" class="psc-scan-remark">
                    <text>{{rec.remark}}</text>
                  </view>
                  <view wx:if="{{rec.canUndo}}" class="psc-scan-undo" catchtap="onUndoScan" data-id="{{rec.id}}">
                    <text>{{t.undoBtn}}</text>
                  </view>
                </view>
              </view>
              <view wx:else class="psc-no-records">
                <text>{{t.noScanRecordsT}}</text>
              </view>
            </view>
            <!-- 展开/收起指示器 -->
            <view class="psc-toggle-indicator">
              <text>{{item.expanded ? t.collapseText : t.viewDetailText}}</text>
              <view class="psc-arrow {{item.expanded ? 'psc-arrow-up' : ''}}"></view>
            </view>
          </view>
        </block>
      </block>
    </block>

    <!-- ══ ⑦ 二次工艺 ══ -->
    <block wx:if="{{stageKey === 'secondary'}}">
      <view class="section-label">
        <text class="sl-text">{{t.tabSecondary}}</text>
        <text class="sl-count">{{secondaryList.length}}{{t.countFmt}}</text>
      </view>
      <view wx:if="{{secondaryList.length === 0}}" class="empty-state">
        <text class="empty-text">{{t.noSecondaryData}}</text>
      </view>
      <block wx:else>
        <view wx:for="{{secondaryList}}" wx:key="id" class="data-card">
          <view class="dc-header">
            <view class="dc-title-row">
              <text class="dc-title">{{item.processName || item.typeText || t.secondaryWordW}}</text>
              <text class="dc-status-tag dst-{{item.status}}">{{item._statusText}}</text>
            </view>
          </view>
          <view class="dc-body">
            <view wx:if="{{item.typeText}}" class="dc-row">
              <text class="dc-label">{{t.typeLabel}}</text>
              <text class="dc-value">{{item.typeText}}</text>
            </view>
            <view wx:if="{{item.quantity}}" class="dc-row">
              <text class="dc-label">{{t.qtyLabel}}</text>
              <text class="dc-value">{{item.quantity}}</text>
            </view>
            <view wx:if="{{item.unitPrice}}" class="dc-row">
              <text class="dc-label">{{t.unitPriceLabel}}</text>
              <text class="dc-value">¥{{item.unitPrice}}</text>
            </view>
            <view wx:if="{{item._totalPriceText}}" class="dc-row">
              <text class="dc-label">{{t.totalPriceLabel}}</text>
              <text class="dc-value">¥{{item._totalPriceText}}</text>
            </view>
            <view wx:if="{{item.factoryName}}" class="dc-row">
              <text class="dc-label">{{t.processorLabel}}</text>
              <text class="dc-value">{{item.factoryName}}</text>
            </view>
            <view wx:if="{{item.assignee}}" class="dc-row">
              <text class="dc-label">{{t.claimantLabel}}</text>
              <text class="dc-value">{{item.assignee}}</text>
            </view>
            <view wx:if="{{item.completedTimeText}}" class="dc-row">
              <text class="dc-label">{{t.completeTimeLabel}}</text>
              <text class="dc-value">{{item.completedTimeText}}</text>
            </view>
            <view wx:if="{{item.description}}" class="dc-row">
              <text class="dc-label">{{t.descLabel}}</text>
              <text class="dc-value">{{item.description}}</text>
            </view>
          </view>
          <view wx:if="{{item._thumbUrl}}" class="dc-image-wrap" data-url="{{item._thumbUrl}}" data-urls="{{[item._thumbUrl]}}" bindtap="onSecondaryImageTap">
            <image src="{{item._thumbUrl}}" mode="aspectFit" class="dc-thumb" />
          </view>
        </view>
      </block>
    </block>

    <!-- ══ ⑧ 工艺说明（D-187 前叫生产制单，production / warehousing 阶段） ══ -->
    <block wx:if="{{stageKey === 'production' || stageKey === 'warehousing'}}">
      <view class="section-label">
        <text class="sl-text">{{t.craftSheetTitle}}</text>
      </view>
      <view wx:if="{{!productionData}}" class="empty-state">
        <text class="empty-text">{{t.noCraftData}}</text>
      </view>
      <block wx:else>
        <!-- 封面 + 款式信息 -->
        <view class="data-card production-header-card">
          <view class="ph-cover-wrap" wx:if="{{productionData.coverUrl}}">
            <image class="ph-cover" src="{{productionData.coverUrl}}" mode="aspectFit" data-url="{{productionData.coverUrl}}" bindtap="onPreviewImage" />
          </view>
          <view class="ph-meta">
            <view class="dc-header"><text class="dc-title">{{t.styleInfoTitle}}</text></view>
            <view class="dc-body">
              <view wx:if="{{productionData.styleNo}}" class="dc-row"><text class="dc-label">{{t.styleNoLabel}}</text><text class="dc-value">{{productionData.styleNo}}</text></view>
              <view wx:if="{{productionData.styleName}}" class="dc-row"><text class="dc-label">{{t.styleNameLabel}}</text><text class="dc-value">{{productionData.styleName}}</text></view>
              <view wx:if="{{productionData.category}}" class="dc-row"><text class="dc-label">{{t.categoryLabel}}</text><text class="dc-value">{{productionData.category}}</text></view>
              <view wx:if="{{productionData.season}}" class="dc-row"><text class="dc-label">{{t.seasonLabel}}</text><text class="dc-value">{{productionData.season}}</text></view>
              <view wx:if="{{productionData.customer}}" class="dc-row"><text class="dc-label">{{t.customerLabel}}</text><text class="dc-value">{{productionData.customer}}</text></view>
              <view wx:if="{{productionData.salesChannel}}" class="dc-row"><text class="dc-label">{{t.channelLabel}}</text><text class="dc-value">{{productionData.salesChannel}}</text></view>
              <view wx:if="{{productionData.color}}" class="dc-row"><text class="dc-label">{{t.colorLabel}}</text><text class="dc-value">{{productionData.color}}</text></view>
              <view wx:if="{{productionData.size}}" class="dc-row"><text class="dc-label">{{t.sizeLabel}}</text><text class="dc-value">{{productionData.size}}</text></view>
              <view wx:if="{{productionData.quantity}}" class="dc-row"><text class="dc-label">{{t.qtyLabel}}</text><text class="dc-value">{{productionData.quantity}}</text></view>
              <view wx:if="{{productionData.tagPrice}}" class="dc-row"><text class="dc-label">{{t.tagPriceLabel}}</text><text class="dc-value">¥{{productionData.tagPrice}}</text></view>
              <view wx:if="{{productionData.salesPrice}}" class="dc-row"><text class="dc-label">{{t.salePriceLabel}}</text><text class="dc-value">¥{{productionData.salesPrice}}</text></view>
              <view wx:if="{{productionData.price}}" class="dc-row"><text class="dc-label">{{t.patternPriceLabel}}</text><text class="dc-value">¥{{productionData.price}}</text></view>
            </view>
          </view>
        </view>

        <!-- 工艺说明（D-187：样衣开发端富文本，rich-text 渲染保排版+图片） -->
        <view class="data-card">
          <view class="dc-header"><text class="dc-title">{{t.craftSheetTitle}}</text></view>
          <view class="dc-body">
            <block wx:if="{{productionData.descriptionHtml}}">
              <view class="dc-text-block dc-requirement-text">
                <rich-text nodes="{{productionData.descriptionHtml}}"></rich-text>
              </view>
            </block>
            <view wx:else class="empty-state compact"><text class="empty-text">{{t.noCraftSheet}}</text></view>
          </view>
        </view>

        <!-- 样衣审核 -->
        <view wx:if="{{productionData.sampleReview}}" class="data-card">
          <view class="dc-header"><text class="dc-title">{{t.sampleReviewTitle}}</text></view>
          <view class="dc-body">
            <view class="dc-row">
              <text class="dc-label">{{t.reviewConclusionWord}}</text>
              <text class="dc-value review-status review-status-{{productionData.sampleReview.tone}}">{{productionData.sampleReview.statusText}}</text>
            </view>
            <view wx:if="{{productionData.sampleReview.reviewer}}" class="dc-row"><text class="dc-label">{{t.reviewerLabel}}</text><text class="dc-value">{{productionData.sampleReview.reviewer}}</text></view>
            <view wx:if="{{productionData.sampleReview.reviewTime}}" class="dc-row"><text class="dc-label">{{t.reviewTimeLabel}}</text><text class="dc-value">{{productionData.sampleReview.reviewTime}}</text></view>
            <view wx:if="{{productionData.sampleReview.reviewComment}}" class="dc-row align-top">
              <text class="dc-label">{{t.reviewComment}}</text>
              <text class="dc-value dc-text-block">{{productionData.sampleReview.reviewComment}}</text>
            </view>
          </view>
        </view>

        <!-- 尺寸表 -->
        <view class="section-label"><text class="sl-text">{{t.sizeTableTitle}}</text><text class="sl-count">{{productionData.sizeTable.rows.length}}{{t.partsCountW}}</text></view>
        <view wx:if="{{productionData.sizeTable.rows.length === 0}}" class="empty-state"><text class="empty-text">{{t.noSizeData}}</text></view>
        <view wx:else class="data-card size-table-card">
          <view class="size-table-wrap">
            <view class="size-table-header psth-header">
              <text class="sth-cell sth-part">{{t.partHeader}}</text>
              <text class="sth-cell sth-method">{{t.measureMethodLabel}}</text>
              <text wx:for="{{productionData.sizeTable.sizes}}" wx:key="*this" class="sth-cell sth-size">{{item}}</text>
              <text class="sth-cell sth-tol">{{t.toleranceLabel}}</text>
            </view>
            <view wx:for="{{productionData.sizeTable.rows}}" wx:key="partName" class="size-table-row">
              <text class="str-cell str-part">{{item.partName}}</text>
              <text class="str-cell str-method">{{item.measureMethod || '-'}}</text>
              <text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="*this" class="str-cell str-size">{{cell || '-'}}</text>
              <text class="str-cell str-tol">{{item.tolerance ? '±' + item.tolerance : '-'}}</text>
            </view>
          </view>
        </view>
      </block>
    </block>

    <!-- ══ ⑨ 码数单价 ══ -->
    <block wx:if="{{stageKey === 'sizePrice'}}">
      <view class="section-label">
        <text class="sl-text">{{t.sizePriceTitle}}</text>
      </view>
      <view wx:if="{{!sizePriceData || !sizePriceData.processes || sizePriceData.processes.length === 0}}" class="empty-state">
        <text class="empty-text">{{t.noSizePriceData}}</text>
      </view>
      <view wx:else class="data-card">
        <view class="dc-header"><text class="dc-title">{{t.sizePriceTitle}}</text></view>
        <view class="dc-body">
          <view class="size-table-wrap">
            <view class="size-table-header">
              <text class="sth-cell sth-part">{{t.processWord}}</text>
              <text wx:for="{{sizePriceData.sizes}}" wx:key="*this" class="sth-cell sth-size">{{item}}</text>
            </view>
            <view wx:for="{{sizePriceData.processes}}" wx:key="processName" class="size-table-row">
              <text class="str-cell str-part">{{item.processName}}</text>
              <text wx:for="{{sizePriceData.sizes}}" wx:for-item="sn" wx:key="*this" class="str-cell str-size">{{item.cells[sn] != null ? '¥' + item.cells[sn] : '-'}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

  </block>

  <!-- ══ ④ 审核表单（页面内展开，非弹窗） ══ -->
  <view wx:if="{{showReviewForm}}" class="review-form-card">
    <view class="rf-header">
      <text class="rf-title">{{t.sampleReviewTitle}}</text>
      <view class="rf-close" bindtap="onCancelReviewForm">
        <view class="line-icon line-icon--sm icon-multiply-sm"></view>
      </view>
    </view>
    <view class="rf-body">
      <view class="rf-row">
        <text class="rf-label">{{t.reviewConclusionWord}}</text>
        <view class="rf-picker" bindtap="openPicker" data-handler="onReviewStatusChange" data-names="reviewStatusOptions">
          <text class="rf-picker-text {{reviewFormStatus === 'PASS' ? 'rf-pass' : reviewFormStatus === 'REWORK' ? 'rf-rework' : 'rf-reject'}}">
            {{reviewFormStatus === 'PASS' ? t.completedLabel : reviewFormStatus === 'REWORK' ? t.needModifyW : t.failWord}}
          </text>
          <view class="line-icon line-icon--sm icon-arrow-right-sm"></view>
        </view>
      </view>
      <view class="rf-row">
        <text class="rf-label">{{t.reviewComment}}</text>
        <textarea
          class="rf-textarea"
          placeholder="{{t.reviewCommentPh}}"
          value="{{reviewFormComment}}"
          bindinput="onReviewCommentInput"
          maxlength="500"
          auto-height
        />
      </view>
    </view>
    <view class="rf-actions">
      <view class="rf-btn rf-btn-secondary" bindtap="onCancelReviewForm">
        <text>{{t.cancel}}</text>
      </view>
      <view class="rf-btn rf-btn-primary" bindtap="onConfirmSubmitReview">
        <text>{{t.confirmSubmit}}</text>
      </view>
    </view>
  </view>

  <!-- ══ ⑤ 底部固定操作栏 ══ -->
  <view wx:if="{{!loading && !showReviewForm}}" class="bottom-bar">
    <view class="bottom-bar-inner">
      <view class="bb-btn bb-btn-primary" bindtap="onSubmitReview">
        <text class="bb-btn-text">{{t.markComplete}}</text>
      </view>
    </view>
  </view>

  <ai-assistant />
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
