<view class="container">
  <!-- 吸顶区：搜索 + 扫码 + 筛选器（与 dashboard 一致的通用组件） -->
  <sticky-search-bar
    placeholder="搜索款号/订单号"
    value="{{keyword}}"
    show-scan="{{true}}"
    show-filter="{{true}}"
    bind:input="onSearchInput"
    bind:scan="onScanTap"
  >
    <view slot="filter">
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{statusTabs}}"
          wx:key="key"
          class="filter-pill {{activeFilter === item.key ? 'filter-pill--on' : ''}} {{item.pillClass}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
        >
          <text class="filter-text">{{item.label}}</text>
          <text wx:if="{{item.count > 0}}" class="filter-num">{{item.count}}</text>
        </view>
      </scroll-view>
    </view>
  </sticky-search-bar>

  <!-- 加载中 -->
  <view wx:if="{{loading && !filteredItems.length}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载采购任务中…</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{filteredItems.length === 0}}" class="empty-state">
    <view class="empty-icon line-icon icon-package"></view>
    <text class="empty-text">暂无采购任务</text>
    <text class="empty-hint">当有物料需要采购时，任务将出现在这里</text>
  </view>

  <!-- 任务列表（按款聚合卡片：与裁剪管理页同款紧凑布局） -->
  <block wx:else>
    <view
      wx:for="{{filteredItems}}"
      wx:key="groupKey"
      class="task-card procurement-task-card"
      data-order-no="{{item.orderNo}}"
      data-style-no="{{item.styleNo}}"
      data-pattern-production-id="{{item.patternProductionId}}"
      data-source-type="{{item.sourceType}}"
      bindtap="onViewDetail"
    >
      <!-- 头部：款式图 + 款号信息 + 右侧状态/操作（对照裁剪卡片） -->
      <view class="card-header procurement-card-header">
        <view class="card-media procurement-card-media">
          <image
            wx:if="{{item.styleCoverUrl}}"
            class="media-img"
            src="{{item.styleCoverUrl}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <view wx:else class="media-placeholder line-icon icon-package"></view>
        </view>
        <view class="card-title-area procurement-card-title-area">
          <text class="style-no">{{item.styleNo || '未知款号'}}</text>
          <text class="style-name" wx:if="{{item.styleName}}">{{item.styleName}}</text>
          <text class="order-no" wx:if="{{item.orderNo}}">{{item.orderNo}}</text>
        </view>
        <view class="procurement-card-right">
          <text class="tag {{item.statusTagClass}}">{{item.statusLabel}}</text>
          <view
            wx:if="{{item.isPending}}"
            class="btn-claim-sm"
            data-group-key="{{item.groupKey}}"
            catchtap="onClaimPurchase"
            hover-class="btn-claim-sm-hover"
            hover-stay-time="100"
          >{{item.pendingCount > 1 ? '领取(' + item.pendingCount + '项)' : '领取'}}</view>
          <view wx:else class="btn-detail-inline">详情 ›</view>
        </view>
      </view>

      <!-- 紧凑统计条：物料 / 总量 / 交货日期 / 是否延期（供应商、采购员、到货明细等进详情页看） -->
      <view class="card-body procurement-card-body">
        <view class="stat-cell">
          <text class="stat-cell-label">物料</text>
          <text class="stat-cell-value">{{item.materialCount}}项</text>
        </view>
        <view class="stat-cell">
          <text class="stat-cell-label">总量</text>
          <text class="stat-cell-value">{{item.quantityText}}</text>
        </view>
        <view class="stat-cell">
          <text class="stat-cell-label">交货日期</text>
          <text class="stat-cell-value">{{item.dateText || '-'}}</text>
        </view>
        <view class="stat-cell">
          <text class="stat-cell-label">延期</text>
          <text class="stat-cell-value {{item.overdue ? 'stat-cell-value--danger' : ''}}">{{item.overdueText}}</text>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="no-more">已显示全部任务</view>
  </block>
  <ai-assistant />
</view>
