<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{materialPurchases.length === 0}}">
    <view class="empty-icon line-icon icon-package"></view>
    <text class="empty-text">{{t.noMaterials}}</text>
  </view>

  <block wx:else>
    <view class="detail-body">

      <!-- Card 1: 订单头部 -->
      <view class="detail-card order-header">
        <view class="header-top">
          <view class="order-media">
            <image wx:if="{{styleImage}}" class="order-cover" src="{{styleImage}}" mode="aspectFit" lazy-load />
            <view wx:else class="media-placeholder line-icon icon-package"></view>
          </view>
          <view class="header-title">
            <text class="order-no">{{isSampleMode ? t.samplePurchaseW : orderNo}}</text>
            <text class="style-no" wx:if="{{styleNo}}">{{t.styleNoPrefix}} {{styleNo}}</text>
          </view>
          <text class="tag tag-{{overallStatusColor}}">{{overallStatusText}}</text>
        </view>

        <view class="header-summary">
          <view class="summary-item">
            <text class="summary-label">{{t.wordTotal}}</text>
            <text class="summary-value">{{materialPurchases.length}}</text>
            <text class="summary-label">{{t.wordItems}}</text>
          </view>
          <view class="summary-divider"></view>
          <view class="summary-item">
            <text class="summary-label">{{t.arrivalRateLabel}}</text>
            <text class="summary-value summary-primary">{{overallArrivalRate}}%</text>
          </view>
        </view>
      </view>

      <!-- Card 2: 统计概览 -->
      <view class="detail-card stats-card">
        <view class="stats-grid">
          <view class="stat-item">
            <text class="stat-label">{{t.itemCountLabel}}</text>
            <text class="stat-value">{{materialPurchases.length}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">{{t.overallArrival}}</text>
            <text class="stat-value stat-primary">{{overallArrivalRate}}%</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">{{t.returnStatusLabel}}</text>
            <text class="stat-value-text stat-{{hasReturnConfirmed ? 'success' : 'warning'}}">{{hasReturnConfirmed ? t.returnedLabel : t.statusDoingW}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">{{t.purchaseStage}}</text>
            <text class="stat-value-text stat-{{overallStatusColor}}">{{overallStatusText}}</text>
          </view>
        </view>
        <view class="overall-progress">
          <view class="overall-progress-track">
            <view class="overall-progress-fill" style="width: {{overallArrivalRate > 100 ? 100 : overallArrivalRate}}%"></view>
          </view>
        </view>
      </view>

      <!-- Card 3: 物料到货进度 -->
      <view class="detail-card material-list">
        <view class="section-head">
          <text class="section-title">{{t.arrivalProgress}}</text>
          <text class="section-count">{{materialPurchases.length}}{{t.wordItems}}</text>
        </view>

        <view
          wx:for="{{materialPurchases}}"
          wx:key="id"
          class="material-item {{item.isComplete ? 'item-done' : ''}}"
        >
          <!-- 物料信息行 -->
          <view class="mat-info">
            <view class="mat-info-left">
              <text class="mat-name">{{item.materialName || t.unknownMatW}}</text>
              <text class="mat-desc">{{item.materialTypeCN}}{{item.materialCode ? ' · ' + t.codePrefix + ' ' + item.materialCode : ''}}{{item.specifications ? ' · ' + t.specPrefix + ' ' + item.specifications : ''}} · {{t.unitPrefix}} {{item.unit || t.meterWord}}</text>
            </view>
            <view class="mat-tags">
              <text class="tag tag-{{item.statusColor}}">{{item.statusText}}</text>
              <text wx:if="{{item.returnConfirmed}}" class="tag tag-green">{{t.returnedLabel}}</text>
            </view>
          </view>

          <!-- 数量统计 4 列 -->
          <view class="qty-grid">
            <view class="qty-item">
              <text class="qty-lbl">{{t.demandLabel}}</text>
              <text class="qty-val">{{item.purchaseQuantity || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">{{t.arrivedShort}}</text>
              <text class="qty-val">{{item.arrivedQuantity || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">{{t.pendingShort}}</text>
              <text class="qty-val qty-pending">{{item.pendingQuantity || (item.purchaseQuantity - item.arrivedQuantity) || 0}}</text>
            </view>
            <view class="qty-item">
              <text class="qty-lbl">{{t.arrivalRateLabel}}</text>
              <text class="qty-val qty-primary">{{item.arrivalRate || 0}}%</text>
            </view>
          </view>

          <!-- 创建/领取/回料信息 -->
          <text class="mat-meta">{{item.creatorName ? t.creatorPrefix + item.creatorName + ' · ' : ''}}{{t.pickupPrefix}}{{item.receiverName || '-'}}{{item.returnConfirmed ? t.returnPrefix + (item.returnQuantity || item.arrivedQuantity) + (item.unit || '') + ' ' + (item.returnConfirmerName || '') + ' ' + (item.returnConfirmTimeText || '') : ''}}</text>

          <!-- 进度条 -->
          <view class="progress-bar">
            <view class="progress-fill {{(item.returnConfirmed || item.isComplete) ? 'fill-success' : ''}}" style="width: {{item.arrivalRate > 100 ? 100 : item.arrivalRate}}%"></view>
          </view>

          <!-- 到货数量输入 -->
          <view class="item-input-row" wx:if="{{item.isActionable && !item.returnConfirmed}}">
            <view class="input-wrap">
              <view class="input-icon line-icon icon-search"></view>
              <input
                class="input-field"
                type="digit"
                placeholder="{{t.arrivalQtyPh}}"
                placeholder-class="input-placeholder"
                data-id="{{item.id || item.purchaseId}}"
                bindinput="onMaterialInput"
                value="{{item.inputQuantity}}"
              />
            </view>
            <view
              wx:if="{{item.canConfirmReturn}}"
              class="btn-return-confirm"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              data-arrived="{{item.arrivedQuantity}}"
              data-purchase="{{item.purchaseQuantity}}"
              data-unit="{{item.unit || ''}}"
              bindtap="onReturnConfirm"
              hover-class="btn-hover"
              hover-stay-time="100"
            >{{t.confirmReturnBtn}}</view>
          </view>

          <!-- 单条操作按钮：确认完成 / 撤回到货 -->
          <view class="item-action-row" wx:if="{{(item.canConfirmComplete || item.canCancelReceive) && !item.returnConfirmed}}">
            <view
              wx:if="{{item.canConfirmComplete}}"
              class="btn-action btn-action-primary"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              bindtap="onConfirmComplete"
              hover-class="btn-hover"
              hover-stay-time="100"
            >{{t.confirmCompleteBtn}}</view>
            <view
              wx:if="{{item.canCancelReceive}}"
              class="btn-action btn-action-danger"
              data-id="{{item.id || item.purchaseId}}"
              data-name="{{item.materialName}}"
              bindtap="onCancelReceive"
              hover-class="btn-hover"
              hover-stay-time="100"
            >{{t.withdrawArrival}}</view>
          </view>

          <!-- 需采购提示 -->
          <view class="receive-hint" wx:if="{{item.needsReceive}}">
            <text>{{t.needPurchaseHint}}</text>
          </view>
        </view>
      </view>

      <!-- Card 4: 备注 -->
      <view class="detail-card remark-section">
        <text class="section-title">{{t.remarkNote}}</text>
        <view class="remark-wrap">
          <textarea
            class="remark-input"
            placeholder="{{t.lowRateRemark}}"
            placeholder-class="remark-placeholder"
            bindinput="onRemarkInput"
            value="{{remark}}"
            maxlength="200"
          />
        </view>
      </view>

    </view>
  </block>
  <ai-assistant />
</view>

<!-- 底部操作栏：领料出库 + 3 主操作 -->
<view class="footer-bar footer-bar-stack" wx:if="{{materialPurchases.length > 0 && !loading}}">
  <view
    class="btn-picking-outline {{hasReturnConfirmed ? 'btn-disabled' : ''}}"
    hover-class="{{hasReturnConfirmed ? '' : 'footer-bar-hover'}}"
    bindtap="onOpenPicking"
  >{{t.pickupOutbound}}</view>
  <view class="footer-bar-row">
    <view
      class="btn-outline {{hasReturnConfirmed ? 'btn-disabled' : ''}}"
      hover-class="{{hasReturnConfirmed ? '' : 'footer-bar-hover'}}"
      bindtap="onReceiveAll"
    >{{t.buyAllBtn}}</view>
    <view
      class="btn-outline {{(!hasInput || submitting || hasReturnConfirmed) ? 'btn-disabled' : ''}}"
      hover-class="{{(hasInput && !submitting && !hasReturnConfirmed) ? 'footer-bar-hover' : ''}}"
      bindtap="onSubmit"
    >{{t.submitArrivalBtn}}</view>
    <view
      wx:if="{{!isSampleMode}}"
      class="btn-primary {{(!canConfirmProcurement || hasReturnConfirmed) ? 'btn-disabled' : ''}}"
      hover-class="{{(canConfirmProcurement && !hasReturnConfirmed) ? 'footer-bar-hover' : ''}}"
      bindtap="onConfirmProcurement"
    >{{t.completeAllBtn}}</view>
  </view>
</view>

<!-- 领料出库弹窗 -->
<view class="picking-modal-mask" wx:if="{{showPickingModal}}" bindtap="onPickingModalClose">
  <view class="picking-modal" catchtap="">
    <view class="picking-modal-header">
      <text class="picking-modal-title">{{t.pickupOutbound}}</text>
      <view class="picking-modal-close" bindtap="onPickingModalClose">×</view>
    </view>
    <view class="picking-modal-tip">{{t.pickupHint}}</view>
    <scroll-view scroll-y class="picking-modal-body">
      <view
        wx:for="{{pickingItems}}"
        wx:key="id"
        class="picking-item"
      >
        <view class="picking-item-info">
          <text class="picking-item-name">{{item.materialName || t.unknownMatW}}</text>
          <text class="picking-item-desc">{{item.materialCode ? t.codePrefix + ' ' + item.materialCode + ' · ' : ''}}{{item.specifications ? t.specPrefix + ' ' + item.specifications + ' · ' : ''}}{{t.unitPrefix}} {{item.unit || t.meterWord}}</text>
          <text class="picking-item-stock">{{t.availableArrival}}{{item.arrivedQuantity || 0}}{{item.unit || ''}}</text>
        </view>
        <view class="picking-item-input">
          <input
            class="picking-input"
            type="digit"
            placeholder="{{t.pickupQtyPh}}"
            placeholder-class="picking-input-placeholder"
            data-index="{{index}}"
            bindinput="onPickQtyInput"
            value="{{item.pickQuantity}}"
          />
        </view>
      </view>
      <view wx:if="{{pickingItems.length === 0}}" class="picking-empty">{{t.noPickupShort}}</view>
    </scroll-view>
    <view class="picking-modal-footer">
      <view class="picking-btn-cancel" bindtap="onPickingModalClose" hover-class="btn-hover" hover-stay-time="100">{{t.cancel}}</view>
      <view class="picking-btn-confirm" bindtap="onConfirmPicking" hover-class="btn-hover" hover-stay-time="100">{{t.submitPickupBtn}}</view>
    </view>
  </view>
</view>

<!-- 回料确认弹窗（含图片上传，对齐PC端） -->
<view class="return-confirm-modal-mask" wx:if="{{showReturnConfirmModal}}" bindtap="onReturnConfirmModalClose">
  <view class="return-confirm-modal" catchtap="">
    <view class="return-confirm-modal-header">
      <text class="return-confirm-modal-title">{{t.confirmReturnBtn}}</text>
      <view class="return-confirm-modal-close" bindtap="onReturnConfirmModalClose">×</view>
    </view>
    <view class="return-confirm-modal-body">
      <text class="return-confirm-material-name">{{returnConfirmItem.name || t.unknownMatW}}</text>
      <view class="return-confirm-input-wrap">
        <text class="return-confirm-input-label">{{t.returnQtyLabel}}</text>
        <input
          class="return-confirm-input"
          type="digit"
          value="{{returnConfirmQty}}"
          bindinput="onReturnConfirmQtyInput"
          placeholder="{{t.returnQtyPh}}"
          placeholder-class="return-confirm-input-placeholder"
        />
        <text class="return-confirm-input-unit">{{returnConfirmItem.unit || ''}}</text>
      </view>

      <!-- 图片上传 -->
      <view class="return-confirm-image-section">
        <text class="return-confirm-image-label">{{t.returnVoucher}}</text>
        <view class="return-confirm-image-grid">
          <view
            wx:for="{{returnConfirmImages}}"
            wx:key="index"
            class="return-confirm-image-item"
          >
            <image
              class="return-confirm-image-thumb"
              src="{{item.authed}}"
              mode="aspectFit"
              bindtap="onPreviewReturnImage"
              data-url="{{item.authed}}"
            />
            <view
              class="return-confirm-image-delete"
              bindtap="onDeleteReturnImage"
              data-index="{{index}}"
            >×</view>
          </view>
          <view
            wx:if="{{returnConfirmImages.length < 5}}"
            class="return-confirm-image-add"
            bindtap="onUploadReturnImage"
          >
            <text class="return-confirm-image-add-icon">+</text>
            <text class="return-confirm-image-add-text">{{t.uploadVoucher}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="return-confirm-modal-footer">
      <view class="return-confirm-btn-cancel" bindtap="onReturnConfirmModalClose" hover-class="btn-hover" hover-stay-time="100">{{t.cancel}}</view>
      <view class="return-confirm-btn-confirm {{returnConfirmSubmitting ? 'btn-disabled' : ''}}" bindtap="onSubmitReturnConfirm" hover-class="btn-hover" hover-stay-time="100">{{t.confirmReturnBtn}}</view>
    </view>
  </view>
</view>
