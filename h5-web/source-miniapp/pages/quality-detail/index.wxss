/* ========== 质检详情页 ========== */
/* 基于设计 Token（CSS 变量）实现，与列表页保持一致 */

.container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 0 var(--page-padding-x);
  padding-bottom: var(--space-40);
  box-sizing: border-box;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: var(--space-24);
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
}
.loading-inline {
  padding: var(--space-40) 0;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-32);
}
.empty-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  font-weight: 600;
}
.empty-hint {
  margin-top: var(--space-12);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.empty-inline {
  padding: var(--space-60) 0;
  text-align: center;
}
.empty-text-inline {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* 卡片基础 */
.detail-card {
  margin: 0 0 12px 0;
  padding: 14px;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-sizing: border-box;
  box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.04));
}
.detail-card.section-pending {
  border-top: 6rpx solid var(--color-primary);
}

/* 卡片标题行 */
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-24);
}
.card-title-with-tag {
  display: flex;
  align-items: center;
}
.card-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}
.card-title-text {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-20);
  display: block;
}
.card-title-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.card-badge {
  margin-left: var(--space-16);
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 var(--space-10);
  text-align: center;
  font-size: var(--font-size-2xs);
  color: var(--color-text-white);
  background: var(--color-text-tertiary);
  border-radius: var(--radius-md);
}
.card-badge--primary {
  background: var(--color-primary);
}
.card-badge--ai {
  background: linear-gradient(135deg, var(--color-purple), var(--color-purple-light));
}
.card-collapse-icon {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  padding: var(--space-8) var(--space-16);
}

/* ========== 1.5 页内 tab 栏（质检明细 / 尺寸表，对齐样衣开发详情页） ========== */
.detail-tabs {
  display: flex;
  margin: 0 var(--space-24);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--color-border-light);
}
.detail-tab {
  flex: 1;
  text-align: center;
  padding: var(--space-20) 0;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  position: relative;
}
.detail-tab--active {
  color: var(--color-primary);
  font-weight: 600;
}
.detail-tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: var(--radius-6);
  background: var(--color-primary);
}

/* ========== 尺寸表（横向：部位为行，尺码为列，对齐样衣开发详情页） ========== */
.size-scroll {
  width: 100%;
  overflow: hidden;
}
.size-table {
  display: inline-flex;
  flex-direction: column;
  min-width: 100%;
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.size-row {
  display: flex;
  border-bottom: 1px solid var(--color-border-light);
}
.size-row:last-child {
  border-bottom: none;
}
.size-row--head {
  background: var(--color-bg-page);
}
.size-row--head .size-cell {
  font-weight: 600;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}
.size-cell {
  padding: var(--space-16) var(--space-12);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  white-space: nowrap;
  text-align: center;
  flex-shrink: 0;
}
.size-cell--part { width: 160rpx; text-align: left; font-weight: 500; }
.size-cell--size { width: 120rpx; font-weight: 600; }
.size-cell--val { width: 120rpx; }

/* ========== 基本信息卡 ========== */
.basic-header {
  display: flex;
  align-items: flex-start;
}
.basic-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--color-bg-muted);
}
.basic-header-info {
  margin-left: var(--space-24);
  flex: 1;
  min-width: 0;
}
.basic-header-info--full {
  margin-left: 0;
}
.basic-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.basic-order-no {
  font-size: var(--font-size-lg-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}
.status-pill {
  margin-left: var(--space-16);
  padding: var(--space-4) var(--space-16);
  border-radius: var(--radius-md);
  font-size: var(--font-size-2xs);
  font-weight: 500;
}
.status-pill.status-success { background: rgba(82, 196, 26, 0.12); color: var(--color-success); }
.status-pill.status-error { background: rgba(245, 63, 63, 0.12); color: var(--color-danger); }
.status-pill.status-warning { background: rgba(255, 159, 0, 0.12); color: var(--color-warning); }
.status-pill.status-info { background: rgba(var(--color-primary-rgb), 0.12); color: var(--color-primary); }
.basic-style-no {
  margin-top: var(--space-6);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
}
.basic-info-rows {
  margin-top: var(--space-12);
}
.basic-info-row {
  display: flex;
  align-items: center;
  padding: var(--space-12) 0;
  border-bottom: 1rpx solid var(--color-border-light);
  font-size: var(--font-size-sm);
}
.basic-info-row.last { border-bottom: none; }
.basic-info-label {
  width: 120rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.basic-info-value {
  flex: 1;
  color: var(--color-text-primary);
  word-break: break-all;
}
.remain-badge {
  margin-left: var(--space-16);
  padding: var(--space-2) var(--space-12);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  font-weight: 600;
}
.remain-badge.remain-normal { background: rgba(82, 196, 26, 0.12); color: var(--color-success); }
.remain-badge.remain-warn { background: rgba(255, 159, 0, 0.12); color: var(--color-warning); }
.remain-badge.remain-danger { background: rgba(245, 63, 63, 0.12); color: var(--color-danger); }

/* ========== 2. 数量进度卡 ========== */
.qty-progress-grid {
  display: flex;
  align-items: stretch;
}
.qty-progress-col {
  flex: 1;
  text-align: center;
  position: relative;
}
.qty-progress-col:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 10%;
  height: 80%;
  width: 1rpx;
  background: var(--color-border-light);
}
.qty-progress-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  display: block;
}
.qty-progress-value {
  font-size: var(--font-size-3xl);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: var(--space-8);
  display: block;
}
.qty-progress-value.qty-success { color: var(--color-success); }
.qty-progress-value.qty-error { color: var(--color-danger); }

/* ========== 3/4. 信息行 / 质检明细 ========== */
.info-rows {
  margin-top: var(--space-4);
}
.info-row {
  display: flex;
  align-items: flex-start;
  padding: var(--space-16) 0;
  border-bottom: 1rpx solid var(--color-border-light);
  font-size: var(--font-size-md);
}
.info-row.last { border-bottom: none; }
.info-row-label {
  width: 160rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.info-row-value {
  flex: 1;
  color: var(--color-text-primary);
  word-break: break-all;
}
.info-row-value--right { text-align: right; }
.info-row-value.defect-value { color: var(--color-danger); font-weight: 500; }

.defect-photo-section {
  margin-top: var(--space-20);
}
.defect-photo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-16);
}
.defect-photo-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}
.defect-photo-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.photo-grid-3 {
  display: flex;
  flex-wrap: wrap;
}
.defect-photo-img {
  width: 200rpx;
  height: 200rpx;
  margin-right: var(--space-12);
  margin-bottom: var(--space-12);
  border-radius: var(--radius-sm);
  background: var(--color-bg-muted);
}

/* ========== 5. 质检概览（待质检/待入库/合格率，紧凑小卡片） ========== */
.overview-grid {
  display: flex;
  margin: var(--space-12) 0;
  gap: 12rpx;
}
.overview-card {
  flex: 1;
  background: var(--color-bg-card);
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-16) var(--space-8);
  box-sizing: border-box;
}
.overview-card--primary { border-top: 6rpx solid var(--color-primary); }
.overview-card--warning { border-top: 6rpx solid var(--color-warning); }
.overview-card--success { border-top: 6rpx solid var(--color-success); }
.overview-card--active { box-shadow: 0 8rpx 32rpx rgba(22, 93, 255, 0.16); }
.overview-value {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.1;
}
.overview-label {
  margin-top: var(--space-6);
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}
.overview-hint {
  margin-top: var(--space-8);
  font-size: var(--font-size-xxs);
  color: var(--color-primary);
}
.overview-hint--muted { color: var(--color-text-quaternary); }

/* ========== 6. 菲号多选列表（页面内操作，与 PC 端对齐） ========== */
.bundle-select-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-16) 0;
  margin-bottom: var(--space-12);
  border-bottom: 1rpx solid var(--color-border-light);
}
.bundle-select-actions {
  display: flex;
  align-items: center;
}
.bundle-select-action {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  padding: var(--space-8) var(--space-20);
  border-right: 1rpx solid var(--color-border-light);
}
.bundle-select-action:last-child { border-right: none; }
.bundle-select-summary {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.bundle-select-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.bundle-select-item {
  display: flex;
  align-items: center;
  padding: var(--space-20);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}
.bundle-select-item--active {
  background: rgba(var(--color-primary-rgb), 0.06);
  border-color: var(--color-primary);
}
.bundle-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: var(--space-20);
  background: var(--color-bg-card);
  transition: all 0.15s ease;
}
.bundle-checkbox--checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.bundle-checkbox-icon {
  color: var(--color-text-white);
  font-size: var(--font-size-sm);
  font-weight: 700;
  line-height: 1;
}
.bundle-select-info {
  flex: 1;
  min-width: 0;
}
.bundle-select-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.bundle-select-no {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  word-break: break-all;
}
.bundle-select-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-6);
}
.bundle-select-meta-item {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-right: var(--space-16);
}
.bundle-select-meta-item:last-child { margin-right: 0; }

.tag {
  display: inline-block;
  padding: var(--space-2) var(--space-12);
  border-radius: var(--radius-xs);
  font-size: var(--font-size-2xs);
  line-height: 1.6;
}
.tag-info {
  background: rgba(var(--color-primary-rgb), 0.1);
  color: var(--color-primary);
  /* 二维码号可能很长，允许换行，防止出界 */
  max-width: 100%;
  word-break: break-all;
  white-space: normal;
}
.tag-current { background: rgba(255, 159, 0, 0.12); color: var(--color-warning); }
.tag-default { background: var(--color-bg-muted); color: var(--color-text-tertiary); }

/* ========== 页面内质检表单（单选，原弹窗样式改为 .qc-form-*） ========== */
.qc-form {
  margin-top: var(--space-24);
  padding: var(--space-24);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-light);
}
.batch-unqual-form {
  background: rgba(245, 63, 63, 0.03);
  border-color: rgba(245, 63, 63, 0.2);
}
.qc-form-title {
  font-size: var(--font-size-md-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-20);
}
.qc-form-info-card,
.wh-form-info-card {
  background: var(--color-bg-muted);
  
  
  margin-bottom: var(--space-20);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 14px;
  box-sizing: border-box;
}
.qc-form-info-row,
.wh-form-info-row {
  display: flex;
  align-items: center;
  padding: var(--space-10) 0;
  font-size: var(--font-size-sm);
}
.qc-form-info-label,
.wh-form-info-label {
  width: 140rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.qc-form-info-value,
.wh-form-info-value {
  flex: 1;
  color: var(--color-text-primary);
  word-break: break-all;
}
.qc-form-info-strong,
.wh-form-info-strong {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--color-primary);
}

.qc-form-row,
.wh-form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: var(--space-20);
}
.qc-form-col,
.qc-form-col-full,
.wh-form-col-full {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.qc-form-label,
.wh-form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-12);
}
.qc-form-input {
  height: 80rpx;
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-20);
  font-size: var(--font-size-md-lg);
  color: var(--color-text-primary);
}
.qc-form-picker,
.wh-form-picker {
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 var(--space-20);
}
.qc-form-textarea {
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: var(--space-16) var(--space-20);
  min-height: 120rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  width: 100%;
  box-sizing: border-box;
}
.qc-form-divider,
.wh-form-divider {
  height: 1rpx;
  background: var(--color-border-light);
  margin: var(--space-20) 0;
}
.qc-form-actions,
.wh-form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: var(--space-8);
}

/* 图片上传（质检表单复用） */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.upload-img {
  width: 100%;
  height: 100%;
  background: var(--color-bg-muted);
}
.upload-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--color-text-white);
  border-radius: 0 0 0 var(--radius-12);
  font-size: var(--font-size-2xs);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
}
.upload-add-icon {
  font-size: var(--font-size-4xl);
  color: var(--color-text-tertiary);
  line-height: 1;
}
.upload-add-text {
  margin-top: var(--space-8);
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

/* picker 通用值显示 */
.picker-value {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  width: 100%;
}
.picker-placeholder {
  color: var(--color-text-quaternary);
}

/* 批量操作按钮区 */
.batch-actions {
  margin-top: var(--space-24);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 7. 质检记录列表 ========== */
.qc-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.qc-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 14px;
  box-sizing: border-box;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
}
.qc-card-highlighted {
  border-color: var(--color-warning);
  background: var(--color-warning-bg);
}
.qc-card--actionable {
  border-left-color: var(--color-primary);
}
.qc-card--warning {
  border-left-color: var(--color-warning);
}
.qc-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-16);
  flex-wrap: wrap;
  gap: 8rpx;
}
.qc-card-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.qc-wh-no {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}
.qc-card-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.quality-status {
  font-size: var(--font-size-xs);
  padding: var(--space-2) var(--space-12);
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.quality-status.status-success { background: rgba(82, 196, 26, 0.12); color: var(--color-success); }
.quality-status.status-error { background: rgba(245, 63, 63, 0.12); color: var(--color-danger); }
.quality-status.status-warning { background: rgba(255, 159, 0, 0.12); color: var(--color-warning); }
.quality-status.status-info { background: rgba(var(--color-primary-rgb), 0.12); color: var(--color-primary); }
.qc-card-body {
  font-size: var(--font-size-sm);
}
.qc-row {
  display: flex;
  padding: var(--space-8) 0;
}
.qc-label {
  width: 140rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.qc-value {
  flex: 1;
  color: var(--color-text-primary);
  word-break: break-all;
}
.qc-error-text { color: var(--color-danger); }
.qc-qty-row {
  display: flex;
  margin: var(--space-12) 0;
  gap: 12rpx;
  flex-wrap: wrap;
}
.qc-qty-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-xs);
  padding: var(--space-12) var(--space-16);
  text-align: center;
}
.qc-qty-label {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
  display: block;
}
.qc-qty-value {
  font-size: var(--font-size-md-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
}
.qc-qty-value.qc-success { color: var(--color-success); }
.qc-qty-value.qc-error { color: var(--color-danger); }
.qc-qty-value.qc-info { color: var(--color-primary); }
.qc-photos {
  margin-top: var(--space-16);
  padding-top: var(--space-16);
  border-top: 1rpx solid var(--color-border-light);
}
.qc-photos-title {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-12);
}

/* ========== 页面内入库表单（记录下方展开，原弹窗样式改为 .wh-form-*） ========== */
.wh-form {
  margin-top: var(--space-20);
  padding: var(--space-24);
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-light);
}
.wh-form-title {
  font-size: var(--font-size-md-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-20);
}

/* ========== 8. AI 质检助手 ========== */
.ai-card { overflow: hidden; }
.ai-urgent-tip {
  display: flex;
  align-items: center;
  background: var(--color-danger-bg);
  border-radius: var(--radius-sm);
  padding: var(--space-16) var(--space-20);
  margin-bottom: var(--space-20);
}
.urgent-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-danger);
  color: var(--color-text-white);
  font-size: var(--font-size-xs);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-16);
  flex-shrink: 0;
}
.urgent-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  line-height: 1.5;
}
.ai-history-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: var(--space-20);
}
.history-block {
  flex: 1;
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: var(--space-16);
  text-align: center;
}
.history-label {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
  display: block;
}
.history-value {
  font-size: var(--font-size-lg);
  font-weight: 700;
  margin-top: var(--space-4);
  display: block;
}
.history-value.verdict-good { color: var(--color-success); }
.history-value.verdict-warn { color: var(--color-warning); }
.history-value.verdict-critical { color: var(--color-danger); }
.ai-section { margin-bottom: var(--space-20); }
.ai-section-title {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-12);
}
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.tip-bullet {
  color: var(--color-primary);
  margin-right: var(--space-12);
  font-weight: 700;
}
.defect-advice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.defect-advice-item {
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  padding: var(--space-16) var(--space-20);
}
.defect-advice-label {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: var(--space-6);
}
.defect-advice-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ========== 9. BOM 物料 ========== */
.bom-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.bom-item {
  background: var(--color-bg-muted);
  
  

  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 12px;
  box-sizing: border-box;
}
.bom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-6);
}
.bom-code {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}
.bom-type-tag {
  font-size: var(--font-size-xxs);
  color: var(--color-primary);
  background: rgba(var(--color-primary-rgb), 0.1);
  padding: var(--space-2) var(--space-12);
  border-radius: var(--radius-xs);
}
.bom-name {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--space-6);
}
.bom-meta {
  display: flex;
  flex-wrap: wrap;
}
.bom-meta-item {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
  margin-right: var(--space-16);
}

/* ========== 按钮通用样式 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 var(--space-28);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-md);
  font-weight: 500;
  line-height: 1;
  border: none;
  box-sizing: border-box;
}
.btn::after { border: none; }
.btn-sm {
  height: 56rpx;
  padding: 0 var(--space-20);
  font-size: var(--font-size-xs);
}
.btn-block {
  display: flex;
  width: 100%;
  flex: 1;
}
.btn-primary-outline {
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
.btn-primary-solid {
  background: var(--color-primary);
  color: var(--color-text-white);
  border: 2rpx solid var(--color-primary);
}
.btn-default-outline {
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}
.btn-success-outline {
  background: var(--color-bg-card);
  color: var(--color-success);
  border: 2rpx solid var(--color-success);
}
.btn-warning-outline {
  background: var(--color-bg-card);
  color: var(--color-warning);
  border: 2rpx solid var(--color-warning);
}
.btn-danger-outline {
  background: var(--color-bg-card);
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
}

/* 线性图标占位 */
.line-icon { display: inline-block; }
.line-icon--xl { width: 64rpx; height: 64rpx; }
.icon-alert::before { content: '!'; font-size: var(--font-size-4xl); color: var(--color-text-tertiary); }

/* ═══ D-185：仓库/库位页面内直选 chips（对齐样衣仓库页风格） ═══ */
.wh-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-10);
}
/* D-517：库位可搜索选择行 */
.wh-loc-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 240rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md, 10rpx);
  border: 1px solid var(--color-border);
  background: var(--color-bg-card);
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}
.wh-loc-picker-value.is-placeholder {
  color: var(--color-text-tertiary);
}
.wh-loc-picker-arrow {
  color: var(--color-text-tertiary);
  margin-left: 10rpx;
}
.wh-chip {
  display: inline-flex;
  align-items: center;
  padding: var(--space-8) var(--space-24);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  border: 1px solid var(--color-border);
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}
.wh-chip--hover {
  opacity: 0.7;
}
.wh-chip--active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-text-white);
  font-weight: 600;
}
.wh-chip--loc.wh-chip--full {
  opacity: 0.45;
  border-style: dashed;
}
.wh-chip-qty {
  margin-left: var(--space-6);
  font-size: var(--font-size-2xs);
  opacity: 0.85;
  font-variant-numeric: tabular-nums;
}
.wh-chip-empty {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  padding: var(--space-8) 0;
}
