page { background-color: var(--color-bg-page); }
.container { padding: 0 var(--page-padding-x); min-height: 100vh; }

.body { height: calc(100vh - 76px); -webkit-overflow-scrolling: touch; }

/* ══ 卡片 ══ */
.sec {
  margin: var(--card-gap) 0; padding: var(--card-padding) var(--spacing-lg);
  background: var(--color-bg-card); border-radius: var(--radius-xl);
}
.sec-hd {
  display: flex; align-items: baseline; justify-content: space-between;
  font-size: var(--font-size-sm); font-weight: 600; color: var(--color-text-primary);
  margin-bottom: 12px; padding-bottom: 8px;
  border-bottom: 1px solid var(--color-border);
}
.sec-hd-x { font-size: var(--font-size-xs); font-weight: 400; color: var(--color-text-tertiary); }
.req { color: var(--color-danger); margin-right: 2px; }

/* ══ 款式头 ══ */
.style-row { display: flex; align-items: center; gap: 12px; }
.style-thumb {
  width: 52px; height: 52px; border-radius: var(--radius-sm); overflow: hidden;
  background: var(--color-bg-page); flex-shrink: 0;
}
.style-thumb image { width: 100%; height: 100%; display: block; }
.no-img {
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-size-lg); font-weight: 700; color: var(--color-primary); background: var(--color-primary-bg);
}
.style-txt { flex: 1; min-width: 0; }
.style-no { display: block; font-size: var(--font-size-base); font-weight: 700; color: var(--color-text-primary); }
.style-nm {
  display: block; font-size: var(--font-size-xs); color: var(--color-text-secondary); margin-top: 2px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.style-inp {
  display: block; width: 100%; height: 26px; padding: 0 8px;
  background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-xs);
  font-size: var(--font-size-base); font-weight: 700; color: var(--color-text-primary);
  box-sizing: border-box;
}
.style-inp.sub {
  height: 24px; margin-top: 4px;
  font-size: var(--font-size-xs); font-weight: 400;
}
.style-tag {
  flex-shrink: 0; font-size: var(--font-size-2xs); color: var(--color-primary-dark);
  background: var(--color-primary-bg); padding: 0 8px; height: 22px; line-height: 22px;
  border-radius: var(--radius-xs); font-weight: var(--font-weight-medium);
}

/* ══ 表单行 ══ */
.f-row-row { display: flex; gap: 10px; margin-bottom: 12px; }
.f-row-row:last-child { margin-bottom: 0; }
.f-col { flex: 1; min-width: 0; }

.f-row { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; min-height: 40px; }
.f-row:last-child { margin-bottom: 0; }

/* 行内标签（左侧固定宽，右对齐） */
.f-lbl {
  flex-shrink: 0; width: 56px;
  font-size: var(--font-size-sm); color: var(--color-text-secondary);
  text-align: right; line-height: 1.4;
}
/* 块级标签（并排列上方小标题） */
.f-lbl-blk {
  display: block; margin-bottom: 6px;
  font-size: var(--font-size-xs); color: var(--color-text-secondary); line-height: 1.4;
}

.f-inp {
  height: 40px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-sm);
  padding: 0 10px; font-size: var(--font-size-sm); color: var(--color-text-primary); width: 100%; box-sizing: border-box;
}
.f-pv {
  height: 40px; line-height: 40px;
  background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-sm);
  padding: 0 10px; font-size: var(--font-size-sm); color: var(--color-text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  box-sizing: border-box;
}
.ph { color: var(--color-text-placeholder); }

.f-btn {
  flex-shrink: 0; height: 40px; padding: 0 14px;
  background: var(--color-primary); border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
}
.f-btn text { font-size: var(--font-size-xs); color: var(--color-text-white); font-weight: 500; }
.f-btn.ghost { background: var(--color-bg-page); border: 1px solid var(--color-border); }
.f-btn.ghost text { color: var(--color-text-secondary); }

.flex-1 { flex: 1; min-width: 0; }

/* 分段控件 */
.f-seg { display: flex; background: var(--color-bg-page); border-radius: var(--radius-sm); padding: 3px; flex-shrink: 0; }
.f-seg-i {
  padding: 0 16px; height: 34px; line-height: 34px;
  font-size: var(--font-size-sm); color: var(--color-text-secondary);
  border-radius: var(--radius-xs); text-align: center; white-space: nowrap;
}
.f-seg-i.on { background: var(--color-bg-card); color: var(--color-text-primary); font-weight: 600; box-shadow: var(--shadow-sm); }
.f-seg-i.danger.on { color: var(--color-danger); }

/* ══ 统计条 ══ */
.stat-bar {
  display: flex; flex-wrap: wrap; gap: 6px 10px;
  padding: 8px 10px; margin-bottom: 14px;
  background: var(--color-bg-page); border-radius: var(--radius-sm);
}
.stat-i { font-size: var(--font-size-2xs); color: var(--color-text-tertiary); }
.stat-n { font-size: var(--font-size-sm); font-weight: 700; color: var(--color-primary); margin: 0 1px; }

/* ══ 颜色 / 码数 区块 ══ */
.blk { margin-bottom: 14px; }
.blk:last-child { margin-bottom: 0; }
.blk-hd {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8px;
}
.blk-t { font-size: var(--font-size-sm); font-weight: 600; color: var(--color-text-primary); }
.blk-tip { font-size: var(--font-size-2xs); color: var(--color-text-tertiary); }
.blk-a {
  font-size: var(--font-size-xs); color: var(--color-primary);
  padding: 2px 10px; background: var(--color-primary-bg); border-radius: var(--radius-full);
}
.blk-a:active { opacity: 0.7; }
.blk-empty {
  font-size: var(--font-size-xs); color: var(--color-text-tertiary);
  padding: 10px; text-align: center;
  background: var(--color-bg-page); border-radius: var(--radius-sm);
}

.add-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.add-inp {
  height: 40px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-sm);
  padding: 0 10px; font-size: var(--font-size-sm); color: var(--color-text-primary); box-sizing: border-box;
}

.chip-wrap { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  padding: 0 14px; height: 32px; line-height: 32px;
  border-radius: var(--radius-lg); font-size: var(--font-size-sm);
  background: var(--color-bg-page); color: var(--color-text-secondary);
  border: 1px solid var(--color-border);
  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.chip.on {
  background: var(--color-primary-bg); color: var(--color-primary);
  border-color: var(--color-primary); font-weight: 600;
}
.chip:active { opacity: 0.75; }

/* ══ 批量铺量 ══ */
.qfill { display: flex; align-items: center; gap: 8px; }
.qfill-inp {
  width: 64px; height: 40px; background: var(--input-bg); border: 1px solid var(--input-border);
  border-radius: var(--radius-sm); padding: 0 8px; font-size: var(--font-size-sm);
  text-align: center; box-sizing: border-box; flex-shrink: 0;
}

/* ══ 二维矩阵（横向滚动 + 左侧固定） ══ */
.mx-wrap {
  margin-top: 4px;
  border: 1px solid var(--color-border); border-radius: var(--radius-sm);
  overflow: hidden; background: var(--color-bg-card);
}
.mx-scroll { width: 100%; white-space: nowrap; }
.mx { display: inline-block; min-width: 100%; }

.mx-row { display: flex; }
.mx-row + .mx-row { border-top: 1px solid var(--color-border); }

.mx-cell {
  flex: 0 0 120rpx; width: 120rpx;
  padding: 6px 4px; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: var(--color-bg-card);
}
.mx-cell + .mx-cell { border-left: 1px solid var(--color-border); }

/* 左侧颜色列：固定不随横向滚动 */
.mx-fix {
  position: sticky; left: 0; z-index: 5;
  flex: 0 0 130rpx; width: 130rpx;
  background: var(--color-bg-page);
  border-right: 1px solid var(--color-border);
}
.mx-cname {
  font-size: var(--font-size-xs); font-weight: 600; color: var(--color-text-primary);
  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mx-csum {
  font-size: var(--font-size-2xs); color: var(--color-text-tertiary); margin-top: 2px;
  font-variant-numeric: tabular-nums;
}

.mx-head .mx-cell { height: 40px; background: var(--color-bg-page); }
.mx-szt {
  font-size: var(--font-size-2xs); font-weight: 600; color: var(--color-text-secondary);
  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.mx-head .mx-cell.mx-fix { font-size: var(--font-size-2xs); color: var(--color-text-secondary); }

.mx-inp {
  width: 100%; height: 32px;
  background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-xs);
  text-align: center; font-size: var(--font-size-sm); padding: 0 2px; box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}

.mx-foot .mx-cell {
  height: 36px; background: var(--color-bg-page);
  font-size: var(--font-size-xs); font-weight: 700; color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

/* ══ 定价 ══ */
.pp-total {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 10px; padding: 10px 12px;
  background: var(--color-primary-bg); border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.pp-total-lbl { font-size: var(--font-size-sm); color: var(--color-text-secondary); }
.pp-total-val { font-size: var(--font-size-lg); font-weight: 700; color: var(--color-primary); font-variant-numeric: tabular-nums; }

/* ══ 底部提交栏 ══ */
.bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 12px;
  padding: var(--spacing-sm) var(--page-padding-x);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: var(--color-bg-card); border-top: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}
.bar-sum { flex-shrink: 0; display: flex; flex-direction: column; }
.bar-sum-l { font-size: var(--font-size-2xs); color: var(--color-text-tertiary); }
.bar-sum-n { font-size: var(--font-size-lg); font-weight: 700; color: var(--color-primary); font-variant-numeric: tabular-nums; }
.bar-btn {
  flex: 1; height: var(--btn-height-md); background: var(--color-primary); border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--font-size-base); font-weight: 600; color: var(--color-text-white);
}
.bar-btn.dis { opacity: 0.5; }
