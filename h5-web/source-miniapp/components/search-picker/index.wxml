<!-- 可搜索选择器（底部弹层）—— 通用组件
     D-517：remote=true 时由父级按关键字请求接口（支持分页），remote=false 时本地过滤 -->
<view wx:if="{{visible}}" class="sp-mask" bindtap="onClose">
  <view class="sp-panel" catchtap="noop">
    <view class="sp-header">
      <text class="sp-title">{{title}}</text>
      <text class="sp-close" bindtap="onClose">✕</text>
    </view>

    <view class="sp-search">
      <text class="sp-search-icon">🔍</text>
      <input
        class="sp-search-input"
        value="{{keyword}}"
        placeholder="{{placeholder}}"
        confirm-type="search"
        bindinput="onInput"
      />
      <text wx:if="{{keyword}}" class="sp-search-clear" bindtap="onClearKeyword">✕</text>
    </view>

    <scroll-view
      scroll-y
      class="sp-list"
      enhanced
      show-scrollbar="{{false}}"
      bindscrolltolower="onLoadMore"
    >
      <view wx:if="{{filtered.length === 0 && !loading}}" class="sp-empty">
        {{options.length === 0 ? '暂无可选项' : (remote ? '没有匹配的结果，换个关键字试试' : '没有匹配的选项')}}
      </view>
      <view
        wx:for="{{filtered}}"
        wx:key="_key"
        class="sp-item {{value === item.value ? 'sp-item--active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelect"
      >
        <text class="sp-item-label">{{item.label}}</text>
        <text wx:if="{{value === item.value}}" class="sp-item-check">✓</text>
      </view>

      <!-- D-517：加载中 / 加载更多（远程分页） -->
      <view wx:if="{{loading}}" class="sp-loading">加载中…</view>
      <view wx:elif="{{remote && hasMore && filtered.length > 0}}" class="sp-loading" bindtap="onLoadMore">
        加载更多
      </view>
      <view wx:elif="{{remote && !hasMore && filtered.length > 0}}" class="sp-loading sp-loading--end">
        — 没有更多了 —
      </view>
    </scroll-view>
  </view>
</view>
