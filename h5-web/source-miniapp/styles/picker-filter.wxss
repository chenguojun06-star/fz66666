/* ============================================================
 * D-463：筛选器胶囊共享样式（filter-bar / picker-box）
 * 此前 8 个页面各自复制粘贴同一段定义（且 D-427 高亮态只同步了
 * 1 份）——统一收编到这里，页面 wxss 顶部 @import 本文件即可。
 * 规范出处：finance/payroll-approval（最完整版本含选中态）。
 * ============================================================ */

.filter-bar { display: flex; gap: 8px; }
.filter-item { flex: 1; min-width: 0; }

.picker-box {
  display: flex; align-items: center; justify-content: space-between;
  gap: 4px; padding: 0 12px; height: 32px;
  background: var(--color-bg-card); border-radius: var(--radius-full);
  box-shadow: var(--shadow-sm); box-sizing: border-box;
}

/* D-427：筛选器选中态（有筛选条件时高亮，便于识别当前视图） */
.picker-box--active {
  background: var(--color-primary-bg);
}
.picker-box--active .picker-text {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}
.picker-box--active .picker-chevron {
  border-top-color: var(--color-primary);
}

.picker-text {
  font-size: var(--font-size-sm); color: var(--color-text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.picker-chevron {
  flex-shrink: 0; width: 0; height: 0;
  border-left: 4px solid transparent; border-right: 4px solid transparent;
  border-top: 4px solid var(--color-text-tertiary);
}
