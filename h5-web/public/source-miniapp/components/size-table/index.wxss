/* D-302 共享尺寸表样式（与 order-detail D-252 同版式） */
.size-table-card {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--color-bg-container, #ffffff);
  border: 1rpx solid var(--color-border, #e5e7eb);
  border-radius: 12rpx;
}
.size-table-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.size-table-title {
  font-size: var(--font-size-sm, 13px);
  font-weight: 600;
  color: var(--color-text-primary, #1f2937);
}
.size-table-count {
  font-size: var(--font-size-xs, 12px);
  color: var(--color-text-tertiary, #9ca3af);
}
.size-table-scroll {
  width: 100%;
  -webkit-overflow-scrolling: touch;
}
.size-table {
  min-width: 100%;
  display: inline-block;
}
.st-row {
  display: flex;
  border-bottom: 1rpx solid var(--color-border, #e5e7eb);
}
.st-row:last-child {
  border-bottom: none;
}
.st-row--head {
  background: var(--color-bg-page, #f7f8fa);
}
.st-cell {
  flex: 0 0 auto;
  min-width: 110rpx;
  padding: 12rpx 14rpx;
  text-align: center;
  font-size: var(--font-size-xs, 12px);
  color: var(--color-text-primary, #1f2937);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.st-cell--part {
  min-width: 130rpx;
  text-align: left;
  color: var(--color-text-secondary, #6b7280);
}
.st-cell--head {
  font-weight: 600;
  color: var(--color-text-secondary, #6b7280);
}

/* D-304：度量方式列 */
.st-cell--measure {
  min-width: 220rpx;
  max-width: 320rpx;
  text-align: left;
  color: var(--color-text-secondary, #6b7280);
  white-space: normal;
  word-break: break-all;
}
