<view class="container">
  <scroll-view scroll-y class="body">
    <!-- ══ 款式 ══ -->
    <view class="sec">
      <view class="style-row">
        <image wx:if="{{coverImage}}" class="style-thumb" src="{{coverImage}}" mode="aspectFit" bindtap="onCoverPreview" data-url="{{coverImage}}" />
        <view wx:else class="style-thumb no-img"><text>{{styleNo || '款'}}</text></view>
        <view class="style-txt">
          <!-- 无资料下单：款号 / 款名可手填 -->
          <input wx:if="{{isNoData}}" class="style-inp" value="{{styleNo}}" bindinput="onStyleNoInput" placeholder="输入款号（选填）" />
          <text wx:else class="style-no">{{styleNo || '无款号'}}</text>
          <input wx:if="{{isNoData}}" class="style-inp sub" value="{{styleName}}" bindinput="onStyleNameInput" placeholder="输入款名（选填）" />
          <text wx:else class="style-nm">{{styleName || '无资料下单'}}</text>
        </view>
        <view wx:if="{{productCategory}}" class="style-tag">{{productCategory}}</view>
      </view>
    </view>

    <!-- ══ 订单信息 ══ -->
    <view class="sec">
      <view class="sec-hd">订单信息</view>

      <view class="f-row">
        <text class="f-lbl"><text class="req">*</text>订单号</text>
        <input class="f-inp flex-1" value="{{orderNo}}" bindinput="onOrderNoInput" placeholder="自动生成" />
        <view class="f-btn" bindtap="onAutoGenOrderNo"><text>生成</text></view>
      </view>

      <view class="f-row">
        <text class="f-lbl"><text class="req">*</text>生产方</text>
        <view class="f-seg">
          <view class="f-seg-i {{factoryMode==='INTERNAL'?'on':''}}" data-v="INTERNAL" bindtap="onFactoryModeTap">内部工厂</view>
          <view class="f-seg-i {{factoryMode==='EXTERNAL'?'on':''}}" data-v="EXTERNAL" bindtap="onFactoryModeTap">外发加工</view>
        </view>
      </view>

      <view wx:if="{{factoryMode==='INTERNAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>部门</text>
        <picker range="{{orgUnitList}}" range-key="name" bindchange="onOrgUnitChange" class="flex-1">
          <view class="f-pv {{orgUnitId?'':'ph'}}">{{orgUnitName || '选择部门'}}</view>
        </picker>
      </view>

      <view wx:if="{{factoryMode==='EXTERNAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>工厂</text>
        <picker range="{{factoryList}}" range-key="factoryName" bindchange="onFactoryChange" class="flex-1">
          <view class="f-pv {{factoryId?'':'ph'}}">{{factoryName || '选择工厂'}}</view>
        </picker>
      </view>
    </view>

    <!-- ══ 时间与交期 ══ -->
    <view class="sec">
      <view class="sec-hd">时间与交期</view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk"><text class="req">*</text>下单时间</text>
          <picker mode="date" value="{{plannedStartDate}}" bindchange="onStartDateChange">
            <view class="f-pv {{plannedStartDate?'':'ph'}}">{{plannedStartDate || '选择日期'}}</view>
          </picker>
        </view>
        <view class="f-col">
          <text class="f-lbl-blk"><text class="req">*</text>订单交期</text>
          <picker mode="date" value="{{plannedEndDate}}" bindchange="onEndDateChange">
            <view class="f-pv {{plannedEndDate?'':'ph'}}">{{plannedEndDate || '选择日期'}}</view>
          </picker>
        </view>
      </view>

      <view class="f-row">
        <text class="f-lbl">急单</text>
        <view class="f-seg">
          <view class="f-seg-i {{urgencyLevel==='normal'?'on':''}}" data-v="normal" bindtap="onUrgencyTap">普通</view>
          <view class="f-seg-i danger {{urgencyLevel==='urgent'?'on':''}}" data-v="urgent" bindtap="onUrgencyTap">急单</view>
        </view>
      </view>
    </view>

    <!-- ══ 业务信息 ══ -->
    <view class="sec">
      <view class="sec-hd">业务信息</view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">客户</text>
          <picker wx:if="{{customerList.length > 0}}" range="{{customerList}}" range-key="companyName" bindchange="onCustomerChange">
            <view class="f-pv {{company?'':'ph'}}">{{company || '选填'}}</view>
          </picker>
          <input wx:else class="f-inp" value="{{company}}" bindinput="onCompanyInput" placeholder="选填" />
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">品类</text>
          <picker range="{{categoryOptions}}" range-key="dictLabel" bindchange="onCategoryChange">
            <view class="f-pv {{productCategory?'':'ph'}}">{{productCategory || '选填'}}</view>
          </picker>
        </view>
      </view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">首翻单</text>
          <picker range="{{plateTypeOptions}}" bindchange="onPlateTypeChange">
            <view class="f-pv {{plateTypeLabel?'':'ph'}}">{{plateTypeLabel || '自动判断'}}</view>
          </picker>
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">下单类型</text>
          <picker range="{{bizTypeLabels}}" bindchange="onBizTypeChange">
            <view class="f-pv {{orderBizTypeLabel?'':'ph'}}">{{orderBizTypeLabel || '选填'}}</view>
          </picker>
        </view>
      </view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">纸样师</text>
          <picker wx:if="{{userOptions.length > 0}}" range="{{userOptions}}" bindchange="onPatternMakerChange">
            <view class="f-pv {{patternMaker?'':'ph'}}">{{patternMaker || '选填'}}</view>
          </picker>
          <input wx:else class="f-inp" value="{{patternMaker}}" bindinput="onPatternMakerInput" placeholder="选填" />
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">跟单员</text>
          <picker wx:if="{{userOptions.length > 0}}" range="{{userOptions}}" bindchange="onMerchandiserChange">
            <view class="f-pv {{merchandiser?'':'ph'}}">{{merchandiser || '选填'}}</view>
          </picker>
          <input wx:else class="f-inp" value="{{merchandiser}}" bindinput="onMerchandiserInput" placeholder="选填" />
        </view>
      </view>
    </view>

    <!-- ══ 下单数量 ══ -->
    <view class="sec">
      <view class="sec-hd">
        <text>下单数量 <text class="req">*</text></text>
        <text class="sec-hd-x">共 {{orderQuantity}} 件</text>
      </view>

      <!-- 统计条（对齐 PC 端：开发色 / 开发码 / 已选 / 组合） -->
      <view class="stat-bar">
        <text class="stat-i">开发色 <text class="stat-n">{{colorOptions.length}}</text></text>
        <text class="stat-i">开发码 <text class="stat-n">{{sizeOptions.length}}</text></text>
        <text class="stat-i">已选 <text class="stat-n">{{selectedColors.length}}</text>色 <text class="stat-n">{{selectedSizes.length}}</text>码</text>
        <text class="stat-i">组合 <text class="stat-n">{{orderLines.length}}</text></text>
      </view>

      <!-- 颜色 -->
      <view class="blk">
        <view class="blk-hd">
          <text class="blk-t">颜色</text>
          <view class="blk-acts">
            <text class="blk-a" data-target="color" bindtap="onOpenAttrLib">库</text>
            <text class="blk-a" bindtap="onSelectAllColors">全选</text>
          </view>
        </view>
        <view class="add-row">
          <input class="add-inp flex-1" value="{{colorInput}}" bindinput="onColorInput" bindconfirm="onColorAdd" placeholder="输入颜色，可粘贴「黑色,白色」批量添加" confirm-type="done" />
          <view class="f-btn" bindtap="onColorAdd"><text>添加</text></view>
        </view>
        <view class="chip-wrap" wx:if="{{colorOptions.length > 0}}">
          <view class="chip {{selectedColors.indexOf(item) !== -1 ? 'on' : ''}}" wx:for="{{colorOptions}}" wx:key="*this" data-c="{{item}}" bindtap="onColorToggle">{{item}}</view>
        </view>
        <view wx:else class="blk-empty">暂无颜色，请上方添加</view>
      </view>

      <!-- 码数 -->
      <view class="blk">
        <view class="blk-hd">
          <text class="blk-t">码数</text>
          <view class="blk-acts">
            <text class="blk-a" data-target="size" bindtap="onOpenAttrLib">库</text>
            <text class="blk-a" bindtap="onSelectAllSizes">全选</text>
          </view>
        </view>
        <view class="add-row">
          <input class="add-inp flex-1" value="{{sizeInput}}" bindinput="onSizeInput" bindconfirm="onSizeAdd" placeholder="输入码数，可粘贴「S,M,L」批量添加" confirm-type="done" />
          <view class="f-btn" bindtap="onSizeAdd"><text>添加</text></view>
        </view>
        <view class="chip-wrap" wx:if="{{sizeOptions.length > 0}}">
          <view class="chip {{selectedSizes.indexOf(item) !== -1 ? 'on' : ''}}" wx:for="{{sizeOptions}}" wx:key="*this" data-s="{{item}}" bindtap="onSizeToggle">{{item}}</view>
        </view>
        <view wx:else class="blk-empty">暂无码数，请上方添加</view>
      </view>

      <!-- 批量铺量（不用一个个输入） -->
      <view class="blk" wx:if="{{orderLines.length > 0}}">
        <view class="blk-hd">
          <text class="blk-t">批量铺量</text>
          <text class="blk-tip">点颜色行铺整行 · 点码数列铺整列</text>
        </view>
        <view class="qfill">
          <input class="qfill-inp" type="number" value="{{quickFillQty}}" bindinput="onQuickFillInput" />
          <view class="f-btn" bindtap="onQuickFill"><text>全部铺量</text></view>
          <view class="f-btn ghost" bindtap="onClearSelection"><text>清空</text></view>
        </view>
      </view>

      <!-- 二维矩阵：横向滚动，左侧颜色列固定，含行小计 / 码数合计 -->
      <view wx:if="{{gridRows.length > 0}}" class="mx-wrap">
        <scroll-view scroll-x class="mx-scroll" show-scrollbar="{{false}}">
          <view class="mx">
            <!-- 表头：点码数 = 整列铺量 -->
            <view class="mx-row mx-head">
              <view class="mx-cell mx-fix">颜色</view>
              <view class="mx-cell mx-sz" wx:for="{{gridSizes}}" wx:key="*this" data-size="{{item}}" bindtap="onColFill">
                <text class="mx-szt">{{item}}</text>
              </view>
            </view>
            <!-- 数据行：点颜色 = 整行铺量 -->
            <view class="mx-row" wx:for="{{gridRows}}" wx:for-item="row" wx:key="color">
              <view class="mx-cell mx-fix" data-color="{{row.color}}" bindtap="onRowFill">
                <text class="mx-cname">{{row.color}}</text>
                <text class="mx-csum">{{row.total}}</text>
              </view>
              <view class="mx-cell mx-sz" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="size">
                <input class="mx-inp" type="number" value="{{cell.quantity || ''}}" data-color="{{row.color}}" data-size="{{cell.size}}" bindinput="onGridQtyInput" placeholder="0" />
              </view>
            </view>
            <!-- 码数合计 -->
            <view class="mx-row mx-foot">
              <view class="mx-cell mx-fix">码数合计</view>
              <view class="mx-cell mx-sz" wx:for="{{sizeTotals}}" wx:key="size">{{item.total}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:elif="{{selectedSizes.length === 0}}" class="blk-empty">请先在上方选择码数</view>
      <view wx:elif="{{selectedColors.length === 0}}" class="blk-empty">请先在上方选择颜色</view>
    </view>

    <!-- ══ 定价 ══ -->
    <view class="sec">
      <view class="sec-hd">定价方式</view>

      <view class="f-row">
        <text class="f-lbl">模式</text>
        <picker range="{{pricingModeLabels}}" bindchange="onPricingModeChange" class="flex-1">
          <view class="f-pv">{{pricingModeLabels[pricingModeIdx]}}</view>
        </picker>
      </view>

      <!-- 系统算出的单价 -->
      <view wx:if="{{pricingMode !== 'MANUAL'}}" class="pp-total">
        <text class="pp-total-lbl">{{pricingModeLabels[pricingModeIdx]}}</text>
        <text class="pp-total-val">{{computedUnitPrice > 0 ? computedUnitPrice : '未取到'}}</text>
      </view>

      <view wx:if="{{pricingMode === 'MANUAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>单价</text>
        <input class="f-inp flex-1" type="digit" value="{{manualOrderUnitPrice}}" bindinput="onManualPriceInput" placeholder="0.00" />
      </view>
    </view>

    <view style="height:96px;"></view>
  </scroll-view>

  <view class="bar">
    <view class="bar-sum">
      <text class="bar-sum-l">总数量</text>
      <text class="bar-sum-n">{{orderQuantity}}</text>
    </view>
    <view class="bar-btn {{submitting?'dis':''}}" bindtap="onSubmit">
      <text>{{submitting ? '提交中...' : '确认下单'}}</text>
    </view>
  </view>
  <!-- ══ 基础属性库：成组预设（覆盖 / 追加） ══ -->
  <view wx:if="{{attrLibOpen}}" class="mask" bindtap="onCloseAttrLib" catchtouchmove="onSheetTouchMove">
    <view class="sheet" catchtap="onSheetTouchMove">
      <view class="sheet-hd">
        <text class="sheet-t">{{attrLibTitle}}</text>
        <text class="sheet-x" bindtap="onCloseAttrLib">关闭</text>
      </view>
      <scroll-view scroll-y class="sheet-bd">
        <view wx:if="{{attrLibGroups.length === 0}}" class="sheet-empty">暂无已保存的组合，可在 PC 端「基础属性库」创建</view>
        <view class="gitem" wx:for="{{attrLibGroups}}" wx:for-item="g" wx:for-index="gidx" wx:key="id">
          <view class="gitem-hd">
            <text class="gitem-n">{{g.name}}</text>
            <text class="gitem-c">{{g.values.length}} 项</text>
          </view>
          <view class="chip-wrap">
            <text class="chip sm" wx:for="{{g.values}}" wx:for-item="v" wx:key="*this">{{v}}</text>
          </view>
          <view class="gitem-acts">
            <view class="f-btn ghost" data-idx="{{gidx}}" data-mode="replace" bindtap="onApplyAttrGroup"><text>覆盖</text></view>
            <view class="f-btn" data-idx="{{gidx}}" data-mode="append" bindtap="onApplyAttrGroup"><text>追加</text></view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  <ai-assistant />
</view>
