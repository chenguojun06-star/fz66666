<view class="container">
  <scroll-view scroll-y class="body">
    <!-- ══ 款式 ══ -->
    <view class="sec">
      <view class="style-row">
        <!-- 无资料下单：款式图 ➕ 大按钮（点击直接上传；已传显示小图 + × 删除） -->
        <view wx:if="{{isNoData && !coverImage}}" hover-class="cover-upload--pressed" hover-stay-time="60" class="style-thumb cover-upload" bindtap="onPickNoDataCover">
          <text class="cover-upload-plus">+</text>
          <text class="cover-upload-t">{{t.uploadStyleImg}}</text>
        </view>
        <view wx:elif="{{coverImage}}" class="style-thumb cover-shown" bindtap="onCoverPreview" data-url="{{coverImage}}">
          <image src="{{coverImage}}" mode="aspectFit" />
          <view wx:if="{{isNoData}}" class="cover-del" catchtap="onDeleteNoDataCover"><text>×</text></view>
        </view>
        <view wx:else class="style-thumb no-img"><text>{{styleNo || t.styleChar}}</text></view>
        <view class="style-txt">
          <!-- 无资料下单：款号 / 款名可手填 -->
          <input wx:if="{{isNoData}}" class="style-inp" value="{{styleNo}}" bindinput="onStyleNoInput" placeholder="{{t.inputStyleNoPh}}" />
          <text wx:else class="style-no">{{styleNo || t.noStyleNo}}</text>
          <input wx:if="{{isNoData}}" class="style-inp sub" value="{{styleName}}" bindinput="onStyleNameInput" placeholder="{{t.inputStyleNmPh}}" />
          <text wx:else class="style-nm">{{styleName || t.noProfileOrder}}</text>
        </view>
        <view wx:if="{{productCategory}}" class="style-tag">{{productCategory}}</view>
      </view>
    </view>

    <!-- ══ 订单信息 ══ -->
    <view class="sec">
      <view class="sec-hd">{{t.orderInfoTitle}}</view>

      <view class="f-row">
        <text class="f-lbl"><text class="req">*</text>{{t.orderNoLabel}}</text>
        <input class="f-inp flex-1" value="{{orderNo}}" bindinput="onOrderNoInput" placeholder="{{t.autoGenPh}}" />
        <view class="f-btn" bindtap="onAutoGenOrderNo"><text>{{t.genBtn}}</text></view>
      </view>

      <view class="f-row">
        <text class="f-lbl"><text class="req">*</text>{{t.producerLabel}}</text>
        <view class="f-seg">
          <view class="f-seg-i {{factoryMode==='INTERNAL'?'on':''}}" data-v="INTERNAL" bindtap="onFactoryModeTap">{{t.internalFactory}}</view>
          <view class="f-seg-i {{factoryMode==='EXTERNAL'?'on':''}}" data-v="EXTERNAL" bindtap="onFactoryModeTap">{{t.outsourceFactory}}</view>
        </view>
      </view>

      <!-- D-517：部门/工厂改为可搜索选择器（原生 picker 没有搜索，工厂上百个只能一路滚） -->
      <view wx:if="{{factoryMode==='INTERNAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>{{t.deptLabel}}</text>
        <view class="flex-1" bindtap="openPicker" data-key="orgUnit">
          <view class="f-pv {{orgUnitId?'':'ph'}}">{{orgUnitName || t.pickDeptPh}}<text class="f-pv-arrow">›</text></view>
        </view>
      </view>

      <view wx:if="{{factoryMode==='EXTERNAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>{{t.factoryLabel}}</text>
        <view class="flex-1" bindtap="openPicker" data-key="factory">
          <view class="f-pv {{factoryId?'':'ph'}}">{{factoryName || t.pickFactoryPh}}<text class="f-pv-arrow">›</text></view>
        </view>
      </view>
    </view>

    <!-- ══ 时间与交期 ══ -->
    <view class="sec">
      <view class="sec-hd">{{t.timeDelivery}}</view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk"><text class="req">*</text>{{t.orderTimeLabel}}</text>
          <picker mode="date" value="{{plannedStartDate}}" bindchange="onStartDateChange">
            <view class="f-pv {{plannedStartDate?'':'ph'}}">{{plannedStartDate || t.pickDatePh}}</view>
          </picker>
        </view>
        <view class="f-col">
          <text class="f-lbl-blk"><text class="req">*</text>{{t.deliveryTimeLabel}}</text>
          <picker mode="date" value="{{plannedEndDate}}" bindchange="onEndDateChange">
            <view class="f-pv {{plannedEndDate?'':'ph'}}">{{plannedEndDate || t.pickDatePh}}</view>
          </picker>
        </view>
      </view>

      <view class="f-row">
        <text class="f-lbl">{{t.urgentTag}}</text>
        <view class="f-seg">
          <view class="f-seg-i {{urgencyLevel==='normal'?'on':''}}" data-v="normal" bindtap="onUrgencyTap">{{t.normalWord}}</view>
          <view class="f-seg-i danger {{urgencyLevel==='urgent'?'on':''}}" data-v="urgent" bindtap="onUrgencyTap">{{t.urgentTag}}</view>
        </view>
      </view>
    </view>

    <!-- ══ 业务信息 ══ -->
    <view class="sec">
      <view class="sec-hd">{{t.bizInfoTitle}}</view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">{{t.customerLabel}}</text>
          <!-- D-517：客户列表可搜索（含「（不选）」清空项） -->
          <view wx:if="{{customerList.length > 0}}" bindtap="openPicker" data-key="customer">
            <view class="f-pv {{company?'':'ph'}}">{{company || t.optionalPh}}<text class="f-pv-arrow">›</text></view>
          </view>
          <input wx:else class="f-inp" value="{{company}}" bindinput="onCompanyInput" placeholder="{{t.optionalPh}}" />
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">{{t.categoryLabel}}</text>
          
            <view bindtap="openPicker" data-handler="onCategoryChange" data-names="categoryOptions" data-range-key="dictLabel" class="f-pv {{productCategory?'':'ph'}}">{{productCategory || t.optionalPh}}</view>
          
        </view>
      </view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">{{t.firstRepeatLabel}}</text>
          
            <view bindtap="openPicker" data-handler="onPlateTypeChange" data-names="plateTypeOptions" class="f-pv {{plateTypeLabel?'':'ph'}}">{{plateTypeLabel || t.autoJudgeW}}</view>
          
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">{{t.orderTypeLabel}}</text>
          
            <view bindtap="openPicker" data-handler="onBizTypeChange" data-names="bizTypeLabels" class="f-pv {{orderBizTypeLabel?'':'ph'}}">{{orderBizTypeLabel || t.optionalPh}}</view>
          
        </view>
      </view>

      <view class="f-row-row">
        <view class="f-col">
          <text class="f-lbl-blk">{{t.patternMakerLabel}}</text>
          <!-- D-517：人员走远程搜索（后端 name 关键字 + 分页），不再只加载前 200 人 -->
          <view bindtap="openPicker" data-key="patternMaker">
            <view class="f-pv {{patternMaker?'':'ph'}}">{{patternMaker || t.optionalSearch}}<text class="f-pv-arrow">›</text></view>
          </view>
        </view>
        <view class="f-col">
          <text class="f-lbl-blk">{{t.merchLabel}}</text>
          <view bindtap="openPicker" data-key="merchandiser">
            <view class="f-pv {{merchandiser?'':'ph'}}">{{merchandiser || t.optionalSearch}}<text class="f-pv-arrow">›</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- ══ 下单数量 ══ -->
    <view class="sec">
      <view class="sec-hd">
        <text>{{t.orderQtyLabel}} <text class="req">*</text></text>
        <text class="sec-hd-x">{{t.totalLabelW}} {{orderQuantity}}{{t.pieceW3}}</text>
      </view>

      <!-- 统计条（对齐 PC 端：开发色 / 开发码 / 已选 / 组合） -->
      <view class="stat-bar">
        <text class="stat-i">{{t.devColorsLabel}} <text class="stat-n">{{colorOptions.length}}</text></text>
        <text class="stat-i">{{t.devSizesLabel}} <text class="stat-n">{{sizeOptions.length}}</text></text>
        <text class="stat-i">{{t.selectedWord}} <text class="stat-n">{{selectedColors.length}}</text>{{t.colorUnit}} <text class="stat-n">{{selectedSizes.length}}</text>{{t.sizeUnit}}</text>
        <text class="stat-i">{{t.comboWord}} <text class="stat-n">{{orderLines.length}}</text></text>
      </view>

      <!-- 颜色 -->
      <view class="blk">
        <view class="blk-hd">
          <text class="blk-t">{{t.colorLabel}}</text>
          <view class="blk-acts">
            <text class="blk-a" data-target="color" bindtap="onOpenAttrLib">{{t.libWord}}</text>
            <text class="blk-a" bindtap="onSelectAllColors">{{t.selectAll}}</text>
          </view>
        </view>
        <view class="add-row">
          <input class="add-inp flex-1" value="{{colorInput}}" bindinput="onColorInput" bindconfirm="onColorAdd" placeholder="{{t.colorPastePh}}" confirm-type="done" />
          <view class="f-btn" bindtap="onColorAdd"><text>{{t.addWord}}</text></view>
        </view>
        <view class="chip-wrap" wx:if="{{colorChips.length > 0}}">
          <view class="chip {{c.selected ? 'on' : ''}}" wx:for="{{colorChips}}" wx:for-item="c" wx:key="name" data-c="{{c.name}}" bindtap="onColorToggle">{{c.name}}<text wx:if="{{c.selected}}" class="chip-check">✓</text></view>
        </view>
        <view wx:else class="blk-empty">{{t.noColorHint}}</view>
      </view>

      <!-- 码数 -->
      <view class="blk">
        <view class="blk-hd">
          <text class="blk-t">{{t.sizeWord}}</text>
          <view class="blk-acts">
            <text class="blk-a" data-target="size" bindtap="onOpenAttrLib">{{t.libWord}}</text>
            <text class="blk-a" bindtap="onSelectAllSizes">{{t.selectAll}}</text>
          </view>
        </view>
        <view class="add-row">
          <input class="add-inp flex-1" value="{{sizeInput}}" bindinput="onSizeInput" bindconfirm="onSizeAdd" placeholder="{{t.sizePastePh}}" confirm-type="done" />
          <view class="f-btn" bindtap="onSizeAdd"><text>{{t.addWord}}</text></view>
        </view>
        <view class="chip-wrap" wx:if="{{sizeChips.length > 0}}">
          <view class="chip {{s.selected ? 'on' : ''}}" wx:for="{{sizeChips}}" wx:for-item="s" wx:key="name" data-s="{{s.name}}" bindtap="onSizeToggle">{{s.name}}<text wx:if="{{s.selected}}" class="chip-check">✓</text></view>
        </view>
        <view wx:else class="blk-empty">{{t.noSizeHint}}</view>
      </view>

      <!-- 批量铺量（不用一个个输入） -->
      <view class="blk" wx:if="{{orderLines.length > 0}}">
        <view class="blk-hd">
          <text class="blk-t">{{t.batchFill}}</text>
          <text class="blk-tip">{{t.matrixHint}}</text>
        </view>
        <view class="qfill">
          <input class="qfill-inp" type="number" value="{{quickFillQty}}" bindinput="onQuickFillInput" />
          <view class="f-btn" bindtap="onQuickFill"><text>{{t.fillAllBtn}}</text></view>
          <view class="f-btn ghost" bindtap="onClearSelection"><text>{{t.clearBtn}}</text></view>
        </view>
      </view>

      <!-- 二维矩阵：横向滚动，左侧颜色列固定，含行小计 / 码数合计 -->
      <view wx:if="{{gridRows.length > 0}}" class="mx-wrap">
        <scroll-view scroll-x class="mx-scroll" show-scrollbar="{{false}}">
          <view class="mx">
            <!-- 表头：点码数 = 整列铺量 -->
            <view class="mx-row mx-head">
              <view class="mx-cell mx-fix">{{t.colorLabel}}</view>
              <view class="mx-cell mx-sz" wx:for="{{gridSizes}}" wx:key="*this" data-size="{{item}}" bindtap="onColFill">
                <text class="mx-szt">{{item}}</text>
              </view>
            </view>
            <!-- 数据行：点颜色 = 整行铺量 -->
            <view class="mx-row" wx:for="{{gridRows}}" wx:for-item="row" wx:key="color">
              <view class="mx-cell mx-fix" data-color="{{row.color}}" bindtap="onRowFill">
                <text class="mx-cname">{{row.color}}</text>
                <text class="mx-csum">{{row.total}}</text>
              </view>
              <view class="mx-cell mx-sz" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="size">
                <input class="mx-inp" type="number" value="{{cell.quantity || ''}}" data-color="{{row.color}}" data-size="{{cell.size}}" bindinput="onGridQtyInput" placeholder="0" />
              </view>
            </view>
            <!-- 码数合计 -->
            <view class="mx-row mx-foot">
              <view class="mx-cell mx-fix">{{t.sizeTotalLabel}}</view>
              <view class="mx-cell mx-sz" wx:for="{{sizeTotals}}" wx:key="size">{{item.total}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:elif="{{selectedSizes.length === 0}}" class="blk-empty">{{t.pickSizeFirst}}</view>
      <view wx:elif="{{selectedColors.length === 0}}" class="blk-empty">{{t.pickColorFirst}}</view>
    </view>

    <!-- ══ 定价 ══ -->
    <view class="sec">
      <view class="sec-hd">{{t.pricingLabel}}</view>

      <view class="f-row">
        <text class="f-lbl">{{t.modeLabel}}</text>
        
          <view bindtap="openPicker" data-handler="onPricingModeChange" data-names="pricingModeLabels" class="f-pv">{{pricingModeLabels[pricingModeIdx]}}</view>
        
      </view>

      <!-- 系统算出的单价 -->
      <view wx:if="{{pricingMode !== 'MANUAL'}}" class="pp-total">
        <text class="pp-total-lbl">{{pricingModeLabels[pricingModeIdx]}}</text>
        <text class="pp-total-val">{{computedUnitPrice > 0 ? computedUnitPrice : t.notFetched}}</text>
      </view>

      <view wx:if="{{pricingMode === 'MANUAL'}}" class="f-row">
        <text class="f-lbl"><text class="req">*</text>{{t.unitPriceLabel}}</text>
        <input class="f-inp flex-1" type="digit" value="{{manualOrderUnitPrice}}" bindinput="onManualPriceInput" placeholder="0.00" />
      </view>
    </view>

    <view style="height:96px;"></view>
  </scroll-view>

  <view class="bar">
    <view class="bar-sum">
      <text class="bar-sum-l">{{t.totalQtyLabel}}</text>
      <text class="bar-sum-n">{{orderQuantity}}</text>
    </view>
    <view class="bar-btn {{submitting?'dis':''}}" bindtap="onSubmit">
      <text>{{submitting ? t.submittingW : t.confirmOrderW}}</text>
    </view>
  </view>
  <!-- ══ 基础属性库：成组预设（覆盖 / 追加） ══ -->
  <view wx:if="{{attrLibOpen}}" class="mask" bindtap="onCloseAttrLib" catchtouchmove="onSheetTouchMove">
    <view class="sheet" catchtap="onSheetTouchMove">
      <view class="sheet-hd">
        <text class="sheet-t">{{attrLibTitle}}</text>
        <text class="sheet-x" bindtap="onCloseAttrLib">{{t.closeBtn}}</text>
      </view>
      <scroll-view scroll-y class="sheet-bd">
        <view wx:if="{{attrLibGroups.length === 0}}" class="sheet-empty">{{t.noSavedCombo}}</view>
        <view class="gitem" wx:for="{{attrLibGroups}}" wx:for-item="g" wx:for-index="gidx" wx:key="id">
          <view class="gitem-hd">
            <text class="gitem-n">{{g.name}}</text>
            <text class="gitem-c">{{g.values.length}}{{t.countUnit2}}</text>
          </view>
          <view class="chip-wrap">
            <text class="chip sm" wx:for="{{g.values}}" wx:for-item="v" wx:key="*this">{{v}}</text>
          </view>
          <view class="gitem-acts">
            <view class="f-btn ghost" data-idx="{{gidx}}" data-mode="replace" bindtap="onApplyAttrGroup"><text>{{t.coverBtn}}</text></view>
            <view class="f-btn" data-idx="{{gidx}}" data-mode="append" bindtap="onApplyAttrGroup"><text>{{t.appendBtn}}</text></view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  <ai-assistant />

  <!-- D-517：通用可搜索选择器（部门/工厂/客户/纸样师/跟单员共用） -->
  <search-picker
    visible="{{pickerVisible}}"
    title="{{pickerTitle}}"
    options="{{pickerOptions}}"
    value="{{pickerValue}}"
    remote="{{pickerRemote}}"
    loading="{{pickerLoading}}"
    has-more="{{pickerHasMore}}"
    bind:search="onPickerSearch"
    bind:loadmore="onPickerLoadMore"
    bind:select="onPickerSelect"
    bind:close="onPickerClose"
  />
</view>
