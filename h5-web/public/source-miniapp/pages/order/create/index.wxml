<view class="page">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'style' ? 'active' : ''}}" data-tab="style" bindtap="switchTab">款式下单</view>
    <view class="tab-item {{activeTab === 'noData' ? 'active' : ''}}" data-tab="noData" bindtap="switchTab">无资料下单</view>
  </view>

  <!-- ══ 无资料下单：上传款式图片（路径一） ══ -->
  <view wx:if="{{activeTab === 'noData'}}" class="no-data-upload-section">
    <view class="upload-hint">
      <view class="hint-icon line-icon icon-camera"></view>
      <text class="hint-h">方式一：上传款式图片</text>
      <text class="hint-desc">拍照或从相册选择，填写订单信息即可下单</text>
    </view>

    <view class="image-upload-large" bindtap="chooseNoDataImage">
      <image wx:if="{{noDataUploadedImage}}" src="{{noDataUploadedImage}}" mode="aspectFit" />
      <view wx:else class="upload-placeholder-large">
        <view class="upload-icon-large line-icon icon-camera"></view>
        <text class="upload-text">点击上传款式图片</text>
        <text class="upload-hint-text">支持 JPG、PNG 格式</text>
      </view>
      <view class="delete-image-large" wx:if="{{noDataUploadedImage}}" catchtap="deleteNoDataImage">
        <view class="icon-close"></view>
      </view>
    </view>

    <button class="next-btn" wx:if="{{noDataUploadedImage}}" bindtap="goToNoDataOrderForm">
      下一步：填写订单信息
    </button>
  </view>

  <!-- ══ 款式列表：两个 Tab 共用（无资料下单为「方式二」） ══ -->
  <view class="list-section">
    <view wx:if="{{activeTab === 'noData'}}" class="list-hint">
      <text class="list-hint-t">方式二：从已有款式下单</text>
      <text class="list-hint-d">沿用款式资料，自行填写颜色与码数</text>
    </view>

    <view class="search-bar">
      <view class="search-box">
        <view class="search-emoji line-icon icon-search"></view>
        <input class="search-input" placeholder="搜索款号/款名" value="{{styleKeyword}}" bindinput="onStyleSearchInput" confirm-type="search" />
        <view class="search-clear icon-close" wx:if="{{styleKeyword}}" catchtap="onStyleSearchClear"></view>
      </view>
    </view>

    <view wx:if="{{styleLoading}}" class="state-wrap"><text>加载中...</text></view>

    <view wx:elif="{{styleFilteredStyles.length === 0}}" class="state-wrap">
      <text>{{styleKeyword ? '未找到匹配' : (activeTab === 'noData' ? '暂无款式' : '暂无已完成入库的样衣')}}</text>
    </view>

    <scroll-view wx:else scroll-y class="grid-scroll">
      <view class="grid">
        <view class="card" wx:for="{{styleFilteredStyles}}" wx:key="id" data-id="{{item.id}}" data-cover="{{item.displayCover}}" data-no="{{item.styleNo}}" data-name="{{item.styleName}}" data-colors="{{item.color}}" data-sizes="{{item.size}}" data-cat="{{item.displayCategory}}" bindtap="onStyleTap">
          <view class="card-img">
            <image wx:if="{{item.displayCover}}" src="{{item.displayCover}}" mode="aspectFit" lazy-load />
            <text wx:else class="card-img-ph">{{item.styleNo}}</text>
          </view>
          <view class="card-body">
            <text class="card-cat" wx:if="{{item.displayCategory}}">{{item.displayCategory}}</text>
            <text class="card-no">{{item.styleNo || '-'}}</text>
            <text class="card-name">{{item.styleName || '-'}}</text>
            <view class="card-meta" wx:if="{{item.orderCount > 0 || item.latestOrderDate}}">
              <text wx:if="{{item.orderCount > 0}}" class="card-oc">已下单{{item.orderCount}}次</text>
              <text wx:if="{{item.latestOrderDate}}" class="card-ld">{{item.latestOrderDate}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <ai-assistant />
</view>
