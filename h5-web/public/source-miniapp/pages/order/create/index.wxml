<view class="page">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'style' ? 'active' : ''}}" data-tab="style" bindtap="switchTab">{{t.tabStyle}}</view>
    <view class="tab-item {{activeTab === 'noData' ? 'active' : ''}}" data-tab="noData" bindtap="switchTab">{{t.tabNoData}}</view>
  </view>

  <!-- ══ 无资料下单：直达空白表单（无需款式、无需图片，款式图在表单内选填） ══ -->
  <view wx:if="{{activeTab === 'noData'}}" class="no-data-upload-section">
    <view class="no-data-start" hover-class="no-data-start--pressed" hover-stay-time="60" bindtap="goNoDataOrderForm">
      <view class="no-data-start-icon line-icon icon-edit"></view>
      <view class="no-data-start-body">
        <text class="no-data-start-t">{{t.noDataTitle}}</text>
        <text class="no-data-start-d">{{t.noDataDesc}}</text>
      </view>
      <view class="no-data-start-arrow">›</view>
    </view>
    <view class="upload-hint">
      <text class="hint-h">{{t.orFromStyle}}</text>
      <text class="hint-desc">{{t.fromStyleDesc}}</text>
    </view>
  </view>

  <!-- ══ 款式列表：两个 Tab 共用 ══ -->
  <view class="list-section">

    <view class="search-bar">
      <view class="search-box">
        <view class="search-emoji line-icon icon-search"></view>
        <input class="search-input" placeholder="{{t.searchPlaceholder}}" value="{{styleKeyword}}" bindinput="onStyleSearchInput" confirm-type="search" />
        <view class="search-clear icon-close" wx:if="{{styleKeyword}}" catchtap="onStyleSearchClear"></view>
      </view>
    </view>

    <view wx:if="{{styleLoading}}" class="state-wrap"><text>{{t.loading}}</text></view>

    <view wx:elif="{{styleFilteredStyles.length === 0}}" class="state-wrap">
      <text>{{styleKeyword ? t.noMatch : (activeTab === 'noData' ? t.noStyle : t.noCompletedSample)}}</text>
    </view>

    <scroll-view wx:else scroll-y class="grid-scroll">
      <view class="grid">
        <view class="card" wx:for="{{styleFilteredStyles}}" wx:key="id" data-id="{{item.id}}" data-cover="{{item.displayCover}}" data-no="{{item.styleNo}}" data-name="{{item.styleName}}" data-colors="{{item.color}}" data-sizes="{{item.size}}" data-cat="{{item.displayCategory}}" bindtap="onStyleTap">
          <view class="card-img">
            <image wx:if="{{item.displayCover}}" src="{{item.displayCover}}" mode="aspectFit" lazy-load />
            <text wx:else class="card-img-ph">{{item.styleNo}}</text>
          </view>
          <view class="card-body">
            <text class="card-cat" wx:if="{{item.displayCategory}}">{{item.displayCategory}}</text>
            <text class="card-no">{{item.styleNo || '-'}}</text>
            <text class="card-name">{{item.styleName || '-'}}</text>
            <view class="card-meta" wx:if="{{item.orderCount > 0 || item.latestOrderDate}}">
              <text wx:if="{{item.orderCount > 0}}" class="card-oc">{{t.orderedPrefix}}{{item.orderCount}}{{t.orderedSuffix}}</text>
              <text wx:if="{{item.latestOrderDate}}" class="card-ld">{{item.latestOrderDate}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <ai-assistant />
</view>
