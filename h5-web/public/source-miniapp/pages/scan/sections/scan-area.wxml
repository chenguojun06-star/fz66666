  <!-- ④ 扫码区（一行：扫码主键） -->
  <view class="scan-area-big">
    <view class="scan-row">
      <view class="scan-btn-big {{loading ? 'off' : ''}}" hover-class="scan-btn-big-hover" hover-stay-time="100" bindtap="onScan">
        <view class="scan-btn-icon-svg">
          <image src="/assets/icons/scan-blue.svg" mode="aspectFit" style="width: 28px; height: 28px;" />
        </view>
        <view class="scan-btn-text-group">
          <text class="scan-btn-main">{{loading ? t.recognizing : t.tapToScan}}</text>
          <text class="scan-btn-sub">{{lastUsedProcessName ? t.lastPrefix + lastUsedProcessName : t.autoMatchStage}}</text>
        </view>
      </view>
    </view>
    <!-- 入库模式：仓库选择 -->
    <view wx:if="{{scanType === 'warehouse'}}" class="warehouse-section">
      <view class="warehouse-label">{{t.targetWarehouse}}</view>
      <view class="warehouse-option-row">
        <view
          wx:for="{{warehouseOptions}}"
          wx:key="index"
          class="warehouse-chip {{warehouse === item ? 'warehouse-chip--active' : ''}}"
          bindtap="onWarehouseChipTap"
          data-value="{{item}}"
          hover-class="warehouse-chip-hover"
          hover-stay-time="100"
        >{{item}}</view>
        <view
          class="warehouse-chip warehouse-chip--clear {{warehouse ? '' : 'warehouse-chip--disabled'}}"
          bindtap="onWarehouseClear"
          hover-class="warehouse-chip-hover"
          hover-stay-time="100"
        >{{t.clear}}</view>
      </view>
      <input
        class="input-box"
        placeholder="{{t.warehouseCodePh}}"
        value="{{warehouse}}"
        bindinput="onWarehouseCodeInput"
      />

      <!-- 库位选择（仓库选择后出现） -->
      <!-- D-517：库位改可搜索选择（库位几十上百个，chip 平铺只能一路滚） -->
      <view wx:if="{{warehouse && locationOptions.length > 0}}" class="warehouse-label" style="margin-top: 12rpx;">{{utils.fmt(t.targetLocationFmt, locationOptions.length)}}</view>
      <view wx:if="{{warehouse && locationOptions.length > 0}}" class="warehouse-option-row">
        <view class="warehouse-picker-row" bindtap="openPicker" data-key="location">
          <text class="warehouse-picker-value {{warehouseLocationCode ? '' : 'is-placeholder'}}">
            {{warehouseLocationCode || t.selectLocation}}
          </text>
          <text class="warehouse-picker-arrow">›</text>
        </view>
        <view
          class="warehouse-chip warehouse-chip--clear {{warehouseLocationCode ? '' : 'warehouse-chip--disabled'}}"
          bindtap="onLocationClear"
          hover-class="warehouse-chip-hover"
          hover-stay-time="100"
        >{{t.clear}}</view>
      </view>
      <input
        wx:if="{{warehouse}}"
        class="input-box"
        placeholder="{{t.locationCodePh}}"
        value="{{warehouseLocationCode}}"
        bindinput="onLocationCodeInput"
      />
    </view>
    <view wx:if="{{currentUser && currentUser.factoryId}}" class="warehouse-input-row">
      <view class="warehouse-hint-text">
        {{t.currentOwner}}{{currentUser.factoryName || '-'}}{{currentUser.orgPath ? ' · ' + currentUser.orgPath : ''}}{{currentUser.factoryType === 'INTERNAL' ? t.suffixInternal : (currentUser.factoryType === 'EXTERNAL' ? t.suffixExternal : '')}}
      </view>
    </view>
    <view class="scan-mode-tip">
      <text>{{t.scanModeTip}}</text>
    </view>
  </view>

