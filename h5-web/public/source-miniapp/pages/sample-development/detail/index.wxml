<!-- 样衣开发详情页 - 对照设计稿 sample-detail.html 重写 -->
<view class="page-root">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{t.loading}}</text>
  </view>

  <block wx:elif="{{styleInfo}}">
    <!-- 1. 款式信息卡片（蓝色渐变） -->
    <view class="info-card">
      <view class="info-card__body">
        <view class="info-card__cover">
          <image wx:if="{{styleInfo._coverUrl}}" src="{{styleInfo._coverUrl}}" mode="aspectFit" class="info-card__img" />
          <view wx:else class="info-card__placeholder">
            <view class="icon-sample" style="width:28px;height:28px;"></view>
          </view>
        </view>
        <view class="info-card__content">
          <text class="info-card__no">{{styleInfo.styleNo || styleInfo.styleCode || '--'}}</text>
          <text class="info-card__name">{{styleInfo.styleName || styleInfo.name || '--'}}</text>
          <text wx:if="{{styleInfo._metaText}}" class="info-card__meta">{{styleInfo._metaText}}</text>
          <view class="info-card__tags">
            <view wx:if="{{styleInfo._statusTag}}" class="tag-status" style="background:{{styleInfo._statusColorVar}};color:var(--color-text-white);">
              {{styleInfo._statusTag}}
            </view>
            <view wx:if="{{patternSnapshot._receiver}}" class="tag-chip">{{patternSnapshot._receiver}}</view>
            <view wx:if="{{styleInfo._colorText}}" class="tag-chip">{{styleInfo._colorText}}</view>
            <view wx:if="{{styleInfo._sizeText}}" class="tag-chip">{{styleInfo._sizeText}}</view>
            <view wx:if="{{styleInfo._quantityText}}" class="tag-chip">{{styleInfo._quantityText}}{{t.pieceUnit}}</view>
          </view>
        </view>
      </view>
      <!-- 交板日期栏 -->
      <view wx:if="{{styleInfo._deliveryDate}}" class="info-card__delivery">
        <view class="delivery-left">
          <text class="delivery-label">{{t.deliveryDateLabel}}</text>
          <text class="delivery-date">{{styleInfo._deliveryDate}}</text>
        </view>
        <view wx:if="{{styleInfo._daysLeftText}}" class="delivery-right {{styleInfo._overdue ? 'is-overdue' : ''}}">
          <view class="icon-clock-gray" style="width:14px;height:14px;flex-shrink:0;"></view>
          <text class="delivery-countdown">{{styleInfo._daysLeftText}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 开发进度 -->
    <view class="section-card">
      <!-- 领取按钮（未领取时显示）+ 工序扫码入口（D-157闭环：详情页直达按工序扫码） -->
      <view wx:if="{{patternSnapshot && !patternSnapshot._isScrapped}}" class="receive-row">
        <view wx:if="{{!patternSnapshot._isReceived && !patternSnapshot._isFullyCompleted}}" class="receive-btn" hover-class="receive-btn--pressed" hover-stay-time="60" bindtap="onReceivePattern">
          <text class="receive-btn__text">{{t.claimSample}}</text>
        </view>
        <view class="receive-btn receive-btn--secondary" hover-class="receive-btn--pressed" hover-stay-time="60" bindtap="onProcessScan">
          <text class="receive-btn__text">{{t.processScanTitle}}</text>
        </view>
        <!-- D-181 对齐PC：审核/入库是详情页动作，不是工序 -->
        <view wx:if="{{patternSnapshot._showReviewAction}}" class="receive-btn receive-btn--secondary" hover-class="receive-btn--pressed" hover-stay-time="60" bindtap="onSampleReview">
          <text class="receive-btn__text">{{t.sampleReview}}</text>
        </view>
        <view wx:if="{{patternSnapshot._showWarehouseInAction}}" class="receive-btn receive-btn--warehouse" hover-class="receive-btn--pressed" hover-stay-time="60" bindtap="onSampleWarehouseIn">
          <text class="receive-btn__text">{{t.sampleInbound}}</text>
        </view>
      </view>
      <!-- P2：样衣完成 / 推送到下单管理（与 PC 端对齐的操作入口） -->
      <view wx:if="{{styleInfo._canCompleteSample || styleInfo._canPushToOrder}}" class="sample-action-row">
        <view wx:if="{{styleInfo._canCompleteSample}}" class="sample-action-btn" bindtap="onCompleteSampleTap">
          <text class="sample-action-btn__text">{{t.completeSample}}</text>
        </view>
        <view wx:if="{{styleInfo._canPushToOrder}}" class="sample-action-btn sample-action-btn--primary" bindtap="onPushToOrderTap">
          <text class="sample-action-btn__text sample-action-btn__text--primary">{{t.pushToOrder}}</text>
        </view>
      </view>
      <!-- 三列统计 -->
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-value">{{progressPercent}}%</text>
          <text class="stats-label">{{t.totalProgress}}</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item">
          <text class="stats-value">{{completedCount}}/{{totalCount}}</text>
          <text class="stats-label">{{t.doneNodes}}</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item">
          <text class="stats-value stats-value--accent">{{styleInfo._daysLeftText || '--'}}</text>
          <text class="stats-label">{{t.untilDelivery}}</text>
        </view>
      </view>
      <!-- 进度条 -->
      <view class="progress-bar-wrap">
        <view class="progress-bar-track">
          <view class="progress-bar-fill" style="width:{{progressPercent}}%;"></view>
        </view>
      </view>
      <!-- 横向滚动阶段时间线 -->
      <scroll-view scroll-x class="stages-scroll" enhanced show-scrollbar="{{false}}" wx:if="{{!noProcessConfig}}">
        <view class="stages-list">
          <view
            wx:for="{{stages}}"
            wx:key="key"
            class="stage-item {{expandedStageKey === item.key ? 'stage-item--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onStageTap"
          >
            <view class="stage-circle stage-circle--{{item.status}}">
              <view wx:if="{{item.status === 'completed'}}" class="icon-check-sm" style="width:16px;height:16px;"></view>
              <text wx:else class="stage-num">{{item.index}}</text>
            </view>
            <text class="stage-name">{{item.name}}</text>
            <text class="stage-status stage-status--{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
      </scroll-view>
      <!-- D-182：未配置工序时明确提示，不再显示固定的4个父阶段假节点 -->
      <view wx:if="{{noProcessConfig}}" class="stage-empty-hint">
        <text class="stage-empty-hint__text">{{t.noProcessConfig}}</text>
      </view>
    </view>

    <!-- 资料区（筛选条 + 内容合并为一个卡片） -->
    <view class="section-card tab-section-card">

    <!-- 资料标签栏（可滑动） -->
    <scroll-view scroll-x class="data-tabs" enhanced show-scrollbar="{{false}}">
      <view class="data-tabs__inner">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="data-tab {{activeTab === item.key ? 'data-tab--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTabChange"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 标签内容区 -->
    <view class="tab-content-wrap">

      <!-- BOM 物料 -->
      <view wx:if="{{activeTab === 'bom'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.tabBom}}</text>
          <view class="tab-card__header-right">
            <text class="tab-card__count">{{bomList.length}}{{t.countUnit}}</text>
            <view
              wx:if="{{patternId}}"
              class="tab-card__proc-btn"
              bindtap="onGoProcurement"
              hover-class="tab-card__proc-btn-hover"
              hover-stay-time="100"
            >{{t.managePurchase}}</view>
          </view>
        </view>
        <view wx:if="{{bomLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <view wx:elif="{{bomList.length > 0}}" class="bom-list">
          <view wx:for="{{bomList}}" wx:key="id" class="bom-item">
            <view class="bom-item__main">
              <view class="bom-item__title-row">
                <text class="bom-item__name">{{item.materialName || item.partName || '-'}}</text>
                <text wx:if="{{item.partName}}" class="bom-item__part">{{item.partName}}</text>
              </view>
              <view class="bom-item__meta">
                <text wx:if="{{item.materialTypeText}}" class="bom-item__tag">{{item.materialTypeText}}</text>
                <text wx:if="{{item.color}}" class="bom-item__sub">{{item.color}}</text>
                <text wx:if="{{item.specification}}" class="bom-item__sub">{{item.specification}}</text>
              </view>
              <view class="bom-item__detail">
                <view class="bom-item__detail-item">
                  <text class="bom-item__detail-label">{{t.usagePerPiece}}</text>
                  <text class="bom-item__detail-val">{{item.usageAmount || '-'}}{{item.unit || ''}}</text>
                </view>
                <view wx:if="{{item.lossRate !== null && item.lossRate !== undefined}}" class="bom-item__detail-item">
                  <text class="bom-item__detail-label">{{t.lossRate}}</text>
                  <text class="bom-item__detail-val">{{item.lossRate}}%</text>
                </view>
                <view wx:if="{{item.unitPrice}}" class="bom-item__detail-item">
                  <text class="bom-item__detail-label">{{t.unitPrice}}</text>
                  <text class="bom-item__detail-val">¥{{item.unitPrice}}</text>
                </view>
                <view wx:if="{{item.totalPrice}}" class="bom-item__detail-item">
                  <text class="bom-item__detail-label">{{t.total}}</text>
                  <text class="bom-item__detail-val bom-item__detail-val--accent">¥{{item.totalPrice}}</text>
                </view>
              </view>
              <view wx:if="{{item.stockStatus}}" class="bom-item__stock">
                <view class="bom-item__stock-dot bom-item__stock-dot--{{item.stockStatus}}"></view>
                <text class="bom-item__stock-text">{{item.stockStatusText}}</text>
                <text wx:if="{{item.availableStock !== null && item.availableStock !== undefined}}" class="bom-item__stock-qty">{{item.availableStock}}{{item.unit}}</text>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noBomHint}}</text></view>
      </view>

      <!-- 纸样（附件中 bizType 为 pattern* 的子集，含流转后的终版，避免样衣完成后纸样消失） -->
      <view wx:if="{{activeTab === 'pattern'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.patternFiles}}</text>
          <text class="tab-card__count">{{patternFileList.length}}{{t.countPiecesUnit}}</text>
        </view>
        <view wx:if="{{attachmentLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <view wx:elif="{{patternFileList.length > 0}}" class="file-list">
          <view
            wx:for="{{patternFileList}}"
            wx:key="id"
            class="file-item"
            data-idx="{{item._srcIndex}}"
            bindtap="onAttachmentTap"
            hover-class="file-item--pressed"
            hover-stay-time="60"
          >
            <image wx:if="{{item._isImage}}" src="{{item._previewUrl}}" mode="aspectFill" class="file-item__thumb" />
            <view wx:else class="file-item__icon file-item__icon--pattern"></view>
            <view class="file-item__info">
              <text class="file-item__name">{{item.fileName || t.patternFiles}}</text>
              <text class="file-item__meta">v{{item.version || 1}} · {{item._bizTypeText}} · {{item._uploadTimeText}}</text>
            </view>
            <view class="file-item__action" data-idx="{{item._srcIndex}}" catchtap="onDownloadAttachment">
              <view class="icon-cloud" style="width:16px;height:16px;"></view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noPatternHint}}</text></view>
      </view>

      <!-- 尺寸表（横向：部位为行，尺码为列） -->
      <view wx:if="{{activeTab === 'size'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.tabSize}}</text>
          <text class="tab-card__count">{{sizeRows.length}}{{t.partsCount}}</text>
        </view>
        <view wx:if="{{sizeLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <scroll-view scroll-x wx:elif="{{sizeRows.length > 0}}" class="size-scroll" enhanced show-scrollbar="{{false}}">
          <view class="size-table">
            <!-- 表头：部位 | S | M | L | ... -->
            <view class="size-row size-row--head">
              <text class="size-cell size-cell--part">{{t.partHeader}}</text>
              <text wx:for="{{sizeColumns}}" wx:key="*this" class="size-cell size-cell--size">{{item}}</text>
            </view>
            <!-- 数据行：胸围 | 90 | 94 | 98 | ... -->
            <view wx:for="{{sizeRows}}" wx:key="partName" class="size-row">
              <text class="size-cell size-cell--part">{{item.partName}}</text>
              <block wx:for="{{sizeColumns}}" wx:for-item="col" wx:key="*this">
                <text class="size-cell size-cell--val">{{item.values[col]}}</text>
              </block>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noSizeHint}}</text></view>
      </view>

      <!-- 工序（可点击展开，显示实际扫码进度+记录） -->
      <view wx:if="{{activeTab === 'process'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.processProgress}}</text>
          <text class="tab-card__count">{{allProcesses.length}}{{t.countUnit}}</text>
        </view>
        <view wx:if="{{processLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <!-- D-170：工序时间线（布局对齐订单详情页「工序进度」） -->
        <view wx:elif="{{allProcesses.length > 0}}" class="proc-timeline">
          <view
            wx:for="{{allProcesses}}"
            wx:key="_key"
            class="proc-tl-item {{item._expanded ? 'proc-tl-item--expanded' : ''}}"
            data-idx="{{index}}"
            catchtap="onProcessItemTap"
          >
            <!-- 左侧轨道：状态圆点 + 连接线 -->
            <view class="proc-tl-rail">
              <view class="proc-tl-dot-wrap">
                <view wx:if="{{item._status === 'in_progress'}}" class="proc-tl-pulse"></view>
                <view class="proc-tl-dot proc-tl-dot--{{item._status}}">
                  <view wx:if="{{item._status === 'completed'}}" class="icon-checkmark-sm"></view>
                </view>
              </view>
              <view wx:if="{{index < allProcesses.length - 1}}" class="proc-tl-line"></view>
            </view>
            <!-- 右侧内容 -->
            <view class="proc-tl-body">
              <view class="proc-tl-info">
                <view class="proc-tl-name-row">
                  <text class="proc-tl-name {{item._status === 'pending' ? 'proc-tl-name--pending' : ''}}">{{item._name}}</text>
                  <text wx:if="{{item._stage}}" class="proc-tl-stage">{{item._stage}}</text>
                </view>
                <text wx:if="{{item._totalQty > 0}}" class="proc-tl-qty">{{item._completedQty}}/{{item._totalQty}}</text>
              </view>
              <view wx:if="{{item._totalQty > 0}}" class="proc-tl-bar">
                <view class="proc-tl-fill {{item._status === 'completed' ? 'proc-tl-fill--done' : ''}}" style="width:{{item._percent}}%"></view>
              </view>
              <view class="proc-tl-meta" wx:if="{{item._claimBy || item._lastTime || item._price}}">
                <text wx:if="{{item._claimBy}}" class="proc-tl-meta-text">{{item._claimBy}}</text>
                <text wx:if="{{item._claimBy && item._lastTime}}" class="proc-tl-meta-sep"> · </text>
                <text wx:if="{{item._lastTime}}" class="proc-tl-meta-text">{{item._lastTime}}</text>
                <text wx:if="{{item._price}}" class="proc-tl-meta-sep"> · </text>
                <text wx:if="{{item._price}}" class="proc-tl-meta-text">¥{{item._price}}/{{t.pieceUnit}}</text>
              </view>
              <!-- 展开明细：扫码记录列表 -->
              <view wx:if="{{item._expanded && item._scanRecords.length > 0}}" class="proc-tl-expand">
                <view class="scan-summary">
                  <text class="scan-summary__label">{{t.scanRecords}}</text>
                  <text class="scan-summary__count">{{item._scanCount}}{{t.recordsUnit}}</text>
                  <text wx:if="{{item._completedQty > 0}}" class="scan-summary__done">{{t.completedQty}}</text>
                  <text wx:if="{{item._receivedQty > 0}}" class="scan-summary__received">{{t.receivedQty}}</text>
                </view>
                <view class="scan-record-list">
                  <view wx:for="{{item._scanRecords}}" wx:for-item="rec" wx:for-index="ri" wx:key="ri" class="scan-record-item">
                    <view class="scan-record-item__top">
                      <text class="scan-record-item__op scan-record-item__op--{{rec._operationClass}}">{{rec._operationText}}</text>
                      <text class="scan-record-item__time">{{rec._displayTime || '-'}}</text>
                    </view>
                    <view class="scan-record-item__body">
                      <text class="scan-record-item__operator">{{rec.operatorName}}</text>
                      <text wx:if="{{rec.color}}" class="scan-record-item__color">· {{rec.color}}</text>
                      <text wx:if="{{rec.size}}" class="scan-record-item__size">· {{rec.size}}</text>
                      <text wx:if="{{rec.quantity > 0}}" class="scan-record-item__qty">· {{rec.quantity}}{{t.pieceUnit}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noProcessHint}}</text></view>
      </view>

      <!-- 二次工艺 -->
      <view wx:if="{{activeTab === 'secondary'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.tabSecondary}}</text>
          <text class="tab-card__count">{{secondaryList.length}}{{t.countUnit}}</text>
        </view>
        <view wx:if="{{secondaryLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <view wx:elif="{{secondaryList.length > 0}}" class="bom-list">
          <view wx:for="{{secondaryList}}" wx:key="id" class="bom-item">
            <view class="bom-item__main">
              <text class="bom-item__name">{{item.processName || '-'}}</text>
              <view class="bom-item__meta">
                <text wx:if="{{item.processTypeText}}" class="bom-item__tag">{{item.processTypeText}}</text>
                <text wx:if="{{item.factoryName}}" class="bom-item__sub">{{item.factoryName}}</text>
                <text wx:if="{{item.statusText}}" class="bom-item__sub">{{item.statusText}}</text>
              </view>
            </view>
            <view class="bom-item__right">
              <text wx:if="{{item.quantity}}" class="bom-item__qty">{{item.quantity}}</text>
              <text wx:if="{{item.unitPrice}}" class="bom-item__price">¥{{item.unitPrice}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noSecondary}}</text></view>
      </view>

      <!-- 附件（与 PC 端资料中心「附件文件」同源：/api/style/attachment/list?styleId=；底部不再重复展示，上传入口收进此处） -->
      <view wx:if="{{activeTab === 'attachment'}}" class="tab-card">
        <view class="tab-card__header">
          <text class="tab-card__title">{{t.tabAttachment}}</text>
          <view class="tab-card__header-right">
            <text class="tab-card__count">{{attachmentList.length}}{{t.countPiecesUnit}}</text>
            <view class="outline-btn outline-btn--sm" bindtap="onUploadAttachment">
              <view class="icon-plus-sm" style="width:12px;height:12px;"></view>
              <text class="outline-btn__text">{{t.tabAttachUpload}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{attachmentLoading}}" class="empty-hint"><text class="empty-hint__text">{{t.loading}}</text></view>
        <view wx:elif="{{attachmentList.length > 0}}" class="file-list">
          <view
            wx:for="{{attachmentList}}"
            wx:key="id"
            class="file-item"
            data-idx="{{index}}"
            bindtap="onAttachmentTap"
            hover-class="file-item--pressed"
            hover-stay-time="60"
          >
            <image wx:if="{{item._isImage}}" src="{{item._previewUrl}}" mode="aspectFill" class="file-item__thumb" />
            <view wx:elif="{{item._isPattern}}" class="file-item__icon file-item__icon--pattern"></view>
            <view wx:else class="file-item__icon"></view>
            <view class="file-item__info">
              <text class="file-item__name">{{item.fileName || t.tabAttachment}}</text>
              <text class="file-item__meta">{{item._bizTypeText}} · {{item.fileSizeText}} · {{item._uploadTimeText}}</text>
            </view>
            <view class="file-item__action" data-idx="{{index}}" catchtap="onDownloadAttachment">
              <view class="icon-cloud" style="width:16px;height:16px;"></view>
            </view>
          </view>
        </view>
        <view wx:else class="empty-hint"><text class="empty-hint__text">{{t.noAttachmentHint}}</text></view>
      </view>

    </view>
    </view>
    <!-- 资料区结束 -->

    <!-- 3. 款式备注（附件与 tab 内合并为一份展示，上传入口在「附件」tab；此处只保留备注） -->
    <view class="remarks-section">
      <view class="remarks-title-row">
        <text class="remarks-title">{{t.styleRemark}}</text>
        <text wx:if="{{styleInfo.styleNo}}" class="remarks-sub">{{styleInfo.styleNo}}</text>
        <text class="remarks-count">{{remarkList.length || 0}}{{t.remarkUnit}}</text>
      </view>
      <view class="remark-input-bar">
        <view class="remark-input-top">
          
            <view bindtap="openPicker" data-handler="onRemarkRoleChange" data-names="remarkRoles" data-range-key="label" class="remark-role-trigger">
              <view class="icon-user" style="width:14px;height:14px;flex-shrink:0;"></view>
              <text class="remark-role-text">{{remarkRoles[remarkRoleIndex].label}}</text>
              <view class="remark-role-chevron"></view>
            </view>
          
          <view class="outline-btn outline-btn--sm {{(submittingRemark || !remarkInput) ? 'is-disabled' : ''}}" bindtap="onSubmitRemark">
            <text class="outline-btn__text">{{submittingRemark ? t.submittingWord : t.submitWord}}</text>
          </view>
        </view>
        <textarea
          class="remark-textarea"
          placeholder="{{t.remarkInputPh}}"
          placeholder-class="remark-placeholder"
          value="{{remarkInput}}"
          bindinput="onRemarkInput"
          maxlength="500"
          auto-height
        />
      </view>
      <view wx:if="{{remarkList.length > 0}}" class="remark-list">
        <view wx:for="{{remarkList}}" wx:key="id" class="remark-card">
          <view class="remark-avatar" style="background:{{item._avatarColor}};">
            <text class="remark-avatar__text">{{item._avatarText}}</text>
          </view>
          <view class="remark-card__body">
            <view class="remark-card__header">
              <text class="remark-card__author">{{item._authorName}}</text>
              <view wx:if="{{item._roleLabel}}" class="remark-card__role">{{item._roleLabel}}</view>
              <text wx:if="{{item._timeText}}" class="remark-card__time">{{item._timeText}}</text>
            </view>
            <text class="remark-card__content">{{item.content}}</text>
          </view>
        </view>
      </view>
      <view wx:elif="{{!remarkLoading}}" class="empty-hint">
        <text class="empty-hint__text">{{t.noRemark}}</text>
      </view>
    </view>

    <view class="safe-area-bottom"></view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <view class="icon-sample" style="width:48px;height:48px;opacity:0.3;"></view>
    <text class="empty-state__text">{{t.noStyleInfo}}</text>
  </view>
  <ai-assistant />
</view>

<!-- 进度编辑器（与 PC 端 progressEditor 对齐） -->
<view wx:if="{{progressEditor.visible}}" class="progress-editor-mask" bindtap="onProgressCancel">
  <view class="progress-editor" catchtap="">
    <view class="progress-editor__header">
      <text class="progress-editor__title">{{t.progressEditor}} - {{progressEditor.stageName}}</text>
      <view class="progress-editor__close" bindtap="onProgressCancel">
        <text class="progress-editor__close-text">×</text>
      </view>
    </view>
    <view class="progress-editor__body">
      <view class="progress-editor__value-row">
        <view class="progress-editor__step-btn" data-delta="-10" bindtap="onProgressStep">
          <text class="progress-editor__step-text">-10</text>
        </view>
        <view class="progress-editor__value-display">
          <text class="progress-editor__value-num">{{progressEditor.percent}}</text>
          <text class="progress-editor__value-unit">%</text>
        </view>
        <view class="progress-editor__step-btn" data-delta="10" bindtap="onProgressStep">
          <text class="progress-editor__step-text">+10</text>
        </view>
      </view>
      <slider
        class="progress-editor__slider"
        min="0"
        max="100"
        step="5"
        value="{{progressEditor.percent}}"
        activeColor="var(--color-primary)"
        backgroundColor="var(--color-border)"
        block-color="var(--color-primary)"
        bindchange="onProgressSliderChange"
        bindchanging="onProgressSliderChange"
      />
      <view class="progress-editor__quick-row">
        <view class="progress-editor__quick-btn" data-delta="0" data-absolute="true" bindtap="onProgressStep">
          <text class="progress-editor__quick-text">{{t.resetWord}}</text>
        </view>
        <view class="progress-editor__quick-btn" data-delta="50" data-absolute="true" bindtap="onProgressStep">
          <text class="progress-editor__quick-text">{{t.halfWord}}</text>
        </view>
        <view class="progress-editor__quick-btn" data-delta="100" data-absolute="true" bindtap="onProgressStep">
          <text class="progress-editor__quick-text">{{t.completeWord}}</text>
        </view>
      </view>
    </view>
    <view class="progress-editor__footer">
      <view class="progress-editor__btn progress-editor__btn--cancel" bindtap="onProgressCancel">
        <text class="progress-editor__btn-text">{{t.cancel}}</text>
      </view>
      <view class="progress-editor__btn progress-editor__btn--save {{progressSaving ? 'is-disabled' : ''}}" bindtap="onProgressSave">
        <text class="progress-editor__btn-text">{{progressSaving ? t.savingWord : t.saveWord}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 可搜索选择器：替代原生 picker（原生没有搜索，选项多时只能一路滚） -->
<search-picker
  visible="{{pickerVisible}}"
  title="{{pickerTitle}}"
  options="{{pickerOptions}}"
  value="{{pickerValue}}"
  bind:select="onPickerSelect"
  bind:close="onPickerClose"
/>
