.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 12px var(--page-padding-x, 16px);
  box-sizing: border-box;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0;
}
.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-bottom: 10px;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
}

/* 卡片 */
.section-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  /* D-513：原 14px 偏大 → 降为 8px，卡片整体瘦身 */
  padding: 8px;
  box-sizing: border-box;
  margin-bottom: 8px;
  box-shadow: var(--shadow-sm);
}

/* 款式信息 */
.style-card {
  display: flex;
  gap: 8px;
  align-items: center;
}
.style-image {
  /* D-513：再缩，56→40，详情页头部更紧凑 */
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--color-bg-subtle);
}
.style-image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.style-image-text {
  /* D-513：原 4xl(24px) 是全局最大的号，占位字太夸张 → 降为 xl(18px) */
  font-size: var(--font-size-xl);
  color: var(--color-text-quaternary);
}
.style-info {
  flex: 1;
  min-width: 0;
}
.style-no {
  /* D-513：lg(16) → md(14)，头部更紧凑 */
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  line-height: 1.2;
}
.style-name {
  /* D-513：sm(13) → xs(12) */
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 1px;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}
.style-meta {
  display: flex;
  gap: 6px;
  /* D-513：margin 6px → 4px */
  margin-top: 4px;
  flex-wrap: wrap;
}
.meta-tag {
  font-size: var(--font-size-2xs);
  color: var(--color-primary);
  background: rgba(var(--color-primary-rgb), 0.08);
  padding: 2px 8px;
  border-radius: var(--radius-xs);
}
.meta-sub {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 6px;
  margin-bottom: 8px;
}
.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  text-align: center;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  /* D-513：原 14px → 降为 8px */
  padding: 8px 4px;
  box-sizing: border-box;
}
.stat-value {
  /* D-513：再缩，lg(16) → md(14) */
  font-size: var(--font-size-md);
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  line-height: 1.1;
}
.stat-value--muted { color: var(--color-text-tertiary); }
.stat-value--danger { color: var(--color-danger); }
.stat-value--info { color: var(--color-primary); }
.stat-label {
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
  margin-top: 2px;
  display: block;
}

/* 卡片头 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.card-title {
  font-size: var(--font-size-md-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}
.card-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* SKU 表格 */
.sku-scroll {
  margin: 0 -16px;
  padding: 0 16px;
  overflow: hidden;
}
.sku-table {
  display: inline-flex;
  flex-direction: column;
  min-width: 100%;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.sku-row {
  display: flex;
  border-bottom: 1px solid var(--color-border-light);
}
.sku-row:last-child {
  border-bottom: none;
}
.sku-row--header {
  background: var(--color-bg-muted);
}
.sku-row--header .sku-cell {
  font-weight: 600;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}
.sku-cell {
  padding: 10px 8px;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  white-space: nowrap;
  text-align: center;
  flex-shrink: 0;
}
.sku-cell--color { width: 70px; text-align: left; }
.sku-cell--size { width: 50px; }
.sku-cell--qty { width: 56px; }
.sku-cell--price { width: 60px; color: var(--color-primary); }
.sku-cell--loc { width: 70px; color: var(--color-text-tertiary); }
.sku-cell--action { width: 60px; }
.sku-cell--bold { font-weight: 600; }
.sku-cell--danger { color: var(--color-danger); }

.outbound-btn {
  display: inline-block;
  padding: 3px 10px;
  font-size: var(--font-size-xs);
  color: var(--color-text-white);
  background: var(--color-primary);
  border-radius: var(--radius-xs);
}
.outbound-btn--disabled {
  font-size: var(--font-size-xs);
  color: var(--color-text-quaternary);
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 0;
}
.empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
}

/* 出库弹窗 — 本地覆盖：居中弹窗（align-items: center），与全局 .modal-mask 底部弹窗（align-items: flex-end）不同，z-index 999 避免遮盖顶部导航 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  width: 80%;
  max-width: 320px;
  background: var(--color-bg-card);
  border-radius: var(--radius-2xl);
  overflow: hidden;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid var(--color-border);
}
.modal-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}
.modal-close {
  padding: 4px 8px;
  color: var(--color-text-tertiary);
}
.modal-body {
  padding: 20px 16px;
}
.outbound-info {
  text-align: center;
  margin-bottom: 16px;
}
.outbound-sku {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4px;
}
.outbound-available {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.qty-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}
.qty-btn {
  width: 36px;
  height: var(--btn-height-sm);
  line-height: 34px;
  text-align: center;
  /* D-513：原 2xl(20px) 在 36px 按钮里过满 → 降为 lg(16px)，+/- 更协调 */
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.qty-input {
  width: 60px;
  height: 36px;
  text-align: center;
  font-size: var(--font-size-lg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}
.modal-footer {
  display: flex;
  border-top: 1px solid var(--color-border);
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: var(--font-size-md-lg);
}
.modal-btn--cancel {
  color: var(--color-text-secondary);
  border-right: 1px solid var(--color-border);
}
.modal-btn--confirm {
  color: var(--color-primary);
  font-weight: 600;
}

/* ============ Tab 切换栏 ============ */
.tab-bar {
  display: flex;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 3px;
  /* D-513：margin 12px → 8px */
  margin-bottom: 8px;
  box-shadow: var(--shadow-sm);
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  /* D-513：padding 8px 0 → 6px 0 */
  padding: 6px 0;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
  position: relative;
  transition: all 0.2s ease;
}
.tab-item--active {
  background: rgba(var(--color-primary-rgb), 0.08);
  color: var(--color-primary);
  font-weight: 600;
}
.tab-text {
  font-size: var(--font-size-md);
}
.tab-badge {
  margin-left: 6px;
  min-width: 18px;
  height: 18px;
  line-height: 18px;
  padding: 0 5px;
  font-size: var(--font-size-2xs);
  color: var(--color-text-white);
  background: var(--color-primary);
  border-radius: var(--radius-md);
  text-align: center;
}

/* ============ 入库记录列表 ============ */
/* ============ 入库记录（精简：D-513） ============ */
.inbound-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.inbound-item {
  background: var(--color-bg-muted);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  /* D-513：原 10px 12px → 6px 8px，行高减半 */
  padding: 6px 8px;
}
.inbound-line {
  display: flex;
  align-items: center;
  /* D-513：单行紧凑布局：菲号|规格|数量|时间 */
  gap: 6px;
  font-size: var(--font-size-xs);
  line-height: 1.4;
}
.inbound-no {
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-text-primary);
  flex-shrink: 0;
}
.inbound-spec {
  flex: 1;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-2xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.inbound-qty {
  color: var(--color-primary);
  font-weight: 600;
  font-size: var(--font-size-xs);
  flex-shrink: 0;
}
.inbound-time {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-2xs);
  flex-shrink: 0;
}

/* ============ 对账信息（单行紧凑） ============ */
.reconcile-summary {
  margin-top: 8px;
  padding: 8px 10px;
  background: rgba(var(--color-primary-rgb), 0.04);
  border: 1px solid var(--color-primary-bg-dark);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.4;
}
.reconcile-strong {
  color: var(--color-text-primary);
  font-weight: 700;
}
.reconcile-strong--success { color: var(--color-success); }
.reconcile-strong--danger { color: var(--color-danger); }

/* ============ 辅助：小号加载/空状态 ============ */
.loading-wrap--small {
  padding: 30px 0;
}
.loading-spinner--small {
  width: 24px;
  height: 24px;
  border-width: 2px;
  margin-bottom: 6px;
}
.empty-wrap--small {
  padding: 40px 0;
}

/* ── D-482：入库操作按钮（手机端补上入库入口） ── */
.action-row {
  display: flex;
  justify-content: flex-end;
  padding: var(--space-8, 8rpx) var(--space-16, 16rpx) 0;
}
.action-btn {
  padding: var(--space-8, 8rpx) var(--space-32, 32rpx);
  font-size: 14px;
  font-weight: 600;
  border-radius: var(--radius-lg, 8px);
}
.action-btn--primary {
  color: #fff;
  background: var(--color-primary, #2d7ff9);
}
