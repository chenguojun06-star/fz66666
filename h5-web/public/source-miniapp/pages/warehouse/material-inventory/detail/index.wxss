/* 物料库存详情（D-514）
 * 版式对标 finished-inventory/detail；全部使用 design-tokens，禁止硬编码
 * 容器 .container 由 app.wxss 提供（含页面内边距与底部安全区）
 */

/* ===== ① 物料信息卡 ===== */
.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}
.material-card {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
}
.material-image {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--color-bg-page);
}
.material-image--placeholder {
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.material-image-text {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}
.material-info {
  flex: 1;
  min-width: 0;
}
.material-top {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-xs);
}
.type-tag {
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  color: var(--color-text-white);
  flex-shrink: 0;
}
.low-tag {
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  background: var(--color-danger-bg);
  color: var(--color-danger);
  flex-shrink: 0;
}
.material-name {
  display: block;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.material-code {
  display: block;
  margin-top: 2px;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ===== ② 操作按钮 ===== */
.action-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.action-btn {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}
.action-btn--primary {
  color: var(--color-text-white);
  background: var(--color-primary);
}
.action-btn--ghost {
  color: var(--color-primary);
  background: var(--color-primary-bg);
}

/* ===== ③ 库存概览 ===== */
.stats-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.stat-card {
  flex: 1;
  min-width: 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xs);
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.stat-value {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-value--muted {
  color: var(--color-text-secondary);
}
.stat-value--danger {
  color: var(--color-danger);
}
.stat-label {
  display: block;
  margin-top: 2px;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

/* ===== ④ 基本信息 ===== */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-xs);
}
.card-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}
.card-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1px solid var(--color-border-light);
  font-size: var(--font-size-sm);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  color: var(--color-text-secondary);
  flex-shrink: 0;
}
.info-value {
  color: var(--color-text-primary);
  text-align: right;
  margin-left: var(--spacing-md);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== ⑤ 出入库流水 ===== */
.tx-item {
  padding: var(--spacing-sm) 0;
  border-bottom: 1px solid var(--color-border-light);
}
.tx-item:last-child {
  border-bottom: none;
}
.tx-line {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-sm);
}
.tx-type {
  font-size: var(--font-size-2xs);
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.tx-type--IN {
  background: var(--color-success-bg);
  color: var(--color-success);
}
.tx-type--OUT {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}
.tx-qty {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
.tx-time {
  margin-left: auto;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}
.tx-sub {
  margin-top: 2px;
  font-size: var(--font-size-2xs);
  color: var(--color-text-tertiary);
}

/* ===== 加载 / 空状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}
.loading-wrap--small {
  padding-top: var(--spacing-xl);
}
.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: md-spin 0.8s linear infinite;
}
.loading-spinner--small {
  width: 20px;
  height: 20px;
  border-width: 2px;
}
@keyframes md-spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}
.empty-wrap--small {
  padding-top: var(--spacing-xl);
}
.empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}
