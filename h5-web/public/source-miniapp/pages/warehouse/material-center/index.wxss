/* 物料中心（D-514）
 * 视觉风格：与 material-database / defect / scan/history 等列表页保持一致
 * - 用 design-tokens，禁止硬编码颜色/尺寸
 * - 容器用 container（项目约定），不用 page
 * - 加载/空状态用项目约定类名（-wrap / -text / -sub）
 */

page {
  background: var(--color-bg-page);
}

.container {
  min-height: 100vh;
  padding-bottom: calc(20px + env(safe-area-inset-bottom));
}

/* ===== 筛选器 slot（sticky-search-bar 已含搜索框，此处只放 picker） ===== */
.filter-pickers {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.filter-picker {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--color-bg-card);
  border-radius: var(--radius-sm);
  padding: 0 10px;
  height: 32px;
  flex: 1;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}
.filter-picker-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.filter-picker-arrow {
  font-size: var(--font-size-xxs);
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* ===== 5 个 tab 切换（沿用项目 tab-bar / tab-item / active 约定） ===== */
.tab-bar {
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1px solid var(--color-border);
  margin: 0 calc(-1 * var(--page-padding-x));
  padding: 0 var(--page-padding-x);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  position: relative;
  transition: color 0.15s ease;
}
.tab-item.active {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  background: var(--color-primary);
  border-radius: var(--radius-sm);
}

/* ===== 加载/空状态（项目约定 -wrap / -text / -sub） ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}
.loading-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: mc-spin 0.8s linear infinite;
}
@keyframes mc-spin { to { transform: rotate(360deg); } }
.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120px;
}
.empty-icon {
  font-size: 48px;
}
.empty-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-md-lg);
  color: var(--color-text-secondary);
}
.empty-sub {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ===== 库存 tab 卡片列表（沿用 material-inventory 风格，对齐 --radius-lg / --color-bg-card） ===== */
.total-bar {
  padding: var(--spacing-sm) 0;
}
.total-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.card-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-xs);
}
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 12px;
  box-shadow: var(--shadow-sm);
}
/* D-514：卡片头 = 图片(44x44) + 右侧信息，与成品库存卡片同构 */
.card-header {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
}
.item-image {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.item-image--placeholder {
  background: var(--color-primary-bg);
}
.item-image-text {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}
.item-info {
  flex: 1;
  min-width: 0;
}
.card-top {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.type-tag {
  padding: 2px 10px;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  color: var(--color-text-white);
  flex-shrink: 0;
}
.card-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.low-tag {
  padding: 2px 8px;
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-2xs);
  flex-shrink: 0;
}
.card-main {
  margin-top: var(--spacing-sm);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--spacing-sm);
}
.card-code {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stock-main {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  flex-shrink: 0;
}
.stock-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}
.stock-value {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
  font-variant-numeric: tabular-nums;
}
.stock-value.is-low {
  color: var(--color-danger);
}
.stock-value.is-zero {
  color: var(--color-text-tertiary);
}
.stock-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}
.card-sub {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}
.card-loc {
  color: var(--color-text-tertiary);
  margin-left: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160px;
}
.card-actions {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1px solid var(--color-border);
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-sm);
}
.act-btn {
  min-height: 32px;
  line-height: 30px;
  padding: 0 var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  text-align: center;
}
.act-btn--in {
  color: var(--color-primary);
  background: var(--color-primary-bg);
  border: 1px solid var(--color-primary-border);
}
.act-btn--out {
  color: var(--color-text-white);
  background: var(--color-primary);
}

/* ===== 非库存 tab：操作面板（让用户立刻看到"能做什么 / 最近做了什么"） ===== */
.tab-panel {
  padding-top: var(--spacing-lg);
}
.action-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}
.action-icon {
  width: 48px;
  height: 48px;
  line-height: 48px;
  text-align: center;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 24px;
  font-weight: var(--font-weight-semibold);
  flex-shrink: 0;
}
.action-icon--in {
  background: var(--color-success-bg);
  color: var(--color-success);
}
.action-icon--out {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}
.action-icon--picking {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 22px;
}
.action-icon--scan {
  background: var(--color-primary-bg);
  font-size: 22px;
}
.action-info {
  flex: 1;
  min-width: 0;
}
.action-title {
  font-size: var(--font-size-md-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 2px;
}
.action-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}
.action-arrow {
  font-size: 20px;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.action-tips {
  margin-top: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.7;
}