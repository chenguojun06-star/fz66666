<view class="container">
  <view class="sub-header">
    <view class="count">{{t.pendingFmt}}{{activeTab === 'tenant' ? tenantTotal : total}}{{t.peopleUnit}}</view>
  </view>

  <!--
    D-422：tab 命名与 PC 端 UserApproval 对齐（原先命名名不符实，导致"外发工厂审核"找不到入口）
      PC 端「租户员工审批」   ← /api/system/user/pending
      PC 端「外发工厂员工审批」← /api/system/tenant/registrations/pending
    小程序此前分别叫「系统注册」「工人注册」，与实际业务对不上，现改正。
    注：data-tab 取值保持 tenant/system 不变，仅调整展示文案，避免牵连既有逻辑。
  -->
  <view wx:if="{{isTenantOwner || isFactoryOwner}}" class="tab-bar">
    <view class="tab-item {{activeTab === 'tenant' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="tenant">
      {{t.externalTab}} ({{tenantTotal}})
    </view>
    <view wx:if="{{isPlatformAdmin}}" class="tab-item {{activeTab === 'system' ? 'tab-active' : ''}}" bindtap="onTabChange" data-tab="system">
      {{t.tenantTab}} ({{total}})
    </view>
  </view>

  <!-- 系统待审批列表 -->
  <view wx:if="{{activeTab === 'system'}}">
    <view wx:if="{{loading && pendingUsers.length === 0}}" class="loading">
      <view class="loading-spinner"></view>
      <view class="loading-text">{{t.loading}}</view>
    </view>

    <view wx:elif="{{pendingUsers.length === 0}}" class="empty">
      <view class="empty-icon icon-check-green"></view>
      <view class="empty-text">{{t.noPendingUsers}}</view>
    </view>

    <view wx:else class="user-list">
      <view wx:for="{{pendingUsers}}" wx:key="id" class="user-card">
        <view class="user-header">
          <view class="user-avatar">
            <view class="line-icon line-icon--sm icon-user"></view>
          </view>
          <view class="user-info">
            <view class="user-name-row">
              <view class="user-name">{{item.name || item.username}}</view>
              <view class="user-time">{{item.createTime}}</view>
            </view>
            <view wx:if="{{item.phone}}" class="user-phone">{{item.phone}}</view>
          </view>
        </view>
        <view wx:if="{{item.roleName}}" class="user-meta-row">
          <view class="position-tag">{{item.roleName}}</view>
        </view>
        <view class="card-divider"></view>
        <view class="user-actions">
          <view class="action-btn approve-btn" data-user="{{item}}" bindtap="onApproveUser">{{t.passBtnW}}</view>
          <view class="action-btn reject-btn" data-user="{{item}}" bindtap="onReject">{{t.rejectBtnW}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && pendingUsers.length > 0}}" class="loading-more">{{t.loadMoreW}}</view>
  </view>

  <!-- 外发工厂员工注册列表（对应 PC 端「外发工厂员工审批」tab） -->
  <view wx:if="{{activeTab === 'tenant'}}">
    <view wx:if="{{tenantRegistrations.length === 0}}" class="empty">
      <view class="empty-icon line-icon line-icon--xl icon-clipboard"></view>
      <view class="empty-text">{{t.noExternalPending}}</view>
      <view class="empty-hint">{{t.shareQrHint}}</view>
    </view>

    <view wx:else class="user-list">
      <view wx:for="{{tenantRegistrations}}" wx:key="id" class="user-card">
        <view class="user-header">
          <view class="user-avatar avatar-tenant">
            <view class="line-icon line-icon--sm icon-user"></view>
          </view>
          <view class="user-info">
            <view class="user-name-row">
              <view class="user-name">
                {{item.name || item.username}}
                <text class="badge-tag">{{t.externalFactory}}</text>
              </view>
              <view class="user-time">{{item.createTime}}</view>
            </view>
            <view wx:if="{{item.phone}}" class="user-phone">{{item.phone}}</view>
          </view>
        </view>
        <view class="user-meta-row">
          <view wx:if="{{item.factoryName}}" class="user-factory">
            <view class="icon-factory"></view>
            <text class="factory-name">{{item.factoryName}}</text>
          </view>
          <view wx:if="{{item.roleName}}" class="position-tag">{{item.roleName}}</view>
        </view>
        <view class="card-divider"></view>
        <view class="user-actions">
          <view class="action-btn approve-btn" data-user="{{item}}" bindtap="onTenantApprove">{{t.passBtnW}}</view>
          <view class="action-btn reject-btn" data-user="{{item}}" bindtap="onTenantReject">{{t.rejectBtnW}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 批准区域 —— 角色分配（页内展开，租户员工 / 外发工厂员工共用，按 approvalMode 分流接口） -->
  <view wx:if="{{showApprovalModal}}" class="inline-form-card">
    <view class="inline-form-title">{{approvalMode === 'tenant' ? t.approveExtTitle : t.approveUserTitle}}</view>
    <view class="mf-body">
      <view class="modal-text">
        {{t.approvePrefix}}<text class="highlight">{{currentUser.name || currentUser.username}}</text>
      </view>
      <view class="modal-hint" wx:if="{{approvalMode === 'tenant' && currentUser.factoryName}}">{{t.factoryOfLabel}}{{currentUser.factoryName}}</view>
      <view class="modal-hint">{{t.approveHint}}</view>

      <view class="mf-item">
        <view class="mf-label">{{t.pickRole}} <text class="required">*</text></view>
        <view class="inline-selector">
          <scroll-view class="inline-selector-list" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
            <view
              wx:for="{{roleOptions}}"
              wx:key="id"
              class="inline-selector-item {{selectedRoleId === item._idStr ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onRoleSelect">
              <view class="inline-selector-left">
                <view class="inline-selector-radio {{selectedRoleId === item._idStr ? 'checked' : ''}}">
                  <view wx:if="{{selectedRoleId === item._idStr}}" class="inline-selector-radio-dot"></view>
                </view>
                <text class="inline-selector-label">{{item.roleName}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
    <view class="mf-actions">
      <view class="mf-btn cancel" bindtap="cancelApprove">{{t.cancel}}</view>
      <view class="mf-btn ok" bindtap="confirmApprove">{{t.approveAssignBtn}}</view>
    </view>
  </view>

  <!-- 拒绝区域（页内展开） -->
  <view wx:if="{{showRejectModal}}" class="inline-form-card">
    <view class="inline-form-title">{{t.rejectUserTitle}}</view>
    <view class="mf-body">
      <view class="modal-text">
        {{t.rejectUserFmt}} <text class="highlight">{{currentUser.name || currentUser.username}}</text>{{t.nameUnit}}
      </view>
      <view class="modal-hint danger">{{t.rejectLoginHintW}}</view>

      <view class="mf-item">
        <view class="mf-label">{{t.rejectReasonLabel}} <text class="required">*</text></view>
        <textarea
          class="mf-textarea"
          placeholder="{{t.rejectReasonReq}}"
          value="{{rejectReason}}"
          bindinput="onRejectReasonInput"
          maxlength="200"
        />
      </view>
    </view>
    <view class="mf-actions">
      <view class="mf-btn cancel" bindtap="cancelReject">{{t.cancel}}</view>
      <view class="mf-btn danger" bindtap="confirmReject">{{t.confirmRejectBtn}}</view>
    </view>
  </view>
  <ai-assistant />
</view>
