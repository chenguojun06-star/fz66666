{
	servers {
		protocols h1
	}
}

api.webyszl.cn {
	reverse_proxy /ws/* backend:8088 {
		flush_interval -1
	}
	reverse_proxy backend:8088 {
		flush_interval -1
	}
}

db.webyszl.cn {
	# D-461：CloudBeaver 崩溃循环暂退位，phpMyAdmin 轻量常驻（内存占用极小）
	reverse_proxy phpmyadmin:80
	# D-460：管理台不可用时给友好提示而非裸 502
	handle_errors {
		respond <<HTML
		<!DOCTYPE html>
		<html lang="zh"><head><meta charset="utf-8"><title>数据库管理台不可用</title></head>
		<body style="font-family:system-ui;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#f5f5f7">
		<div style="text-align:center">
		<h2 style="color:#1d1d1f">数据库管理台暂时不可用</h2>
		<p style="color:#6e6e73">在服务器执行以下命令启动，然后刷新本页：</p>
		<code style="background:#1d1d1f;color:#fff;padding:10px 14px;border-radius:6px;display:inline-block">cd /opt/fz66666/deploy/lighthouse && sudo docker compose up -d phpmyadmin</code>
		<p style="color:#8e8e93;font-size:13px">数据本身安然无恙——只是查看工具没在运行。</p>
		</div>
		</body></html>
		HTML 503
	}
}

www.webyszl.cn {
	reverse_proxy /api/* backend:8088 {
		flush_interval -1
	}
	reverse_proxy /ws/* backend:8088 {
		flush_interval -1
	}
	reverse_proxy frontend:80
}

webyszl.cn {
	redir https://www.webyszl.cn{uri} permanent
}
