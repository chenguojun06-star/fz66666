#!/bin/bash
# pre-push — git hook，push 前自动触发 safe-push.sh
#
# 安装方式（二选一）：
#   方式1（推荐）: git config core.hooksPath scripts/hooks
#   方式2: cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# 绕过方式（紧急情况）: git push --no-verify
#
# ★ 智能全量模式（2026-08-20 改造，P0 事故根因修复）：
#   旧逻辑默认 --quick 跳过编译/tsc → 坏代码进仓库 → CI 编译失败 →
#   deploy job 被静默跳过 → 云端跑旧代码 → 用户看到 404/500。
#   新逻辑按待推送代码类型自动选择检查范围：
#     - 含 .java  → 跑后端编译（safe-push --backend，含 Flyway/租户审计）
#     - 含 .ts/.tsx → 跑前端 tsc（safe-push --frontend）
#     - 同时含    → 全量 safe-push
#     - 纯文档/脚本 → --quick（脚本类检查本来就全跑）
#   环境变量：
#     SAFE_PUSH_FULL=1  强制全量
#     SAFE_PUSH_QUICK=1 强制快速（仅紧急情况）
#
set -uo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
SAFE_PUSH="$ROOT_DIR/scripts/safe-push.sh"

# 读取并丢弃 stdin（git pre-push 协议要求）
while read -r _ _ _ _; do :; done

if [[ ! -x "$SAFE_PUSH" ]]; then
  echo "[pre-push] safe-push.sh 不存在或不可执行，跳过检查"
  echo "[pre-push] 请确认 scripts/safe-push.sh 存在且有执行权限"
  exit 0
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  pre-push hook 触发 — 执行 safe-push.sh（智能模式）"
echo "  紧急绕过: git push --no-verify"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ---- 检测待推送 commit 涉及的代码类型 ----
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "origin/HEAD")
PUSHED_FILES=$(git log --name-only --pretty=format: "$UPSTREAM"..HEAD 2>/dev/null | sort -u | grep -v '^$' || true)

HAS_JAVA=$(echo "$PUSHED_FILES" | grep -c '\.java$' || true)
HAS_TS=$(echo "$PUSHED_FILES" | grep -cE '\.(ts|tsx)$' || true)
HAS_SQL=$(echo "$PUSHED_FILES" | grep -c '\.sql$' || true)

echo "[pre-push] 待推送变更: $(echo "$PUSHED_FILES" | grep -c '' || echo 0) 个文件 (java=$HAS_JAVA ts=$HAS_TS sql=$HAS_SQL)"

# ---- 选择检查范围 ----
if [[ "${SAFE_PUSH_QUICK:-0}" == "1" ]]; then
  ARGS="--quick"
  echo "[pre-push] ⚡ SAFE_PUSH_QUICK=1，快速模式（紧急情况，风险自负）"
elif [[ "${SAFE_PUSH_FULL:-0}" == "1" ]]; then
  ARGS=""
  echo "[pre-push] 🔍 SAFE_PUSH_FULL=1，强制全量模式"
elif [[ "$HAS_JAVA" -gt 0 && "$HAS_TS" -gt 0 ]]; then
  ARGS=""
  echo "[pre-push] 🔍 检测到 Java + TS 变更 → 全量检查（编译+tsc）"
elif [[ "$HAS_JAVA" -gt 0 ]]; then
  ARGS="--backend"
  echo "[pre-push] 🔍 检测到 Java 变更 → 后端全量检查（含编译）"
elif [[ "$HAS_TS" -gt 0 ]]; then
  ARGS="--frontend"
  echo "[pre-push] 🔍 检测到 TS 变更 → 前端全量检查（含 tsc）"
else
  ARGS="--quick"
  echo "[pre-push] ⚡ 无代码变更（文档/脚本/SQL）→ 快速模式（脚本检查仍全跑）"
fi

# ---- 小程序引用完整性检查（D-476）----
# 背景：小程序改动此前**完全没有推送前校验**，导致两次事故都是推上去之后
#   才在开发者工具编译阶段暴露：
#     - design-tokens.wxss 自定义属性写在规则块外 → 整个 token 文件编译失败（D-468）
#     - 6 个三层深页面 @import 路径写浅一层 → 文件找不到（D-475）
#   小程序不走 CI 编译，故必须在这里拦。
HAS_MINI=$(echo "$PUSHED_FILES" | grep -c '^miniprogram/' || true)
if [[ "$HAS_MINI" -gt 0 ]]; then
  echo "[pre-push] 🔍 检测到小程序变更 ${HAS_MINI} 个文件 → 引用完整性检查"
  MINI_CHECK="$ROOT_DIR/scripts/check-miniprogram-refs.py"
  if [[ -f "$MINI_CHECK" ]]; then
    # 仓库里有**多份小程序副本**，必须都查 ——
    # miniprogram 是源（_sync-meta.json 的 sourceRoot），
    # h5-web/source-miniapp 与 h5-web/public/source-miniapp 是同步脚本产出的镜像
    # （见 h5-web/scripts/sync-miniprogram.mjs，单向：miniprogram → 两份镜像）。
    # D-475 当初只改了 miniprogram/，两份镜像仍带着同样的 bug —— 故三份都要查。
    for MINI_DIR in miniprogram h5-web/source-miniapp h5-web/public/source-miniapp; do
      if [[ -d "$ROOT_DIR/$MINI_DIR" ]]; then
        python3 "$MINI_CHECK" "$MINI_DIR"
        MINI_CODE=$?
        if [[ $MINI_CODE -ne 0 ]]; then
          echo ""
          echo "❌ 小程序引用完整性检查未通过（$MINI_DIR），推送已阻止"
          echo "   修复上述引用问题后重新 push，或紧急情况: git push --no-verify"
          echo ""
          echo "⚠️  小程序不走 CI 编译 —— 带病推送会直到开发者工具编译阶段才暴露。"
          echo "⚠️  注意：仓库有多份小程序副本，修复要同步到每一份，否则另一份仍会编译失败。"
          exit 1
        fi
      fi
    done
  else
    echo "[pre-push] ⚠️ 未找到 $MINI_CHECK，跳过小程序检查"
  fi

  # ---- 三份副本一致性（D-492）----
  # 引用完整性是**逐份独立**校验，查不出「源改了、镜像没改」—— 旧写法本身可能
  # 照样能解析（如 pages/scan 两层深，'../../styles/x' 也合法）。
  # 这个坑踩过两次：D-475（6 处 import 路径）、D-476（2 处路径归一化）都只改了源。
  SYNC_CHECK="$ROOT_DIR/scripts/check-miniprogram-sync.py"
  if [[ -f "$SYNC_CHECK" ]]; then
    echo "[pre-push] 🔁 检查三份副本一致性"
    python3 "$SYNC_CHECK"
    SYNC_CODE=$?
    if [[ $SYNC_CODE -ne 0 ]]; then
      echo ""
      echo "❌ 三份小程序副本不一致（多半是只改了 miniprogram/ 忘了同步镜像），推送已阻止"
      echo "   把改动同步到 h5-web/source-miniapp 与 h5-web/public/source-miniapp 后重新 push"
      echo "   紧急情况: git push --no-verify"
      exit 1
    fi
  fi

  # ---- 小程序页面逻辑测试（D-490）----
  # 引用完整性查不出**运行时**问题。今晚实际踩到两个：
  #   - setData 回调不绑定 this（10 处，D-487）
  #   - wx.showActionSheet itemList ≤6（9 处，D-488）
  # 故再加一层：用 mock 的 wx/api 把页面逻辑在 Node 里真跑一遍（70 项断言）。
  PAGE_TEST="$ROOT_DIR/scripts/test-warehouse-pages.mjs"
  if command -v node >/dev/null 2>&1 && [[ -f "$PAGE_TEST" ]]; then
    echo "[pre-push] 🧪 运行小程序页面逻辑测试"
    node "$PAGE_TEST"
    TEST_CODE=$?
    if [[ $TEST_CODE -ne 0 ]]; then
      echo ""
      echo "❌ 小程序页面逻辑测试未通过，推送已阻止"
      echo "   修复后重新 push，或紧急情况: git push --no-verify"
      exit 1
    fi
    echo "[pre-push] ✅ 页面逻辑测试通过"
  else
    echo "[pre-push] ⚠️ 未找到 node 或 $PAGE_TEST，跳过页面逻辑测试"
  fi
fi

"$SAFE_PUSH" $ARGS
EXIT_CODE=$?

if [[ $EXIT_CODE -ne 0 ]]; then
  echo ""
  echo "❌ pre-push 检查未通过，推送已阻止"
  echo "   修复问题后重新 push，或紧急情况: git push --no-verify"
  echo ""
  echo "⚠️  重要：如果用 --no-verify 强推，CI 编译失败会导致部署被跳过，"
  echo "   云端继续跑旧代码（2026-08-20 事故根因），请务必确认 CI 绿色。"
  exit 1
fi

exit 0
